+/// The entries of one of the vendor's three pushes, in the order they should
+/// reach the CP. Owned by `config`; null with `*out_n` zero if `config` is
+/// null or `group` is out of range.
+///
+/// # Safety
+/// As [`samsung_ims_config_entries`].
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_config_group(
+    config: *const SamsungImsConfig,
+    group: SamsungImsConfigGroup,
+    out_n_entries: *mut usize,
+) -> *const SamsungAimsConfigEntry {
+    let slot = match group {
+        SamsungImsConfigGroup::Full => 0usize,
+        SamsungImsConfigGroup::Identity => 1,
+        SamsungImsConfigGroup::Carrier => 2,
+    };
+    if config.is_null() {
+        if !out_n_entries.is_null() {
+            out_n_entries.write(0);
+        }
+        return core::ptr::null();
+    }
+    let g = &(*config).groups[slot];
+    if !out_n_entries.is_null() {
+        out_n_entries.write(g.len());
+    }
+    g.as_ptr()
+}
