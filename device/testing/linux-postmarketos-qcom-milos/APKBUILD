maintainer="Luca Weiss <luca@lucaweiss.eu>"
_flavor="postmarketos-qcom-milos"
pkgname=linux-$_flavor
pkgver=7.3.0
pkgrel=0
pkgdesc="Mainline Kernel fork for Qualcomm Milos SoC (SM7635, etc.) devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/milos-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-uefi
	"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	python3
	zstd
"

_repo="linux"
_config="config-$_flavor.$arch"
_tag="v$pkgver-milos"

# Source
source="
	https://github.com/milos-mainline/$_repo/archive/refs/tags/$_tag/$_repo-$_tag.tar.gz
	$_config
"
builddir="$srcdir/$_repo-$pkgver-milos"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	# ZBOOT EFI decompressor for EFI booting
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
		"$pkgdir/boot/linux.efi"

	# Old GZIP'd kernel image for boot.img compatibility
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm "$pkgdir"/usr/lib/modules/*/build

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

sha512sums="
b99fdefbbc3dd91cbbc6ca0099486ebe7e28eabb2b9f219d1ba4f2f928423faa6a5aa60d9e9f6af9c59aee5ef2e74ed0bed3f5667ca185d5ecd3d4b8f261b8bf  linux-v7.3.0-milos.tar.gz
e9ca00d632b6710c4213116fa5b37dd40a56edfc45bff8e61c6526600e94ff3bffa6d92bfc882cf61ebabdf8cc1d4851cc888f20cf197ec63a3ab44bd5e00820  config-postmarketos-qcom-milos.aarch64
"
