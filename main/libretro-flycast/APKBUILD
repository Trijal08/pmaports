# Maintainer: Trijal Saha <trijalsaha2012@gmail.com>
pkgname=libretro-flycast
pkgver=0_git20260706
pkgrel=0
_commit="45bd2f4e59708a7c16a5bb1cb90a94d1b39e330d"
pkgdesc="libretro core for flycast"
url="https://github.com/libretro/flycast"
# aarch64 only, on purpose: "pmbootstrap build" with no --arch builds for
# the native architecture whenever the APKBUILD lists it, so listing
# x86_64 here quietly builds a package the R36S cannot use.
arch="aarch64"
license="GPL-2.0-only"
# !pmb:crossdirect: crossdirect runs Alpine's *cross* gcc, which cannot
# reach its own toolchain directories from inside the aarch64 chroot. It
# surfaced three times in a row and each was the same fault - no omp.h, then
# "'-fuse-linker-plugin', but liblto_plugin.so not found", then "cannot find
# crtbeginS.o" and "cannot find -lgcc". Every one of those files exists in
# both chroots. Falling back to qemu uses the target's own complete gcc.
# pmaports does the same for networkmanager over a related lto1 failure.
# The cost is an emulated compile, once.
options="!check !pmb:crossdirect" # No tests
# Overrides Alpine's aport, which is pinned at 0_git20220406 - an April 2022
# snapshot. This is the libretro mirror's HEAD as of 2026-07-06: four years
# of Dreamcast fixes, and nothing more exotic than that. The option keys are
# unchanged (libretro_core_option_defines.h still says CORE_OPTION_NAME
# "reicast"), so reicast_region and the rest of the tuning carry over.
#
# Not flyinghead/flycast, which is what Arch packages: upstream moved the
# libretro target to CMake and needs nine git submodules (asio, glslang,
# libchdr, tinycmmc, tinygettext, Vulkan-Headers, VulkanMemoryAllocator,
# xbyak). The mirror still ships the legacy Makefile and vendors everything
# under core/deps, so a plain archive builds - a version bump rather than a
# packaging project. Upstream is also the heavier renderer, which is the
# wrong direction for a 4x Cortex-A35.
makedepends="mesa-dev zlib-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/libretro/flycast/archive/$_commit.tar.gz
	0001-libzip-include-unistd-h-unconditionally.patch
	"
builddir="$srcdir/flycast-$_commit"

case $CARCH in
aarch64)
	# HOST_CPU_FLAGS is computed by the Makefile from WITH_DYNAREC
	# (-DHOST_CPU=0x20000006 for arm64). Passing it on the command line
	# would override that assignment and leave HOST_CPU undefined.
	_args="WITH_DYNAREC=arm64 HAVE_GENERIC_JIT=0 HAVE_VULKAN=0" ;;
arm*)
	_args="WITH_DYNAREC=arm HAVE_GENERIC_JIT=0 HAVE_VULKAN=0" ;;
esac

build() {
	# Built against the bundled deps. The old aport unbundled libzip,
	# miniupnpc and zlib via two local patches plus SYSTEM_LIBZIP=1 and
	# SYSTEM_ZLIB=1; those Makefile switches no longer exist, and the
	# patches were written against the 2022 tree.
	#
	# The last two switches are no longer load-bearing now that the build
	# does not go through crossdirect; both are kept on their own merits,
	# and both are a line to drop if they ever get in the way.
	#
	# HAVE_OPENMP=0: flycast uses OpenMP in exactly one place, the xBRZ
	# texture upscaler, which a 4x Cortex-A35 cannot run at a playable
	# speed. Turning it off keeps libgomp out of the core's dependencies.
	# It defines TARGET_NO_OPENMP, which TexCache.cpp guards every omp use
	# behind - the upscaler falls back to a serial xbrz::scale() - and
	# softrend.cpp, the only other omp.h user, is not in the source list.
	#
	# LDFLAGS_END=-fno-use-linker-plugin: Alpine's gcc is built with
	# HAVE_LTO_PLUGIN=2 and offers the linker an LTO plugin on every link.
	# Nothing here is compiled with LTO (HAVE_LTCG=0), so there is nothing
	# for it to do. LDFLAGS_END is empty on every non-Windows target and
	# appears only in the link rule.
	make $_args HAVE_LTCG=0 HAVE_OPENMP=0 LDFLAGS_END=-fno-use-linker-plugin
}

package() {
	install -Dm644 flycast_libretro.so \
		"$pkgdir"/usr/lib/libretro/flycast_libretro.so
}

sha512sums="
