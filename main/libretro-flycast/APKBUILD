a156c5f5b5492126b4128db00aae7cd550b1d4053fe80513c432ee78c7fd2180102f90f54c0e1934a8cd318f13927c388058a8e6699b7f1334fc297132b7f402  0001-libzip-include-unistd-h-unconditionally.patch
