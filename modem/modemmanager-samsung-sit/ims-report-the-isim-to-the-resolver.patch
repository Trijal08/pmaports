From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Fri, 7 Nov 2026 00:00:00 +0000
Subject: [PATCH] samsung-sit: read the ISIM's home domain and report it

Stock puts the IMS home domain in the hidden menu, and only for a card
that carries an ISIM: of this pair the Videotron card has one and is sent
ims.mnc500.mcc302.3gppnetwork.org, the Telus card has none and is sent no
domain at all.

The name is the operator's to choose. TS 23.003 13.2 gives a default form
and most operators use it, but a card states its own in EF_DOMAIN and
nothing obliges that to match -- so this reads the file rather than
deriving a string that would be confidently wrong on the networks that
differ. Deriving stays as the fallback for a card that has an ISIM but
refuses the file.

EF_DOMAIN already appears in the boot read list, next to the other ISIM
files, and has never produced anything: those reads go to the subscription
application, and the ISIM's files are reachable only under ADF_ISIM. The
read therefore needed an application of its own, which is the bulk of this
change; the AID is one the card already reported and the SIM_IO builder
already takes.
diff -ruN mm67/src/plugins/samsung-sit/mm-sit-carrier-config.h v72/src/plugins/samsung-sit/mm-sit-carrier-config.h
--- a/src/plugins/samsung-sit/mm-sit-carrier-config.h	2026-11-06 22:23:25.989017451 -0500
+++ b/src/plugins/samsung-sit/mm-sit-carrier-config.h	2026-11-06 22:31:52.068379767 -0500
@@ -17,6 +17,11 @@
     const gchar *gid1;
     const gchar *gid2;
     const gchar *privilege_access_rule;
+    /* Whether the card carries an ISIM application. Only the IMS settings
+     * read it; the manifest resolver ignores it. */
+    gboolean     has_isim;
+    /* EF_DOMAIN as the ISIM states it, or NULL to derive the 3GPP form. */
+    const gchar *isim_domain;
 } MMSitCarrierIdentity;
 
 typedef struct {
diff -ruN mm67/src/plugins/samsung-sit/mm-sit-client.c v72/src/plugins/samsung-sit/mm-sit-client.c
--- a/src/plugins/samsung-sit/mm-sit-client.c	2026-11-06 22:23:25.988242165 -0500
+++ b/src/plugins/samsung-sit/mm-sit-client.c	2026-11-06 22:31:21.180933205 -0500
@@ -123,6 +123,10 @@
      * on the stack whose SIM has an ISIM (AID ...871004...), two on the one
      * that does not. Caching only apps[0] made that impossible.
      */
+    /* EF_DOMAIN from the ISIM, if the card has one. The operator chooses it,
+     * so it is read rather than derived -- most use the 3GPP default form but
+     * nothing requires them to. */
+    gchar               *isim_domain;
     guint8               sim_aids[MM_SIT_MAX_SIM_APPS][MM_SIT_MAX_AID_LENGTH];
     gsize                sim_aid_lens[MM_SIT_MAX_SIM_APPS];
     guint                sim_aid_count;
@@ -488,6 +492,93 @@
         *out_software_version = self->priv->device_build;
 }
 
+/*
+ * Whether the card carries an ISIM application.
+ *
+ * It decides one hidden-menu value: stock sends the IMS home domain only for
+ * a card that has an ISIM. Of this pair, the Videotron card has one and is
+ * sent ims.mnc500.mcc302.3gppnetwork.org; the Telus card has none and is sent
+ * no domain at all.
+ */
+/* 3GPP TS 31.103: the ISIM's application identifier. */
+static const guint8 isim_aid_prefix[] = { 0xa0, 0x00, 0x00, 0x00, 0x87, 0x10, 0x04 };
+
+static const guint8 *
+isim_aid (MMSitClient *self,
+          gsize       *out_len)
+{
+    guint i;
+
+    for (i = 0; i < self->priv->sim_aid_count; i++) {
+        if (self->priv->sim_aid_lens[i] >= G_N_ELEMENTS (isim_aid_prefix) &&
+            memcmp (self->priv->sim_aids[i], isim_aid_prefix,
+                    G_N_ELEMENTS (isim_aid_prefix)) == 0) {
+            *out_len = self->priv->sim_aid_lens[i];
+            return self->priv->sim_aids[i];
+        }
+    }
+    *out_len = 0;
+    return NULL;
+}
+
+/*
+ * EF_DOMAIN (TS 31.103 4.2.3): a single TLV, tag 0x80, holding the home
+ * network domain name. Stock puts it in the hidden menu as tag 778.
+ */
+static void
+isim_domain_ready (MMSitClient  *self,
+                   GAsyncResult *res,
+                   gpointer      unused)
+{
+    g_autoptr(GBytes) data = NULL;
+    const guint8     *raw;
+    gsize             len = 0;
+
+    /* A card may have an ISIM and still refuse the file; that is not an
+     * error, it only means no domain to send. */
+    data = mm_sit_client_read_ef_finish (self, res, NULL, NULL);
+    if (!data)
+        return;
+    raw = g_bytes_get_data (data, &len);
+    if (len < 2 || raw[0] != 0x80 || raw[1] == 0 || (gsize) raw[1] + 2 > len)
+        return;
+    g_free (self->priv->isim_domain);
+    self->priv->isim_domain = g_strndup ((const gchar *) raw + 2, raw[1]);
+    mm_obj_dbg (self, "ISIM home domain '%s'", self->priv->isim_domain);
+}
+
+static void
+read_isim_domain (MMSitClient  *self,
+                  GCancellable *cancellable)
+{
+    const guint8 *aid;
+    gsize         aid_len = 0;
+
+    aid = isim_aid (self, &aid_len);
+    if (!aid)
+        return;
+    mm_sit_client_read_ef_for_aid (self, 0x6f03, aid, aid_len, cancellable,
+                                   (GAsyncReadyCallback) isim_domain_ready, NULL);
+}
+
+/* The home domain the ISIM names, or NULL. Owned by @self. */
+const gchar *
+mm_sit_client_get_isim_domain (MMSitClient *self)
+{
+    g_return_val_if_fail (MM_IS_SIT_CLIENT (self), NULL);
+    return self->priv->isim_domain;
+}
+
+gboolean
+mm_sit_client_sim_has_isim (MMSitClient *self)
+{
+    gsize len = 0;
+
+    g_return_val_if_fail (MM_IS_SIT_CLIENT (self), FALSE);
+
+    return isim_aid (self, &len) != NULL;
+}
+
 gboolean
 mm_sit_client_get_carrier_sim_info (MMSitClient         *self,
                                     MMSitCarrierSimInfo *out_info)
@@ -1198,6 +1289,14 @@
      * stock reads none at all.
      */
     guint        max_data_passes;
+    /*
+     * The application the file lives under. Empty means the subscription
+     * application, which is every file but the ISIM's: EF_DOMAIN and its
+     * neighbours exist only under ADF_ISIM, and a read of them against the
+     * USIM is refused.
+     */
+    guint8       aid[MM_SIT_MAX_AID_LENGTH];
+    gsize        aid_len;
 } ReadEfContext;
 
 static void
@@ -1353,7 +1452,8 @@
 
     ctx->passes++;
     request = mm_sit_request_new_sim_io (mm_sit_client_next_token (self), &sim_io,
-                                         self->priv->sim_aid, self->priv->sim_aid_len,
+                                         ctx->aid_len ? ctx->aid : self->priv->sim_aid,
+                                         ctx->aid_len ? ctx->aid_len : self->priv->sim_aid_len,
                                          &error);
     if (!request) {
         g_task_return_error (task, g_steal_pointer (&error));
@@ -1395,6 +1495,35 @@
     read_ef_step (task);
 }
 
+/*
+ * The same read against a named application.
+ *
+ * Only the ISIM needs it, and only because its files are not reachable from
+ * the subscription application: a card with an ISIM answers EF_DOMAIN under
+ * ADF_ISIM and refuses it everywhere else.
+ */
+void
+mm_sit_client_read_ef_for_aid (MMSitClient        *self,
+                               guint16             file_id,
+                               const guint8       *aid,
+                               gsize               aid_len,
+                               GCancellable       *cancellable,
+                               GAsyncReadyCallback callback,
+                               gpointer            user_data)
+{
+    GTask         *task;
+    ReadEfContext *ctx;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    ctx = g_slice_new0 (ReadEfContext);
+    ctx->file_id = file_id;
+    ctx->aid_len = MIN (aid_len, MM_SIT_MAX_AID_LENGTH);
+    memcpy (ctx->aid, aid, ctx->aid_len);
+    ctx->data = g_byte_array_new ();
+    g_task_set_task_data (task, ctx, (GDestroyNotify) read_ef_context_free);
+    read_ef_step (task);
+}
+
 void
 mm_sit_client_read_ef (MMSitClient        *self,
                        guint16             file_id,
@@ -2848,6 +2977,7 @@
             mm_sit_client_next_token (self), self->priv->cp ? 2 : 1);
         break;
     case BOOT_CONFIG_STEP_BOOT_EFS:
+        read_isim_domain (self, g_task_get_cancellable (task));
         /* See mm_sit_client_read_boot_efs(). Cannot fail the boot. */
         mm_sit_client_read_boot_efs (self, g_task_get_cancellable (task),
                                      (GAsyncReadyCallback) boot_config_efs_ready,
diff -ruN mm67/src/plugins/samsung-sit/mm-sit-client.h v72/src/plugins/samsung-sit/mm-sit-client.h
--- a/src/plugins/samsung-sit/mm-sit-client.h	2026-11-06 22:23:25.984923100 -0500
+++ b/src/plugins/samsung-sit/mm-sit-client.h	2026-11-06 22:31:21.181010196 -0500
@@ -77,6 +77,22 @@
                                             const gchar **out_os_version,
                                             const gchar **out_software_version);
 
+/* Read one elementary file under a named application rather than the
+ * subscription one; the ISIM's files are reachable no other way. */
+void mm_sit_client_read_ef_for_aid (MMSitClient        *self,
+                                    guint16             file_id,
+                                    const guint8       *aid,
+                                    gsize               aid_len,
+                                    GCancellable       *cancellable,
+                                    GAsyncReadyCallback callback,
+                                    gpointer            user_data);
+
+/* Whether the card carries an ISIM application (AID A000000087 1004). */
+gboolean mm_sit_client_sim_has_isim (MMSitClient *self);
+
+/* The home domain EF_DOMAIN names, or NULL. Owned by the client. */
+const gchar *mm_sit_client_get_isim_domain (MMSitClient *self);
+
 gboolean mm_sit_client_get_carrier_sim_info (MMSitClient         *self,
                                              MMSitCarrierSimInfo *out_info);
 void     mm_sit_client_query_carrier_sim_info        (MMSitClient         *self,
diff -ruN mm67/src/plugins/samsung-sit/mm-sit-ims.c v72/src/plugins/samsung-sit/mm-sit-ims.c
--- a/src/plugins/samsung-sit/mm-sit-ims.c	2026-11-06 22:23:25.988390227 -0500
+++ b/src/plugins/samsung-sit/mm-sit-ims.c	2026-11-06 22:31:52.068481058 -0500
@@ -985,6 +985,8 @@
             .spn = self->priv->sim_spn,
             .gid1 = self->priv->sim_gid1,
             .gid2 = self->priv->sim_gid2,
+            .has_isim = mm_sit_client_sim_has_isim (self->priv->client),
+            .isim_domain = mm_sit_client_get_isim_domain (self->priv->client),
         };
 
         ctx->config = mm_sit_ims_config_resolve (self->priv->ims_database,
diff -ruN mm67/src/plugins/samsung-sit/mm-sit-ims-config.c v72/src/plugins/samsung-sit/mm-sit-ims-config.c
--- a/src/plugins/samsung-sit/mm-sit-ims-config.c	2026-11-06 22:23:25.989099712 -0500
+++ b/src/plugins/samsung-sit/mm-sit-ims-config.c	2026-11-06 22:31:52.068399517 -0500
@@ -42,6 +42,8 @@
         out.gid1   = identity->gid1;
         out.gid2   = identity->gid2;
         out.iccid  = identity->iccid;
+        out.has_isim = identity->has_isim ? 1 : 0;
+        out.isim_domain = identity->isim_domain;
     }
     return out;
 }
