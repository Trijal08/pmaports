+// SPDX-License-Identifier: GPL-2.0-or-later
+//! Prints what resolve() produces, in the same form as the C oracle, so the
+//! two can be diffed entry for entry.
+use samsung_ims_config::{apns, resolve, CarrierIdentity, DeviceIdentity, Value};
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let arg = |n: usize| a.get(n).cloned().unwrap_or_default();
+    let db = &a[1];
+    let id = CarrierIdentity {
+        mccmnc: arg(2),
+        imsi: arg(3),
+        gid1: arg(4),
+        spn: arg(5),
+        ..Default::default()
+    };
+    let dev = DeviceIdentity {
+        manufacturer: "Google".into(),
+        model: "Pixel 9 Pro XL".into(),
+        os_name: "Nura".into(),
+        os_version: "1.0".into(),
+        software_version: "nura-edge".into(),
+    };
+    let c = match resolve(db, &dev, &id) {
+        Ok(c) => c,
+        Err(e) => {
+            println!("error {e}");
+            std::process::exit(1);
+        }
+    };
+    println!("carrier {}", c.carrier);
+    println!("ua {}", c.user_agent);
+    println!("entries {}", c.entries.len());
+    for (t, v) in &c.entries {
+        match v {
+            Value::Int(i) => println!("tag {t} int {i}"),
+            Value::Str(s) => println!("tag {t} str {s}"),
+            Value::Byte(b) => println!("tag {t} int {b}"),
+            Value::Bytes(b) => println!(
+                "tag {t} bytes {}",
+                b.iter().map(|x| format!("{x:02x}")).collect::<String>()
+            ),
+        }
+    }
+    let list = apns(db, &id).unwrap_or_default();
+    println!("apns {}", list.len());
+    for p in &list {
+        println!(
+            "apn {}|{}|{}|{}|{}|{}",
+            p.name, p.apn, p.types, p.bearers, p.protocol, p.roaming
+        );
+    }
+}
