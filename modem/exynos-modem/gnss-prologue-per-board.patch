+/// A pseudo-terminal whose slave is linked at a stable path, so a consumer that
+/// needs a device rather than a socket can be pointed straight at it. gpsd
+/// takes a serial device or a tcp://, udp:// or gpsd:// URL and has no unix
+/// socket source at all, so without this it needs a socat bridge in between.
+struct PtyGuard {
+    path: PathBuf,
+}
+
+impl Drop for PtyGuard {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+fn open_pty(path: &Path, group: Option<&str>) -> io::Result<(File, PtyGuard)> {
+    let fd = unsafe { libc::posix_openpt(libc::O_RDWR | libc::O_NOCTTY) };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let master = unsafe { OwnedFd::from_raw_fd(fd) };
+    if unsafe { libc::grantpt(master.as_raw_fd()) } < 0
+        || unsafe { libc::unlockpt(master.as_raw_fd()) } < 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    let name = unsafe { libc::ptsname(master.as_raw_fd()) };
+    if name.is_null() {
+        return Err(io::Error::last_os_error());
+    }
+    let slave = unsafe { CStr::from_ptr(name) }.to_string_lossy().into_owned();
+
+    // A consumer that stops reading must not be able to stall the daemon.
+    if unsafe { libc::fcntl(master.as_raw_fd(), libc::F_SETFL, libc::O_NONBLOCK) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if let Some(name) = group {
+        let gid = group_gid(name)?;
+        chown_group(Path::new(&slave), gid)?;
+    }
+    std::fs::set_permissions(&slave, std::fs::Permissions::from_mode(0o660))?;
+
+    let _ = std::fs::remove_file(path);
+    std::os::unix::fs::symlink(&slave, path)?;
+    eprintln!(
+        "kepler-gnssd: NMEA device {} -> {slave}",
+        path.display()
+    );
+    Ok((File::from(master), PtyGuard { path: path.to_path_buf() }))
+}
