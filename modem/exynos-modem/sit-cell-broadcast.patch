+/// One inclusive range of cell broadcast message identifiers, and whether the
+/// CP should accept it. 4352-4356 are ETWS, 4370 onwards CMAS.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct SamsungSitBroadcastRange {
+    pub from_service_id: u16,
+    pub to_service_id: u16,
+    pub from_code_scheme: u8,
+    pub to_code_scheme: u8,
+    /// Non-zero to accept this range.
+    pub selected: u8,
+}
+
+impl From<BroadcastRange> for SamsungSitBroadcastRange {
+    fn from(r: BroadcastRange) -> Self {
+        Self {
+            from_service_id: r.from_service_id,
+            to_service_id: r.to_service_id,
+            from_code_scheme: r.from_code_scheme,
+            to_code_scheme: r.to_code_scheme,
+            selected: r.selected as u8,
+        }
+    }
+}
+
+impl From<SamsungSitBroadcastRange> for BroadcastRange {
+    fn from(r: SamsungSitBroadcastRange) -> Self {
+        Self {
+            from_service_id: r.from_service_id,
+            to_service_id: r.to_service_id,
+            from_code_scheme: r.from_code_scheme,
+            to_code_scheme: r.to_code_scheme,
+            selected: r.selected != 0,
+        }
+    }
