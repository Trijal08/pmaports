# Maintainer: Steffen Deusch <steffen@deusch.me>
pkgname="exynos-modem"
pkgver=0.1.0_git20260731
pkgrel=3
pkgdesc="Userspace daemon for the Exynos S5300/S5400 modem vendor channels"
url="https://git.deusch.me/pixel-mainline/exynos-modem"
arch="aarch64"
license="GPL-2.0-or-later"
makedepends="cargo cargo-auditable"
depends="
	android-tools
	e2fsprogs
	jq
	tar
	util-linux
"
subpackages="
	libsamsung-sit-ffi:libsamsung_sit_ffi
	$pkgname-lpa:lpa
	$pkgname-polkit:polkit
"
options="net"

_commit="eba1e23aea1be111aa30796cc84dc4678bae2b46"
source="
	$pkgname-$_commit.tar.gz::https://git.deusch.me/api/v1/repos/pixel-mainline/exynos-modem/archive/$_commit.tar.gz
	gipc-serve-uecap-fetch.patch
	gipc-uecap-type2-and-wrapper.patch
	gipc-serve-requested-block.patch
	gipc-pace-bulk-serve.patch
	caimito-modem-setup.sh
	pixel-modem-stage.service
	exynos-modem.service
	sit-proxy.service
	99-google-komodo-modem.rules
"
builddir="$srcdir/$pkgname"

prepare() {
	default_prepare

	# Remove workspace config pinning the static-musl target so cargo uses CTARGET
	rm -f .cargo/config.toml
	RUSTC_WRAPPER= cargo fetch --target="$CTARGET" --locked
}

build() {
	# Compile the full workspace so both daemons and the static library are produced
	# sit-proxy/polkit adds the authorization transport sit-lpa asks for when
	# /run/sit-proxy/0.auth exists; without it the bridge falls back to raw
	# filesystem-controlled sockets.
	RUSTC_WRAPPER= cargo auditable build --release --frozen --features sit-proxy/polkit
}

package() {
	# Main package: install the userspace daemons
	install -Dm755 target/release/exynos-modem \
		-t "$pkgdir/usr/sbin"
	install -Dm755 target/release/sit-proxy \
		-t "$pkgdir/usr/sbin"

	# Install staging helper script
	install -Dm755 "$srcdir"/caimito-modem-setup.sh \
		"$pkgdir/usr/libexec/caimito-modem-setup"

	# Install systemd service units
	install -Dm644 "$srcdir"/pixel-modem-stage.service \
		"$pkgdir/usr/lib/systemd/system/pixel-modem-stage.service"
	install -Dm644 "$srcdir"/exynos-modem.service \
		"$pkgdir/usr/lib/systemd/system/exynos-modem.service"
	install -Dm644 "$srcdir"/sit-proxy.service \
		"$pkgdir/usr/lib/systemd/system/sit-proxy.service"

	# Points ModemManager's samsung-sit plugin at the carrier config and routes
	# it through sit-proxy; see the file for why it must match every SIT port.
	install -Dm644 "$srcdir"/99-google-komodo-modem.rules \
		"$pkgdir/usr/lib/udev/rules.d/99-google-komodo-modem.rules"

	# Enable service by default in systemd multi-user target
	install -dm755 "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s "../exynos-modem.service" \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/exynos-modem.service"
	ln -s "../sit-proxy.service" \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/sit-proxy.service"
}

polkit() {
	pkgdesc="Polkit authorization policy for the Exynos SIT proxy"
	depends="$pkgname=$pkgver-r$pkgrel polkit"

	install -Dm644 "$builddir"/crates/sit-proxy/org.exynosmodem.sit-proxy.policy \
		-t "$subpkgdir/usr/share/polkit-1/actions"
	install -Dm644 "$builddir"/crates/sit-proxy/polkit.conf \
		"$subpkgdir/usr/lib/systemd/system/sit-proxy.service.d/50-polkit.conf"
}

lpa() {
	pkgdesc="lpac APDU bridge for eSIM management over Exynos SIT"
	# Stock lpac 2.3.0-r0 returns failure from its stdio callbacks even on
	# success and dies in euicc_init before a single SIT request goes out.
	depends="$pkgname=$pkgver-r$pkgrel lpac>=2.3.0-r1"
	provides="sit-lpa-session=1"

	install -Dm755 "$builddir"/target/release/sit-lpa \
		-t "$subpkgdir/usr/bin"
	install -Dm755 "$builddir"/crates/sit-lpa/lpa-gtk-sit \
		-t "$subpkgdir/usr/bin"

	# Compatibility path for unpatched clients: a private PATH entry whose
	# "lpac" is the bridge itself. The patched lpa-gtk calls sit-lpa directly.
	install -dm755 "$subpkgdir/usr/libexec/sit-lpa"
	ln -s /usr/bin/sit-lpa "$subpkgdir/usr/libexec/sit-lpa/lpac"
}

libsamsung_sit_ffi() {
	pkgdesc="C ABI for the samsung-sit SIT (Exynos RIL) wire codec"

	local _lib
	_lib=$(find "$builddir"/target -name 'libsamsung_sit_ffi.a' -path '*/release/*' -not -path '*/deps/*' -print -quit)
	[ -n "$_lib" ] || return 1

	install -Dm644 "$_lib" "$subpkgdir/usr/lib/libsamsung_sit_ffi.a"
	install -Dm644 "$builddir"/crates/samsung-sit-ffi/include/samsung_sit_ffi.h \
		"$subpkgdir/usr/include/samsung_sit_ffi.h"

	install -dm755 "$subpkgdir/usr/lib/pkgconfig"
	sed -e "s|@prefix@|/usr|" \
		-e "s|@version@|${pkgver%%_*}|" \
		"$builddir"/crates/samsung-sit-ffi/samsung-sit-ffi.pc.in \
		> "$subpkgdir/usr/lib/pkgconfig/samsung-sit-ffi.pc"
}
