modem() {
	pkgdesc="Google Pixel 9 Pro S5400 Modem and GNSS firmware"

	# Modem Main Firmware Blobs
	#
	# radio/modem.img is a git-lfs pointer and TheMuppets host their objects
	# themselves (.lfsconfig), so the tarball carries 134 bytes of text rather
	# than the image. Resolve the oid out of the pointer and fetch the object
	# directly -- keeping it keyed on the commit's own pointer instead of a
	# hardcoded oid, so a repin needs no edit here.
	#
	# The oid *is* the sha256 of the content, so verifying against it is a
	# stronger check than a sha512sums entry would be.
	local _ptr="$builddir"/radio/modem.img
	local _oid="$(sed -n 's/^oid sha256://p' "$_ptr")"
	# Anchored: .lfsconfig also carries a pushurl, and matching both yields a
	# two-line value that resolves to Endpoint=<unknown>.
	local _lfs="$(sed -n 's/^[[:space:]]*url[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' \
		"$builddir"/.lfsconfig)"
	[ -n "$_oid" ] || die "radio/modem.img is not an LFS pointer"
	[ -n "$_lfs" ] || die "no lfs url in .lfsconfig"

	curl -fsSL -o "$srcdir"/modem.img "$_lfs/objects/$_oid"
	echo "$_oid  $srcdir/modem.img" | sha256sum -c - >/dev/null \
		|| die "modem.img does not match its LFS oid"

	install -d "$subpkgdir/usr/lib/firmware/google/s5400/modem/"
	debugfs -R "rdump images $subpkgdir/usr/lib/firmware/google/s5400/modem" "$srcdir"/modem.img
	# debugfs exits 0 even when it cannot open the image, so the result has to
	# be checked or the package silently ships an empty modem/ directory.
	# -s also proves the images/default symlink (carried in from the image)
	# resolved.
	[ -s "$subpkgdir/usr/lib/firmware/google/s5400/modem/images/default/modem.bin" ] \
		|| die "modem.bin was not extracted from modem.img"
	chown -R root:root "$subpkgdir/usr/lib/firmware/google/s5400/modem/images"

	# Modem Partition Mounting Script
	install -Dm755 "$srcdir"/initramfs_setup_modemfw.sh \
		-t "$subpkgdir/usr/share/mkinitfs/hooks-cleanup/"

	# Carrier config
	install -d "$subpkgdir/usr/lib/firmware/google/s5400/carrierconfig/"
	rsync -a --chmod=D755,F644 "$builddir"/proprietary/vendor/firmware/carrierconfig/ "$subpkgdir/usr/lib/firmware/google/s5400/carrierconfig/"

	# IMS configuration, converted from the factory image's own CarrierSettings
	# protobufs. The samsung-sit plugin looks for ims.db beside cfg.db and treats
	# a missing one as fatal -- without it there is no IMS, and on a network with
	# no CS domain that means no VoLTE, no incoming calls and no reliable SMS.
	#
	# Built here rather than shipped: the inputs are Google's proprietary carrier
	# data, already downloaded for this package, and the output is derived from
	# them. aosp-carrier-defaults.txt is the framework layer no protobuf carries
	# (Apache-2.0, extracted from CarrierConfigManager.java).
	carrier-settings-tool build-db \
		"$builddir"/proprietary/product/etc/CarrierSettings \
		"$srcdir"/aosp-carrier-defaults.txt \
		"$subpkgdir/usr/lib/firmware/google/s5400/carrierconfig/ims.db"
	chmod 644 "$subpkgdir/usr/lib/firmware/google/s5400/carrierconfig/ims.db"

	# UE Cap config
	install -d "$subpkgdir/usr/lib/firmware/google/s5400/uecapconfig/"
	rsync -a --chmod=D755,F644 "$builddir"/proprietary/vendor/firmware/uecapconfig/ "$subpkgdir/usr/lib/firmware/google/s5400/uecapconfig/"

	# IMS configuration the vendor IMS service carries in its own assets
	#
	# ims.db covers what AOSP CarrierConfig knows, and that is about a third of
	# what the CP is told on Android. The rest is inside ShannonIms.apk: XML
	# keyed by MCC, then MNC, then MVNO, with the vendor's own key names
	# (SUPPORT_EMERG_REG_TIMER, EMERGENCY_CALL_AFTER_IMS_REG, UT_OVER_LTE and
	# the like) that never pass through CarrierConfig at all. Measured on this
	# device: the stock hidden-menu push is ~2 KB across four groups against
	# our 615 bytes, and the CP then registers SIP in 1.5 s where we take 13 s.
	#
	# Only the assets are taken, not the app: it is 3.9 MB of dex we have no
	# use for, and these are 744 KB of plain XML. Names are flattened on the
	# way out -- sim_configuration_302.xml becomes sim/302.xml -- because the
	# directory already says what they are.
	local _ims="$subpkgdir/usr/lib/firmware/google/s5400/imsconfig"
	local _apk="$builddir"/proprietary/system_ext/priv-app/ShannonIms/ShannonIms.apk
	[ -f "$_apk" ] || die "ShannonIms.apk is missing from the vendor import"
	rm -rf "$srcdir"/imsassets
	unzip -q -o "$_apk" 'assets/*' -d "$srcdir"/imsassets
	local _a="$srcdir"/imsassets/assets
	[ -d "$_a"/sim_configurations ] || die "no sim_configurations in ShannonIms.apk"

	install -d "$_ims"/sim "$_ims"/rcs
	local _f _mcc
	for _f in "$_a"/sim_configurations/sim_configuration_*.xml; do
		_mcc=${_f##*/sim_configuration_}
		install -Dm644 "$_f" "$_ims/sim/${_mcc}"
	done
	# Global layers, under the per-MCC ones.
	install -Dm644 "$_a"/common_configuration.xml "$_ims"/common.xml
	install -Dm644 "$_a"/operator_config.xml      "$_ims"/operator.xml
	install -Dm644 "$_a"/ut_default_setting.xml   "$_ims"/ut-default.xml
	install -Dm644 "$_a"/emergency_type.xml       "$_ims"/emergency-type.xml
	install -Dm644 "$_a"/sim_operator_list.xml    "$_ims"/operator-list.xml
	for _f in "$_a"/rcs_*.xml; do
		_mcc=${_f##*/rcs_}
		install -Dm644 "$_f" "$_ims/rcs/${_mcc}"
	done
	[ -s "$_ims/sim/302.xml" ] || die "the per-MCC IMS configuration did not land"

	# The one device override, taken from its own source rather than restated.
	#
	# ShannonImsOverlayProductZumapro is a static RRO against
	# com.shannon.imsservice whose whole content is a single boolean, and it
	# lives in the SoC tree because it is true of every zumapro board rather
	# than of caimito. VDSDA is dual SIM dual *active*: the IMS service is
	# told this device is not dual-standby, which is worth having here because
	# everything difficult about this modem has been the second stack.
	#
	# Converted to key=value so nothing has to read Android resource XML to
	# use it, with the source named so the value can always be checked.
	local _soc="$srcdir/$_soc_repo-$_soc_commit"
	local _bools="$_soc"/overlay/ShannonImsOverlayProductZumapro/res/values/bools.xml
	[ -f "$_bools" ] || die "the ShannonIms overlay is missing from the SoC tree"
	{
		echo "# Device overrides for the vendor IMS configuration above."
		echo "# Source: $_soc_repo overlay/ShannonImsOverlayProductZumapro"
		echo "# (Apache-2.0), targetPackage com.shannon.imsservice, static."
		sed -n 's/.*<bool name="\([^"]*\)">\([^<]*\)<\/bool>.*/\1=\2/p' "$_bools"
	} > "$_ims"/device.conf
	grep -q '^enable_vdsda=' "$_ims"/device.conf || die "no bools came out of the overlay"
	chmod 644 "$_ims"/device.conf

	# Emergency-call routing policy, from the LineageOS device tree.
	#
	# TeleServiceOverlayVendorCaimito is Apache-2.0 and names the countries
	# where emergency calls are dynamically routed, as ISO3166 codes. It is
	# kept beside the vendor IMS configuration because it belongs to the same
	# decision and because, unlike that configuration, it is readable and
	# editable source rather than a blob.
	local _lin="$srcdir/$_lineage_repo-$_lineage_commit"
	install -Dm644 "$_lin"/overlay/TeleServiceOverlayVendorCaimito/res/values/config.xml \
		"$_ims"/emergency-routing.xml

	# GNSS Main Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/kepler.bin \
		"$subpkgdir/usr/lib/firmware/google/s5400/kepler.bin"
}

aoc() {
	pkgdesc="Google Pixel 9 Pro AoC (Always-on-Compute) firmware"

	# Main Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/aoc.bin \
		"$subpkgdir/usr/lib/firmware/google/zumapro/aoc.bin"

	# AoC Sensor USF Registry
	install -d "$subpkgdir/usr/lib/firmware/google/usf/caiman/"
	rsync -a --chmod=D755,F644 "$builddir"/proprietary/vendor/etc/sensors/registry/ "$subpkgdir/usr/lib/firmware/google/usf/caiman/"
}

audio() {
	pkgdesc="Google Pixel 9 Pro Audio CS35L41 DSP/Protection firmware"

	# Speaker Protection Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/cs35l41-dsp1-spk-prot.wmfw \
		"$subpkgdir/usr/lib/firmware/cirrus/cs35l41-dsp1-spk-prot-caiman.wmfw"

	# Left Speaker Tuning Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/cs35l41-dsp1-spk-prot.bin \
		"$subpkgdir/usr/lib/firmware/cirrus/cs35l41-dsp1-spk-prot-caiman.bin"

	# Right Speaker Tuning Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/R-cs35l41-dsp1-spk-prot.bin \
		"$subpkgdir/usr/lib/firmware/cirrus/cs35l41-dsp1-spk-prot-caiman-r.bin"
}

haptics() {
	pkgdesc="Google Pixel 9 Pro Haptics CS40L26 DSP/Protection firmware"

	# Haptics Protection Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/cs40l26.wmfw \
		"$subpkgdir/usr/lib/firmware/cs40l26.wmfw"

	# Haptics Tuning Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/cs40l26.bin \
		"$subpkgdir/usr/lib/firmware/cs40l26.bin"
}

mfc() {
	pkgdesc="Google Pixel 9 Pro MFC (Multi-format Codec) firmware"

	# Main Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/mfc_fw.bin \
		"$subpkgdir/usr/lib/firmware/google/zumapro/mfc_fw.bin"
}
