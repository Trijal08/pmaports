+/// `MEDIA_STATE_IND` (0x0d30) -- tell the CP what a call's media is doing.
+///
+/// An indication, not a request: the CP sends no response, and it dispatches
+/// on the header's type byte, so this cannot be sent through the ordinary
+/// request path.  `state` takes the values observed on Android: 2 just after
+/// the dial, 4 while alerting, 0 as the call becomes active, 6 at hangup.
+/// Any other value is rejected rather than guessed at.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_aims_build_media_state_ind(
+    state: u8,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    use aims::media::MediaState;
+
+    let state = match state {
+        0 => MediaState::Connected,
+        2 => MediaState::Setup,
+        4 => MediaState::Alerting,
+        6 => MediaState::Ended,
+        _ => return emit_result(Err(SitError::Malformed("media state")), out, out_len),
+    };
+    emit_result(Ok(aims::media::build_media_state_ind(state)), out, out_len)
+}
+
+/// `SET_FRAME_TIME` (0x0d0b) -- sent straight after the dial, before the call
+/// connects.  The payload is replayed from a capture; see the crate docs.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_aims_build_set_frame_time(
+    token: u16,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    emit_result(Ok(aims::media::build_set_frame_time(token)), out, out_len)
+}
+
+/// `SET_RTP_THRESHOLD` (0x0d72) -- sent as the call becomes active.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_aims_build_set_rtp_threshold(
+    token: u16,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    emit_result(Ok(aims::media::build_set_rtp_threshold(token)), out, out_len)
+}
+
