+/// The session-open records, with `POS_REQ` set to `tbf_ms`.
+///
+/// Returned as records rather than an encoded datagram so a caller can keep
+/// the set it actually used -- see `kepler-gnssd`'s session cache, which
+/// persists the batch that produced a fix and replays that instead of this
+/// table on later runs.
+pub fn session_open_records(tbf_ms: u32) -> Vec<(u16, u16, Vec<u8>)> {
+    let pos = pos_req_bytes(tbf_ms);
+    SESSION_OPEN
+        .iter()
+        .map(|&(midsid, data)| {
+            let d = if midsid == MIDSID_POS_REQ {
+                pos.to_vec()
+            } else {
+                data.to_vec()
+            };
+            (midsid, 2u16, d)
+        })
+        .collect()
+}
