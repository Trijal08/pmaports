+/// `GET_FACILITY_LOCK` (0x0209) naming the application it asks about.
+///
+/// The 59-byte payload is `[0] = facility`, then at payload+41 a `07`, the AID
+/// length, and the AID itself (`body[45..]`). Stock never omits it: measured on
+/// baseband g5400c-260604-260807-B-16035863 it asks twice per application, for
+/// facility 0x10 and 0x03, with the USIM AID `a0000000871002...` and -- where
+/// the SIM has one -- the ISIM AID `a0000000871004...`. We were sending
+/// facility 0x03 with the AID left as zeros.
+pub fn build_get_facility_lock_aid(token: u16, facility: u8, aid: &[u8]) -> Vec<u8> {
     let mut body = vec![0u8; 63];
     body[4] = facility;
+    if !aid.is_empty() {
+        let n = aid.len().min(16);
+        body[45] = 0x07;
+        body[46] = n as u8;
+        body[47..47 + n].copy_from_slice(&aid[..n]);
+    }
     crate::frame_header(msg_id::GET_FACILITY_LOCK, token, &body)
 }
 
