+/// What `CONF_CALL_ADD_REMOVE_USER` (0x0d12) does to the named participants,
+/// from `RilReqConfCallAddRemoveUser$OperationType` in `ShannonIms.apk`.
+///
+/// The enum has a third value, `NULL_OPERATION` (0xf), which nothing in the
+/// APK ever sets -- so it is not modelled here.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ConfCallOp {
+    /// Invite a participant into an established conference.
+    Add = 0,
+    /// Drop a participant, leaving the conference up for everybody else.
+    Remove = 1,
+}
+
+/// One participant of a `CONF_CALL_ADD_REMOVE_USER`: a call id *and* the
+/// number. The CP is given both; `RilReqConfCallAddRemoveUser$Participant`
+/// has no way to name one without the other.
+#[derive(Debug, Clone, Copy)]
+pub struct ConfParticipant<'a> {
+    pub call_id: u8,
+    pub number: &'a str,
+}
+
+/// `CONF_CALL_ADD_REMOVE_USER` (0x0d12) -- add or drop conference members
+/// without disturbing the rest of the call.
+///
+/// Layout from `RilReqConfCallAddRemoveUser.getBytes()`: the operation and the
+/// *conference's* call id one byte each, then a `u16` count, then one record
+/// per participant of `u32 number_len`, `u8 call_id` and the number in the
+/// same fixed 513-byte field a dial uses.
+///
+/// This is how a member is hung up one at a time. A plain [`build_hangup`]
+/// aimed at a swallowed leg is silently dropped by the CP -- the leg is no
+/// longer a call it will take orders about -- and one aimed at the conference
+/// ends the whole thing. The captured dialler dropped a single member of a
+/// two-party conference with exactly one of these, and the CP answered
+/// `status 0` and then republished the conference with its party count down
+/// by one.
+pub fn build_conf_call_add_remove_user(
+    token: u16,
+    op: ConfCallOp,
+    conf_call_id: u8,
+    participants: &[ConfParticipant<'_>],
+) -> Result<Vec<u8>, SitError> {
+    if participants.is_empty() {
+        return Err(SitError::Malformed("conference change with no participant"));
+    }
+    if participants.len() > u16::MAX as usize {
+        return Err(SitError::ArgTooLong("conference participant list"));
+    }
+    let mut p = Vec::with_capacity(4 + participants.len() * (5 + NUM_FIELD));
+    p.push(op as u8);
+    p.push(conf_call_id);
+    p.extend_from_slice(&(participants.len() as u16).to_le_bytes());
+    for member in participants {
+        if member.number.is_empty() {
+            return Err(SitError::Malformed("conference participant with no number"));
+        }
+        if member.number.len() > NUM_FIELD {
+            return Err(SitError::ArgTooLong("conference participant number"));
+        }
+        p.extend_from_slice(&(member.number.len() as u32).to_le_bytes());
+        p.push(member.call_id);
+        let mut num = [0u8; NUM_FIELD];
+        num[..member.number.len()].copy_from_slice(member.number.as_bytes());
+        p.extend_from_slice(&num);
+    }
+    Ok(frame(msg_id::CONF_CALL_ADD_REMOVE_USER, token, &p))
+}
+
