+/// `CONF_CALL_ADD_REMOVE_USER` (0x0d12) -- add or drop one conference member
+/// while leaving the conference up for everybody else.
+///
+/// `op` is 0 add, 1 remove. `conf_call_id` is the *conference's* call id, and
+/// the member is named by both its own call id and its number, because the
+/// vendor layout carries both.
+///
+/// This is how a member is hung up one at a time. `samsung_aims_build_hangup`
+/// aimed at a swallowed leg is dropped by the CP without an answer, and aimed
+/// at the conference it ends the whole call.
+///
+/// Only one participant per frame: that is all the captured dialler ever sent,
+/// and the count field is written accordingly.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_aims_build_conf_call_add_remove_user(
+    token: u16,
+    op: u8,
+    conf_call_id: u8,
+    member_call_id: u8,
+    member_number: *const c_char,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    let op = match op {
+        0 => aims::ConfCallOp::Add,
+        1 => aims::ConfCallOp::Remove,
+        _ => return SamsungSitStatus::ArgOutOfRange,
+    };
+    let number = match crate::cstr(member_number) {
+        Ok(n) => n,
+        Err(s) => return s,
+    };
+    emit_result(
+        aims::build_conf_call_add_remove_user(
+            token,
+            op,
+            conf_call_id,
+            &[aims::ConfParticipant {
+                call_id: member_call_id,
+                number,
+            }],
+        ),
+        out,
+        out_len,
+    )
+}
+
