+/// Which of the vendor's three `HIDDEN_MENU` pushes an entry belongs to.
+///
+/// Stock does not send its configuration as one message. Every stack in the
+/// five 2026-11-06 captures gets three, and the split is the same each time:
+///
+/// ```text
+///   1492B   the device identity and SIP timers, then the whole carrier
+///           block, then the video capability descriptor (tag 771)
+///     14B   the identity extras: 777, 782, 783, and 778 for a card with
+///           an ISIM -- 51B when that one is present
+///    448B   the carrier block on its own, the same 63 records again
+/// ```
+///
+/// Reproducing that matters for more than tidiness. The CP does not emit its
+/// registration indication while the link is idle, and the AP's next write is
+/// what frees it -- so stock's three writes, arriving a second or two apart,
+/// are why its grant-to-registration is 0.7-2.5 s where our single write left
+/// the link silent for 12 s. See the note on the grant-to-registration gap.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Group {
+    /// Everything: identity, timers and the carrier block.
+    Full,
+    /// The identity extras alone.
+    Identity,
+    /// The carrier block alone.
+    Carrier,
+}
+
+/// The tags stock puts in its identity-extras push.
+const IDENTITY_EXTRAS: &[u16] =
+    &[tag::UA_IMS_CLIENT_VERSION, tag::IMS_HOME_DOMAIN, tag::UA_EXTRA_1, tag::UA_EXTRA_2];
+
+/// The tags stock keeps out of its carrier-only push: the device identity,
+/// the five SIP timers it hardcodes, and the geolocation flags.
+const IDENTITY_AND_TIMERS: &[u16] = &[
+    tag::USER_AGENT,
+    tag::SIP_TIMER_TA_MS, tag::SIP_TIMER_TE_MS, tag::SIP_TIMER_TG_MS,
+    tag::SIP_TIMER_TI_MS, tag::SIP_TIMER_TK_MS,
+    tag::UA_MANUFACTURER, tag::UA_MODEL, tag::UA_SOFTWARE_VERSION,
+    tag::UA_PRODUCT_LINE, tag::UA_OS_VERSION,
+    tag::GEOLOCATION_VOWIFI_EMERGENCY, tag::GEOLOCATION_VOLTE_EMERGENCY,
+];
+
+impl ImsConfig {
+    /// The entries belonging to one of the vendor's three pushes.
+    ///
+    /// `Full` is everything bar the identity extras, which stock carries in
+    /// its own message rather than in the big one.
+    pub fn group(&self, group: Group) -> Vec<(u16, Value)> {
+        self.entries
+            .iter()
+            .filter(|(t, _)| match group {
+                Group::Full => !IDENTITY_EXTRAS.contains(t),
+                Group::Identity => IDENTITY_EXTRAS.contains(t),
+                Group::Carrier => {
+                    !IDENTITY_EXTRAS.contains(t) && !IDENTITY_AND_TIMERS.contains(t)
+                }
+            })
+            .cloned()
+            .collect()
+    }
+}
+
