maintainer="Trijal Saha <trijalsaha2012@gmail.com>"
pkgname=device-google-tegu
pkgdesc="Google Pixel 9a"
pkgver=1
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools
	linux-postmarketos-zumapro
	firmware-google-tegu-brcm_a3
	firmware-google-tegu-modem
	firmware-google-tegu-aoc
	firmware-google-tegu-haptics
	firmware-google-tegu-mfc
	alsa-ucm-conf-zumapro
	linux-firmware-arm
	linux-firmware-cirrus
	soc-google
	soc-google-gbootctl
	neard
	postmarketos-base
"
makedepends="devicepkg-dev"
subpackages="$pkgname-haptics"
source="
	deviceinfo
	kernel-cmdline.conf
	feedbackd-cirrus.rules
	feedbackd-theme.json
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Identify the haptic driver to feedbackd and hand the seat's user access
	# to it. Unconditional because it names the hardware and sets its
	# permissions, which anything driving force feedback needs, not only the
	# shell; the tuning that depends on a shell is in the subpackage below.
	install -Dm644 "$srcdir"/feedbackd-cirrus.rules \
		"$pkgdir"/usr/lib/udev/rules.d/72-feedbackd-cirrus.rules
}

# How hard the LRA is driven for UI feedback. feedbackd's stock theme asks for
# a fifth of full scale for seven milliseconds, which on this actuator is a
# blunt thud; these are the values the hardware was tuned to in use -- a short,
# light tick. The override goes in the "quiet" profile because that is where
# the stock theme puts its vibra feedbacks and the "full" profile inherits
# them -- overriding "full" instead changes nothing.
#
# Named after the first device tree compatible, which is how feedbackd looks a
# device theme up. That name carries a comma and abuild forbids one in a source
# file name, so the file is carried under a plain name and renamed on the way in.
haptics() {
	install_if="$pkgname=$pkgver-r$pkgrel feedbackd"
	pkgdesc="$pkgdesc (haptic feedback tuning)"

	install -Dm644 "$srcdir"/feedbackd-theme.json \
		"$subpkgdir"/usr/share/feedbackd/themes/google,tegu.json
}

