+/// The 4 bytes of a body that land in the frame's reserved field, ahead of the
+/// payload proper.
+const RESERVED_SIZE: usize = 4;
+
+/// Pad the payload out to a multiple of 8, leaving `length` alone.
+///
+/// The vendor RIL does this to everything it sends. In a capture from this
+/// baseband, all 1611 AP->CP frames -- 861 requests, 326 indications and the
+/// rest of the channel traffic -- have a payload (everything past the 12-byte
+/// header) whose length is a multiple of 8, with no exceptions, while the
+/// header's `length` still declares the true size.
+///
+/// The CP reads `length` bytes, so the padding is invisible to it either way;
+/// the point is to stop being the only thing on the bus that does it
+/// differently. This has to live here rather than in the FFI's
+/// `samsung_sit_build_request`, because that is one entry point out of sixty:
+/// every typed builder assembles its frame through `frame_header`, so padding
+/// anywhere else leaves most of what we send unpadded. Header-only frames
+/// carry no payload and are left alone.
+fn pad_payload(frame: &mut Vec<u8>, body_len: usize) {
+    if body_len <= RESERVED_SIZE {
+        return;
+    }
+    let payload = body_len - RESERVED_SIZE;
+    let pad = (8 - payload % 8) % 8;
+    frame.resize(frame.len() + pad, 0);
+}
+
 // ---- little-endian slice readers (bounds-checked) ----
 
 pub(crate) fn le16(b: &[u8], off: usize) -> Result<u16, SitError> {
