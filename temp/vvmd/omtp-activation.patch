+/*
+ * The client type an OMTP request carries in "ct=".
+ *
+ * The spec only says the server uses it to identify the client, and that some
+ * servers require an agreed value. Android builds
+ * "<manufacturer>.<model>.<version>" with '=', ';', '.' and ' ' replaced by
+ * '_' inside each component and the whole thing kept under 30 characters, so
+ * follow that shape: a server that accepts an Android handset should accept
+ * this. Refer to Android's OmtpConstants.getClientType().
+ */
+static char *
+vvm_util_sanitize_component (const char *value,
+                             gsize       limit)
+{
+  g_autofree char *copy = NULL;
+  char *p;
+
+  if (value == NULL || *value == '\0')
+    return g_strdup ("unknown");
+
+  copy = g_strdup (value);
+  for (p = copy; *p != '\0'; p++) {
+    if (*p == '=' || *p == ';' || *p == '.' || *p == ' ' || g_ascii_iscntrl (*p))
+      *p = '_';
+  }
+  if (strlen (copy) > limit)
+    copy[limit] = '\0';
+
+  return g_steal_pointer (&copy);
+}
+
+static char *
+vvm_util_create_omtp_client_type (void)
+{
+  g_autofree char *model_raw = NULL;
+  g_autofree char *version_raw = NULL;
+  g_autofree char *manufacturer = NULL;
+  g_autofree char *version = NULL;
+  g_autofree char *model = NULL;
+  const char *rest;
+  gsize model_limit;
+
+  /* The device tree model reads like "Google Pixel 9 Pro XL": the first word
+   * is the manufacturer and the remainder is the model, which is how Android
+   * reports the same hardware. */
+  if (!g_file_get_contents ("/proc/device-tree/model", &model_raw, NULL, NULL))
+    model_raw = g_strdup (g_get_host_name ());
+
+  version_raw = g_get_os_info (G_OS_INFO_KEY_VERSION_ID);
+
+  rest = strchr (model_raw, ' ');
+  if (rest != NULL) {
+    manufacturer = vvm_util_sanitize_component (model_raw, rest - model_raw);
+    manufacturer[MIN (strlen (manufacturer), 12)] = '\0';
+    model_raw[rest - model_raw] = '\0';
+    rest++;
+  } else {
+    manufacturer = vvm_util_sanitize_component ("unknown", 12);
+    rest = model_raw;
+  }
+
+  version = vvm_util_sanitize_component (version_raw, 8);
+  model_limit = 28 - strlen (manufacturer) - strlen (version);
+  model = vvm_util_sanitize_component (rest, model_limit);
+
+  return g_strdup_printf ("%s.%s.%s", manufacturer, model, version);
+}
