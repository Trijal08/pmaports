+/// The presence URI for the emergency location document, or an empty string
+/// when the SIM gave no IMSI. Owned by `config`.
+///
+/// # Safety
+/// As [`samsung_ims_config_entries`].
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_config_geo_entity(
+    config: *const SamsungImsConfig,
+) -> *const c_char {
+    if config.is_null() {
+        return core::ptr::null();
+    }
+    (*config).geo_entity.as_ptr()
+}
