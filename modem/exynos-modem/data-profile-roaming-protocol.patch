+/// As above, with the roaming protocol given separately.
+///
+/// Stock sends the carrier's own roaming protocol here, which is not always the
+/// home one. Measured against the capture on identical firmware:
+/// `services.telus.com` and `sos` go out with pdp 2 and roaming **3**, where
+/// copying the home protocol sent 2. Keeping the copying form above means the
+/// callers that genuinely have only one protocol stay unchanged.
+#[allow(clippy::too_many_arguments)]
+pub fn build_set_data_profile_roaming(
+    token: u16,
+    apn: &str,
+    pdp: PdpType,
+    roaming_pdp: PdpType,
+    apn_types: u32,
+    bearers: u32,
+    auth: &ApnAuth,
+) -> Result<Vec<u8>, SitError> {
     let request = SetDataProfileRequest {
         profile_id: u32::MAX,
         apn: check_apn(apn)?,
         pdp_type: pdp as u8,
-        roaming_pdp_type: pdp as u8,
+        roaming_pdp_type: roaming_pdp as u8,
         auth: auth.auth as u8,
         user: check_credential(auth.user, "APN username")?,
         password: check_credential(auth.password, "APN password")?,
