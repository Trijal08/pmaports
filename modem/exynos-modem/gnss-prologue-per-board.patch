diff --git a/crates/gnss-betp/examples/extract_prologue.rs b/crates/gnss-betp/examples/extract_prologue.rs
new file mode 100644
index 0000000..a06cebe
--- /dev/null
+++ b/crates/gnss-betp/examples/extract_prologue.rs
@@ -0,0 +1,98 @@
+//! Build a `session-prologue.bin` out of a `/proc/gnssdump` capture.
+//!
+//! The board profile `kepler-gnssd` replays is the six BETP records the stock
+//! daemon sends host->device once the BETP service opens. Nothing on the vendor
+//! partition holds them -- `gnssd` rebuilds them from `/vendor/etc/gnss/gps.cfg`
+//! at every session open -- so the only way to obtain a board's own set is to
+//! capture one stock session and pull them out.
+//!
+//!   extract_prologue gnssdump.bin > /etc/kepler-gnssd/session-prologue.bin
+//!
+//! The capture's records are the /proc/sitdump layout:
+//!
+//!     u64 ts_ns ; u16 len ; u8 dir (0 = host->device) ; u8 ch (0 = ipc) ; body
+//!
+//! Only the host->device CHPP channel is read; everything else is skipped.
+use gnss_betp::{
+    app_header, betp_records_tx, chpp_datagrams, BETP_CMD_TX, BETP_HANDLE, SESSION_OPEN,
+};
+use std::io::Write;
+
+/// Which records are the prologue is not a fixed list: it is everything the
+/// host sends before it opens the session, and that differs per board. A Tegu
+/// sends `00e4 0edd 08ad 0d46 7304 09d3`; a komodo sends `00e4 08ad 7304 0d46
+/// 17d3` with no `0edd` at all and `09d3` only after session open. So the
+/// boundary is found rather than assumed: the first datagram carrying a
+/// session-open record ends the prologue.
+fn opens_session(ids: &[u16]) -> bool {
+    ids.iter()
+        .any(|id| SESSION_OPEN.iter().any(|(open, _)| open == id))
+}
+
+fn main() {
+    let path = std::env::args()
+        .nth(1)
+        .expect("usage: extract_prologue <gnssdump.bin>");
+    let raw = std::fs::read(&path).unwrap_or_else(|e| panic!("read {path}: {e}"));
+
+    // Reassemble the host->device CHPP byte stream in capture order.
+    let mut tx = Vec::new();
+    let mut off = 0usize;
+    let mut records = 0usize;
+    while off + 12 <= raw.len() {
+        let len = u16::from_le_bytes([raw[off + 8], raw[off + 9]]) as usize;
+        let dir = raw[off + 10];
+        let ch = raw[off + 11];
+        off += 12;
+        if off + len > raw.len() {
+            break;
+        }
+        if dir == 0 && ch == 0 {
+            tx.extend_from_slice(&raw[off..off + len]);
+        }
+        off += len;
+        records += 1;
+    }
+    eprintln!("{records} capture records, {} host->device bytes", tx.len());
+
+    // Every BETP record the host sent before it opened the session, in order
+    // and deduplicated by id: the transport retransmits, and a repeat of an id
+    // already seen is that rather than new configuration.
+    let mut seen: Vec<(u16, u16, Vec<u8>)> = Vec::new();
+    let mut all: Vec<u16> = Vec::new();
+    for datagram in chpp_datagrams(&tx) {
+        let Some((app, inner)) = app_header(&datagram) else {
+            continue;
+        };
+        if app.handle != BETP_HANDLE || app.command != BETP_CMD_TX {
+            continue;
+        }
+        let records = betp_records_tx(inner);
+        let ids: Vec<u16> = records.iter().map(|r| r.midsid).collect();
+        all.extend_from_slice(&ids);
+        if opens_session(&ids) {
+            break;
+        }
+        for r in records {
+            if !seen.iter().any(|(id, _, _)| *id == r.midsid) {
+                seen.push((r.midsid, r.proto, r.data.to_vec()));
+            }
+        }
+    }
+    eprintln!("host-sent records up to session open: {all:04x?}");
+    if seen.is_empty() {
+        eprintln!("no prologue records: the capture has no session open in it");
+        std::process::exit(1);
+    }
+
+    let mut out = Vec::new();
+    for (midsid, proto, data) in &seen {
+        out.extend_from_slice(&midsid.to_le_bytes());
+        out.extend_from_slice(&proto.to_le_bytes());
+        out.extend_from_slice(&(data.len() as u16).to_le_bytes());
+        out.extend_from_slice(data);
+        eprintln!("  {midsid:#06x} proto {proto} len {}", data.len());
+    }
+    std::io::stdout().write_all(&out).expect("write prologue");
+    eprintln!("wrote {} bytes", out.len());
+}
