+    gchar   *name;      /* the vendor's label, for logging */
+    gchar   *apn;
+    guint32  types;     /* MM_SIT_APN_TYPE_* bitmask */
+    guint32  bearers;   /* 1 << (radio tech - 1); 0 means any */
+    guint8   protocol;  /* MM_SIT_PDP_TYPE_* */
