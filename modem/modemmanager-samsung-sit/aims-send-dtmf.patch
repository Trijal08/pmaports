 /*****************************************************************************/
+/* DTMF */
+
+/*
+ * AIMS carries a key press as two requests -- down, then up -- naming the same
+ * digit, and holds the tone in between.  That is the shape ModemManager's base
+ * call class already drives: it calls send_dtmf, waits the call's configured
+ * tone duration, then calls stop_dtmf, and sequences a multi-character string
+ * itself.  So each of these sends exactly one request for one key.
+ *
+ * Only the IMS half is implemented.  The CS group has DTMF messages too, but
+ * their payloads are not decoded, and a call that is up on one stack cannot be
+ * served by the other.
+ */
+
+static MMSitIms *
+peek_ims_for_dtmf (MMCallSamsungSit  *self,
+                   GError           **error)
+{
+    if (!call_is_ims (self)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED,
+                     "DTMF is only supported on IMS calls");
+        return NULL;
+    }
+    return mm_broadband_modem_samsung_sit_peek_ims (MM_BROADBAND_MODEM_SAMSUNG_SIT (self->priv->modem));
+}
+
+static gssize
+call_send_dtmf_finish (MMBaseCall    *self,
+                       GAsyncResult  *res,
+                       GError       **error)
+{
+    return g_task_propagate_int (G_TASK (res), error);
+}
+
+static void
+ims_send_dtmf_ready (MMSitIms     *ims,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_sit_ims_send_dtmf_finish (ims, res, &error))
+        g_task_return_error (task, error);
+    else
+        /* One key per request; the base class advances the string by this. */
+        g_task_return_int (task, 1);
+    g_object_unref (task);
+}
+
+static void
+call_send_dtmf (MMBaseCall          *_self,
+                const gchar         *dtmf,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    MMCallSamsungSit *self = MM_CALL_SAMSUNG_SIT (_self);
+    MMSitIms         *ims;
+    GTask            *task;
+    GError           *error = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    if (!dtmf || !dtmf[0]) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                 "No DTMF tone to send");
+        g_object_unref (task);
+        return;
+    }
+
+    ims = peek_ims_for_dtmf (self, &error);
+    if (!ims) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    self->priv->dtmf_pressed = dtmf[0];
+    mm_obj_dbg (self, "pressing DTMF key '%c' on IMS call %u",
+                dtmf[0], call_cp_id (_self));
+    mm_sit_ims_send_dtmf (ims, call_cp_id (_self), MM_SIT_IMS_DTMF_START, dtmf[0],
+                          (GAsyncReadyCallback) ims_send_dtmf_ready, task);
+}
+
+static gboolean
+call_stop_dtmf_finish (MMBaseCall    *self,
+                       GAsyncResult  *res,
+                       GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+call_stop_dtmf (MMBaseCall          *_self,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    MMCallSamsungSit *self = MM_CALL_SAMSUNG_SIT (_self);
+    MMSitIms         *ims;
+    GTask            *task;
+    GError           *error = NULL;
+    gchar             digit;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    /* Releasing a key that was never pressed would name a digit the CP is not
+     * holding, so treat it as already done. */
+    digit = self->priv->dtmf_pressed;
+    if (!digit) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+    self->priv->dtmf_pressed = 0;
+
+    ims = peek_ims_for_dtmf (self, &error);
+    if (!ims) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "releasing DTMF key '%c' on IMS call %u",
+                digit, call_cp_id (_self));
+    mm_sit_ims_send_dtmf (ims, call_cp_id (_self), MM_SIT_IMS_DTMF_STOP, digit,
+                          (GAsyncReadyCallback) ims_simple_ready, task);
+}
+
+/*****************************************************************************/
 
