From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Fri, 7 Nov 2026 00:00:00 +0000
Subject: [PATCH] aims: build the emergency location document (0x0d62)

Stock sends one `SET_GEO_LOCATION_INFO` per stack at boot, in the same
window as its configuration pushes, and we never sent one at all. It is
what lets the network route an emergency call before the device has any
position fix, so it belongs at registration rather than when a call is
placed.

The payload is a PIDF-LO presence document (RFC 4119) behind a u16 length.
Across five captures and both stacks exactly three things vary -- the
`entity` URI, the civic country, and a device UUID that is fresh every boot
-- so it is a template, and `it_reproduces_the_captured_frame` rebuilds
stack 0's captured 837-byte frame from it byte for byte. There is no
position in the document: no gml:pos, no method, no confidence, no
timestamp, just the country.

`entity` is `pres:<IMSI>@<IMS home domain>`, and the domain is the one the
ISIM stated when it had one, so this and tag 778 cannot disagree.

The country is ISO 3166-1 alpha-2 for the SIM's MCC. That mapping is
generated from `mobile-broadband-provider-info`'s serviceproviders.xml --
the `<country code="..">` each `<network-id mcc=".."/>` sits under -- which
is the database ModemManager already depends on, so it is maintained
upstream rather than invented here. Where an MCC appears under several
countries the one with the most networks wins, which gives GB for 234 and
RU for 250. An MCC that is not in the table yields no country and the
document carries an empty element: honest, where guessing would put a wrong
country in an emergency call.
diff -ruN '--exclude=target' '--exclude=.git' em30/crates/samsung-aims/src/geoloc.rs em/crates/samsung-aims/src/geoloc.rs
--- a/crates/samsung-aims/src/geoloc.rs	1969-12-31 19:00:00.000000000 -0500
+++ b/crates/samsung-aims/src/geoloc.rs	2026-11-06 23:53:29.685052766 -0500
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//! `SET_GEO_LOCATION_INFO` (0x0d62) -- the emergency location the CP puts in
+//! an emergency INVITE.
+//!
+//! Stock sends exactly one per stack at boot, inside the window between the
+//! IMS grant and registration. The payload is a PIDF-LO presence document
+//! (RFC 4119) length-prefixed with a `u16`:
+//!
+//! ```text
+//!   [u16le xml_len][xml]
+//! ```
+//!
+//! Only three things in the document vary, confirmed across five captures and
+//! both stacks: the `entity` URI, the civic country, and a device UUID that is
+//! fresh on every boot. Everything else is byte-identical, so it is a template
+//! rather than a generated document.
+//!
+//! There is no position in it -- no `gml:pos`, no method, no confidence, no
+//! timestamp. It is a civic address naming the country and nothing more, which
+//! is what the network needs to route an emergency call before any fix exists.
+
+use crate::{frame, msg_id};
+
+/// The document stock sends, with its three variable fields.
+const PIDF_LO: &str = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><presence xmlns=\"urn:ietf:params:xml:ns:pidf\" xmlns:con=\"urn:ietf:params:xml:ns:geopriv:conf\" xmlns:dm=\"urn:ietf:params:xml:ns:pidf:data-model\" xmlns:gp=\"urn:ietf:params:xml:ns:pidf:geopriv10\" xmlns:gml=\"http://www.opengis.net/gml\" xmlns:gs=\"http://www.opengis.net/pidflo/1.0\" xmlns:gbp=\"urn:ietf:params:xml:ns:pidf:geopriv10:basicPolicy\" xmlns:ca=\"urn:ietf:params:xml:ns:pidf:geopriv10:civicAddr\" entity=\"{entity}\"><dm:device id=\"user\"><gp:geopriv><gp:location-info><ca:civicAddress><ca:country>{country}</ca:country></ca:civicAddress></gp:location-info><gp:usage-rules><gbp:retransmission-allowed>false</gbp:retransmission-allowed></gp:usage-rules></gp:geopriv><dm:deviceID>urn:uuid:{uuid}</dm:deviceID></dm:device></presence>";
+
+/// A version 4 UUID from the system's random source, formatted as the
+/// document wants it. Fresh per call, as stock's is fresh per boot.
+fn uuid_v4() -> String {
+    let mut b = [0u8; 16];
+    if std::fs::File::open("/dev/urandom")
+        .and_then(|mut f| std::io::Read::read_exact(&mut f, &mut b))
+        .is_err()
+    {
+        // Without randomness a fixed UUID is still a valid document; the CP
+        // uses it as an opaque device identifier.
+        b = [0x5e; 16];
+    }
+    b[6] = (b[6] & 0x0f) | 0x40;
+    b[8] = (b[8] & 0x3f) | 0x80;
+    let h = |r: &[u8]| r.iter().map(|x| format!("{x:02x}")).collect::<String>();
+    format!("{}-{}-{}-{}-{}", h(&b[0..4]), h(&b[4..6]), h(&b[6..8]), h(&b[8..10]), h(&b[10..16]))
+}
+
+/// Build `SET_GEO_LOCATION_INFO` for a subscriber.
+///
+/// `entity` is the presence URI -- `pres:<IMSI>@<IMS home domain>` -- and
+/// `country` the ISO 3166-1 alpha-2 code for the SIM's MCC. An empty country
+/// is allowed and sends an empty `<ca:country/>` rather than a wrong one.
+pub fn build_set_geo_location_info(token: u16, entity: &str, country: &str) -> Vec<u8> {
+    build_set_geo_location_info_with_uuid(token, entity, country, &uuid_v4())
+}
+
+/// As above with the UUID supplied, so a test can reproduce a capture.
+pub fn build_set_geo_location_info_with_uuid(
+    token: u16,
+    entity: &str,
+    country: &str,
+    uuid: &str,
+) -> Vec<u8> {
+    let xml = PIDF_LO
+        .replace("{entity}", entity)
+        .replace("{country}", country)
+        .replace("{uuid}", uuid);
+    let mut payload = Vec::with_capacity(2 + xml.len());
+    payload.extend_from_slice(&(xml.len() as u16).to_le_bytes());
+    payload.extend_from_slice(xml.as_bytes());
+    frame(msg_id::SET_GEO_LOCATION_INFO, token, &payload)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Reproduces the 0x0d62 frame captured from stock on 2026-11-06, stack 0,
+    /// byte for byte -- which is what says the template and the length prefix
+    /// are right rather than merely plausible.
+    #[test]
+    fn it_reproduces_the_captured_frame() {
+        let f = build_set_geo_location_info_with_uuid(
+            0x0001,
+            "pres:302220808479542@ims.mnc220.mcc302.3gppnetwork.org",
+            "CA",
+            "e78d02ba-388a-460a-8e26-85fd09243b69",
+        );
+        assert_eq!(&f[2..4], &0x0d62u16.to_le_bytes());
+        let payload = &f[12..];
+        assert_eq!(payload.len(), 837);
+        assert_eq!(u16::from_le_bytes([payload[0], payload[1]]) as usize, 835);
+        let xml = std::str::from_utf8(&payload[2..]).expect("utf-8");
+        assert!(xml.starts_with("<?xml version=\"1.0\" encoding=\"UTF-8\"?><presence "));
+        assert!(xml.contains("entity=\"pres:302220808479542@ims.mnc220.mcc302.3gppnetwork.org\""));
+        assert!(xml.contains("<ca:country>CA</ca:country>"));
+        assert!(xml.ends_with("urn:uuid:e78d02ba-388a-460a-8e26-85fd09243b69</dm:deviceID></dm:device></presence>"));
+    }
+
+    /// A fresh UUID per call, as stock has a fresh one per boot.
+    #[test]
+    fn the_uuid_is_not_fixed() {
+        let a = build_set_geo_location_info(1, "pres:x@y", "CA");
+        let b = build_set_geo_location_info(1, "pres:x@y", "CA");
+        assert_ne!(a, b);
+        assert_eq!(a.len(), b.len());
+    }
+}
