+/// Parse a `NEW_BROADCAST_SMS` (0x0110) indication into `out`/`out_len`, which
+/// must have room for SAMSUNG_SIT_MAX_CBS_PAGE bytes.
+///
+/// The page is a TS 23.041 CBS message, handed over untouched. A page longer
+/// than the buffer is an error rather than a truncation: half an emergency
+/// alert is worse than none.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_sit_parse_new_broadcast_sms(
+    data: *const u8,
+    len: usize,
+    out: *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    if out.is_null() || out_len.is_null() {
+        return SamsungSitStatus::NullPointer;
+    }
+    let buf = match in_slice(data, len) {
+        Ok(b) => b,
+        Err(s) => return s,
+    };
+    match sit::parse_new_broadcast_sms(buf) {
+        Ok(page) => {
+            if page.len() > crate::MAX_CBS_PAGE {
+                return SamsungSitStatus::ArgTooLong;
+            }
+            core::ptr::copy_nonoverlapping(page.as_ptr(), out, page.len());
+            out_len.write(page.len());
+            SamsungSitStatus::Ok
+        }
+        Err(e) => status_from_err(&e),
+    }
+}
+
+/// Parse a `GET_BROADCAST_SMS_CONFIG` (0x0105) reply into `out`/`out_count`,
+/// which must have room for SAMSUNG_SIT_MAX_BROADCAST_RANGES entries.
+///
+/// A CP that has no config yet is not an error: it comes back as
+/// `out_count == 0`.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_sit_parse_broadcast_sms_config(
+    data: *const u8,
+    len: usize,
+    out: *mut crate::SamsungSitBroadcastRange,
+    out_count: *mut usize,
+) -> SamsungSitStatus {
+    if out.is_null() || out_count.is_null() {
+        return SamsungSitStatus::NullPointer;
+    }
+    let buf = match in_slice(data, len) {
+        Ok(b) => b,
+        Err(s) => return s,
+    };
+    match sit::parse_broadcast_sms_config(buf) {
+        Ok(ranges) => {
+            if ranges.len() > crate::MAX_BROADCAST_RANGES {
+                return SamsungSitStatus::ArgTooLong;
+            }
+            for (i, r) in ranges.iter().enumerate() {
+                out.add(i).write((*r).into());
+            }
+            out_count.write(ranges.len());
+            SamsungSitStatus::Ok
+        }
+        Err(e) => status_from_err(&e),
+    }
+}
