# Reference: <https://nura.eco/devicepkg>
maintainer="Antoine Martin (ayakael) <dev@ayakael.net>"
pkgname=device-clockworkpi-uconsole-radxa-cm5
pkgdesc="Clockwork Tech ClockworkPi uConsole Radxa CM5"
pkgver=8
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-rockchip
	postmarketos-base
	u-boot-clockworkpi-uconsole-radxa-cm5
"
makedepends="
	devicepkg-dev
	"
subpackages="
	$pkgname-x11
"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	modules-load.conf
	modprobe.conf
	partition-table.txt
	xorg.conf
	cwu50-init.sh
	gunzip-vmlinuz.sh
"
build() {
	devicepkg_build $startdir $pkgname
}

x11() {
	install_if="$pkgname xorg-server"
	install -Dm644 "$srcdir"/xorg.conf \
		"$subpkgdir"/etc/X11/xorg.conf.d/10-monitor.conf
}

package() {
	devicepkg_package $startdir $pkgname

	# On the first pre-enable after cold probe, the DSI2 command interface
	# comes up wedged. Every DCS write of the panel init sequence times out, so
	# the panel is never initialised. The post_disable path performs a full
	# controller/PHY reset, so a second enable works perfectly.
	install -Dm755 "$srcdir"/cwu50-init.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks/

	# Rockchip u-boot does not support compressed kernels. Boot-deploy hook
	# makes sure it is gunzipped. Kernel is compressed because other devices it
	# supports has smaller boot partitions. This is a workaround until we move
	# to mainline u-boot that is a work in progress.
	install -Dm755 "$srcdir"/gunzip-vmlinuz.sh \
		-t "$pkgdir"/usr/share/boot-deploy/hooks/
}

