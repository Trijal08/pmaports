+/// Keep the session-open batch that just produced a fix, so the next run opens
+/// with what is known to work on this board rather than the table compiled in.
+///
+/// Written through a temporary and renamed, so a run that dies mid-write
+/// cannot leave a half-written batch behind. Failures are reported and
+/// otherwise ignored: a cache that cannot be written costs nothing but the
+/// bootstrap, and is no reason to stop serving positions.
+fn save_session_cache(path: &Path, records: &[protocol::PrologueRecord]) {
+    if records.is_empty() {
+        return;
+    }
+    let encoded = encode_prologue(records);
+    if let Ok(existing) = std::fs::read(path) {
+        if existing == encoded {
+            return;
+        }
+    }
+    if let Some(dir) = path.parent() {
+        if let Err(e) = std::fs::create_dir_all(dir) {
+            eprintln!("kepler-gnssd: session cache {}: {e}", dir.display());
+            return;
+        }
+    }
+    let tmp = path.with_extension("tmp");
+    let write = std::fs::write(&tmp, &encoded).and_then(|()| std::fs::rename(&tmp, path));
+    match write {
+        Ok(()) => eprintln!(
+            "kepler-gnssd: recorded {} session-open records to {}",
+            records.len(),
+            path.display()
+        ),
+        Err(e) => {
+            let _ = std::fs::remove_file(&tmp);
+            eprintln!("kepler-gnssd: session cache {}: {e}", path.display());
+        }
+    }
+}
