# Maintainer: Trijal Saha <trijalsaha2012@gmail.com>
pkgname=portmaster-compat
pkgver=1
pkgrel=0
pkgdesc="Run PortMaster and its glibc game ports on postmarketOS"
url="https://portmaster.games"
arch="all"
license="MIT"
options="!check pmb:support-openrc pmb:support-systemd"
install="
	$pkgname.post-install
	$pkgname.pre-deinstall
"

# bash: every PortMaster launcher and control.txt is #!/bin/bash and uses
#   bash-only syntax. Without it EmulationStation's exec fails with 127 and
#   no output at all.
# bubblewrap: port-launch runs each port in a namespace - this is what binds
#   the glibc loader and overlays the port directory read-only.
# gcompat: supplies /lib/ld-linux-aarch64.so.1, the path port-launch binds
#   the sysroot loader OVER. Without gcompat there is no bind target and
#   port-launch falls back to running ports unsandboxed.
# glibc-sysroot: the real glibc/Mesa/SDL runtime the ports execute against.
# python3: es-input-for-portmaster.
depends="
	bash
	bubblewrap
	gcompat
	glibc-sysroot
	python3
	"
source="
	port-launch
	es-input-for-portmaster
	portmaster-compat-links
	portmaster-compat.service
	portmaster-compat.initd
	80-portmaster-compat.preset
	gamecontrollerdb.txt
	mod_postmarketOS.txt
	oga_events.service
	50-oga-events.rules
	"

package() {
	# /usr/bin, not /usr/sbin: EmulationStation runs this as the session
	# user, and /usr/sbin is for administrative tools.
	install -Dm755 "$srcdir"/port-launch -t "$pkgdir"/usr/bin
	install -Dm755 "$srcdir"/es-input-for-portmaster -t "$pkgdir"/usr/bin
	install -Dm755 "$srcdir"/portmaster-compat-links -t "$pkgdir"/usr/bin

	# /roms and /storage. A service rather than tmpfiles.d because the
	# target depends on the user's home directory, whose name is chosen at
	# "pmbootstrap init" time and cannot be written into a static file.
	install -Dm644 "$srcdir"/portmaster-compat.service \
		-t "$pkgdir"/usr/lib/systemd/system
	install -Dm755 "$srcdir"/portmaster-compat.initd \
		"$pkgdir"/etc/init.d/portmaster-compat
	# Without a preset the unit ships disabled, /roms is never created and
	# every port fails to resolve its own location.
	install -Dm644 "$srcdir"/80-portmaster-compat.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset

	# Layered into every port by port-launch, but only where the port does
	# not already ship a file of that name - so PortMaster's own much
	# larger gamecontrollerdb.txt is never replaced.
	install -Dm644 "$srcdir"/gamecontrollerdb.txt \
		-t "$pkgdir"/opt/port-overlays/common

	install -Dm644 "$srcdir"/mod_postmarketOS.txt \
		-t "$pkgdir"/usr/share/portmaster

	# PortMaster ports restart ArchR's oga_events at exit; provide the unit
	# and let the session user bounce it without a polkit prompt.
	install -Dm644 "$srcdir"/oga_events.service \
		-t "$pkgdir"/usr/lib/systemd/system
	install -Dm644 "$srcdir"/50-oga-events.rules \
		-t "$pkgdir"/usr/share/polkit-1/rules.d
}

