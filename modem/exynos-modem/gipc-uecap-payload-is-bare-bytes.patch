+    /// The two block sizes stock was captured serving, byte for byte: a
+    /// 4000-byte block's payload is 4003 bytes beginning `0a a0 1f`, and
+    /// ap_plmn_mapping's 2970-byte one is 2973 beginning `0a 9a 17`. Nothing
+    /// follows the data -- no offset, no result, no last_block -- which is the
+    /// whole point: the modelled wrapper made the CP re-read for ever.
+    #[test]
+    fn uecap_payload_is_one_field_of_bytes_like_stock() {
+        let p = uecap_read_payload(&[0u8; 4000]);
+        assert_eq!(p.len(), 4003);
+        assert_eq!(&p[..3], &[0x0a, 0xa0, 0x1f]);
+
+        let p = uecap_read_payload(&[0u8; 2970]);
+        assert_eq!(p.len(), 2973);
+        assert_eq!(&p[..3], &[0x0a, 0x9a, 0x17]);
+
+        /* A short block still has a single-byte length. */
+        let p = uecap_read_payload(&[1, 2, 3]);
+        assert_eq!(p, vec![0x0a, 0x03, 1, 2, 3]);
+    }
