# Reference: <https://postmarketos.org/devicepkg>
maintainer="Vitaliy Ognev <vitaliy.ognev@gmail.com>"
pkgname=device-rockchip-r36s
pkgdesc="Rockchip R36S"
pkgver=7
pkgrel=11
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-rockchip-r36s
	linux-rockchip-r36s
	postmarketos-base
	postmarketos-bootsplash
	u-boot-rockchip-r36s
	e2fsprogs
	acl
	postmarketos-mkinitfs
"
makedepends="devicepkg-dev"
# umtprd.conf is shipped by postmarketos-usb-moded. apk refuses to install two
# packages owning the same path, so claim it explicitly.
replaces="postmarketos-usb-moded"
source="
	80-device-rockchip-r36s.preset
	99-rockchip-r36s-gpu.rules
	usb-role-default
	usb-role-default.service
	usb-gadget-reconnect
	usb-gadget-reconnect.service
	usb-gadget-rebind.service
	99-rockchip-r36s-usb-hotplug.rules
	deviceinfo
	kernel-cmdline.conf
	50-storage-partition.sh
	storage-partition-setup
	storage-partition.service
	umtprd.conf
"
_pmb_recommends="rockchip-r36s-mapper"
# abuild moves usr/lib/udev into this via default_udev, with install_if on
# udev - the same split the other device rules use.
subpackages="$pkgname-systemd $pkgname-udev"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/80-device-rockchip-r36s.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/

	install -Dm644 "$srcdir"/99-rockchip-r36s-gpu.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/

	# See the comment in the script: as a udev rule this hangs dwc2's core
	# reset at boot. It has to run once the controller has settled.
	install -Dm755 "$srcdir"/usb-role-default -t "$pkgdir"/usr/bin
	install -Dm644 "$srcdir"/usb-role-default.service \
		-t "$pkgdir"/usr/lib/systemd/system

	# The board powers the port itself, so the controller never sees the
	# cable move; this keeps the gadget advertising itself after a
	# disconnect so attaching later still enumerates.
	install -Dm755 "$srcdir"/usb-gadget-reconnect -t "$pkgdir"/usr/bin
	install -Dm644 "$srcdir"/usb-gadget-reconnect.service \
		-t "$pkgdir"/usr/lib/systemd/system
	install -Dm644 "$srcdir"/usb-gadget-rebind.service \
		-t "$pkgdir"/usr/lib/systemd/system
	install -Dm644 "$srcdir"/99-rockchip-r36s-usb-hotplug.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d

	# Separate STORAGE partition for ROMs, BIOS files and ports.
	#
	# pmbootstrap can only install boot + root: partition.py hardcodes
	# ["mkpart", "primary", mb_root_start, "100%"] and deviceinfo has no
	# key for extra partitions, so the tail of the card has to be claimed
	# from the initramfs. /hooks-extra, not /hooks: init_2nd.sh runs it
	# after udev has settled but before wait_root_partition,
	# resize_root_partition and mount_root_partition.
	install -Dm644 "$srcdir"/50-storage-partition.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks-extra/

	# mkfs cannot run in the initramfs, so the formatting and the mount
	# happen on the first real boot. Enabled by the preset above.
	install -Dm755 "$srcdir"/storage-partition-setup \
		-t "$pkgdir"/usr/bin/
	install -Dm644 "$srcdir"/storage-partition.service \
		-t "$pkgdir"/usr/lib/systemd/system/

	install -Dm644 "$srcdir"/umtprd.conf \
		"$pkgdir"/etc/umtprd/umtprd.conf
}

