# Source
_owner="TheMuppets"
_repository="proprietary_vendor_google_komodo"
# A branch name is not a pin: the tarball changes under the recorded checksum
# whenever upstream pushes, so this always names a commit.
#
# Currently pinned to 1aa6782a -- "komodo: Pin rust binaries to CP2A.260805.005"
# (2026-10-20), 7 commits ahead of eeadf643. It boots and works.
#
# Note this pin does NOT change the CP's own firmware, so it cannot move
# anything about the 2253 refusal: kepler.bin here is the *GNSS* image
# (S5XXX_GNSS_FW in s5xxx_modem.c), and the baseband runs modem.bin out of the
# read-only modem partition, which no package touches.
#
# What it does change, by git blob sha against eeadf643 (which IS this
# device's build): 653 of 1398 uecapconfig files, 6 carrierconfig files plus
# ~400 renames each way, kepler.bin and aoc.bin. Those uecap/carrier counts are
# *identical* to the CP3A.260905.009 branch tip, so the blob divergence landed
# at or before CP2A.260805.005.
#
# Measured regressions on this pin, 2026-11-04:
#  - the CP re-reads TELUS_*.binarypb 5x per boot instead of once (8 uecap
#    reads against Android's 4), losing the parity won in exynos-modem r20
#  - Telus IMS draws the good P-CSCF pool and then does not register, where
#    eeadf643 registered 7/7 times on that pool
#  - Freedom's first two bearer connects fail with SIT command timeouts
#
# Previously eeadf643f25b96045802ef6ff4cfa2cd40c705b6, which was verified
# byte-identical to this device's own vendor partition: the device reports
# vendor CP2A.260605.016 and that import's uecapconfig and carrierconfig
# matched it 1398/1398 and 1305/1305 by git blob sha. Tracking the branch tip
# instead picked up CP3A.260905.009, where 653 of 1398 uecapconfig files
# differed from what the modem on this device shipped with. If the modem
# misbehaves after a pin change, check the blob shas against the device before
# looking anywhere else.
_commit="1aa6782a3ef467a08b600c0dd3bdc073c8008cf0"
source="
	$pkgname-$_commit.tar.gz::https://github.com/$_owner/$_repository/archive/$_commit.tar.gz
	initramfs_setup_modemfw.sh
	initramfs_setup_serialnumber.sh
	aosp-carrier-defaults.txt
"
builddir="$srcdir/$_repository-$_commit"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

brcm_a0() {
	pkgdesc="Google Pixel 9 Pro XL Broadcom BCM4390A0 firmware"

	# Main Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/fw_bcmdhd.bin_4390_a0 \
		"$subpkgdir/usr/lib/firmware/brcm/brcmfmac4390a0-pcie.bin"

	# NVRAM Blob (plain text)
	install -Dm644 "$builddir"/proprietary/vendor/firmware/bcmdhd.cal_4390_a0 \
		"$subpkgdir/usr/lib/firmware/brcm/brcmfmac4390a0-pcie.txt"

	# CLM Binary Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/bcmdhd_clm.blob_4390_a0 \
		"$subpkgdir/usr/lib/firmware/brcm/brcmfmac4390a0-pcie.clm_blob"

	# TXCAP Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/bcmdhd_txcap.blob_4390_a0 \
		"$subpkgdir/usr/lib/firmware/brcm/brcmfmac4390a0-pcie.txcap_blob"

	# Bluetooth HCD Blob
	# install -Dm644 "$builddir"/proprietary/vendor/firmware/brcm/BCM_200.hcd \
	# 	"$subpkgdir/usr/lib/firmware/brcm/BCM4390A0.hcd"
	install -Dm644 "$builddir"/proprietary/vendor/firmware/brcm/BCM_200.hcd \
		"$subpkgdir/usr/lib/firmware/brcm/BCM.hcd"
}

