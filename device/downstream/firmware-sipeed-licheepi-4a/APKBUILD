maintainer="Kanak Shilledar <kanakshilledar@proton.me>"
pkgname=firmware-sipeed-licheepi-4a
pkgver=0_git20261010
pkgrel=0
_commit="725756411ecc20f2c2dbc5ea6b8e5aacc6f83aad"
pkgdesc="TH1520 boot firmware (AON/E902, audio/C906) for LicheePi 4A, from RevyOS"
url="https://github.com/revyos/th1520-boot-firmware"
arch="riscv64"
license="proprietary"
makedepends="opensbi"
options="!check !strip !archcheck !tracedeps"
source="th1520-boot-firmware-$_commit.tar.gz::https://github.com/revyos/th1520-boot-firmware/archive/$_commit.tar.gz"
builddir="$srcdir/th1520-boot-firmware-$_commit"

package() {
	cd "$builddir/addons/boot"
	mkdir -p "$pkgdir/boot"
	cp light_aon_fpga.bin "$pkgdir/boot/"
	cp light_c906_audio.bin "$pkgdir/boot/"
	cp str.bin "$pkgdir/boot/"
	install -Dm644 /usr/share/opensbi/generic/firmware/fw_dynamic.bin "$pkgdir"/boot/fw_dynamic.bin
}

