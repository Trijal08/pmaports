# Maintainer: Trijal Saha <trijalsaha2012@gmail.com>
pkgname=rockchip-r36s-storage-partition
pkgver=1
pkgrel=0
pkgdesc="Separate STORAGE partition for ROMs, BIOS and ports, created on first boot"
url="https://postmarketos.org"
arch="noarch"
license="GPL-3.0-or-later"
options="!check"
# exfatprogs: mkfs.exfat, run once by storage-partition.service.
# postmarketos-mkinitfs: owns /usr/share/mkinitfs and the trigger that
# rebuilds the initramfs when anything under it changes.
depends="
	exfatprogs
	postmarketos-mkinitfs
	"
# umtprd.conf is shipped by postmarketos-usb-moded. apk refuses to install
# two packages owning the same path, so claim it explicitly.
replaces="postmarketos-usb-moded"
source="
	50-storage-partition.sh
	storage-partition-setup
	storage-partition.service
	umtprd.conf
	"

package() {
	# /hooks-extra, not /hooks: init_2nd.sh runs the former immediately
	# before resize_root_partition(), which is the only window where the
	# free space is still unclaimed and nothing is mounted yet.
	install -Dm644 "$srcdir"/50-storage-partition.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks-extra/

	install -Dm755 "$srcdir"/storage-partition-setup \
		-t "$pkgdir"/usr/bin/
	install -Dm644 "$srcdir"/storage-partition.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../storage-partition.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/storage-partition.service

	install -Dm644 "$srcdir"/umtprd.conf \
		"$pkgdir"/etc/umtprd/umtprd.conf
}
sha512sums="
