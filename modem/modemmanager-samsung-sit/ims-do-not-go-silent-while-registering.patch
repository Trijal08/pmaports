From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Fri, 7 Nov 2026 00:00:00 +0000
Subject: [PATCH] samsung-sit: do not go silent while a registration is outstanding

The CP will not emit its REGISTRATION indication while the link is idle.
Measured with the rings instrument at 20 Hz across a stall: `fmt rx
undrained` was 0 for all 115 samples of the window, so nothing was queued
and no notification had been lost, and the indication arrived within a
second of whatever the AP wrote next.

Pushing the configuration in three messages was not enough, and the
captures say why. Over the three seconds after its IMS grant, stock makes
17-45 writes on the stack with a longest silent gap of 0.32-1.79 s, and
its registration lands 0.7-2.5 s after the grant -- before the late
hidden-menu push, so that push is not what frees it. We made a comparable
14-27 writes but all of them inside the first 30 ms, then nothing. The CP
finished registering at about a second and the indication sat there until
the next periodic poll twelve to sixteen seconds later.

So ask after registration once a second while waiting, and discard the
answer: the CP announces the real state in its own indication and the
write is the point. It is the query we already use for this question
rather than traffic invented to fill space, one second keeps us inside
stock's own gap, and it stops as soon as the indication arrives or the
sequence leaves IMS_STATE_STARTED.
diff -ruN mm71/src/plugins/samsung-sit/mm-sit-ims.c f72/src/plugins/samsung-sit/mm-sit-ims.c
--- a/src/plugins/samsung-sit/mm-sit-ims.c	2026-11-07 00:25:55.279791923 -0500
+++ b/src/plugins/samsung-sit/mm-sit-ims.c	2026-11-07 00:22:35.197501893 -0500
@@ -133,6 +133,28 @@
  */
 #define REGISTRATION_WATCHDOG_SECS 180
 
+/*
+ * How often to ask after registration while waiting for the CP to announce
+ * it.
+ *
+ * Not impatience -- the CP will not emit its REGISTRATION indication while
+ * the link is idle, and the AP's next write is what frees it. Measured with
+ * the rings instrument at 20 Hz across a stall: `fmt rx undrained` was 0 for
+ * all 115 samples, so nothing was queued and no notification had been lost,
+ * and the indication arrived within a second of whatever the AP wrote next.
+ *
+ * Stock never goes quiet here. Over the three seconds after its IMS grant it
+ * makes 17-45 writes on the stack with a longest silent gap of 0.32-1.79 s,
+ * and its registration lands 0.7-2.5 s after the grant. We made a comparable
+ * 14-27 writes but all inside the first 30 ms, then nothing -- so the CP
+ * finished registering at about a second and the indication sat until the
+ * next periodic poll twelve to sixteen seconds later.
+ *
+ * One second keeps us inside stock's own gap, and the query is the one we
+ * already use for this question rather than traffic invented to fill space.
+ */
+#define REGISTRATION_NUDGE_SECS 1
+
 typedef enum {
     IMS_STATE_STOPPED,
     IMS_STATE_STARTING,
@@ -212,6 +234,9 @@
     /* Armed when provisioning completes, disarmed by registration; see
      * REGISTRATION_WATCHDOG_SECS. */
     guint         registration_watchdog_id;
+    /* Keeps the link from going silent while a registration is outstanding;
+     * see REGISTRATION_NUDGE_SECS. */
+    guint         registration_nudge_id;
 };
 
 enum {
@@ -680,6 +705,34 @@
         g_source_remove (self->priv->registration_watchdog_id);
         self->priv->registration_watchdog_id = 0;
     }
+    if (self->priv->registration_nudge_id) {
+        g_source_remove (self->priv->registration_nudge_id);
+        self->priv->registration_nudge_id = 0;
+    }
+}
+
+/* Ask after registration, and discard the answer: the CP announces the real
+ * state in its own indication, and what this is for is the write. */
+static void
+registration_nudge_done (MMSitClient  *client,
+                         GAsyncResult *res,
+                         gpointer      unused)
+{
+    MMSitRegistration registration;
+
+    mm_sit_client_get_registration_finish (client, res, &registration, NULL);
+}
+
+static gboolean
+registration_nudge_cb (MMSitIms *self)
+{
+    if (self->priv->registered || self->priv->state != IMS_STATE_STARTED) {
+        self->priv->registration_nudge_id = 0;
+        return G_SOURCE_REMOVE;
+    }
+    mm_sit_client_get_registration (self->priv->client, self->priv->cancellable,
+                                    (GAsyncReadyCallback) registration_nudge_done, NULL);
+    return G_SOURCE_CONTINUE;
 }
 
 static gboolean
@@ -709,6 +762,9 @@
     self->priv->registration_watchdog_id =
         g_timeout_add_seconds (REGISTRATION_WATCHDOG_SECS,
                                (GSourceFunc) registration_watchdog_cb, self);
+    self->priv->registration_nudge_id =
+        g_timeout_add_seconds (REGISTRATION_NUDGE_SECS,
+                               (GSourceFunc) registration_nudge_cb, self);
 }
 
 static void
diff -ruN mm71/src/plugins/samsung-sit/tests/test-sit-protocol.c f72/src/plugins/samsung-sit/tests/test-sit-protocol.c
--- a/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-07 00:25:55.276620515 -0500
+++ b/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-07 00:24:03.926907659 -0500
@@ -3018,6 +3018,15 @@
     case MM_SIT_MESSAGE_SET_INDICATION_FILTER:
     case MM_SIT_MESSAGE_SET_SCREEN_STATE:
         break;
+    /*
+     * The registration nudge, which repeats once a second while the CP has
+     * not announced registration. Its answer is discarded -- the write is
+     * the point -- so a plain success is right, and the retry ladder this
+     * test measures is unaffected by it.
+     */
+    case MM_SIT_MESSAGE_GET_DATA_REGISTRATION:
+    case MM_SIT_MESSAGE_GET_OPERATOR:
+        break;
     case 0x0d3a: /* AIMS_STACK_STOP_REQ */
         peer->stops++;
         break;
