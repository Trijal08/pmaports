From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Fri, 7 Nov 2026 00:00:00 +0000
Subject: [PATCH] samsung-sit: stop the AIMS stack before starting it

We only ever started it. Stock stops it first, and the captures are
unanimous -- all seven on this baseband, both stacks, no exceptions:

    message                      Android      ours
    AIMS_STACK_STOP  0x0d3a      2 per stack     0
    AIMS_XCAPM_STOP  0x0d3c      2-3             0
    AIMS_XCAPM_START 0x0d3b      2-3             1
    AIMS_STACK_START 0x0d39      2               2

Stock's order per stack, read off the wire with its own payloads -- byte 0
is the vendor's flag, byte 1 the 1-based stack index:

    STACK_STOP  01  ->  STACK_START 01  ->  XCAPM_STOP 01  ->  XCAPM_START 01
    ->  STACK_STOP 00  ->  XCAPM_STOP 00  ->  XCAPM_START 01  ->  STACK_START 01

So it tears the stack down, brings it up, then repeats the pair with the
flag clear -- and ends on a START. We were configuring a stack the CP still
held state for, which is the one thing in that block we were not doing at
all.

The whole sequence goes in the PRE_PDN table, trailing START included.
An earlier version of this patch left that last START out, on the theory
that mm-sit-ims.c's own AIMS_STACK_START would serve as stock's second one.
It does not: on the wire ims.c's START arrives *before* this table, not
after it, so the block ended on the flag-clear STOP and the CP was left
holding an IMS stack that was down. It then accepted every later request
-- hidden menu, geo location, ADD_PDN_INFO, all status 0 -- brought the IMS
PDN up, and never emitted AIMS_REGISTRATION (0x0d05). Provisioning
completed, registration never arrived, and the 180s watchdog recycled the
context in a loop. Both stacks, every boot.

mm-sit-client.c already rewrites payload byte 1 for all four of these ids,
so they are correct on both stacks without further work.

AIMS_SET_CALL_WAITING (0x0d17) is still missing -- stock sends it 2-3 times
per stack -- but its 18-byte payload carries a live timestamp, and replaying
a frozen one is the bug that had it removed from this path before. It needs
building, not replaying, so it is left for its own change.

The retry test needed a real fix, not a weakened assertion. Its peer counted
every 0x0d3a as a teardown, and the PRE_PDN block now legitimately sends
two per attempt, so its wait returned after the second attempt instead of
the fifth. Both carry flag 1 and the stack index and are otherwise
identical, so the peer now arms the counter on AIMS_DEREGISTRATION (0x0d06),
which the teardown always sends first and the replay never sends.
diff --color -ruN base/src/plugins/samsung-sit/mm-sit-boot-config.c t/src/plugins/samsung-sit/mm-sit-boot-config.c
--- a/src/plugins/samsung-sit/mm-sit-boot-config.c	2026-11-08 09:02:12.660431615 -0500
+++ b/src/plugins/samsung-sit/mm-sit-boot-config.c	2026-11-08 09:02:26.661334639 -0500
@@ -116,7 +116,22 @@
 static const guint8 cfg_set_allowed_network_type_bitmap[4] = { 0xf8, 0x01, 0x04, 0x00 };
 static const guint8 cfg_sit_set_gps_supl_ni_ready[2] = { 0x6b, 0x1c };
 static const guint8 cfg_set_fast_dormancy_info[4] = { 0x0a, 0x0a, 0x0a, 0x0a };
+/*
+ * The AIMS stack requests: byte 0 is the flag the vendor sets, byte 1 the
+ * 1-based stack index, rewritten per stack in mm-sit-client.c.
+ *
+ * Stock stops the stack before it starts it, and does it twice -- once with
+ * the flag set and once clear. Checked against all seven Android captures on
+ * this baseband, both stacks, with no exceptions: STACK_STOP twice per stack,
+ * XCAPM_STOP two or three times, where we sent none at all and only ever
+ * started. Starting a stack the CP still holds state for is the one thing in
+ * that block we were not doing.
+ */
 static const guint8 pre_aims_stack_start_req[2] = { 0x01, 0x01 };
+static const guint8 pre_aims_stack_stop_req[2]  = { 0x01, 0x01 };
+static const guint8 pre_aims_stack_stop_off[2]  = { 0x00, 0x01 };
+static const guint8 pre_aims_xcapm_stop_req[2]  = { 0x01, 0x01 };
+static const guint8 pre_aims_xcapm_stop_off[2]  = { 0x00, 0x01 };
 static const guint8 pre_aims_set_frame_time[10] = { 0x00, 0x02, 0x20, 0x04, 0xa9, 0xa8, 0xa1, 0x01, 0x00, 0x00 };
 static const guint8 pre_aims_xcapm_start_req[2] = { 0x01, 0x01 };
 static const guint8 pre_set_voice_operation[4] = { 0x03, 0x00, 0x00, 0x00 };
@@ -342,12 +357,37 @@
      * Since r60 the first ask is granted 6 times out of 6, so that experiment
      * is now cheap and worth running.
      */
+    /*
+     * Stock's order, per stack, from the captures: stop, start, xcapm stop,
+     * xcapm start, then the pair again with the flag clear, then a second
+     * xcapm start. The second STACK_START is the one mm-sit-ims.c sends.
+     */
+    { 0x0d3a, "aims stack stop req", MM_SIT_BOOT_PHASE_PRE_PDN,
+      { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_stack_stop_req },
     { 0x0d39, "aims stack start req", MM_SIT_BOOT_PHASE_PRE_PDN,
       { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_stack_start_req },
+    { 0x0d3c, "aims xcapm stop req", MM_SIT_BOOT_PHASE_PRE_PDN,
+      { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_xcapm_stop_req },
     { 0x0d0b, "aims set frame time", MM_SIT_BOOT_PHASE_PRE_PDN,
       { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 10, pre_aims_set_frame_time },
     { 0x0d3b, "aims xcapm start req", MM_SIT_BOOT_PHASE_PRE_PDN,
       { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_xcapm_start_req },
+    { 0x0d3a, "aims stack stop req (flag clear)", MM_SIT_BOOT_PHASE_PRE_PDN,
+      { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_stack_stop_off },
+    { 0x0d3c, "aims xcapm stop req (flag clear)", MM_SIT_BOOT_PHASE_PRE_PDN,
+      { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_xcapm_stop_off },
+    { 0x0d3b, "aims xcapm start req", MM_SIT_BOOT_PHASE_PRE_PDN,
+      { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_xcapm_start_req },
+    /*
+     * And the stack comes back up.  Stock's block ends on a START, not on the
+     * flag-clear STOP above it: leave it off and the CP holds an IMS stack that
+     * is down, accepts every later request, and never emits AIMS_REGISTRATION
+     * (0x0d05) -- provisioning completes, registration never arrives, and the
+     * watchdog recycles the context forever.  mm-sit-ims.c's own START cannot
+     * stand in for this one; it runs before this table, not after it.
+     */
+    { 0x0d39, "aims stack start req", MM_SIT_BOOT_PHASE_PRE_PDN,
+      { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_stack_start_req },
     { 0x091a, "set voice operation", MM_SIT_BOOT_PHASE_PRE_PDN,
       { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 4, pre_set_voice_operation },
     { 0x0d0b, "aims set frame time", MM_SIT_BOOT_PHASE_PRE_PDN,
diff --color -ruN base/src/plugins/samsung-sit/tests/test-sit-protocol.c t/src/plugins/samsung-sit/tests/test-sit-protocol.c
--- a/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-08 09:02:12.668462857 -0500
+++ b/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-08 09:02:12.676367659 -0500
@@ -2951,6 +2951,7 @@
 typedef struct {
     guint setups;
     guint stops;
+    gboolean deregistered;  /* a teardown is in progress; see 0x0d06 */
     guint pdn_infos;
     guint deactivations;
     guint succeed_on;
@@ -2998,6 +2999,14 @@
          * A plain success here; the caller carries on either way. */
         break;
     case 0x0d06: /* AIMS_DEREGISTRATION */
+        /*
+         * The teardown deregisters before it stops the stack; the PRE_PDN
+         * replay never does. That is the only thing that tells the two
+         * STACK_STOPs apart -- both carry flag 1 and the stack index -- so
+         * it is what arms the stop counter below.
+         */
+        peer->deregistered = TRUE;
+        break;
     case 0x0d39: /* AIMS_STACK_START_REQ */
     case 0x0d07: /* AIMS_HIDDEN_MENU */
         break;
@@ -3028,7 +3037,11 @@
     case MM_SIT_MESSAGE_GET_OPERATOR:
         break;
     case 0x0d3a: /* AIMS_STACK_STOP_REQ */
-        peer->stops++;
+        /* Only the teardown's, not the two the PRE_PDN block replays. */
+        if (peer->deregistered) {
+            peer->stops++;
+            peer->deregistered = FALSE;
+        }
         break;
     case 0x0d08: /* AIMS_ADD_PDN_INFO */
         peer->pdn_infos++;
