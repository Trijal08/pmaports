# eSIM support. Pinned to the device because both halves are modem transport,
# not a user preference, and no UI meta pulls either in.
#
# exynos-modem-polkit is the gate: without it sit-proxy defaults to --auth none
# and serves only the root-only /run/sit-proxy/{0,1} sockets, so the desktop
# backend gets EACCES on connect and the app reports "No eSIM support". The
# drop-in sets SIT_PROXY_AUTH=polkit, which is what creates the 0.auth endpoint.
#
# lpa-gtk is the only GUI frontend for lpac; it pulls exynos-modem-lpa and the
# patched lpac 2.3.0-r1 (stock r0 dies in euicc_init) in behind it.
depends="$depends
	exynos-modem-polkit
	lpa-gtk
"
makedepends="devicepkg-dev"
subpackages="$pkgname-audio $pkgname-cutouts $pkgname-plasma-mobile:plasma_mobile"
source="
	deviceinfo
	kernel-cmdline.conf
	plasma-mobile-preset.conf
	gmobile-cutout.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

# Audio, the way the PinePhone's device package carries it: only pulled in once
# a UI with audio is installed, and nothing in it is a user preference.
#
# pinephone-callaudiod rather than callaudiod, which the UI asks for and this
# provides.  Upstream callaudiod cannot switch the output on a card configured
# through the use case manager: such a card has one port per sink -- a mapping,
# and so a sink, per UCM device -- and callaudiod switches output by setting a
# port on the sink it bound to, so the speakerphone button set its own state
# and nothing moved.  pinephone-callaudiod switches card profiles instead,
# which is the only thing that works here, and it needs nothing
# device-specific: ACP builds its profile names out of any UCM devices called
# Earpiece, Speaker and Mic.
audio() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-base-ui-audio"
	depends="
		alsa-ucm-conf-zumapro
		pinephone-callaudiod
		postmarketos-base-ui-audio-backend-pipewire
	"

	mkdir -p "$subpkgdir"
}

# The display's cutout, for gmobile. It compiles its panels into the library as
# GResources and reads no directory at runtime, so a panel shipped as a file is
# found only through GLib's resource overlay -- hence the environment drop-in
# next to it. Without a panel the shell has no cutout to lay out around and
# leaves the clock centered underneath it.
#
# Named after the SoC-prefixed compatible, as upstream's own Google panels are;
# gmobile walks every compatible the device tree lists, so either name resolves.
# That name carries a comma and abuild forbids one in a source file name, so the
# file is carried under a plain name and renamed on the way in.
cutouts() {
	install_if="$pkgname=$pkgver-r$pkgrel gmobile"
	pkgdesc="$pkgdesc (display cutout)"

	install -Dm644 "$srcdir"/gmobile-cutout.conf \
		"$subpkgdir"/usr/share/gmobile/display-panels/google,zumapro-komodo.json

	mkdir -p "$subpkgdir"/etc/environment.d
	printf '%s\n' \
		'G_RESOURCE_OVERLAYS=/mobi/phosh/gmobile/devices/display-panels=/usr/share/gmobile/display-panels' \
		> "$subpkgdir"/etc/environment.d/90-gmobile-cutouts.conf
}

plasma_mobile() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-plasma-mobile"

	# Plasma Mobile looks its preset up by the first DT compatible string, so
	# the installed name has to be "google,komodo.conf" - abuild forbids a
	# comma in a source file name, hence the rename here. Without the preset
	# the shell sizes the panels for a smaller screen and leaves the top one
	# off-centre against the punch-hole camera.
	install -Dm644 "$srcdir"/plasma-mobile-preset.conf \
		"$subpkgdir"/usr/share/plasma-mobile-device-presets/google,komodo.conf
}

