+    /* Provisioning floor; see PROVISIONING_COOLDOWN_SECS. Monotonic, so it
+     * outlives the stop/start cycles that clear provisioning_failures. */
+    gint64        last_start_us;
+    guint         cooldown_secs;
+    guint         cooldown_id;
 };
 
