CONFIG_DRM_PANEL_KINGDISPLAY_KD097D04=m
CONFIG_CROS_EC_SENSORHUB=m
CONFIG_PHY_ROCKCHIP_DPHY_RX0=y

# touchscreen support for rk3399-google-scarlet
# introduced via MR #3903
CONFIG_TOUCHSCREEN_ELAN=m

# a few fixes for rk3399-google-scarlet
# introduced via MR #7332
CONFIG_ROCKCHIP_RK3066_HDMI=y                                 
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=m
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=m

# initial support for rk3399-pinebook-pro
# introduced via MR #882
CONFIG_PHY_ROCKCHIP_DP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_ROCKCHIP_DW_MIPI_DSI2=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_HW_RANDOM_ROCKCHIP=m
