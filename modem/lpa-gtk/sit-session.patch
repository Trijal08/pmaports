+# SPDX-License-Identifier: GPL-3.0-only
+"""One unprivileged SIT helper per application, using private stdio pipes."""
+import atexit
+import json
+import os
+import shutil
+import subprocess
+import threading
+import weakref
+
+_sessions = weakref.WeakSet()
+MAX_LINE = 16 * 1024 * 1024
+
+
+class SitSessionError(RuntimeError):
+    pass
+
+
+class SitSession:
+    def __init__(self):
+        self.lock = threading.RLock()
+        self.process = None
+        executable = shutil.which("sit-lpa")
+        if not executable:
+            raise SitSessionError("The sit-lpa helper is not installed")
+        args = [executable, "--session"]
+        if os.path.exists("/run/sit-proxy/0.auth"):
+            args.append("--authorize")
+        self.process = subprocess.Popen(args, stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE, text=True, encoding="utf-8", bufsize=1)
+        _sessions.add(self)
+        try:
+            ready = self._read()
+            if ready.get("type") != "session" or ready.get("version") != 1:
+                payload = ready.get("payload", {})
+                raise SitSessionError(f"Cannot open modem session: {payload.get('data', ready)}")
+            self.slots = ready["slots"]
+            if not isinstance(self.slots, list) or any(type(n) is not int or n < 1 for n in self.slots):
+                raise SitSessionError("Invalid modem slot list")
+        except Exception:
+            self.close()
+            raise
+
+    def _read(self):
+        if self.process is None:
+            raise SitSessionError("Modem session closed; reopen the application")
+        line = self.process.stdout.readline(MAX_LINE + 1)
+        if not line:
+            raise SitSessionError("Modem session ended; reopen the application")
+        if len(line) > MAX_LINE:
+            raise SitSessionError("Modem session response is too large")
+        message = json.loads(line)
+        if not isinstance(message, dict):
+            raise SitSessionError("Invalid modem session response")
+        return message
+
+    def run_command(self, slot, args):
+        # Profile operations and the background notification worker must not
+        # interleave their APDU channels or consume each other's responses.
+        with self.lock:
+            finished = False
+            try:
+                if self.process is None:
+                    raise SitSessionError("Modem session closed; reopen the application")
+                self.process.stdin.write(json.dumps({"type": "command", "slot": slot, "args": args}) + "\n")
+                self.process.stdin.flush()
+                while True:
+                    message = self._read()
+                    if message.get("type") == "exit":
+                        finished = True
+                        if message.get("code") != 0:
+                            raise SitSessionError(f"lpac exited with status {message.get('code')}")
+                        return
+                    if message.get("type") not in ("lpa", "progress"):
+                        raise SitSessionError("Unexpected modem session message")
+                    yield message
+            except (OSError, ValueError) as error:
+                raise SitSessionError(str(error)) from error
+            finally:
+                # A cancelled consumer must not leave part of one reply for
+                # the next command. Fail closed instead of silently reopening.
+                if not finished:
+                    self.close()
+
+    def close(self):
+        process, self.process = self.process, None
+        if process is None:
+            return
+        try:
+            process.stdin.close()
+        except (OSError, ValueError):
+            pass
+        try:
+            process.wait(timeout=2)
+        except subprocess.TimeoutExpired:
+            process.terminate()
+            try:
+                process.wait(timeout=2)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait()
+        process.stdout.close()
+
+
+@atexit.register
+def close_sessions():
+    for session in list(_sessions):
+        session.close()
