@@ -18,14 +18,45 @@
 #include "mm-sit-ims.h"
 #include "mm-sit-protocol.h"
 
+/*
+ * Compare a built frame against the bytes a capture shows, which stop at the
+ * length the header declares. The builder then pads the payload out to a
+ * multiple of 8 with zeros, exactly as the vendor RIL does -- every one of the
+ * 1611 AP->CP frames in the reference capture is padded that way -- so the
+ * expectation here is the declared prefix plus a check that the tail is the
+ * padding and nothing else.
+ */
 static void
 assert_bytes (GByteArray  *actual,
               const guint8 *expected,
               gsize         expected_len)
 {
+    gsize pad = 0;
+
     g_assert_nonnull (actual);
-    g_assert_cmpuint (actual->len, ==, expected_len);
-    g_assert_cmpmem (actual->data, actual->len, expected, expected_len);
+    if (expected_len > 12)
+        pad = (8 - (expected_len - 12) % 8) % 8;
+    g_assert_cmpuint (actual->len, ==, expected_len + pad);
+    g_assert_cmpmem (actual->data, expected_len, expected, expected_len);
+    while (pad--)
+        g_assert_cmpuint (actual->data[expected_len + pad], ==, 0);
+}
+
+/*
+ * A frame's declared length, plus the zero padding that rounds its payload up
+ * to a multiple of 8. See assert_bytes() for why the two differ.
+ */
+static void
+assert_frame_len (GByteArray *frame,
+                  gsize       declared)
+{
+    gsize pad = 0;
+
+    g_assert_nonnull (frame);
+    if (declared > 12)
+        pad = (8 - (declared - 12) % 8) % 8;
+    g_assert_cmpuint (frame->data[4] | (((guint16) frame->data[5]) << 8), ==, declared);
+    g_assert_cmpuint (frame->len, ==, declared + pad);
 }
 
