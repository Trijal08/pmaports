+        }
+        eprintln!(
+            "sit-proxy: port {} client {}: replayed {} indication(s) the CP sent \
+             before anything was listening{}",
+            cfg.index,
+            id,
+            n,
+            if early.dropped > 0 {
+                format!(" ({} dropped, buffer full)", early.dropped)
+            } else {
+                String::new()
+            }
+        );
+        early.clear();
+    }
 }
 
