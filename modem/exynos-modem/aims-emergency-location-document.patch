+
+        // No IMSI, no presence URI -- better empty than malformed.
+        let anon = CarrierIdentity { imsi: String::new(), ..id.clone() };
+        assert!(resolve(&path, &DEVICE(), &anon).expect("resolve").geo_entity.is_empty());
+    }
