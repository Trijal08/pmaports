+    /// Every block of one reply carries the request's sequence, and the reply
+    /// ends with a bare envelope on the same sequence. Stock sends all 31
+    /// blocks of its multi-block read with sequence 6; incrementing per block
+    /// walks into the sequences the CP's next requests use, and the CP then
+    /// re-asks for ever.
+    #[test]
+    fn every_block_carries_the_requests_sequence() {
+        let dir = std::env::temp_dir().join(format!("gipc-seq-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let name = "seqtest.binarypb";
+        std::fs::write(dir.join(name), vec![7u8; 9000]).unwrap();
+
+        let req = GipcMessage {
+            r#type: Some(TYPE_REQUEST),
+            endpoint: Some(132),
+            service: Some(SVC_UECAP_FILE),
+            method: Some(0x5b78_66da),
+            payload: Some(
+                UecapFileReadRequest {
+                    size: 20000,
+                    block_size: 4000,
+                    file_dir: 1,
+                    file_name: name.to_string(),
+                }
+                .encode_to_vec(),
+            ),
+            sequence: Some(6),
+        };
+        let out = Gipc::new(dir.clone(), false).serve_uecap_file(&req);
+        std::fs::remove_dir_all(&dir).ok();
+
+        /* 9000 bytes at 4000 per block is 3 blocks, plus the closing envelope. */
+        assert_eq!(out.len(), 4);
+        for (n, frame) in out.iter().enumerate() {
+            let m = GipcMessage::decode(frame.as_slice()).unwrap();
+            assert_eq!(m.sequence, Some(6), "frame {} changed the sequence", n);
+            assert_eq!(m.service, Some(SVC_UECAP_FILE));
+        }
+        /* The first three carry data; the last closes with no payload. */
+        for frame in &out[..3] {
+            assert!(GipcMessage::decode(frame.as_slice()).unwrap().payload.is_some());
+        }
+        assert!(GipcMessage::decode(out[3].as_slice()).unwrap().payload.is_none());
+    }
+
