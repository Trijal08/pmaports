#!/bin/sh
# Re-bind the gadget when a cable arrives and nothing enumerates.
#
# dwc2_ovr_init() overrides B-session-valid so the session reads permanently
# valid - which is what makes a role-switch-only board work at all - but it
# also means attaching a cable raises no session interrupt, so nothing
# re-connects the gadget. Measured on the device, booting with the cable out:
#
#   17:57:21  pullup=OFF udc=not attached extconUSB=0
#   17:57:41  pullup=OFF udc=not attached extconUSB=1   <- cable in, port silent
#
# Re-driving the role switch is not enough. dwc2_drd_role_sw_set() calls only
# dwc2_hsotg_core_connect() for USB_ROLE_DEVICE, skipping the
# dwc2_hsotg_core_init_disconnected() that dwc2_hsotg_pullup() does first, so
# the core attaches without being set up and the host times out:
#
#   usb 1-1: new high-speed USB device number 37 using xhci_hcd
#   usb 1-1: device descriptor read/64, error -110
#
# soft_connect cannot be used either: dwc2_hsotg_pullup() returns early unless
# op_state is OTG_STATE_B_PERIPHERAL, so the write is silently dropped.
#
# Unbinding and re-binding the UDC runs udc_stop/udc_start, which does the full
# init - the same thing switching USB modes by hand was doing. Only done when
# the session is valid and the gadget still has not been reached, so an idle
# port is left alone.

# --once: called from udev the moment the PHY reports the session changing,
# so the port comes back without waiting for the next poll. The loop stays as
# a backstop for anything that does not raise an extcon event.
once=
[ "$1" = "--once" ] && once=1

udc_name=$(ls /sys/class/udc 2>/dev/null | head -1)
[ -n "$udc_name" ] || exit 0

session_valid() {
	for c in /sys/class/extcon/*/cable.*; do
		[ -e "$c/name" ] || continue
		[ "$(cat "$c/name" 2>/dev/null)" = "USB" ] || continue
		[ "$(cat "$c/state" 2>/dev/null)" = "1" ] && return 0
	done
	return 1
}

rebind() {
	for gadget in /sys/kernel/config/usb_gadget/*/UDC; do
		[ -e "$gadget" ] || continue
		[ -n "$(cat "$gadget" 2>/dev/null)" ] || continue
		echo "" >"$gadget" 2>/dev/null || continue
		sleep 1
		echo "$udc_name" >"$gadget" 2>/dev/null || :
	done
}

if [ -n "$once" ]; then
	# Give the host its own chance first; only step in if it gets nowhere.
	sleep 1
	role=$(cat /sys/class/usb_role/*/role 2>/dev/null)
	[ "$role" = "device" ] || exit 0
	state=$(cat "/sys/class/udc/$udc_name/state" 2>/dev/null)
	[ "$state" = "configured" ] && exit 0
	session_valid || exit 0
	rebind
	exit 0
fi

stale=0
while :; do
	sleep 1

	role=$(cat /sys/class/usb_role/*/role 2>/dev/null)
	[ "$role" = "device" ] || { stale=0; continue; }

	state=$(cat "/sys/class/udc/$udc_name/state" 2>/dev/null)
	if [ "$state" = "configured" ] || ! session_valid; then
		stale=0
		continue
	fi

	# A cable is present and the host still has not reached us. A fresh
	# attach enumerates in well under a second, so two misses is already
	# generous - any longer is just dead time the user sits through.
	stale=$((stale + 1))
	[ "$stale" -lt 2 ] && continue
	stale=0
	rebind
done
