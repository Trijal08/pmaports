_config="config-$_flavor.$arch"
source="
	$pkgname-$pkgver.tar.xz::$url/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
	misc.config
	$_config
	$_rocknix_patches
	$_rocknix_dts
	$_aw88166_patches
	disable-fan-on-boot.patch
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config

	# device-trees from ROCKNIX tree
	for dts in $_rocknix_dts; do
		cp "$srcdir/$(basename "$dts")" arch/arm64/boot/dts/qcom/
	done

	echo 'dtb-$(CONFIG_ARCH_QCOM) += cq8725s-ayn-odin3.dtb' >> arch/arm64/boot/dts/qcom/Makefile
	echo 'dtb-$(CONFIG_ARCH_QCOM) += sm8750-konkr-pf-elite.dtb' >> arch/arm64/boot/dts/qcom/Makefile
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
		"$pkgdir/boot/linux.efi"

	make LLVM=1 zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm "$pkgdir"/usr/lib/modules/*/build

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

