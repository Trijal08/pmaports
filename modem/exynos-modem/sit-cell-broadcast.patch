+/// Build an `SMS_BROADCAST_ACTIVATION` (0x0107).
+///
+/// `activate` non-zero turns reception on. The wire value is inverted -- zero
+/// is on -- which is the downstream RIL's polarity and what the captured
+/// Android sends; the caller does not see that.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_sit_build_sms_broadcast_activation(
+    token: u16,
+    activate: u8,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    emit_bytes(
+        sit::build_sms_broadcast_activation(token, activate != 0),
+        out,
+        out_len,
+    )
+}
