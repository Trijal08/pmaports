+    /// A key press is three bytes, and the digit is ASCII -- the bug worth
+    /// guarding is sending 2 where the CP wants '2'.
+    #[test]
+    fn dtmf_sends_the_digit_as_ascii() {
+        let f = build_send_dtmf(7, 0, DtmfType::Start, '2').unwrap();
+        assert_eq!(f.len(), 15);
+        assert_eq!(&f[12..], &[0x00, 0x01, 0x32]);
+
+        // Key up carries the same digit, so the CP knows which tone ended.
+        let f = build_send_dtmf(8, 3, DtmfType::Stop, '#').unwrap();
+        assert_eq!(&f[12..], &[0x03, 0x02, b'#']);
+
+        // Lower-case letter keys are the same keys.
+        let f = build_send_dtmf(9, 0, DtmfType::Burst, 'b').unwrap();
+        assert_eq!(&f[12..], &[0x00, 0x00, b'B']);
+
+        for bad in ['e', ' ', '+', 'Z'] {
+            assert!(build_send_dtmf(1, 0, DtmfType::Start, bad).is_err());
+        }
+    }
