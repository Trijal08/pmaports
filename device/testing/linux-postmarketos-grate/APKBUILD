# Co-Maintainer: Svyatoslav Ryhel <clamor95@gmail.com>
maintainer="Robert Eckelmann <longnoserob@postmarketos.org>"
pkgname=linux-postmarketos-grate
pkgver=7.3.1
pkgrel=0
_commit="eab1ff1e1eefc77e0adb3384f45dc3aadd9f5714"
pkgdesc="Linux kernel with experimental patches for Tegra"
url="https://codeberg.org/libre-tegra/linux"
arch="armv7"
license="GPL-2.0-only"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"
# Source
_tag="stable"
_carch="arm"
source="$pkgname-$_tag.tar.gz::https://codeberg.org/libre-tegra/linux/archive/$_commit.tar.gz
	config-${pkgname#linux-}.$arch
"
builddir="$srcdir/linux"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-uefi
"

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor' and '_config'.
_config="config-${pkgname#linux-}"
_flavor="${pkgname#linux-}"

prepare() {
	default_prepare
	cp "$srcdir"/config-${pkgname#linux-}.$arch .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

sha512sums="
