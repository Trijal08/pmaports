# Maintainer: Trijal Saha <trijalsaha2012@gmail.com>
pkgname=glibc-sysroot
pkgver=2.41
pkgrel=0
pkgdesc="Self-contained glibc runtime under /opt for prebuilt game ports"
url="https://postmarketos.org/"
# Prebuilt aarch64 binaries; there is nothing to compile for other arches.
arch="aarch64"
license="LGPL-2.1-or-later AND MIT AND GPL-2.0-or-later"

# !tracedeps is the important one. These are glibc's own shared objects, so
# tracing would make the package depend on so:libc.so.6, so:libm.so.6 and
# friends, which nothing in Alpine provides - and would advertise this
# package as PROVIDING them, which would let apk satisfy an unrelated
# package's glibc dependency with a tree that is not on the library path.
# The sysroot is reached only through port-launch, never through ld.so.conf.
#
# !strip keeps the binaries byte-identical to the ones validated on device.
options="!check !strip !tracedeps !fhs"

# A curated closure of an aarch64 glibc root (glibc 2.41, Mesa 25.0.7,
# SDL 2.32), built by build-sysroot.py walking DT_NEEDED from the binaries
# the ports actually run. It is a binary artefact by nature: the point is
# to run prebuilt glibc ports unmodified, and rebuilding these libraries
# from source under musl would defeat that.
#
# The donor is DEBIAN, from official packages - not an ArchR card as it
# was through 2.40, and not Arch either. Two reasons, both learned the
# hard way:
#
#   * ArchR drives this GPU with the proprietary Mali blob, so the Mesa on
#     that card was a stripped side-installation it never used itself - no
#     llvmpipe, no dri symlinks, no GBM backend. Ports rendering through
#     Wayland never noticed; the first KMSDRM port did.
#   * Arch's Mesa is compiled against a newer glibc than the ports bundle.
#     McpeLauncherV2 ships Debian 13's glibc 2.41 and puts its own runtime
#     first on the library path, so Arch's Mesa 26.2 died with
#     "version `GLIBC_2.43' not found" the moment it was dlopen'd.
#     PortMaster ports are built on Debian/Ubuntu; matching that removes
#     the whole class of problem. Debian's Mesa needs only GLIBC_2.38.
#
# Regenerating it (see ~/Documents/R36S-K36/portmaster/):
#   fetch-debian-sysroot.py donor <package>...   # official .debs + deps
#   build-sysroot.py donor sysroot <binaries and dlopen'd libs...>
#   mv sysroot/usr/lib/aarch64-linux-gnu/* sysroot/usr/lib/   # flatten multiarch
#   cp -a donor/usr/lib/aarch64-linux-gnu/{dri,gbm,pulseaudio,alsa-lib,spa-0.2,pipewire-0.3} sysroot/usr/lib/
#   cp -a donor/usr/share/{glvnd,drirc.d,alsa} sysroot/usr/share/
#   cp -a donor/usr/sbin/ldconfig sysroot/usr/bin/
#   tar -czf glibc-sysroot-$pkgver.tar.gz --transform 's,^\./,glibc-sysroot-$pkgver/,' -C sysroot .
#
# Three libraries have no Debian equivalent and are carried forward from
# the 2.40 tree: libjpeg.so.8 and libtinfow.so.6 (Arch sonames some ports
# link), and libisl.so.22 (Ubuntu 20.04 vintage, for the compiler
# render96ex ships).
#
# dlopen'd libraries are invisible to a DT_NEEDED walk and must be named
# explicitly. The set that matters here, each found by something failing:
#   usr/lib/gbm/dri_gbm.so          libgbm's backend, dlopen'd from a
#     compiled-in ${libdir}/gbm. Miss it and eglInitialize on the GBM
#     platform fails with EGL_NOT_INITIALIZED while surfaceless EGL still
#     reports 130 configs - it reads as a broken driver, not a missing
#     file. port-launch must also set GBM_BACKENDS_PATH, or the compiled-in
#     path finds Alpine's MUSL backend instead.
#   usr/lib/dri/*_dri.so            the whole directory, symlinks included
#     (they all point at libdril_dri.so; copying only the target leaves
#     every driver name unresolvable)
#   libEGL_mesa / libGLX_mesa       glvnd vendor libraries
#   libGLESv2 / libGLESv1_CM        glvnd dispatches GLES separately from GL
#   libxkbcommon                    SDL's Wayland backend
#   libwebp / libwebpdemux          SDL2_image
#   libwavpack / libxmp             SDL2_mixer
#   libnss_files                    glibc user lookups
#   libtheoradec.so.1 / libtheoraenc / libtheora.so.0
#     PortMaster's Love 11.5 runtime links libtheoradec.so.1. Alpine ships
#     theora 1.2.0, whose soname is .so.2, so the host copy cannot satisfy
#     it - the port only ever worked because glibc's loader falls back to
#     /usr/lib and Alpine used to ship .so.1. From Ubuntu ports, like the
#     GCC runtime above.
#   libisl.so.22 / libmpc / libmpfr / libgmp
#     Not dlopen'd - needed by a compiler a PORT ships. render96ex extracts
#     its assets by building four host tools with its own bundled gcc, which
#     expects the Ubuntu runtime its binaries were built against. isl 22 in
#     particular is Ubuntu 20.04 vintage, so it comes from ports.ubuntu.com
#     rather than the donor root (Arch ships .23).
# plus the data files no ELF walk can see: the glvnd vendor JSON, drirc,
# and the ALSA/SPA/PipeWire plugin trees.
source="glibc-sysroot-$pkgver.tar.gz"

package() {
	install -dm755 "$pkgdir"/opt/glibc-sysroot
	cp -a "$builddir"/. "$pkgdir"/opt/glibc-sysroot/

	# No ldconfig here: port-launch builds the cache at first launch with
	# the sysroot's OWN ldconfig, into the user's ~/.cache. Running the
	# host's musl ldconfig over these libraries would produce nothing
	# usable, and a root-owned cache inside /opt could not be refreshed
	# when a port is added.

	# Ports probe the Debian multiarch triplet before anything else - see
	# McpeLauncherV2's GPU search order, which lists
	# /usr/lib/aarch64-linux-gnu ahead of /usr/lib. Alpine leaves that path
	# empty, so without this they fall through to Alpine's MUSL Mesa and
	# load it into a glibc process, which survives until the first
	# allocator crossing and then dies on "free(): invalid pointer" inside
	# libgallium. Pointing the triplet at the sysroot keeps such a port on
	# one libc. Nothing in Alpine looks in this directory.
	install -dm755 "$pkgdir"/usr/lib
	ln -s /opt/glibc-sysroot/usr/lib "$pkgdir"/usr/lib/aarch64-linux-gnu

	# Rockchip ports built against the vendor Mali stack dlopen GBM under
	# the blob's name. Mesa's libgbm exports the same API, so the name only
	# has to resolve - mcpelauncher-client's patched SDL asks for exactly
	# this one and reports "kmsdrm not available" without it.
	ln -s libgbm.so.1 \
		"$pkgdir"/opt/glibc-sysroot/usr/lib/libmali-bifrost-g31-rxp0-gbm.so
}

sha512sums="
903161b32b24163cd7d22db5243bfcf5dd680386fb06156f8036af3cf0e356229fe80ba4a13e3dce3d56a6eb8fff7caa1bc0f929cb6d93828c25d832217a2622  glibc-sysroot-2.41.tar.gz
"
