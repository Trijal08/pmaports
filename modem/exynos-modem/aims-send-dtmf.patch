+/// `SEND_DTMF` (0x0d0a) -- press or release a DTMF key on an established call.
+///
+/// `kind` is 0 for one self-timed tone, 1 for key down and 2 for key up.
+/// `digit` is the key's ASCII character, not its value: pass `'2'`, not 2.
+/// Both are rejected rather than guessed at when out of range.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_aims_build_send_dtmf(
+    token: u16,
+    call_id: u8,
+    kind: u8,
+    digit: u8,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    use aims::call::DtmfType;
+
+    let kind = match kind {
+        0 => DtmfType::Burst,
+        1 => DtmfType::Start,
+        2 => DtmfType::Stop,
+        _ => return status_from_err(&SitError::Malformed("dtmf type")),
+    };
+    emit_result(
+        aims::call::build_send_dtmf(token, call_id, kind, digit as char),
+        out,
+        out_len,
+    )
+}
