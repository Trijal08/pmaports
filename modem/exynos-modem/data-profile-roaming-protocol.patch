+/// `SET_DATA_PROFILE` with the carrier's roaming protocol named separately;
+/// see `build_set_data_profile_roaming`. The older symbol above copies the home
+/// protocol and is kept so nothing that links against it has to change.
+#[no_mangle]
+#[allow(clippy::too_many_arguments)]
+pub unsafe extern "C" fn samsung_sit_build_set_data_profile_roaming(
+    token: u16,
+    apn: *const c_char,
+    pdp: SamsungSitPdpType,
+    roaming_pdp: SamsungSitPdpType,
+    apn_types: u32,
+    bearers: u32,
+    auth: *const SamsungSitApnAuth,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    let apn = match cstr(apn) {
+        Ok(a) => a,
+        Err(s) => return s,
+    };
+    let auth = match apn_auth(auth) {
+        Ok(a) => a,
+        Err(s) => return s,
+    };
+    emit_result(
+        sit::build_set_data_profile_roaming(
+            token,
+            apn,
+            pdp.into(),
+            roaming_pdp.into(),
+            apn_types,
+            bearers,
+            &auth,
+        ),
+        out,
+        out_len,
+    )
+}
