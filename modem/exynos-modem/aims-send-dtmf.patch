+/// Which half of a key press `SEND_DTMF` carries, in the CP's own numbering.
+///
+/// `ImsCall` picks between them: `sendDtmf` sends [`DtmfType::Burst`] and lets
+/// the CP time the tone, while the dialler's key handler sends
+/// [`DtmfType::Start`] on key-down and [`DtmfType::Stop`] on key-up. The
+/// captured call uses the second pair, about 60 ms apart.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[repr(u8)]
+pub enum DtmfType {
+    /// One complete tone, the CP choosing how long to hold it.
+    Burst = 0,
+    /// Key down. The tone runs until a [`DtmfType::Stop`] arrives.
+    Start = 1,
+    /// Key up.
+    Stop = 2,
+}
+
+/// The sixteen keys a DTMF keypad can send: RFC 4733's digits, letters and
+/// the two symbols. Anything else is not a tone and the CP has no encoding
+/// for it.
+fn is_dtmf_digit(digit: char) -> bool {
+    digit.is_ascii_digit() || matches!(digit, 'A'..='D' | '*' | '#')
+}
+
+/// `SEND_DTMF` (0x0d0a) -- press or release a DTMF key on an established call.
+///
+/// Layout from `RilReqSendDtmf.getBytes()` in `ShannonIms.apk`: call id, type
+/// and digit, one byte each. The digit field is a Java `char` written with
+/// `writeByte`, so it goes out as its *ASCII* value -- `'2'` is 0x32, not 2.
+/// The captured call confirms it: the keys typed into a voicemail prompt were
+/// logged as their characters, and the prompt acted on them.
+pub fn build_send_dtmf(
+    token: u16,
+    call_id: u8,
+    kind: DtmfType,
+    digit: char,
+) -> Result<Vec<u8>, SitError> {
+    // A/B/C/D are the same keys either way, and the interface above does not
+    // normalise them.
+    let digit = digit.to_ascii_uppercase();
+    if !is_dtmf_digit(digit) {
+        return Err(SitError::Malformed("not a DTMF digit"));
+    }
+    Ok(frame(
+        msg_id::SEND_DTMF,
+        token,
+        &[call_id, kind as u8, digit as u8],
+    ))
+}
