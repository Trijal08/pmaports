+/// As `samsung_sit_build_device_info`, plus the fourth 32-byte field of 0x0922
+/// (a vendor software-version string; stock komodo sends `17`).
+///
+/// A separate entry point rather than a signature change, so that an older
+/// ModemManager keeps linking against the same library.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_sit_build_device_info_sw(
+    token: u16,
+    model: *const c_char,
+    build: *const c_char,
+    codename: *const c_char,
+    sw_version: *const c_char,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    let model = match cstr(model) {
+        Ok(a) => a,
+        Err(s) => return s,
+    };
+    let build = match cstr(build) {
+        Ok(a) => a,
+        Err(s) => return s,
+    };
+    let codename = match cstr(codename) {
+        Ok(a) => a,
+        Err(s) => return s,
+    };
+    let sw_version = match cstr(sw_version) {
+        Ok(a) => a,
+        Err(s) => return s,
+    };
+    emit_result(
+        sit::build_device_info(token, model, build, codename, sw_version),
         out,
         out_len,
     )
