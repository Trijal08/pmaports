+        // A stated domain wins, exactly as it does for tag 778.
+        let stated = CarrierIdentity { isim_domain: "ims.example.net".into(), ..id.clone() };
+        assert_eq!(resolve(&path, &DEVICE(), &stated).expect("resolve").geo_entity,
