--- a/crates/samsung-sit-ffi/src/aims.rs	2026-11-09 17:22:50.268046486 -0500
+++ b/crates/samsung-sit-ffi/src/aims.rs	2026-11-09 17:23:09.874220864 -0500
@@ -427,6 +427,32 @@
     )
 }
 
+/// `CALL_MANAGE` (0x0d09) -- hold, resume, or merge into a conference.
+///
+/// `op` is 1 hold, 2 resume, 6 conference. A conference is addressed to call
+/// id 0xff, every call. The captured dialler holds the active call and only
+/// then sends the conference, so send the pair rather than the merge alone.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_aims_build_call_manage(
+    token: u16,
+    op: u8,
+    call_id: u8,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    let op = match op {
+        1 => aims::CallManageOp::Hold,
+        2 => aims::CallManageOp::Resume,
+        6 => aims::CallManageOp::Conference,
+        _ => return SamsungSitStatus::ArgOutOfRange,
+    };
+    emit_result(
+        Ok(aims::build_call_manage(token, op, call_id)),
+        out,
+        out_len,
+    )
+}
+
