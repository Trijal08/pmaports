From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] samsung-sit: do not deadlock cancelling a SIT command

Cancelling a request that is still in flight hung the whole daemon. Caught
on hardware: ModemManager stopped answering D-Bus at 15:56:10, every mmcli
returned "couldn't create manager: Timeout was reached", and systemd still
called the unit active with zero restarts. gdb on the live process:

    g_main_context dispatch
      -> pending_cancelled            (our cancelled handler)
        -> pending_complete
          -> g_hash_table_remove
            -> pending_free
              -> g_cancellable_disconnect   <-- blocks forever

g_cancellable_disconnect() waits for the cancelled handlers to return, so
calling it from inside one is a self-deadlock -- on whichever thread did the
cancelling, which here was the main loop. The trigger was the IMS stack
cancelling its pending work after 60 s with no supporting RAT; any cancel
with a command outstanding does it.

pending_cancelled() now drops the handler with
g_signal_handler_disconnect(), which is the non-blocking one and what GLib
documents for this case, and clears the id so pending_free() leaves it be.

The second half was next to it: g_cancellable_connect() was called *before*
the hash-table insert. On an already-cancelled cancellable it invokes the
handler synchronously, so pending_complete() ran against a token that was
not in the table yet -- the remove found nothing, pending_free() never ran,
and the submit path then inserted an already-completed Pending with a live
timeout source behind it and wrote the request anyway. The connect moved
after the insert, and its return value is now checked instead of stored
blindly, because a 0 means the Pending was freed before it returned.

Two regression tests, /MM/sit/port/cancelled-command and
/MM/sit/port/precancelled-command. Neither asserts on the deadlock as such:
without the fix the first one never returns from g_main_loop_run() and the
suite timeout is what reports it (verified -- it hangs, and passes with).

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XzdpD3EoDuxNrEps73GD56
diff -ruN a/src/plugins/samsung-sit/mm-port-serial-sit.c b/src/plugins/samsung-sit/mm-port-serial-sit.c
--- a/src/plugins/samsung-sit/mm-port-serial-sit.c	2026-11-08 14:05:41.979614930 -0500
+++ b/src/plugins/samsung-sit/mm-port-serial-sit.c	2026-11-08 16:06:17.226173960 -0500
@@ -161,6 +161,24 @@
 static void
 pending_cancelled (GCancellable *cancellable, Pending *pending)
 {
+    /*
+     * This runs inside the cancellable's own "cancelled" emission, and
+     * completing the request retires the token, which frees the Pending.
+     * g_cancellable_disconnect() waits for the cancelled handlers to return,
+     * so pending_free() must not be allowed to reach it from here or the
+     * thread deadlocks against itself -- main loop included, which takes the
+     * whole daemon down with it: no D-Bus, no modems, and a live process that
+     * systemd still calls active.
+     *
+     * Drop the handler the non-blocking way instead and clear the id so
+     * pending_free() leaves it alone. The id is zero when g_cancellable_connect()
+     * ran us synchronously because the cancellable was already cancelled.
+     */
+    if (pending->cancelled_id) {
+        g_signal_handler_disconnect (cancellable, pending->cancelled_id);
+        pending->cancelled_id = 0;
+    }
+
     pending_complete (pending, NULL,
                       g_error_new (G_IO_ERROR, G_IO_ERROR_CANCELLED,
                                    "SIT request cancelled"));
@@ -336,17 +354,33 @@
     pending->timeout_id = g_timeout_add_seconds (timeout_seconds,
                                                  (GSourceFunc) pending_timed_out,
                                                  pending);
+    g_hash_table_insert (self->priv->pending, GUINT_TO_POINTER ((guint) token), pending);
+
     /*
      * The cancellable is held here rather than given to the GTask, because
      * cancelling has to retire the token as well and only this knows how.
+     *
+     * Connected *after* the insert, and the result is checked rather than
+     * stored blindly: if the cancellable is already cancelled,
+     * g_cancellable_connect() runs pending_cancelled() synchronously and
+     * returns 0. That completes the request and retires the token, so the
+     * Pending is already freed when it returns -- assigning to it, or sending
+     * the request, would be a use-after-free. Connecting before the insert
+     * was worse still: the remove found nothing, so pending_free() never ran
+     * and the request went out anyway with a completed task and a live
+     * timeout behind it.
      */
     if (cancellable) {
+        gulong cancelled_id;
+
         pending->cancellable = g_object_ref (cancellable);
-        pending->cancelled_id = g_cancellable_connect (cancellable,
-                                                       (GCallback) pending_cancelled,
-                                                       pending, NULL);
+        cancelled_id = g_cancellable_connect (cancellable,
+                                              (GCallback) pending_cancelled,
+                                              pending, NULL);
+        if (!cancelled_id)
+            return;
+        pending->cancelled_id = cancelled_id;
     }
-    g_hash_table_insert (self->priv->pending, GUINT_TO_POINTER ((guint) token), pending);
 
     /* mm_port_serial_send() still logs the write through the debug_log vfunc
      * below, so the request lines read exactly as they did before. */
diff -ruN a/src/plugins/samsung-sit/tests/test-sit-protocol.c b/src/plugins/samsung-sit/tests/test-sit-protocol.c
--- a/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-08 14:05:42.004334821 -0500
+++ b/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-08 16:07:00.973379045 -0500
@@ -1567,6 +1567,136 @@
     g_main_loop_quit (ctx->loop);
 }
 
+/*
+ * Cancelling a command that is still in flight. Both halves of this used to
+ * take the daemon down.
+ *
+ * The cancelled handler completes the request, which retires the token and so
+ * frees the Pending, and pending_free() called g_cancellable_disconnect() --
+ * which waits for the cancelled handlers to return. Called from inside one,
+ * that is a self-deadlock on whichever thread cancelled: with the main loop
+ * there, ModemManager stops answering D-Bus entirely while systemd still
+ * reports it active. Seen on hardware when the IMS stack cancelled its
+ * pending work after 60 s without a supporting RAT.
+ *
+ * Nothing is asserted about a deadlock directly -- the loop simply never
+ * returns and the suite's own timeout is what reports it.
+ */
+static void
+port_test_cancel_ready (MMPortSerialSit *port,
+                        GAsyncResult    *res,
+                        PortTestContext *ctx)
+{
+    g_autoptr(MMSitMessage) response = NULL;
+    g_autoptr(GError)       error = NULL;
+
+    response = mm_port_serial_sit_command_finish (port, res, &error);
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+    g_assert_null (response);
+    ctx->command_completed = TRUE;
+    g_main_loop_quit (ctx->loop);
+}
+
+static gboolean
+port_test_cancel_now (GCancellable *cancellable)
+{
+    g_cancellable_cancel (cancellable);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+test_port_cancelled_command (void)
+{
+    PortTestContext            ctx = { 0 };
+    gint                       sockets[2];
+    guint                      timeout_id;
+    g_autoptr(GCancellable)    cancellable = NULL;
+    g_autoptr(MMPortSerialSit) port = NULL;
+    g_autoptr(GByteArray)      request = NULL;
+    g_autoptr(GError)          error = NULL;
+
+    g_assert_cmpint (socketpair (AF_UNIX, SOCK_STREAM, 0, sockets), ==, 0);
+    ctx.peer_fd = sockets[1];
+    ctx.loop = g_main_loop_new (NULL, FALSE);
+
+    port = MM_PORT_SERIAL_SIT (g_object_new (MM_TYPE_PORT_SERIAL_SIT,
+                                             MM_PORT_DEVICE, "test-sit-cancel",
+                                             MM_PORT_SUBSYS, MM_PORT_SUBSYS_WWAN,
+                                             MM_PORT_TYPE, MM_PORT_TYPE_SIT,
+                                             MM_PORT_SERIAL_FD, sockets[0],
+                                             NULL));
+    g_assert_true (mm_port_serial_open (MM_PORT_SERIAL (port), &error));
+    g_assert_no_error (error);
+
+    /* Nobody answers, so the request is still outstanding when it is cancelled. */
+    cancellable = g_cancellable_new ();
+    request = mm_sit_request_new_query (MM_SIT_MESSAGE_GET_SIM_STATUS,
+                                        mm_port_serial_sit_next_token (port));
+    mm_port_serial_sit_command (port, request, 30, cancellable,
+                                (GAsyncReadyCallback) port_test_cancel_ready, &ctx);
+    g_idle_add ((GSourceFunc) port_test_cancel_now, cancellable);
+    timeout_id = g_timeout_add_seconds (5, (GSourceFunc) port_test_timeout, &ctx);
+    g_main_loop_run (ctx.loop);
+
+    if (!ctx.timed_out)
+        g_source_remove (timeout_id);
+    mm_port_serial_close (MM_PORT_SERIAL (port));
+    close (ctx.peer_fd);
+    g_main_loop_unref (ctx.loop);
+
+    g_assert_false (ctx.timed_out);
+    g_assert_true (ctx.command_completed);
+}
+
+/*
+ * A cancellable that is *already* cancelled. g_cancellable_connect() then runs
+ * the handler synchronously and returns 0, so the Pending is freed before the
+ * submit path returns -- it must neither store the id into it nor write the
+ * request.
+ */
+static void
+test_port_command_with_a_cancelled_cancellable (void)
+{
+    PortTestContext            ctx = { 0 };
+    gint                       sockets[2];
+    guint                      timeout_id;
+    g_autoptr(GCancellable)    cancellable = NULL;
+    g_autoptr(MMPortSerialSit) port = NULL;
+    g_autoptr(GByteArray)      request = NULL;
+    g_autoptr(GError)          error = NULL;
+
+    g_assert_cmpint (socketpair (AF_UNIX, SOCK_STREAM, 0, sockets), ==, 0);
+    ctx.peer_fd = sockets[1];
+    ctx.loop = g_main_loop_new (NULL, FALSE);
+
+    port = MM_PORT_SERIAL_SIT (g_object_new (MM_TYPE_PORT_SERIAL_SIT,
+                                             MM_PORT_DEVICE, "test-sit-precancel",
+                                             MM_PORT_SUBSYS, MM_PORT_SUBSYS_WWAN,
+                                             MM_PORT_TYPE, MM_PORT_TYPE_SIT,
+                                             MM_PORT_SERIAL_FD, sockets[0],
+                                             NULL));
+    g_assert_true (mm_port_serial_open (MM_PORT_SERIAL (port), &error));
+    g_assert_no_error (error);
+
+    cancellable = g_cancellable_new ();
+    g_cancellable_cancel (cancellable);
+    request = mm_sit_request_new_query (MM_SIT_MESSAGE_GET_SIM_STATUS,
+                                        mm_port_serial_sit_next_token (port));
+    mm_port_serial_sit_command (port, request, 30, cancellable,
+                                (GAsyncReadyCallback) port_test_cancel_ready, &ctx);
+    timeout_id = g_timeout_add_seconds (5, (GSourceFunc) port_test_timeout, &ctx);
+    g_main_loop_run (ctx.loop);
+
+    if (!ctx.timed_out)
+        g_source_remove (timeout_id);
+    mm_port_serial_close (MM_PORT_SERIAL (port));
+    close (ctx.peer_fd);
+    g_main_loop_unref (ctx.loop);
+
+    g_assert_false (ctx.timed_out);
+    g_assert_true (ctx.command_completed);
+}
+
 static void
 test_port_drops_a_stale_response (void)
 {
@@ -3590,6 +3720,9 @@
     g_test_add_func ("/MM/sit/port/command-and-indication", test_port_command_and_indication);
     g_test_add_func ("/MM/sit/port/stale-response", test_port_drops_a_stale_response);
     g_test_add_func ("/MM/sit/port/queued-commands", test_port_answers_queued_commands);
+    g_test_add_func ("/MM/sit/port/cancelled-command", test_port_cancelled_command);
+    g_test_add_func ("/MM/sit/port/precancelled-command",
+                     test_port_command_with_a_cancelled_cancellable);
     g_test_add_func ("/MM/sit/client/connect-sequence", test_client_connect_sequence);
     g_test_add_func ("/MM/sit/client/sim-cache-refresh", test_client_sim_cache_refresh);
     g_test_add_func ("/MM/sit/ims/config-defaults", test_ims_config_defaults);
