+/*
+ * Record the modem-wide attach APN so STEP_ATTACH_REFRESH can re-send it.
+ * The modem resolves it once, before radio-on, and hands it here.
+ */
+void
+mm_sit_ims_set_attach_apn (MMSitIms    *self,
+                           const gchar *apn,
+                           guint8       pdp,
+                           guint8       pcscf)
+{
+    g_return_if_fail (MM_IS_SIT_IMS (self));
+
+    if (!g_strcmp0 (self->priv->attach_apn, apn) &&
+        self->priv->attach_pdp == pdp &&
+        self->priv->attach_pcscf == pcscf)
+        return;
+
+    g_free (self->priv->attach_apn);
+    self->priv->attach_apn = g_strdup (apn);
+    self->priv->attach_pdp = pdp;
+    self->priv->attach_pcscf = pcscf;
+}
