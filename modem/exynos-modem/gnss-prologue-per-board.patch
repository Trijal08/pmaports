+        // not go away just because nothing has it open yet.
+        let (client, server) = UnixStream::pair().unwrap();
+        server.set_nonblocking(true).unwrap();
+        let mut peer = Peer {
+            io: File::from(OwnedFd::from(server)),
+            output: VecDeque::new(),
+            read_open: false,
+            doomed: false,
+            persistent: true,
+            attached: true,
+        };
+        drop(client);
+        service_peer(&mut peer, libc::POLLHUP);
+        assert!(!peer.doomed);
+        service_peer(&mut peer, libc::POLLERR);
+        assert!(!peer.doomed);
+    }
 }
