# Maintainer: Trijal Saha <trijalsaha2012@gmail.com>
pkgname=postmarketos-ui-emulationstation
pkgver=1
pkgrel=20
pkgdesc="(Wayland) EmulationStation emulator frontend, fullscreen under cage"
url="https://postmarketos.org/"
arch="all"
license="GPL-3.0-or-later"
options="!check pmb:drm pmb:default-openrc pmb:support-openrc pmb:support-systemd"

# abuild moves usr/lib/udev into this via default_udev, with install_if on
# udev - the same split rockchip-r36s-mapper uses for its rules.
subpackages="$pkgname-udev"
# sudo-virt rather than sudo: postmarketos-base recommends sudo-rs, and
# the two real implementations conflict over cmd:sudo/sudoedit/visudo.
# Both provide sudo-virt, so the image keeps whichever one base picked.
# coreutils, findutils, unzip, zip: game ports are written against a GNU/glibc
# userland and call options BusyBox does not have. They fail silently,
# because the callers redirect stderr, and surface as empty data rather
# than an error. In McpeLauncherV2 alone: the APK browser runs
# "ls --time-style=" and renders an empty directory, the version list runs
# "find -printf" and renders nothing, and extract_apk.sh verifies the game
# library with "unzip -Z1" and reports libminecraftpe.so missing from an
# APK that contains it. The GNU builds install alongside the BusyBox
# applets rather than replacing them. zip has no BusyBox applet at all -
# a port that repacks an archive gets "command not found" - so it is here
# pre-emptively rather than after the next silent failure.
# GNU rather than uutils-coreutils: the ports do not just call these, they
# parse their exact output - main.lua matches ls -la column by column - and
# GNU is the implementation every PortMaster host ships and these scripts
# were written against.
# postmarketos-usb-moded: brings usb-signaller (which owns com.meego.usb_moded
# on the system bus), umtprd and the default profile. Nothing else in the image
# pulls it in - only the gnome-mobile, phosh and plasma-mobile UIs list it - so
# without this a fresh flash has no USB mode switching at all: the ES menu entry
# reads UNAVAILABLE, MTP does not exist, and host mode is unreachable.
# Not usb-moded itself: it is a second implementation of the same bus name, its
# Alpine package installs the unit to /usr/lib/systemd/service/ instead of
# /usr/lib/systemd/system/ so it never starts anyway, and usb-signaller is the
# one postmarketOS actually runs.
# dbus: the menu shells out to dbus-send.
depends="
	keyd
	sudo-virt
	postmarketos-usb-moded
	dbus
	emulationstation
	postmarketos-base-ui-cage
	bash
	portmaster-compat
	coreutils
	findutils
	unzip
	zip
	ppsspp
	gzdoom
	freedoom
	retroarch
	"
source="
	10-emulationstation.sh
	99-keyd-ignore-pointer.rules
	keyd-default.conf
	r36s-volume
	51-default-sink-volume.conf
	51-min-quantum.conf
	emulationstation-shutdown.sudoers
	es_systems.cfg
	99-backlight-permissions.rules
	gzdoom.ini
	unudhcpd-rebind.conf
	"
# https://gitlab.postmarketos.org/postmarketOS/pmbootstrap/-/issues/2347
# "input" is required: the r36s-mapper exposes a uinput node (a virtual
# "Nintendo Switch Pro Controller")
# owned root:input 0660, and SDL2 reads joysticks straight from /dev/input,
# not through Wayland. Without this the UI renders but no button works.
_pmb_groups="seat input"
# Mirrors the libretro cores ArchR ships on this hardware, reduced to what
# Alpine actually packages (61 of 122; the rest have no aport). A few map
# to a near equivalent -- snes9x2010 -> snes9x, mame2003_plus -> mame2003,
# and two are dropped for having no aarch64 build at all:
# libretro-mupen64plus (parallel-n64 covers N64) and libretro-yabause
# (beetle-saturn covers Saturn).
# fbalpha2019 -> fbneo, mupen64plus_next -> mupen64plus, and so on.
# PortMaster's Python UI (pugwash) needs SDL2_mixer/ttf/image; glfw is for
# GLFW-based ports such as re3. The ports themselves are prebuilt glibc
# binaries and run against the real glibc in portmaster-compat, not under
# musl - so no symbol shim is involved. Verified on device with gptokeyb
# and the Love2D 11.5 runtime.
# standalone: Alpine has no libretro core for these
_pmb_recommends="
	retroarch-joypad-autoconfig
	libtheora
	mesa-demos
	glfw
	sdl2_mixer
	sdl2_ttf
	sdl2_image
	es-theme-art-book-next
	retroarch
	gzdoom
	ppsspp
	libretro-81
	libretro-atari800
	libretro-beetle-lynx
	libretro-beetle-ngp
	libretro-beetle-pce-fast
	libretro-beetle-pcfx
	libretro-beetle-supergrafx
	libretro-beetle-vb
	libretro-beetle-wswan
	libretro-beetle-saturn
	libretro-bluemsx
	libretro-bsnes
	libretro-cap32
	libretro-core-info
	libretro-crocods
	libretro-daphne
	libretro-database
	libretro-desmume
	libretro-dolphin
	libretro-dosbox
	libretro-fbneo
	libretro-fceumm
	libretro-flycast
	libretro-fmsx
	libretro-freechaf
	libretro-freeintv
	libretro-fuse
	libretro-gambatte
	libretro-gearboy
	libretro-genesis-plus-gx
	libretro-gpsp
	libretro-gw
	libretro-handy
	libretro-hatari
	libretro-mame2003
	libretro-melonds
	libretro-mgba
	libretro-mu
	libretro-neocd
	libretro-nestopia
	libretro-o2em
	libretro-opera
	libretro-parallel-n64
	libretro-pcsx-rearmed
	libretro-picodrive
	libretro-pokemini
	libretro-prosystem
	libretro-quicknes
	libretro-sameboy
	libretro-scummvm
	libretro-snes9x
	libretro-stella2014
	libretro-tgbdual
	libretro-theodore
	libretro-tyrquake
	libretro-uzem
	libretro-vba-next
	libretro-vbam
	libretro-vecx
	libretro-virtualjaguar
	"

package() {
	# cage-ui-session.sh sources /etc/cage-ui/*.sh, then execs
	# $CAGE_UI_COMMAND. postmarketos-ui-moonlight uses tinydm's
	# env-wayland.d instead; /etc/cage-ui is what cage-ui-session.sh
	# reads directly.
	install -Dm755 "$srcdir"/10-emulationstation.sh \
		-t "$pkgdir"/etc/cage-ui

	# EmulationStation reads /etc/emulationstation/es_systems.cfg -- NOT
	# ~/.emulationstation/es_systems.cfg. Without it ES aborts startup with
	# "es_systems.cfg file does not exist!" and never reaches its CONFIGURE
	# INPUT wizard, so the pad stays unmapped too.
	install -Dm644 "$srcdir"/es_systems.cfg \
		-t "$pkgdir"/etc/emulationstation

	install -Dm644 "$srcdir"/51-default-sink-volume.conf \
		-t "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d
	install -Dm644 "$srcdir"/51-min-quantum.conf \
		-t "$pkgdir"/usr/share/pipewire/pipewire.conf.d

	# No RetroArch config and no joypad autoconfig are shipped. RetroArch
	# reads ~/.config/retroarch/retroarch.cfg in preference to
	# /etc/retroarch.cfg and rewrites it on exit, so a system-wide file never
	# takes effect - the session script injects the settings into the user's
	# config instead. /etc/retroarch.cfg is also owned by the retroarch
	# package, so shipping one made the rootfs unpackable.
	#
	# The merged pad impersonates a real Nintendo Switch Pro Controller, so
	# the profile in retroarch-joypad-autoconfig matches it on name and
	# vendor/product, and its button numbering already matches the mapper's
	# bitmap exactly - including index 4, the Capture button, which is why
	# the mapper declares an unused BTN_Z. The session script points
	# joypad_autoconfig_dir at the system path and sets the hotkeys, which
	# the profile leaves unbound.

	# Volume rocker: the keys are delivered but nothing in a cage session binds
	# media keys.
	install -Dm755 "$srcdir"/r36s-volume -t "$pkgdir"/usr/bin
	install -Dm644 "$srcdir"/keyd-default.conf "$pkgdir"/etc/keyd/default.conf

	# sudoers files must be 0440 or sudo refuses to read them.
	install -Dm440 "$srcdir"/emulationstation-shutdown.sudoers \
		"$pkgdir"/etc/sudoers.d/10-emulationstation
	install -Dm644 "$srcdir"/99-keyd-ignore-pointer.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm644 "$srcdir"/99-backlight-permissions.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm644 "$srcdir"/gzdoom.ini \
		-t "$pkgdir"/usr/share/emulationstation

	# See the comment in the file: unudhcpd goes deaf after a USB mode
	# switch. The drop-in stops it with usb0; the symlink is what starts it
	# again, since BindsTo alone only ever tears down.
	install -Dm644 "$srcdir"/unudhcpd-rebind.conf \
		-t "$pkgdir"/usr/lib/systemd/system/unudhcpd@.service.d
	mkdir -p "$pkgdir"/usr/lib/systemd/system/sys-subsystem-net-devices-usb0.device.wants
	ln -s ../unudhcpd@.service \
		"$pkgdir"/usr/lib/systemd/system/sys-subsystem-net-devices-usb0.device.wants/unudhcpd@usb0.service

	# NOTE: bash is a hard dependency, not a recommend. Every PortMaster
	# launcher and control.txt itself is #!/bin/bash and uses bash-only
	# syntax ([[ ]], source, $(< file)). Without it EmulationStation's exec
	# fails with 127 and no output at all.

}
