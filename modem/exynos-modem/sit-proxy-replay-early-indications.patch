+/// Indications the CP sent while nothing was listening, replayed to the first
+/// client that takes them.
+///
+/// The CP talks as soon as the driver releases it and does not repeat itself.
+/// Its carrier-configuration handshake is the case that matters: it pushes
+/// CARRIER_CONFIG_SIM_INFO once, naming the SIM it wants a configuration for,
+/// and waits to be pointed at one. Miss it and the CP applies no carrier
+/// policy, keeps no URSP rules, and from then on refuses every PDN but the one
+/// it attached with -- which is a modem that registers, carries data, and
+/// cannot place a VoLTE call.
+///
+/// That is a window this proxy cannot close by being quick: it binds its socket
+/// before any client exists, so for the first seconds of a boot there is a
+/// listener on the device and nobody behind it. Dropping those frames is what
+/// it used to do.
+///
+/// Bounded, because a boot with no client ever must not grow without end, and
+/// cleared when the device is reopened: indications from a CP that has since
+/// restarted describe a state that no longer exists.
+#[derive(Default)]
+struct Early {
+    frames: VecDeque<Vec<u8>>,
+    bytes: usize,
+    dropped: usize,
+}
+
+/// Enough for a boot's worth of unsolicited traffic, not enough to matter.
+const EARLY_MAX_FRAMES: usize = 64;
+const EARLY_MAX_BYTES: usize = 64 * 1024;
+
+impl Early {
+    fn push(&mut self, frame: &[u8]) {
+        if self.frames.len() >= EARLY_MAX_FRAMES
+            || self.bytes + frame.len() > EARLY_MAX_BYTES
+        {
+            self.dropped += 1;
+            return;
+        }
+        self.bytes += frame.len();
+        self.frames.push_back(frame.to_vec());
+    }
+
+    fn clear(&mut self) {
+        self.frames.clear();
+        self.bytes = 0;
+        self.dropped = 0;
+    }
+}
