#!/bin/sh
# Re-assert the gadget's pull-up once the host goes away.
#
# The board drives the port's VBUS itself, so B-session-valid never drops and
# the controller is never told the cable left or came back. The gadget stops
# advertising itself after a disconnect and nothing ever makes it start again,
# so attaching the cable after boot does nothing until the gadget is torn down
# and rebuilt - which is what switching USB modes and back was doing by hand.
#
# soft_connect is write-only and calls usb_gadget_connect(), so writing
# "connect" while nothing is attached simply leaves the pull-up asserted,
# ready for whenever the cable does arrive. That is the state the port was
# accidentally in when the role switch still read "none", which is the one
# configuration hot-plug was ever observed to work in.
#
# Skipped in host mode: there is no gadget to connect, and the UDC is the
# wrong thing to be touching while the controller is driving a downstream
# device.

while :; do
	for udc in /sys/class/udc/*; do
		[ -e "$udc/state" ] || continue

		role=$(cat /sys/class/usb_role/*/role 2>/dev/null)
		[ "$role" = "host" ] && continue

		if [ "$(cat "$udc/state" 2>/dev/null)" = "not attached" ]; then
			echo connect >"$udc/soft_connect" 2>/dev/null || :
		fi
	done
	sleep 2
done
