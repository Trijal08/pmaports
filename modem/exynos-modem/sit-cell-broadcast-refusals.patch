+/// The ranges stock would send to accept exactly `accepts`: those ranges
+/// selected, plus every [`ANDROID_BOOT_RANGES`] entry they do not overlap,
+/// left unselected.
+///
+/// Stock never writes a config of accepts alone. All nineteen captured
+/// Android frames spell out the refusals too -- 4355, 4380-4382 and
+/// 4393-4395 carry `selected = 0` in every one -- so a caller asking for a
+/// subset should still describe the rest of the ETWS/CMAS space rather than
+/// leave it unmentioned. Functionally the two are the same, because a range
+/// the CP was not told about is not accepted either; this is for parity with
+/// what the carrier's own stack puts on the wire.
+pub fn ranges_like_stock(accepts: &[BroadcastRange]) -> Vec<BroadcastRange> {
+    let overlaps = |a: &BroadcastRange, b: &BroadcastRange| {
+        a.from_service_id <= b.to_service_id && b.from_service_id <= a.to_service_id
+    };
+    let mut out: Vec<BroadcastRange> = accepts
+        .iter()
+        .map(|r| BroadcastRange {
+            selected: true,
+            ..*r
+        })
+        .collect();
+    for d in ANDROID_BOOT_RANGES {
+        if !accepts.iter().any(|a| overlaps(a, &d)) {
+            out.push(BroadcastRange {
+                selected: false,
+                ..d
+            });
+        }
+    }
+    out.sort_by_key(|r| r.from_service_id);
+    out
+}
