+    /// What the CP says before anyone is listening is kept, in order, and
+    /// handed to the first client that takes indications. The carrier-config
+    /// handshake depends on it: the CP names its SIM once and waits.
+    #[test]
+    fn indications_sent_before_any_client_are_replayed() {
+        let mut early = Early::default();
+        let first = frame(msg_type::INDICATION, 0x4602, 0, 8);
+        let second = frame(msg_type::INDICATION, 0x0906, 0, 4);
+
+        early.push(&first);
+        early.push(&second);
+        assert_eq!(early.frames.len(), 2);
+
+        let (mut peer, mut client) = peer_pair();
+        for f in early.frames.iter() {
+            queue_to_peer(&mut peer, f);
+        }
+        early.clear();
+        assert!(early.frames.is_empty());
+        assert_eq!(early.bytes, 0);
+
+        let mut got = vec![0u8; first.len() + second.len()];
+        let mut n = 0;
+        while n < got.len() {
+            n += client.read(&mut got[n..]).unwrap();
+        }
+        assert_eq!(&got[..first.len()], &first[..], "first frame, in order");
+        assert_eq!(&got[first.len()..], &second[..], "second frame, in order");
+    }
+
+    /// A boot where no client ever arrives must not grow without end.
+    #[test]
+    fn the_replay_buffer_is_bounded() {
+        let mut early = Early::default();
+        let ind = frame(msg_type::INDICATION, 0x0906, 0, 64);
+
+        for _ in 0..EARLY_MAX_FRAMES * 2 {
+            early.push(&ind);
+        }
+        assert_eq!(early.frames.len(), EARLY_MAX_FRAMES);
+        assert_eq!(early.dropped, EARLY_MAX_FRAMES);
+        assert!(early.bytes <= EARLY_MAX_BYTES);
+
+        let mut big = Early::default();
+        let huge = frame(msg_type::INDICATION, 0x0906, 0, EARLY_MAX_BYTES + 1);
+        big.push(&huge);
+        assert!(big.frames.is_empty(), "a frame over the byte cap is refused");
+        assert_eq!(big.dropped, 1);
+    }
+
