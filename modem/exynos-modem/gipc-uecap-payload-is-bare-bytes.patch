+/// The payload of a uecap file-read response: the block's bytes in field 1,
+/// and nothing else.
+///
+/// Recovered from stock on 2026-11-01, which settles a shape that had been
+/// inferred. For a 4000-byte block stock's envelope field 5 is **4003** bytes
+/// long and begins `0a a0 1f`, i.e. field 1, length-delimited, 4000 bytes --
+/// 3 bytes of header plus the data exactly, leaving room for nothing more. The
+/// small `ap_plmn_mapping.binarypb` is the same shape: field 5 is 2973 and
+/// begins `0a 9a 17`, one field-1 block of 2970.
+///
+/// So there is no offset, no result and no last_block on the wire, and no
+/// UecapFileMessage wrapper: the CP reassembles the blocks in the order they
+/// arrive, which the GIPC sequence already carries. Sending the modelled
+/// `UecapFileMessage{UecapFileReadResponse{offset, data, result, last_block}}`
+/// instead -- which is what this did -- made the CP re-read the same files
+/// without end: 78 requests for `ap_plmn_mapping.binarypb` in 81 seconds and
+/// 5.7 MB on a channel stock uses 128 KB of.
+fn uecap_read_payload(block: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(block.len() + 8);
+    out.push(0x0a); // field 1, wire type 2
+    let mut n = block.len();
+    while n >= 0x80 {
+        out.push((n as u8 & 0x7f) | 0x80);
+        n >>= 7;
+    }
+    out.push(n as u8);
+    out.extend_from_slice(block);
+    out
+}
