maintainer="Vitaliy Ognev <vitaliy.ognev@gmail.com>"
pkgname=rockchip-r36s-mapper
pkgver=1.0.3
pkgrel=0
pkgdesc="Rockchip R36S gamepad joiner/mapper"
url="https://github.com/Trijal08/r36s-mapper"
arch="aarch64"
license="MIT"
options="!check"
makedepends="cargo"
# Pinned to a commit, NOT refs/heads/master. The branch tarball was saved
# as rockchip-r36s-mapper-$pkgver.tar.gz, a name that does not change when
# master moves, so a cached distfile is never refetched: the package would
# keep building whatever snapshot happened to be downloaded first. That is
# how a build silently shipped the pre-impersonation "Fake Gamepad" mapper
# while master already carried the Switch Pro identity.
_commit="94f379f6fea7fc3fb9aa981b6da06b469fbf61fe"
source="rockchip-r36s-mapper-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/r36s-mapper-$_commit"
subpackages="$pkgname-openrc $pkgname-systemd $pkgname-udev"
install="
	$pkgname-openrc.post-install
	$pkgname-openrc.pre-deinstall
"

build() {
	cargo build --release --locked
}

package() {
	install -Dm644 contrib/postmarketos/99-disable-real-gamepad.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm755 target/release/r36s-mapper \
		-t "$pkgdir"/usr/bin/
	install -Dm644 contrib/postmarketos/rockchip-r36s-mapper.service \
		-t "$pkgdir"/usr/lib/systemd/system/
	install -Dm755 contrib/postmarketos/rockchip-r36s-mapper.initd \
		"$pkgdir"/etc/init.d/rockchip-r36s-mapper
}

sha512sums="
c3b2e9ae45ed00927a8ff53aae84b80e71e4e80364310a3f57ebabe6508619a83952828f651dd023fbce6d661df1d14593adccfaf7bc5ae78e0480ed042dfccf  rockchip-r36s-mapper-94f379f6fea7fc3fb9aa981b6da06b469fbf61fe.tar.gz
"
