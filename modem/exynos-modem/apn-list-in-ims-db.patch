+/// One APN of a carrier's list, with the vendor's enums already mapped to the
+/// values the CP expects.
+pub struct ApnRow {
+    pub name: String,
+    pub apn: String,
+    pub types: u32,
+    pub bearers: u32,
+    pub protocol: u8,
+    pub roaming: u8,
+}
+
+/// `ApnItem.type` and `bearer_bitmask` are 1-based enum lists; AOSP turns each
+/// into `1 << (n - 1)`.
+fn bitmask<I: IntoIterator<Item = i32>>(values: I) -> u32 {
+    values
+        .into_iter()
+        .filter(|&v| (1..=32).contains(&v))
+        .fold(0u32, |m, v| m | 1 << (v - 1))
+}
+
+/// `ApnItem.Protocol` is IP = 0, IPV6 = 1, IPV4V6 = 2; SIT numbers the same
+/// three from one. Absent means IPv4, which is the vendor's own default.
+fn sit_pdp(protocol: Option<i32>) -> u8 {
+    (protocol.unwrap_or(0) + 1) as u8
+}
+
+/// Convert a carrier's APN list for the database.
+pub fn apn_rows(apns: &[crate::ApnItem]) -> Vec<ApnRow> {
+    apns.iter()
+        .filter_map(|a| {
+            // An entry with no APN names no DNN, so there is nothing to
+            // register and nothing to attach with.
+            let apn = a.apn.clone().filter(|s| !s.is_empty())?;
+            let bearers = a
+                .bearer_bitmask
+                .as_deref()
+                .map(|b| bitmask(b.split('|').filter_map(|t| t.trim().parse().ok())))
+                .unwrap_or(0);
+            Some(ApnRow {
+                name: a.name.clone().unwrap_or_default(),
+                apn,
+                types: bitmask(a.r#type.iter().copied()),
+                bearers,
+                protocol: sit_pdp(a.protocol),
+                roaming: sit_pdp(a.roaming_protocol.or(a.protocol)),
+            })
+        })
+        .collect()
+}
