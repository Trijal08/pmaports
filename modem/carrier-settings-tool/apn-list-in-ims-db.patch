+#[cfg(test)]
+mod apn_mapping_tests {
+    use super::{apn_type_mask, sit_pdp};
+
+    /// The proto enum values, for readable cases below.
+    const DEFAULT: i32 = 1;
+    const MMS: i32 = 2;
+    const SUPL: i32 = 3;
+    const HIPRI: i32 = 5;
+    const IMS: i32 = 7;
+    const IA: i32 = 9;
+    const EMERGENCY: i32 = 10;
+    const XCAP: i32 = 11;
+    const UT: i32 = 12;
+    const ALL: i32 = 0;
+
+    /// Every value here was read off the stock capture on identical firmware,
+    /// so a change that breaks one is a change away from the modem's own
+    /// Android.
+    #[test]
+    fn matches_the_stock_wire() {
+        // fizz mobile.bm is typed `default,mms,supl` and stock sends 23:
+        // TYPE_DEFAULT is DEFAULT|HIPRI, so 1|16|2|4.
+        assert_eq!(apn_type_mask([DEFAULT, MMS, SUPL]), 23);
+        // telus sp.telus.com, `default,mms,supl,hipri,ia`.
+        assert_eq!(apn_type_mask([DEFAULT, MMS, SUPL, HIPRI, IA]), 279);
+        // XCAP is bit 11, not bit 10 -- MCX holds bit 10 and the proto has no
+        // MCX, which is what `1 << (v - 1)` got wrong.
+        assert_eq!(apn_type_mask([XCAP]), 2048);
+        assert_eq!(apn_type_mask([XCAP, MMS]), 2050);
+        assert_eq!(apn_type_mask([IMS]), 64);
+        assert_eq!(apn_type_mask([EMERGENCY]), 512);
+    }
+
+    #[test]
+    fn drops_what_it_cannot_map() {
+        assert_eq!(apn_type_mask([ALL]), 0);
+        assert_eq!(apn_type_mask([UT]), 0);
+        assert_eq!(apn_type_mask([UT, IMS]), 64);
+    }
+
+    /// proto2 omits a field equal to its default, so an explicit
+    /// roaming_protocol="IP" arrives as None. It must stay IP rather than
+    /// borrow the home protocol.
+    #[test]
+    fn absent_roaming_protocol_is_ip() {
+        assert_eq!(sit_pdp(None), 1);
+        assert_eq!(sit_pdp(Some(0)), 1);
+        assert_eq!(sit_pdp(Some(2)), 3);
+    }
+}
