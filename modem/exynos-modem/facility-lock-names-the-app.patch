+/// As `samsung_sit_build_get_facility_lock`, naming the application via its
+/// AID (`aid_len` 0 keeps the old all-zero field).
+#[no_mangle]
+pub unsafe extern "C" fn samsung_sit_build_get_facility_lock_aid(
+    token: u16,
+    facility: u8,
+    aid: *const u8,
+    aid_len: usize,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    let aid = if aid.is_null() || aid_len == 0 {
+        &[][..]
+    } else {
+        std::slice::from_raw_parts(aid, aid_len)
+    };
+    emit_bytes(
+        sit::build_get_facility_lock_aid(token, facility, aid),
+        out,
+        out_len,
+    )
+}
