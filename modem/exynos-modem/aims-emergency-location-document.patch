+    /// The emergency location's variable fields, which must agree with tag
+    /// 778: a card that states its domain decides both.
+    #[test]
+    fn the_geo_entity_follows_the_isim_domain() {
+        let (_dir, path) = fixture();
+        let id = CarrierIdentity {
+            has_isim: true,
+            imsi: "302220808479542".into(),
+            mccmnc: "302220".into(),
+            ..Default::default()
