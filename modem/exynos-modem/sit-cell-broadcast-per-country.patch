--- a/crates/samsung-sit/tools/gen-cbs-channels.py	1969-12-31 19:00:00.000000000 -0500
+++ b/crates/samsung-sit/tools/gen-cbs-channels.py	2026-11-09 20:03:06.909629843 -0500
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# Generate src/cbs_channels.rs from AOSP's CellBroadcastReceiver resources.
+#
+# Which cell broadcast message identifiers a phone should accept is not a
+# property of the modem and not carrier config -- it is per *country*, and
+# AOSP keeps it in res/values-mcc<NNN>/ overlays of its own
+# CellBroadcastReceiver. The identifier for a category moves between regions:
+# Brazil (724) puts the monthly test on 0x111D and the exercise on 0x111E,
+# which in the default table are the exercise and the operator-defined
+# channels. Hand-writing that would turn a test channel on, or a real alert
+# off, somewhere in the world.
+#
+# Usage:
+#   tools/gen-cbs-channels.py <AOSP>/packages/apps/CellBroadcastReceiver/res \
+#       > src/cbs_channels.rs
+#
+# Overlay semantics are Android's: an array the overlay defines REPLACES the
+# default for that category; categories it leaves alone fall back.
+
+import glob, os, re, sys
+
+# Resource array -> our category name, and whether it is on by default.
+# The defaults are the *_enabled_default booleans in res/values/.
+CATEGORIES = [
+    ("etws_alerts_range_strings",                      "EtwsAlert",       True),
+    ("etws_test_alerts_range_strings",                 "EtwsTest",        False),
+    ("cmas_presidential_alerts_channels_range_strings","Presidential",    True),
+    ("cmas_alert_extreme_channels_range_strings",      "Extreme",         True),
+    ("cmas_alerts_severe_range_strings",               "Severe",          True),
+    ("cmas_amber_alerts_channels_range_strings",       "Amber",           True),
+    ("required_monthly_test_range_strings",            "MonthlyTest",     False),
+    ("exercise_alert_range_strings",                   "Exercise",        False),
+    ("operator_defined_alert_range_strings",           "OperatorDefined", False),
+    ("public_safety_messages_channels_range_strings",  "PublicSafety",    True),
+    ("state_local_test_alert_range_strings",           "StateLocalTest",  False),
+    ("emergency_alerts_channels_range_strings",        "EmergencyAlert",  True),
+    ("geo_fencing_trigger_messages_range_strings",     "GeoFencingTrigger", True),
+    ("additional_cbs_channels_strings",                "Additional",      True),
+]
+BY_ARRAY = {a: c for a, c, _ in CATEGORIES}
+
+
+def parse_dir(d):
+    """{category: [(start, end)]} for one resource directory, GSM only."""
+    text = ""
+    for f in sorted(glob.glob(os.path.join(d, "*.xml"))):
+        with open(f, encoding="utf-8", errors="replace") as fh:
+            text += fh.read()
+
+    out = {}
+    pattern = r'<string-array name="([a-z_0-9]+)"[^>]*>(.*?)</string-array>'
+    for m in re.finditer(pattern, text, re.S):
+        cat = BY_ARRAY.get(m.group(1))
+        if cat is None:
+            continue
+        ranges = []
+        for item in re.findall(r"<item>(.*?)</item>", m.group(2), re.S):
+            item = item.strip()
+            if not item:
+                continue
+            spec, _, attrs = item.partition(":")
+            # CDMA service categories share the arrays and are a different
+            # number space; this modem is 3GPP only.
+            if "rat=cdma" in attrs:
+                continue
+            lo, _, hi = spec.partition("-")
+            try:
+                lo = int(lo, 16) if lo.lower().startswith("0x") else int(lo)
+                hi = int(hi, 16) if hi.lower().startswith("0x") else (int(hi) if hi else lo)
+            except ValueError:
+                continue
+            if lo > hi:
+                lo, hi = hi, lo
+            ranges.append((lo, hi))
+        # An array present but empty is a deliberate "this region has none",
+        # which must still override the default -- so record it either way.
+        out[cat] = sorted(set(ranges))
+    return out
+
+
+def rows(table):
+    for _, cat, _ in CATEGORIES:
+        for lo, hi in table.get(cat, []):
+            yield cat, lo, hi
+
+
+def main():
+    if len(sys.argv) != 2:
+        sys.exit("usage: gen-cbs-channels.py <CellBroadcastReceiver/res>")
+    res = sys.argv[1]
+
+    default = parse_dir(os.path.join(res, "values"))
+    regions = {}
+    for d in sorted(glob.glob(os.path.join(res, "values-mcc[0-9][0-9][0-9]"))):
+        mcc = int(os.path.basename(d)[-3:])
+        table = parse_dir(d)
+        if table:
+            regions[mcc] = table
+
+    w = sys.stdout.write
+    w("// SPDX-License-Identifier: GPL-2.0-or-later\n")
+    w("//\n")
+    w("//! Cell broadcast message identifiers per country. GENERATED by\n")
+    w("//! `tools/gen-cbs-channels.py` from AOSP's CellBroadcastReceiver\n")
+    w("//! resources -- do not edit by hand.\n")
+    w("//!\n")
+    w("//! Which identifiers a phone accepts is a property of the country, not\n")
+    w("//! of the modem or the carrier, and the identifier for a category moves\n")
+    w("//! between regions: Brazil puts the monthly test where the default table\n")
+    w("//! has the exercise channel.\n\n")
+    w("use crate::cell_broadcast::CbsCategory::{self, *};\n\n")
+    w("/// One category's inclusive identifier range.\n")
+    w("pub(crate) type CbsRow = (CbsCategory, u16, u16);\n\n")
+    w("/// What a region that says nothing accepts.\n")
+    w("pub(crate) const DEFAULT_CHANNELS: &[CbsRow] = &[\n")
+    for cat, lo, hi in rows(default):
+        w("    (%s, %d, %d),\n" % (cat, lo, hi))
+    w("];\n\n")
+    w("/// Per-MCC overlays, sorted by MCC so the lookup can bisect. A category\n")
+    w("/// listed here replaces the default for that category; one absent falls\n")
+    w("/// back. A category present with no ranges means the region has none.\n")
+    w("pub(crate) const MCC_CHANNELS: &[(u16, &[CbsRow], &[CbsCategory])] = &[\n")
+    for mcc in sorted(regions):
+        table = regions[mcc]
+        listed = [c for _, c, _ in CATEGORIES if c in table]
+        w("    (%d, &[\n" % mcc)
+        for cat, lo, hi in rows(table):
+            w("        (%s, %d, %d),\n" % (cat, lo, hi))
+        w("    ], &[%s]),\n" % ", ".join(listed))
+    w("];\n")
+
+
+if __name__ == "__main__":
+    main()
