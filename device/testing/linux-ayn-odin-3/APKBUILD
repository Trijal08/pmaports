# include sm8750-konkr-pf-elite.dts because we can
_rocknix_dts="
	$_rocknix_base_url_dts/cq8725s-ayn-common.dtsi
	$_rocknix_base_url_dts/cq8725s-ayn-odin3.dts
	$_rocknix_base_url_dts/sm8750-konkr-pf-elite.dts
