From: Trijal Saha <trijalsaha2012@gmail.com>
Subject: [PATCH] use the system zlib and libzip headers

SYSTEM_ZLIB=1 / SYSTEM_LIBZIP=1 drop the vendored sources from the build
and add the system include paths, but two files reach into core/deps by
path regardless, so the build still wants the bundled headers - and with
them the bundled 1.2.8 zlib declarations against a system 1.3.x library.
Point both at the system headers instead. Alpine's aport carries the same
change as patch-unbundle.patch.

--- a/core/hw/maple/maple_devs.cpp
+++ b/core/hw/maple/maple_devs.cpp
@@ -9,7 +9,7 @@
 #include <math.h>
 #include <time.h>
 
-#include "deps/zlib/zlib.h"
+#include <zlib.h>
 #include "deps/xxhash/xxhash.h"
 
 #define LOGJVS(...) DEBUG_LOG(JVS, __VA_ARGS__)
--- a/core/archive/ZipArchive.h
+++ b/core/archive/ZipArchive.h
@@ -22,7 +22,7 @@
 #ifndef CORE_ARCHIVE_ZIPARCHIVE_H_
 #define CORE_ARCHIVE_ZIPARCHIVE_H_
 #include "archive.h"
-#include "deps/libzip/zip.h"
+#include <zip.h>
 
 class ZipArchive : public Archive
 {
