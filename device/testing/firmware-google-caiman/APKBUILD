maintainer="Trijal Saha <trijalsaha2012@gmail.com>"
pkgname=firmware-google-caiman
pkgver=20260627
pkgrel=5
pkgdesc="Firmware for Google Pixel 9 Pro"
subpackages="
	$pkgname-brcm_a0
	$pkgname-brcm_b0
	$pkgname-brcm_b1
	$pkgname-modem
	$pkgname-aoc
	$pkgname-audio
	$pkgname-haptics
	$pkgname-mfc
	"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-zumapro"
url="https://kernel.org"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
makedepends="
	carrier-settings-tool>=0.1.0_git20260731-r2
	rsync
	e2fsprogs-extra
	curl
	unzip
"

# Source
_owner="TheMuppets"
_repository="proprietary_vendor_google_caiman"
# A branch name is not a pin: the tarball changes under the recorded checksum
# whenever upstream pushes, so this always names a commit.
#
# Pinned to the lineage-24.0 tip as of 2026-11-05, "caiman: Pin rust binaries to
# CP2A.260805.005" (2026-10-22) -- the same import batch as komodo's 1aa6782a.
#
# Unlike komodo this has not been checked against a device's own vendor
# partition. If the modem misbehaves on this device, compare the uecapconfig
# and carrierconfig blob shas against what the device shipped with before
# looking anywhere else; firmware-google-komodo records how that is done and
# what it turned up there.
_commit="6f00e36ebf8c8e2fee8c911ee6f7eceec96ddcde"
# The LineageOS device tree, for the parts of the telephony configuration that
# are open rather than vendor blobs: the overlays under overlay/ are Apache-2.0
# and are the source the device's own RROs are built from, so they can be read
# directly instead of decoded out of a compiled resources.arsc.
#
# Pinned for the same reason as the vendor import above: a branch name is not a
# pin. This is lineage-24.0 as of 2026-11-06, "caimito: Fix BuildSystemDesc in
# PRODUCT_BUILD_PROP_OVERRIDES" (2026-10-24), taken from LineageOS upstream.
# The device tree carries the per-device overlays; the SoC tree carries the
# ones shared by every zumapro board, and the IMS service override is one of
# those, not a caimito one.
_lineage_owner="LineageOS"
_lineage_repo="android_device_google_caimito"
_lineage_commit="cceac3fb397ab27894c44ae30bb8894e64e64aff"
_soc_repo="android_device_google_zumapro"
_soc_commit="c03df81e8fed84aeb4f2d26e9cef2ea5762d7c3f"

source="
	$pkgname-$_commit.tar.gz::https://github.com/$_owner/$_repository/archive/$_commit.tar.gz
	$_lineage_repo-$_lineage_commit.tar.gz::https://github.com/$_lineage_owner/$_lineage_repo/archive/$_lineage_commit.tar.gz
	$_soc_repo-$_soc_commit.tar.gz::https://github.com/$_lineage_owner/$_soc_repo/archive/$_soc_commit.tar.gz
	initramfs_setup_modemfw.sh
	initramfs_setup_serialnumber.sh
	aosp-carrier-defaults.txt
"
builddir="$srcdir/$_repository-$_commit"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

brcm_a0() {
	pkgdesc="Google Pixel 9 Pro Broadcom BCM4390A0 firmware"

	# Main Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/fw_bcmdhd.bin_4390_a0 \
		"$subpkgdir/usr/lib/firmware/brcm/brcmfmac4390a0-pcie.bin"

	# NVRAM Blob (plain text)
	install -Dm644 "$builddir"/proprietary/vendor/firmware/bcmdhd.cal_4390_a0 \
		"$subpkgdir/usr/lib/firmware/brcm/brcmfmac4390a0-pcie.txt"

	# CLM Binary Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/bcmdhd_clm.blob_4390_a0 \
		"$subpkgdir/usr/lib/firmware/brcm/brcmfmac4390a0-pcie.clm_blob"

	# TXCAP Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/bcmdhd_txcap.blob_4390_a0 \
		"$subpkgdir/usr/lib/firmware/brcm/brcmfmac4390a0-pcie.txcap_blob"

	# Bluetooth HCD Blob
	# install -Dm644 "$builddir"/proprietary/vendor/firmware/brcm/BCM_200.hcd \
	# 	"$subpkgdir/usr/lib/firmware/brcm/BCM4390A0.hcd"
	install -Dm644 "$builddir"/proprietary/vendor/firmware/brcm/BCM_200.hcd \
		"$subpkgdir/usr/lib/firmware/brcm/BCM.hcd"
}

