+    /// Stock sends its configuration as three pushes, not one, and the split
+    /// is the same on every stack of every capture. Counts here are against
+    /// the fixture, not the shipped database; what is asserted is the
+    /// membership rule, which is what has to hold for any carrier.
+    #[test]
+    fn the_three_pushes_partition_the_entries() {
+        let (_dir, path) = fixture();
+        let id = CarrierIdentity { has_isim: true, mccmnc: "26203".into(), ..Default::default() };
+        let cfg = resolve(&path, &DEVICE(), &id).expect("resolve");
+
+        let full: Vec<u16> = cfg.group(Group::Full).iter().map(|(t, _)| *t).collect();
+        let ident: Vec<u16> = cfg.group(Group::Identity).iter().map(|(t, _)| *t).collect();
+        let carrier: Vec<u16> = cfg.group(Group::Carrier).iter().map(|(t, _)| *t).collect();
+
+        // The identity extras travel alone, and 778 only with an ISIM.
+        assert_eq!(ident, vec![tag::UA_IMS_CLIENT_VERSION, tag::IMS_HOME_DOMAIN,
+                               tag::UA_EXTRA_1, tag::UA_EXTRA_2]);
+        let plain = CarrierIdentity { mccmnc: "26203".into(), ..Default::default() };
+        let cfg2 = resolve(&path, &DEVICE(), &plain).expect("resolve");
+        assert_eq!(cfg2.group(Group::Identity).len(), 3);
+
+        // Full is everything else, and Carrier drops the identity and timers.
+        assert!(full.iter().all(|t| !ident.contains(t)));
+        assert_eq!(full.len() + ident.len(), cfg.entries.len());
+        assert!(carrier.iter().all(|t| full.contains(t)));
+        for t in [tag::USER_AGENT, tag::UA_MODEL, tag::SIP_TIMER_TA_MS,
+                  tag::GEOLOCATION_VOLTE_EMERGENCY] {
+            assert!(full.contains(&t), "Full should carry {t}");
+            assert!(!carrier.contains(&t), "Carrier should not carry {t}");
+        }
+        // The carrier block still has the carrier's own values in it.
+        assert!(carrier.contains(&1028));
+    }
+
     /// Carriers that ship no APNs are a normal outcome; another carrier's
     /// APNs would be worse than none, so there is no default to fall back on.
     #[test]
