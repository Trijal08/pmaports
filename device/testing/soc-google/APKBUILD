maintainer="Trijal Saha <trijalsaha2012@gmail.com>"
pkgname=soc-google
pkgdesc="Common package for Google Tensor devices"
pkgver=10
pkgrel=0
url="https://postmarketos.org"
license="BSD-3-Clause"
arch="aarch64"
options="!check !archcheck !tracedeps !pmb:crossdirect"
depends=""
makedepends="
	cargo
	cargo-auditable
"
subpackages="
	$pkgname-gbootctl-systemd:gbootctl_systemd
	$pkgname-gbootctl
"

_owner="Trijal08"
_repository="pixel-boot-control"
_commit="f75cab4079b8317ebf525fa87f8caee8951eebf6"
source="
	$_repository-$_commit.tar.gz::https://github.com/$_owner/$_repository/archive/$_commit.tar.gz
	80-pixel-boot-control.preset
	pixel-boot-control.service
	pixel-boot-control.timer
"
builddir="$srcdir/$_repository-$_commit"

prepare() {
	default_prepare
	rm -f .cargo/config.toml
	RUSTC_WRAPPER= cargo fetch --target="$CTARGET" --locked
}

build() {
	RUSTC_WRAPPER= cargo auditable build --release --frozen
}

package() {
	mkdir -p "$pkgdir"

	# Install the compiled native binary
	install -Dm755 target/release/pixel-boot-control \
		-t "$pkgdir/usr/sbin"
}

gbootctl_systemd() {
	pkgdesc="Systemd units for pixel-boot-control"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"

	install -Dm644 \
		"$srcdir/pixel-boot-control.service" \
		"$srcdir/pixel-boot-control.timer" \
		-t "$subpkgdir/usr/lib/systemd/system"
	install -Dm644 "$srcdir/80-pixel-boot-control.preset" \
		-t "$subpkgdir/usr/lib/systemd/system-preset"
}

gbootctl() {
	pkgdesc="Enable pixel-boot-control mark-boot-successful service"
	depends="$pkgname-gbootctl-systemd"

	mkdir -p "$subpkgdir"
}

