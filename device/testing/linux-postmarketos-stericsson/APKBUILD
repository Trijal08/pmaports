d60ef1a82d0f809164cd3f63c2663c3f53bece6365572fea17589fd2f801e9b7191243c2f7b816cbb9c9742afd6ff8f4001e20dc931e3699e560670a39fa23e7  config-postmarketos-stericsson.armv7
1733c01d617fa6e076a6e93cabc232c879075bfd0d4ebfb20a433150a2a29b023fe64d59c072aea9e217cb055604adfdd5ce70d1cc3e9ec24f738b024e2dd327  0001-dmaengine-ste_dma40-Keep-prepared-descriptors-across.patch
