-/// The config this device's own Android writes at boot, in its order.
+/// What a cell broadcast identifier is for, which decides whether it is
+/// accepted by default.
+///
+/// The categories and their defaults are AOSP's own, from
+/// `CellBroadcastReceiver`'s resource arrays and its `*_enabled_default`
+/// booleans. Real alerts are on; tests, exercises and operator-defined
+/// channels are off, which is what a user expects and what the captured
+/// Android asks for.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CbsCategory {
+    EtwsAlert,
+    EtwsTest,
+    /// Cannot be switched off anywhere, by regulation.
+    Presidential,
+    Extreme,
+    Severe,
+    Amber,
+    MonthlyTest,
+    Exercise,
+    OperatorDefined,
+    PublicSafety,
+    StateLocalTest,
+    EmergencyAlert,
+    GeoFencingTrigger,
+    /// Extra channels a country adds outside the standard categories.
+    Additional,
+}
+
+impl CbsCategory {
+    /// Whether this category is accepted when nobody has chosen otherwise.
+    pub const fn accepted_by_default(self) -> bool {
+        match self {
+            CbsCategory::EtwsTest
+            | CbsCategory::MonthlyTest
+            | CbsCategory::Exercise
+            | CbsCategory::OperatorDefined
+            | CbsCategory::StateLocalTest => false,
+            _ => true,
+        }
+    }
+}
+
+/// Every identifier a country uses, with what each is for.
+///
+/// `mcc` of `None` -- or one no overlay covers -- gets the default table. A
+/// region's overlay replaces the default for the categories it names and
+/// leaves the rest alone, which is Android's own overlay rule.
+fn channels_for_mcc(mcc: Option<u16>) -> Vec<CbsRow> {
+    let region = mcc.and_then(|mcc| {
+        cbs_channels::MCC_CHANNELS
+            .binary_search_by_key(&mcc, |(m, _, _)| *m)
+            .ok()
+            .map(|i| cbs_channels::MCC_CHANNELS[i])
+    });
+
+    let mut out: Vec<CbsRow> = Vec::new();
+    if let Some((_, rows, overridden)) = region {
+        out.extend_from_slice(rows);
+        out.extend(
+            cbs_channels::DEFAULT_CHANNELS
+                .iter()
+                .filter(|(cat, _, _)| !overridden.contains(cat)),
+        );
+    } else {
+        out.extend_from_slice(cbs_channels::DEFAULT_CHANNELS);
+    }
+    out
+}
+
+/// Coalesce a per-identifier accept map into the fewest inclusive ranges.
+///
+/// The CP takes ranges, and the categories are deliberately laid out in
+/// adjacent blocks, so the eight entries stock sends are what the forty-odd
+/// identifiers collapse to.
+fn coalesce(flags: &BTreeMap<u16, bool>) -> Vec<BroadcastRange> {
+    let mut out: Vec<BroadcastRange> = Vec::new();
+    for (&id, &selected) in flags {
+        match out.last_mut() {
+            Some(last)
+                if last.selected == selected && last.to_service_id + 1 == id =>
+            {
+                last.to_service_id = id;
+            }
+            _ => out.push(BroadcastRange::new(id, id, selected)),
+        }
+    }
+    out
+}
+
+/// The ranges to accept in `mcc`, with nothing chosen by the user: every
+/// identifier the country uses, each selected or refused by its category.
+///
+/// This is derived rather than hardcoded on purpose. A category's identifier
+/// moves between countries -- Brazil puts the monthly test on 4381 and the
+/// exercise on 4382, where the default table has the exercise and the
+/// operator-defined channel -- so a single fixed list is right in one place
+/// and wrong elsewhere, and being wrong here either turns a test channel on
+/// or silences a real alert.
+pub fn default_ranges_for_mcc(mcc: Option<u16>) -> Vec<BroadcastRange> {
+    let mut flags: BTreeMap<u16, bool> = BTreeMap::new();
+    for (cat, lo, hi) in channels_for_mcc(mcc) {
+        for id in lo..=hi {
+            // Accepted wins a disagreement: silencing a real alert is the
+            // worse way to be wrong.
+            let e = flags.entry(id).or_insert(false);
+            *e |= cat.accepted_by_default();
+        }
+    }
+    coalesce(&flags)
+}
