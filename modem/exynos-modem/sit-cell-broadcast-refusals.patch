     #[test]
+    fn asking_for_a_subset_still_spells_out_the_refusals() {
+        // Just the presidential and extreme CMAS identifiers.
+        let got = ranges_like_stock(&[BroadcastRange::new(4370, 4379, true)]);
+        // That one accepted, and every stock range it does not cover refused.
+        assert_eq!(
+            got.iter().filter(|r| r.selected).count(),
+            1,
+            "only the asked-for range is accepted"
+        );
+        assert!(got.iter().any(|r| r.from_service_id == 4352 && !r.selected));
+        assert!(got.iter().any(|r| r.from_service_id == 4355 && !r.selected));
+        assert!(got.iter().any(|r| r.from_service_id == 4396 && !r.selected));
+        // 4370-4379 is covered by the request, so it is not also refused.
+        assert_eq!(
+            got.iter().filter(|r| r.from_service_id == 4370).count(),
+            1
+        );
+        assert!(got.windows(2).all(|w| w[0].from_service_id <= w[1].from_service_id));
+
+        // Asking for exactly stock's accepted set reproduces stock's own eight
+        // entries, which is the frame every captured boot ends on.
+        let stock_accepts: Vec<BroadcastRange> = ANDROID_BOOT_RANGES
+            .iter()
+            .copied()
+            .filter(|r| r.selected)
+            .collect();
+        assert_eq!(
+            ranges_like_stock(&stock_accepts).as_slice(),
+            &ANDROID_BOOT_RANGES
+        );
+    }
+
