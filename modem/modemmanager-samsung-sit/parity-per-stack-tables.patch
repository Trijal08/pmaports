+/* The table for `stack`, and how many rows it has. Stacks beyond the captured
+ * two fall back to stack 0's, which is what a single-table build did for every
+ * stack. */
+static inline const MMSitParityRequest *
+mm_sit_parity_requests_for_stack (guint stack, gsize *out_n)
+{
+    if (stack == 1) {
+        *out_n = G_N_ELEMENTS (mm_sit_parity_requests_stack1);
+        return mm_sit_parity_requests_stack1;
+    }
+    *out_n = G_N_ELEMENTS (mm_sit_parity_requests_stack0);
+    return mm_sit_parity_requests_stack0;
+}
