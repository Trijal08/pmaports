From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Subject: [PATCH] samsung-sit: make the broadcast table's staleness visible

The generated channel table said how to regenerate it but not what it
was generated from, which is exactly how the boot-parity table went
quietly stale: nothing about a wrong generated file looks wrong.

It now records the AOSP revision it came from, and the generator takes
--check to compare a committed table against a tree and fail if they
differ, so drift is one command away from being caught instead of
waiting to be noticed on the wire.

diff --git a/crates/samsung-sit/src/cbs_channels.rs b/crates/samsung-sit/src/cbs_channels.rs
--- a/crates/samsung-sit/src/cbs_channels.rs	2026-11-09 21:05:27.448760508 -0500
+++ b/crates/samsung-sit/src/cbs_channels.rs	2026-11-09 21:58:35.478276684 -0500
@@ -8,6 +8,9 @@
 //! of the modem or the carrier, and the identifier for a category moves
 //! between regions: Brazil puts the monthly test where the default table
 //! has the exercise channel.
+//!
+//! Generated from a634487
+//! Re-check with `tools/gen-cbs-channels.py --check <res> src/cbs_channels.rs`.
 
 use crate::cell_broadcast::CbsCategory::{self, *};
 
diff --git a/crates/samsung-sit/tools/gen-cbs-channels.py b/crates/samsung-sit/tools/gen-cbs-channels.py
--- a/crates/samsung-sit/tools/gen-cbs-channels.py	2026-11-09 21:05:27.448954820 -0500
+++ b/crates/samsung-sit/tools/gen-cbs-channels.py	2026-11-09 21:58:29.248393774 -0500
@@ -16,10 +16,14 @@
 #   tools/gen-cbs-channels.py <AOSP>/packages/apps/CellBroadcastReceiver/res \
 #       > src/cbs_channels.rs
 #
+#   tools/gen-cbs-channels.py --check <same path> src/cbs_channels.rs
+#       exits non-zero if the committed table no longer matches the tree,
+#       which is the only way a generated table goes quietly stale.
+#
 # Overlay semantics are Android's: an array the overlay defines REPLACES the
 # default for that category; categories it leaves alone fall back.
 
-import glob, os, re, sys
+import glob, io, os, re, subprocess, sys
 
 # Resource array -> our category name, and whether it is on by default.
 # The defaults are the *_enabled_default booleans in res/values/.
@@ -86,10 +90,42 @@
             yield cat, lo, hi
 
 
+def provenance(res):
+    """Where this came from, so drift is visible rather than silent."""
+    repo = os.path.dirname(res.rstrip("/"))
+    try:
+        rev = subprocess.run(["git", "-C", repo, "rev-parse", "--short", "HEAD"],
+                             capture_output=True, text=True, check=True).stdout.strip()
+    except Exception:
+        rev = "unknown"
+    return rev
+
+
+def render(res):
+    out = io.StringIO()
+    emit(out, res)
+    return out.getvalue()
+
+
 def main():
-    if len(sys.argv) != 2:
-        sys.exit("usage: gen-cbs-channels.py <CellBroadcastReceiver/res>")
-    res = sys.argv[1]
+    check = len(sys.argv) == 4 and sys.argv[1] == "--check"
+    if not (len(sys.argv) == 2 or check):
+        sys.exit("usage: gen-cbs-channels.py [--check] "
+                 "<CellBroadcastReceiver/res> [committed.rs]")
+
+    if check:
+        want = render(sys.argv[2])
+        have = open(sys.argv[3]).read()
+        if want == have:
+            print("cbs_channels.rs is current")
+            return
+        sys.exit("cbs_channels.rs is STALE: regenerate it from this tree")
+
+    sys.stdout.write(render(sys.argv[1]))
+
+
+def emit(w_out, res):
+    res = res
 
     default = parse_dir(os.path.join(res, "values"))
     regions = {}
@@ -99,7 +135,7 @@
         if table:
             regions[mcc] = table
 
-    w = sys.stdout.write
+    w = w_out.write
     w("// SPDX-License-Identifier: GPL-2.0-or-later\n")
     w("//\n")
     w("//! Cell broadcast message identifiers per country. GENERATED by\n")
@@ -109,7 +145,10 @@
     w("//! Which identifiers a phone accepts is a property of the country, not\n")
     w("//! of the modem or the carrier, and the identifier for a category moves\n")
     w("//! between regions: Brazil puts the monthly test where the default table\n")
-    w("//! has the exercise channel.\n\n")
+    w("//! has the exercise channel.\n")
+    w("//!\n")
+    w("//! Generated from %s\n" % provenance(res))
+    w("//! Re-check with `tools/gen-cbs-channels.py --check <res> src/cbs_channels.rs`.\n\n")
     w("use crate::cell_broadcast::CbsCategory::{self, *};\n\n")
     w("/// One category's inclusive identifier range.\n")
     w("pub(crate) type CbsRow = (CbsCategory, u16, u16);\n\n")
