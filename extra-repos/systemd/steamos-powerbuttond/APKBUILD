# Co-Maintainer: Anton Bambura <jenneron@protonmail.com>
maintainer="Victoria Brekenfeld <github@drakulix.de>"
pkgname=steamos-powerbuttond
pkgver=4.2
pkgrel=0
pkgdesc="Power button daemon"
url="https://gitlab.steamos.cloud/holo/powerbuttond"
arch="all"
license="BSD-2-Clause"
makedepends="libevdev-dev systemd-dev"
subpackages="$pkgname-doc $pkgname-systemd $pkgname-udev"
source="https://gitlab.steamos.cloud/holo/powerbuttond/-/archive/v$pkgver/powerbuttond-v$pkgver.tar.gz
	0001-run-steam-from-PATH.patch
	0002-Skip-processing-events-during-resume.patch
	0003-bind-to-gamescope-session-plus.patch
"
options="!check" # no tests
builddir="$srcdir/powerbuttond-v$pkgver"

build() {
	LDFLAGS="-lc /usr/lib/crt1.o --dynamic-linker=/usr/lib/ld-musl-aarch64.so.1" make
}

package() {
	make install DESTDIR="$pkgdir"

	rm "$pkgdir/usr/lib/systemd/user/gamescope-session.service.wants/steamos-powerbuttond.service"
	rmdir "$pkgdir/usr/lib/systemd/user/gamescope-session.service.wants"
}

