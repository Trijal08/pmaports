CONFIG_ROCKCHIP_MBOX=y
CONFIG_PHY_ROCKCHIP_USB=m
CONFIG_CRYPTO_DEV_ROCKCHIP=m
CONFIG_SND_SOC_ROCKCHIP_PDM=m
CONFIG_SND_SOC_ROCKCHIP_MAX98090=m

# fixes boot on rk3399-pinebook-pro
# introduced via MR #8604
CONFIG_GPIO_ROCKCHIP=y

# support display from boot rk3399-pinebook-pro
# pinenote only requires =m but pinebook-pro's display's
# requires built-in toshow display early
# introduced via MR #8633
CONFIG_DRM_ROCKCHIP=y

# rootfs support on USB-Attached-SCSI for rk3399-pinebook-pro
# introduced via MR #9583
CONFIG_SCSI_MOD=y
CONFIG_SCSI_COMMON=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# video decoder support for rk3399-pinebook-pro
# introduced via MR #4097
#CONFIG_MEDIA_CONTROLLER_REQUEST_API=y
CONFIG_VIDEO_ROCKCHIP_VDEC=m

# initial support for rk3566-quartz64
# introduced via MR #4178
CONFIG_MOTORCOMM_PHY=m
#CONFIG_CHARGER_RK817=m
CONFIG_PHY_ROCKCHIP_INNO_CSIDPHY=m
