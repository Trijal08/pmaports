	pkgdesc="Google Pixel 9 Pro Fold Broadcom BCM4390B1 firmware"

	# Main Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/fw_bcmdhd.bin_4390_b1 \
