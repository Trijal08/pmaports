# Reference: <https://postmarketos.org/devicepkg>
maintainer="Vitaliy Ognev <vitaliy.ognev@gmail.com>"
pkgname=device-rockchip-r36s
pkgdesc="Rockchip R36S"
pkgver=7
pkgrel=2
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-rockchip-r36s
	linux-rockchip-r36s
	postmarketos-base
	postmarketos-bootsplash
	rockchip-r36s-storage-partition
	u-boot-rockchip-r36s
"
makedepends="devicepkg-dev"
source="
	80-device-rockchip-r36s.preset
	99-rockchip-r36s-gpu.rules
	deviceinfo
	kernel-cmdline.conf
"
_pmb_recommends="rockchip-r36s-mapper"
# abuild moves usr/lib/udev into this via default_udev, with install_if on
# udev - the same split the other device rules use.
subpackages="$pkgname-systemd $pkgname-udev"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/80-device-rockchip-r36s.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset/

	install -Dm644 "$srcdir"/99-rockchip-r36s-gpu.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
}

