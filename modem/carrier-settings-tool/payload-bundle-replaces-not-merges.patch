     }
 
-    /// proto2 omits a field equal to its default, so an explicit
-    /// roaming_protocol="IP" arrives as None. It must stay IP rather than
-    /// borrow the home protocol.
+    /// A carrier that declares its own payload-description bundle replaces
+    /// the layer underneath rather than merging into it.
+    ///
+    /// This is the Videotron case. `default.pb` declares amrwb payload type
+    /// 105 as octet-aligned; Videotron declares 110 instead. Merging leaf by
+    /// leaf left 105 in place, so we told the CP payload type 105 was
+    /// octet-aligned and sent mode 2 where stock sends mode 1. Telus, which
+    /// does declare 105 itself, is mode 2 in both -- so the rule is that the
+    /// declaring layer owns the bundle, not that one carrier is special.
     #[test]
-    fn absent_roaming_protocol_is_ip() {
-        assert_eq!(sit_pdp(None), 1);
-        assert_eq!(sit_pdp(Some(0)), 1);
-        assert_eq!(sit_pdp(Some(2)), 3);
+    fn a_declared_payload_bundle_replaces_the_one_below() {
+        let aosp = BTreeMap::new();
+        let defaults = carrier(
+            "default",
+            &[("imsvoice.amrwb_payload_description_bundle.105.imsvoice.amr_codec_attribute_payload_format_int", 1)],
+        );
+        let vid = carrier(
+            "videotron_ca",
+            &[("imsvoice.amrwb_payload_description_bundle.110.imsvoice.amr_codec_attribute_payload_format_int", 1)],
+        );
+        let out = merge(&aosp, &defaults, &vid);
+        assert!(out.keys().any(|k| k.contains("amrwb_payload_description_bundle.110.")));
+        assert!(
+            !out.keys().any(|k| k.contains("amrwb_payload_description_bundle.105.")),
+            "the default's payload type survived a carrier that declared its own"
+        );
+
+        // A carrier that declares nothing keeps what is underneath.
+        let quiet = carrier("quiet", &[]);
+        let out = merge(&aosp, &defaults, &quiet);
+        assert!(out.keys().any(|k| k.contains("amrwb_payload_description_bundle.105.")));
+
+        // And only the bundle it declared: the other codec is untouched.
+        let both = carrier(
+            "default",
+            &[
+                ("imsvoice.amrwb_payload_description_bundle.105.imsvoice.amr_codec_attribute_payload_format_int", 1),
+                ("imsvoice.amrnb_payload_description_bundle.103.imsvoice.amr_codec_attribute_payload_format_int", 1),
+            ],
+        );
+        let out = merge(&aosp, &both, &vid);
+        assert!(out.keys().any(|k| k.contains("amrnb_payload_description_bundle.103.")));
+        assert!(!out.keys().any(|k| k.contains("amrwb_payload_description_bundle.105.")));
     }
