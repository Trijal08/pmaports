From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Thu, 6 Nov 2026 00:00:00 +0000
Subject: [PATCH] samsung-sit: move the vendor databases out of the plugin

The plugin read two SQLite databases that are not ModemManager's: the
vendor's cfg.db, which says which carrier manifest a SIM should be
configured with, and ims.db, which carries the CP's per-carrier IMS
settings and APN list. Between them that was 1046 lines of vendor schema,
vendor tag numbers, and a reimplementation of the vendor resolver's own
four-tier ranking -- none of it knowledge a modem manager should hold, and
all of it a reason the plugin could not go upstream.

It moves to libsamsung_sit_ffi, next to the codecs that build the frames
these values end up in. What stays here is 260 lines that convert arguments
and errors, the public API is unchanged, and the plugin no longer links
SQLite at all:

    $ readelf -d libmm-plugin-samsung-sit.so | grep NEEDED
     ... [libmm-glib.so.0] [libglib-2.0.so.0] [libgio-2.0.so.0]
     ... [libgobject-2.0.so.0] [libsamsung_sit_ffi.so.0] [libc.so.6]

This is a refactor and nothing the CP sees may change, so the Rust port was
checked against this C, compiled as an oracle, over every identity the
shipped databases contain:

    ims.db   2582 SIM identities    0 differing entries, order, or User-Agent
    cfg.db   3964 SIM identities    0 differing manifests

Three divergences the sweep found, all fixed in the library before it
landed: an APN row with an empty APN string was kept rather than dropped,
a column stored as text was not coerced when read as bytes (the C API
coerces, rusqlite does not), and UA_PRODUCT_LINE was sent as the OS name
instead of the vendor's "SH000000" constant. The real databases exercise
none of the three, which is why only a sweep that builds its own fixtures
could find them.

The suite's own fixtures still need SQLite to *write* a stand-in database,
so the dependency survives on the test executable alone. Nothing that ships
links it.
diff -ruN mmA/meson.build mmB/meson.build
--- a/meson.build	2026-09-12 17:42:47.000000000 -0400
+++ b/meson.build	2026-11-06 21:51:51.123426681 -0500
@@ -330,10 +330,11 @@
 
 enable_plugins = not get_option('auto_features').disabled()
 
-# Samsung's SIT userspace selects carrier manifests from the vendor cfg.db.
-sqlite3_dep = dependency('sqlite3', required: get_option('plugin_samsung_sit'))
 # The SIT wire codec lives in the Rust samsung-sit-ffi static library; the plugin
 # links it through a plain C ABI, so no Rust toolchain is needed to build MM.
+# The same library owns the vendor's two databases -- the carrier manifests in
+# cfg.db and the IMS settings in ims.db -- so the plugin itself needs no SQLite
+# and knows neither schema.
 samsung_sit_ffi_dep = dependency('samsung-sit-ffi', required: get_option('plugin_samsung_sit'))
 
 plugins_shared_reqs = {
@@ -391,7 +392,7 @@
   'quectel': {'available': true, 'shared': ['quectel']},
   'rolling': {'available': true, 'shared': ['fibocom', 'mtk']},
   'samsung': {'available': true, 'shared': ['icera']},
-  'samsung-sit': {'available': sqlite3_dep.found() and samsung_sit_ffi_dep.found(), 'shared': []},
+  'samsung-sit': {'available': samsung_sit_ffi_dep.found(), 'shared': []},
   'sierra-legacy': {'available': true, 'shared': ['icera', 'sierra']},
   'sierra': {'available': true, 'shared': ['xmm']},
   'simtech': {'available': true, 'shared': []},
diff -ruN mmA/src/plugins/meson.build mmB/src/plugins/meson.build
--- a/src/plugins/meson.build	2026-11-06 21:51:33.582045434 -0500
+++ b/src/plugins/meson.build	2026-11-06 21:51:51.123505892 -0500
@@ -45,6 +45,10 @@
 plugins_test_keyfile_c_args = []
 
 if enable_tests and plugins_options['samsung-sit']
+  # Test-only: the suite builds its own stand-in for the vendor's databases, and
+  # writing one needs SQLite even though reading them is the Rust library's job.
+  # Nothing that ships links it.
+  samsung_sit_test_sqlite3_dep = dependency('sqlite3', required: true)
   samsung_sit_protocol_test = executable(
     'test-samsung-sit-protocol',
     sources: files(
@@ -59,7 +63,9 @@
       'samsung-sit/tests/test-sit-protocol.c',
     ),
     include_directories: [top_inc, src_inc, include_directories('samsung-sit')],
-    dependencies: [libhelpers_dep, libport_dep, sqlite3_dep, samsung_sit_ffi_dep],
+    dependencies: [
+      libhelpers_dep, libport_dep, samsung_sit_ffi_dep, samsung_sit_test_sqlite3_dep,
+    ],
     c_args: ['-DMM_SIT_IMS_RETRY_TIMEOUT_SECS=1',
              '-DPROVISIONING_COOLDOWN_SECS=1'],
   )
@@ -997,12 +1003,8 @@
     },
   }}
 
-  # The common plugin build loop consumes one dependency list for all enabled
-  # modules. With --as-needed, SQLite is retained only by samsung-sit.
-  plugins_deps += sqlite3_dep
   plugins_deps += samsung_sit_ffi_dep
   if enable_builtin_plugins
-    deps += sqlite3_dep
     deps += samsung_sit_ffi_dep
   endif
 endif
diff -ruN mmA/src/plugins/samsung-sit/mm-sit-carrier-config.c mmB/src/plugins/samsung-sit/mm-sit-carrier-config.c
--- a/src/plugins/samsung-sit/mm-sit-carrier-config.c	2026-09-12 17:42:47.000000000 -0400
+++ b/src/plugins/samsung-sit/mm-sit-carrier-config.c	2026-11-06 21:51:51.117264301 -0500
@@ -1,39 +1,18 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 /* Copyright (C) 2026 The ModemManager authors */
 
-#include <sqlite3.h>
-#include <string.h>
-
 #include "mm-sit-carrier-config.h"
 
-typedef struct {
-    guint   carrier_id;
-    gint64  rowid;
-    gchar  *name;
-    gchar  *hash;
-    gchar  *mccmnc;
-    gchar  *imsi_pattern;
-    gchar  *spn;
-    gchar  *gid1;
-    gchar  *gid2;
-    gchar  *iccid_prefix;
-    guint   rank;
-    guint   imsi_strength;
-} CarrierCandidate;
-
-static void
-carrier_candidate_clear (CarrierCandidate *candidate)
-{
-    g_free (candidate->name);
-    g_free (candidate->hash);
-    g_free (candidate->mccmnc);
-    g_free (candidate->imsi_pattern);
-    g_free (candidate->spn);
-    g_free (candidate->gid1);
-    g_free (candidate->gid2);
-    g_free (candidate->iccid_prefix);
-    memset (candidate, 0, sizeof (*candidate));
-}
+/*
+ * A GLib face on the carrier-manifest resolver in libsamsung_sit_ffi.
+ *
+ * Which manifest a SIM gets is the vendor's decision, reproduced from its own
+ * resolver: four fallback tiers, a ranking between them, and one special case
+ * for a French IIN. Getting it wrong does not fail loudly -- the CP simply
+ * applies another carrier's rules -- so the logic is kept next to the database
+ * it reads and the frames it feeds, and this file only converts arguments and
+ * errors.
+ */
 
 void
 mm_sit_carrier_config_free (MMSitCarrierConfig *self)
@@ -47,452 +26,54 @@
     g_free (self);
 }
 
-static gchar *
-column_dup (sqlite3_stmt *statement,
-            gint          column)
-{
-    const guchar *value;
-
-    value = sqlite3_column_text (statement, column);
-    return value ? g_strdup ((const gchar *) value) : NULL;
-}
-
-static gboolean
-is_wildcard (const gchar *value)
-{
-    return (!value || !value[0] || g_str_equal (value, "%"));
-}
-
-static gboolean
-like_match (const gchar *value,
-            const gchar *pattern)
-{
-    const gchar *v;
-    const gchar *p;
-    const gchar *star = NULL;
-    const gchar *retry = NULL;
-
-    if (is_wildcard (pattern))
-        return TRUE;
-    if (!value)
-        return FALSE;
-
-    v = value;
-    p = pattern;
-    while (*v) {
-        if (*p == '_') {
-            p++;
-            v++;
-        } else if (*p == '%') {
-            star = ++p;
-            retry = v;
-        } else if (*p == *v) {
-            p++;
-            v++;
-        } else if (star) {
-            p = star;
-            v = ++retry;
-        } else
-            return FALSE;
-    }
-    while (*p == '%')
-        p++;
-    return (*p == '\0');
-}
-
-static gboolean
-candidate_matches (CarrierCandidate          *candidate,
-                   const MMSitCarrierIdentity *identity)
-{
-    gboolean gid1_matches;
-    gboolean gid2_matches;
-    gboolean orange_france_iin;
-    gboolean spn_matches;
-
-    if (!identity->imsi || !like_match (identity->imsi, candidate->imsi_pattern))
-        return FALSE;
-
-    /* The vendor query applies this ICCID constraint only for this IIN/MCCMNC. */
-    orange_france_iin = (identity->iccid &&
-                         g_str_has_prefix (identity->iccid, "894936") &&
-                         candidate->mccmnc &&
-                         g_str_equal (candidate->mccmnc, "20801"));
-    if (orange_france_iin &&
-        (!candidate->iccid_prefix || !like_match ("894936", candidate->iccid_prefix)))
-        return FALSE;
-
-    spn_matches = (identity->spn && candidate->spn &&
-                   g_str_equal (identity->spn, candidate->spn));
-    gid1_matches = (identity->gid1 && candidate->gid1 &&
-                    g_ascii_strcasecmp (identity->gid1, candidate->gid1) == 0);
-    gid2_matches = (identity->gid2 && candidate->gid2 &&
-                    g_ascii_strcasecmp (identity->gid2, candidate->gid2) == 0);
-
-    /*
-     * Each vendor UNION branch deliberately ignores the other discriminators;
-     * e.g. a row with a mismatching SPN may still win its GID1+GID2 branch.
-     */
-    if (spn_matches && gid1_matches && gid2_matches)
-        candidate->rank = 0;
-    else if (gid1_matches && gid2_matches)
-        candidate->rank = 1;
-    else if (spn_matches && gid1_matches)
-        candidate->rank = 2;
-    else if (spn_matches && gid2_matches)
-        candidate->rank = 3;
-    else if (gid1_matches)
-        candidate->rank = 4;
-    else if (gid2_matches)
-        candidate->rank = 5;
-    else if (spn_matches)
-        candidate->rank = 6;
-    else if (g_strcmp0 (candidate->spn, "%") == 0 &&
-             g_strcmp0 (candidate->gid1, "%") == 0 &&
-             g_strcmp0 (candidate->gid2, "%") == 0)
-        candidate->rank = 7;
-    else
-        return FALSE;
-
-    candidate->imsi_strength = is_wildcard (candidate->imsi_pattern) ? 0 : 1;
-    return TRUE;
-}
-
-static gboolean
-candidate_is_better (const CarrierCandidate *candidate,
-                     const CarrierCandidate *current)
-{
-    gsize candidate_mccmnc_len;
-    gsize current_mccmnc_len;
-
-    if (!current->hash)
-        return TRUE;
-    if (candidate->rank != current->rank)
-        return candidate->rank < current->rank;
-    if (candidate->imsi_strength != current->imsi_strength)
-        return candidate->imsi_strength > current->imsi_strength;
-
-    candidate_mccmnc_len = candidate->mccmnc ? strlen (candidate->mccmnc) : 0;
-    current_mccmnc_len = current->mccmnc ? strlen (current->mccmnc) : 0;
-    if (candidate_mccmnc_len != current_mccmnc_len)
-        return candidate_mccmnc_len > current_mccmnc_len;
-    return candidate->rowid < current->rowid;
-}
-
-static gboolean
-prepare (sqlite3       *database,
-         const gchar   *sql,
-         sqlite3_stmt **out_statement,
-         GError       **error)
-{
-    gint result;
-
-    result = sqlite3_prepare_v2 (database, sql, -1, out_statement, NULL);
-    if (result == SQLITE_OK)
-        return TRUE;
-
-    g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
-                 "Invalid Samsung carrier database schema: %s",
-                 sqlite3_errmsg (database));
-    return FALSE;
-}
-
-static gboolean
-resolve_privilege_rule (sqlite3                     *database,
-                        const MMSitCarrierIdentity  *identity,
-                        CarrierCandidate            *selected,
-                        GError                     **error)
-{
-    static const gchar sql[] =
-        "SELECT ci.rowid,ci.carrier_id,cm.confman,"
-        "COALESCE(n.name,pn.name,'') "
-        "FROM carrier_info ci "
-        "INNER JOIN confmap cm ON cm.carrier_id=CAST(ci.carrier_id AS TEXT) "
-        "LEFT JOIN confnames n ON n.carrier_id=ci.carrier_id "
-        "LEFT JOIN confnames pn ON pn.carrier_id=CAST(cm.parent_id AS INTEGER) "
-        "WHERE UPPER(ci.privelege_access_rule)=UPPER(?1) "
-        "ORDER BY ci.rowid LIMIT 1";
-    sqlite3_stmt *statement = NULL;
-    gint          result;
-
-    if (!identity->privilege_access_rule || !identity->privilege_access_rule[0])
-        return TRUE;
-    if (!prepare (database, sql, &statement, error))
-        return FALSE;
-
-    sqlite3_bind_text (statement, 1, identity->privilege_access_rule, -1, SQLITE_TRANSIENT);
-    result = sqlite3_step (statement);
-    if (result == SQLITE_ROW) {
-        selected->rowid = sqlite3_column_int64 (statement, 0);
-        selected->carrier_id = sqlite3_column_int (statement, 1);
-        selected->hash = column_dup (statement, 2);
-        selected->name = column_dup (statement, 3);
-    } else if (result != SQLITE_DONE) {
-        g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
-                     "Failed to query Samsung carrier privilege rule: %s",
-                     sqlite3_errmsg (database));
-        sqlite3_finalize (statement);
-        return FALSE;
-    }
-
-    sqlite3_finalize (statement);
-    return TRUE;
-}
-
-static gboolean
-resolve_ranked_carrier (sqlite3                     *database,
-                        const MMSitCarrierIdentity  *identity,
-                        CarrierCandidate            *selected,
-                        GError                     **error)
-{
-    static const gchar sql[] =
-        "SELECT ci.rowid,ci.carrier_id,ci.mccmnc,ci.imsi_prefix_xpattern,"
-        "ci.spn,ci.gid1,ci.gid2,ci.iccid_prefix,cm.confman,"
-        "COALESCE(n.name,pn.name,'') "
-        "FROM carrier_info ci "
-        "INNER JOIN confmap cm ON cm.carrier_id=CAST(ci.carrier_id AS TEXT) "
-        "LEFT JOIN confnames n ON n.carrier_id=ci.carrier_id "
-        "LEFT JOIN confnames pn ON pn.carrier_id=CAST(cm.parent_id AS INTEGER) "
-        "WHERE ((?1 IS NOT NULL AND ci.mccmnc=?1) OR "
-        "       (?1 IS NULL AND SUBSTR(?2,1,LENGTH(ci.mccmnc))=ci.mccmnc)) "
-        "ORDER BY ci.rowid";
-    sqlite3_stmt    *statement = NULL;
-    CarrierCandidate candidate = { 0 };
-    gint             result;
-
-    /* A matching SIM privilege rule is the vendor resolver's first choice. */
-    if (selected->hash || !identity->imsi || !identity->imsi[0])
-        return TRUE;
-    if (!prepare (database, sql, &statement, error))
-        return FALSE;
-
-    if (identity->mccmnc && identity->mccmnc[0])
-        sqlite3_bind_text (statement, 1, identity->mccmnc, -1, SQLITE_TRANSIENT);
-    else
-        sqlite3_bind_null (statement, 1);
-    sqlite3_bind_text (statement, 2, identity->imsi, -1, SQLITE_TRANSIENT);
-
-    while ((result = sqlite3_step (statement)) == SQLITE_ROW) {
-        candidate.rowid = sqlite3_column_int64 (statement, 0);
-        candidate.carrier_id = sqlite3_column_int (statement, 1);
-        candidate.mccmnc = column_dup (statement, 2);
-        candidate.imsi_pattern = column_dup (statement, 3);
-        candidate.spn = column_dup (statement, 4);
-        candidate.gid1 = column_dup (statement, 5);
-        candidate.gid2 = column_dup (statement, 6);
-        candidate.iccid_prefix = column_dup (statement, 7);
-        candidate.hash = column_dup (statement, 8);
-        candidate.name = column_dup (statement, 9);
-
-        if (candidate_matches (&candidate, identity) &&
-            candidate_is_better (&candidate, selected)) {
-            carrier_candidate_clear (selected);
-            *selected = candidate;
-            memset (&candidate, 0, sizeof (candidate));
-        }
-        carrier_candidate_clear (&candidate);
-    }
-
-    if (result != SQLITE_DONE) {
-        g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
-                     "Failed to query Samsung carrier database: %s",
-                     sqlite3_errmsg (database));
-        sqlite3_finalize (statement);
-        carrier_candidate_clear (&candidate);
-        return FALSE;
-    }
-
-    sqlite3_finalize (statement);
-    return TRUE;
-}
-
-static gboolean
-resolve_iccid_fallback (sqlite3                     *database,
-                        const MMSitCarrierIdentity  *identity,
-                        CarrierCandidate            *selected,
-                        GError                     **error)
-{
-    static const gchar sql[] =
-        "SELECT i.carrier_id,i.iccid_prefix,cm.confman,"
-        "COALESCE(n.name,pn.name,'') "
-        "FROM iin i "
-        "INNER JOIN confmap cm ON cm.carrier_id=i.carrier_id "
-        "LEFT JOIN confnames n ON n.carrier_id=CAST(i.carrier_id AS INTEGER) "
-        "LEFT JOIN confnames pn ON pn.carrier_id=CAST(cm.parent_id AS INTEGER)";
-    sqlite3_stmt *statement = NULL;
-    gint          result;
-    gsize         selected_strength = 0;
-
-    if (selected->hash || !identity->iccid || !identity->iccid[0])
-        return TRUE;
-    if (!prepare (database, sql, &statement, error))
-        return FALSE;
-
-    while ((result = sqlite3_step (statement)) == SQLITE_ROW) {
-        g_autofree gchar *pattern = column_dup (statement, 1);
-        gsize             strength;
-
-        if (!like_match (identity->iccid, pattern))
-            continue;
-        strength = pattern ? strcspn (pattern, "%_") : 0;
-        if (selected->hash && strength <= selected_strength)
-            continue;
-
-        carrier_candidate_clear (selected);
-        selected->carrier_id = (guint) g_ascii_strtoull ((const gchar *) sqlite3_column_text (statement, 0), NULL, 10);
-        selected->hash = column_dup (statement, 2);
-        selected->name = column_dup (statement, 3);
-        selected_strength = strength;
-    }
-
-    if (result != SQLITE_DONE) {
-        g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
-                     "Failed to query Samsung carrier ICCID fallback: %s",
-                     sqlite3_errmsg (database));
-        sqlite3_finalize (statement);
-        return FALSE;
-    }
-
-    sqlite3_finalize (statement);
-    return TRUE;
-}
-
-static gboolean
-resolve_global_fallback (sqlite3           *database,
-                         CarrierCandidate  *selected,
-                         GError           **error)
-{
-    static const gchar sql[] =
-        "SELECT r.carrier_id,cm.confman,COALESCE(n.name,'') "
-        "FROM regional_fallback r "
-        "INNER JOIN confmap cm ON cm.carrier_id=r.carrier_id "
-        "LEFT JOIN confnames n ON n.carrier_id=CAST(r.carrier_id AS INTEGER) "
-        "WHERE CAST(r.country_code AS INTEGER)=0 "
-        "ORDER BY CAST(r.carrier_id AS INTEGER) LIMIT 1";
-    sqlite3_stmt *statement = NULL;
-    gint          result;
-
-    if (selected->hash)
-        return TRUE;
-    if (!prepare (database, sql, &statement, error))
-        return FALSE;
-
-    result = sqlite3_step (statement);
-    if (result == SQLITE_ROW) {
-        selected->carrier_id = (guint) g_ascii_strtoull ((const gchar *) sqlite3_column_text (statement, 0), NULL, 10);
-        selected->hash = column_dup (statement, 1);
-        selected->name = column_dup (statement, 2);
-    } else if (result != SQLITE_DONE) {
-        g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
-                     "Failed to query Samsung global carrier fallback: %s",
-                     sqlite3_errmsg (database));
-        sqlite3_finalize (statement);
-        return FALSE;
-    }
-
-    sqlite3_finalize (statement);
-    return TRUE;
-}
-
-static gboolean
-decode_sha1 (const gchar  *hex,
-             guint8        output[20],
-             GError      **error)
-{
-    guint i;
-
-    if (!hex || strlen (hex) != 40) {
-        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
-                             "Carrier manifest identifier is not a 40-character SHA1");
-        return FALSE;
-    }
-
-    for (i = 0; i < 20; i++) {
-        gint high;
-        gint low;
-
-        high = g_ascii_xdigit_value (hex[i * 2]);
-        low = g_ascii_xdigit_value (hex[i * 2 + 1]);
-        if (high < 0 || low < 0) {
-            g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
-                                 "Carrier manifest identifier contains non-hexadecimal data");
-            return FALSE;
-        }
-        output[i] = (high << 4) | low;
-    }
-    return TRUE;
-}
-
 gboolean
 mm_sit_carrier_config_resolve (const gchar                 *database_path,
                                const MMSitCarrierIdentity  *identity,
                                MMSitCarrierConfig         **out_config,
                                GError                     **error)
 {
-    sqlite3                    *database = NULL;
-    CarrierCandidate            selected = { 0 };
-    g_autofree gchar           *directory = NULL;
-    g_autoptr(MMSitCarrierConfig) config = NULL;
-    gint                        result;
+    SamsungCarrierIdentity  sim = { 0 };
+    SamsungCarrierConfig   *handle = NULL;
+    MMSitCarrierConfig     *config;
+    const guint8           *sha1;
+    SamsungSitStatus        status;
 
     g_return_val_if_fail (database_path != NULL, FALSE);
     g_return_val_if_fail (identity != NULL, FALSE);
     g_return_val_if_fail (out_config != NULL, FALSE);
 
     *out_config = NULL;
-    if (!identity->imsi || !identity->imsi[0]) {
-        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
-                             "Cannot resolve a Samsung carrier profile without an IMSI");
-        return FALSE;
-    }
-
-    result = sqlite3_open_v2 (database_path, &database,
-                              SQLITE_OPEN_READONLY | SQLITE_OPEN_NOMUTEX, NULL);
-    if (result != SQLITE_OK) {
-        g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
-                     "Could not open Samsung carrier database %s: %s",
-                     database_path, database ? sqlite3_errmsg (database) : "unknown error");
-        if (database)
-            sqlite3_close (database);
-        return FALSE;
-    }
-
-    if (!resolve_privilege_rule (database, identity, &selected, error) ||
-        !resolve_ranked_carrier (database, identity, &selected, error) ||
-        !resolve_iccid_fallback (database, identity, &selected, error) ||
-        !resolve_global_fallback (database, &selected, error)) {
-        carrier_candidate_clear (&selected);
-        sqlite3_close (database);
-        return FALSE;
-    }
-    sqlite3_close (database);
 
-    if (!selected.hash) {
-        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
-                             "No matching Samsung carrier manifest was found");
-        carrier_candidate_clear (&selected);
+    sim.imsi                  = identity->imsi;
+    sim.iccid                 = identity->iccid;
+    sim.mccmnc                = identity->mccmnc;
+    sim.spn                   = identity->spn;
+    sim.gid1                  = identity->gid1;
+    sim.gid2                  = identity->gid2;
+    sim.privilege_access_rule = identity->privilege_access_rule;
