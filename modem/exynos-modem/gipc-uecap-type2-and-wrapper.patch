+/// Field 2 of the CP log payload, a bare protobuf string. Hand-decoded rather
+/// than given a schema: the message has no other field we use, and an
+/// unparseable frame must still be dumpable as hex.
+fn cp_log_text(payload: &[u8]) -> Option<String> {
+    let mut i = 0;
+    while i < payload.len() {
+        let (key, n) = varint(payload, i)?;
+        i = n;
+        match (key >> 3, key & 7) {
+            (2, 2) => {
+                let (len, n) = varint(payload, i)?;
+                let end = n.checked_add(len as usize)?;
+                return String::from_utf8(payload.get(n..end)?.to_vec()).ok();
+            }
+            (_, 0) => i = varint(payload, i)?.1,
+            (_, 2) => {
+                let (len, n) = varint(payload, i)?;
+                i = n.checked_add(len as usize)?;
+            }
+            (_, 5) => i += 4,
+            (_, 1) => i += 8,
+            _ => return None,
+        }
+    }
+    None
+}
+
+fn varint(b: &[u8], mut i: usize) -> Option<(u64, usize)> {
+    let (mut v, mut shift) = (0u64, 0);
+    loop {
+        let c = *b.get(i)?;
+        i += 1;
+        v |= ((c & 0x7f) as u64) << shift;
+        if c & 0x80 == 0 {
+            return Some((v, i));
+        }
+        shift += 7;
+        if shift > 63 {
+            return None;
+        }
+    }
+}
