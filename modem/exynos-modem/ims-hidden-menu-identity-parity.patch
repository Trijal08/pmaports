+
+    /// Stock sends the IMS home domain only for a card that has an ISIM, and
+    /// pads the MNC to three digits (3GPP TS 23.003 13.2).
+    #[test]
+    fn the_home_domain_needs_an_isim() {
+        let (_dir, path) = fixture();
+
+        let plain = CarrierIdentity { mccmnc: "26203".into(), ..Default::default() };
+        let cfg = resolve(&path, &DEVICE(), &plain).expect("resolve");
+        assert!(all(&cfg, tag::IMS_HOME_DOMAIN).is_empty());
+
+        let isim = CarrierIdentity { has_isim: true, ..plain.clone() };
+        let cfg = resolve(&path, &DEVICE(), &isim).expect("resolve");
+        assert_eq!(
+            all(&cfg, tag::IMS_HOME_DOMAIN),
+            // A two-digit MNC is written mnc0NN, so the domain cannot be
+            // made by splitting the MCCMNC in half.
+            vec![&Value::Str("ims.mnc003.mcc262.3gppnetwork.org".into())]
+        );
+
+        // A three-digit MNC keeps all three, as the Videotron card does.
+        let three = CarrierIdentity { has_isim: true, mccmnc: "302500".into(), ..Default::default() };
+        let cfg = resolve(&path, &DEVICE(), &three).expect("resolve");
+        assert_eq!(
+            all(&cfg, tag::IMS_HOME_DOMAIN),
+            vec![&Value::Str("ims.mnc500.mcc302.3gppnetwork.org".into())]
+        );
+        let short = CarrierIdentity { has_isim: true, mccmnc: "2620".into(), ..Default::default() };
+        assert!(all(&resolve(&path, &DEVICE(), &short).expect("resolve"),
+                    tag::IMS_HOME_DOMAIN).is_empty());
+
+        // A card that states its own domain is believed over the derived one,
+        // because the operator chooses the name and need not use that form.
+        let stated = CarrierIdentity {
+            has_isim: true,
+            isim_domain: "ims.example-operator.net".into(),
+            mccmnc: "26203".into(),
+            ..Default::default()
+        };
+        assert_eq!(
+            all(&resolve(&path, &DEVICE(), &stated).expect("resolve"), tag::IMS_HOME_DOMAIN),
+            vec![&Value::Str("ims.example-operator.net".into())]
         );
     }
 
+    /// A tag absent from the menu leaves the CP's slot at whatever it held, so
+    /// the ones stock sends empty are sent empty rather than skipped.
+    #[test]
+    fn the_tags_stock_sends_empty_are_sent() {
+        let (_dir, path) = fixture();
+        let cfg = resolve(&path, &DEVICE(), &sim("26203")).expect("resolve");
+        for tag in (tag::UA_EXTRA_1, tag::UA_EXTRA_2).0..=tag::UA_EXTRA_2 {
+            if tag != tag::UA_EXTRA_1 && tag != tag::UA_EXTRA_2 { continue; }
+            assert_eq!(all(&cfg, tag), vec![&Value::Str(String::new())], "tag {tag}");
+        }
+        assert_eq!(int(&cfg, tag::UA_IMS_CLIENT_VERSION), 1);
+    }
+
     /// Carriers that ship no APNs are a normal outcome; another carrier's
     /// APNs would be worse than none, so there is no default to fall back on.
     #[test]
