+mod merge_tests {
+    use super::*;
 
-    #[test]
-    fn drops_what_it_cannot_map() {
-        assert_eq!(apn_type_mask([ALL]), 0);
-        assert_eq!(apn_type_mask([UT]), 0);
-        assert_eq!(apn_type_mask([UT, IMS]), 64);
+    fn carrier(name: &str, pairs: &[(&str, i32)]) -> Carrier {
+        let mut settings: BTreeMap<String, Value> = BTreeMap::new();
+        for (k, v) in pairs {
+            settings.insert((*k).to_string(), Value::Int(*v));
+        }
+        Carrier {
