+// SPDX-License-Identifier: GPL-2.0-or-later
+//! Prints what resolve() picks, in the same form as the C oracle.
+use samsung_carrier_db::{resolve, CarrierIdentity};
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let arg = |n: usize| a.get(n).cloned().unwrap_or_default();
+    let id = CarrierIdentity {
+        imsi: arg(2),
+        iccid: arg(3),
+        mccmnc: arg(4),
+        spn: arg(5),
+        gid1: arg(6),
+        gid2: arg(7),
+        privilege_access_rule: arg(8),
+    };
+    match resolve(&a[1], &id) {
+        Ok(c) => println!(
+            "id {} name {} sha1 {} path {}",
+            c.carrier_id,
+            c.carrier_name,
+            c.manifest_sha1,
+            c.manifest_path.display()
+        ),
+        Err(e) => println!("error {e}"),
+    }
+}
diff --git a/crates/samsung-carrier-db/src/lib.rs b/crates/samsung-carrier-db/src/lib.rs
new file mode 100644
index 0000000..f8aa105
--- /dev/null
+++ b/crates/samsung-carrier-db/src/lib.rs
@@ -0,0 +1,426 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//! Selects the carrier manifest a SIM should be configured with, out of the
+//! vendor's `cfg.db`.
+//!
+//! The CP pulls its carrier policy as a manifest named by SHA1; this decides
+//! which one. The decision is not ours to design: it reproduces the vendor
+//! resolver's own four tiers and its ranking, because a SIM that resolves to a
+//! different manifest here than it would on the stock stack gets a different
+//! set of carrier rules, and the failures that follow look like radio bugs.
+//!
+//! The tiers, in the order the vendor tries them:
+//!
+//! 1. the SIM's privilege access rule, an exact match that beats everything;
+//! 2. the ranked `carrier_info` match on MCCMNC/IMSI/SPN/GID;
+//! 3. an ICCID IIN prefix;
+//! 4. the global regional fallback.
+
+use std::path::{Path, PathBuf};
+
+use rusqlite::{Connection, OpenFlags};
+
+/// The SIM's identity. Absent fields are empty strings, as the vendor's own
+/// query treats "not present" and "empty" alike.
+#[derive(Debug, Default, Clone)]
+pub struct CarrierIdentity {
+    pub imsi: String,
+    pub iccid: String,
+    pub mccmnc: String,
+    pub spn: String,
+    pub gid1: String,
+    pub gid2: String,
+    pub privilege_access_rule: String,
+}
+
+/// The manifest a SIM resolved to.
+#[derive(Debug, Clone)]
+pub struct CarrierConfig {
+    pub carrier_id: u32,
+    pub carrier_name: String,
+    /// Lowercase hex, as the manifest file is named.
+    pub manifest_sha1: String,
+    pub manifest_sha1_bytes: [u8; 20],
+    pub manifest_path: PathBuf,
+}
+
+#[derive(Debug)]
+pub enum Error {
+    /// The resolver has nothing to match on.
+    NoImsi,
+    Open { path: String, reason: String },
+    /// The database is readable but not the shape the resolver expects.
+    Schema(String),
+    Query(String),
+    /// No tier matched, not even the global fallback.
+    NoManifest,
+    /// A `confman` value that is not a SHA1; the database is corrupt.
+    BadSha1(&'static str),
+    /// The manifest the database names is not packaged.
+    MissingManifest(PathBuf),
+}
+
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Error::NoImsi => {
+                write!(f, "Cannot resolve a Samsung carrier profile without an IMSI")
+            }
+            Error::Open { path, reason } => {
+                write!(f, "Could not open Samsung carrier database {path}: {reason}")
+            }
+            Error::Schema(m) => write!(f, "Invalid Samsung carrier database schema: {m}"),
+            Error::Query(m) => write!(f, "Failed to query Samsung carrier database: {m}"),
+            Error::NoManifest => write!(f, "No matching Samsung carrier manifest was found"),
+            Error::BadSha1(m) => write!(f, "Carrier manifest identifier {m}"),
+            Error::MissingManifest(p) => write!(
+                f,
+                "Selected Samsung carrier manifest does not exist: {}",
+                p.display()
+            ),
+        }
+    }
+}
+impl std::error::Error for Error {}
+
+/// One `carrier_info` row, plus where the ranking put it.
+#[derive(Default, Clone)]
+struct Candidate {
+    carrier_id: u32,
+    rowid: i64,
+    name: String,
+    hash: String,
+    mccmnc: String,
+    imsi_pattern: String,
+    spn: String,
+    gid1: String,
+    gid2: String,
+    iccid_prefix: String,
+    rank: u32,
+    imsi_strength: u32,
+}
+
+impl Candidate {
+    fn is_empty(&self) -> bool {
+        self.hash.is_empty()
+    }
+}
+
+/// A pattern that constrains nothing.
+fn is_wildcard(value: &str) -> bool {
+    value.is_empty() || value == "%"
+}
+
+/// SQL `LIKE`, with `%` and `_` and no escape character -- the vendor's
+/// patterns use neither case folding nor escapes.
+fn like_match(value: &str, pattern: &str) -> bool {
+    if is_wildcard(pattern) {
+        return true;
+    }
+    let (v, p) = (value.as_bytes(), pattern.as_bytes());
+    let (mut vi, mut pi) = (0usize, 0usize);
+    let (mut star, mut retry) = (None, 0usize);
+
+    while vi < v.len() {
+        if pi < p.len() && p[pi] == b'_' {
+            pi += 1;
+            vi += 1;
+        } else if pi < p.len() && p[pi] == b'%' {
+            pi += 1;
+            star = Some(pi);
+            retry = vi;
+        } else if pi < p.len() && p[pi] == v[vi] {
+            pi += 1;
+            vi += 1;
+        } else if let Some(s) = star {
+            pi = s;
+            retry += 1;
+            vi = retry;
+        } else {
+            return false;
+        }
+    }
+    while pi < p.len() && p[pi] == b'%' {
+        pi += 1;
+    }
+    pi == p.len()
+}
+
+/// Score a row against the SIM, or reject it.
+///
+/// Each branch of the vendor's UNION deliberately ignores the discriminators
+/// the others test: a row with a mismatching SPN may still win on GID1+GID2.
+/// The ladder below is those branches in their own order.
+fn candidate_matches(c: &mut Candidate, id: &CarrierIdentity) -> bool {
+    if id.imsi.is_empty() || !like_match(&id.imsi, &c.imsi_pattern) {
+        return false;
+    }
+
+    // The vendor query applies this ICCID constraint only for this IIN/MCCMNC.
+    let orange_france_iin = id.iccid.starts_with("894936") && c.mccmnc == "20801";
+    if orange_france_iin && (c.iccid_prefix.is_empty() || !like_match("894936", &c.iccid_prefix)) {
+        return false;
+    }
+
+    let spn = !id.spn.is_empty() && !c.spn.is_empty() && id.spn == c.spn;
+    let gid1 = !id.gid1.is_empty() && !c.gid1.is_empty() && id.gid1.eq_ignore_ascii_case(&c.gid1);
+    let gid2 = !id.gid2.is_empty() && !c.gid2.is_empty() && id.gid2.eq_ignore_ascii_case(&c.gid2);
+
+    c.rank = match (spn, gid1, gid2) {
+        (true, true, true) => 0,
+        (false, true, true) => 1,
+        (true, true, false) => 2,
+        (true, false, true) => 3,
+        (false, true, false) => 4,
+        (false, false, true) => 5,
+        (true, false, false) => 6,
+        _ if c.spn == "%" && c.gid1 == "%" && c.gid2 == "%" => 7,
+        _ => return false,
+    };
+    c.imsi_strength = u32::from(!is_wildcard(&c.imsi_pattern));
+    true
+}
+
+/// Lower rank wins; then a real IMSI pattern over a wildcard; then the longer
+/// MCCMNC; then the row the vendor's `ORDER BY rowid` would have reached first.
+fn candidate_is_better(candidate: &Candidate, current: &Candidate) -> bool {
+    if current.is_empty() {
+        return true;
+    }
+    if candidate.rank != current.rank {
+        return candidate.rank < current.rank;
+    }
+    if candidate.imsi_strength != current.imsi_strength {
+        return candidate.imsi_strength > current.imsi_strength;
+    }
+    if candidate.mccmnc.len() != current.mccmnc.len() {
+        return candidate.mccmnc.len() > current.mccmnc.len();
+    }
+    candidate.rowid < current.rowid
+}
+
+/// SQLite's own column coercion, which the C API applies on every read: a
+/// value comes back as the type you ask for, not only the type it was stored
+/// as. The vendor's database relies on it -- `confmap.carrier_id` is text in
+/// one table and an integer in another.
+fn text(row: &rusqlite::Row<'_>, i: usize) -> String {
+    use rusqlite::types::ValueRef;
+    match row.get_ref(i) {
+        Ok(ValueRef::Text(b)) | Ok(ValueRef::Blob(b)) => String::from_utf8_lossy(b).into_owned(),
+        Ok(ValueRef::Integer(v)) => v.to_string(),
+        Ok(ValueRef::Real(v)) => v.to_string(),
+        _ => String::new(),
+    }
+}
+
+/// Tier 1: an exact privilege-access-rule match, the vendor resolver's first
+/// choice.
+fn resolve_privilege_rule(
+    db: &Connection,
+    id: &CarrierIdentity,
+    selected: &mut Candidate,
+) -> Result<(), Error> {
+    const SQL: &str = "SELECT ci.rowid,ci.carrier_id,cm.confman,\
+         COALESCE(n.name,pn.name,'') \
+         FROM carrier_info ci \
+         INNER JOIN confmap cm ON cm.carrier_id=CAST(ci.carrier_id AS TEXT) \
+         LEFT JOIN confnames n ON n.carrier_id=ci.carrier_id \
+         LEFT JOIN confnames pn ON pn.carrier_id=CAST(cm.parent_id AS INTEGER) \
+         WHERE UPPER(ci.privelege_access_rule)=UPPER(?1) \
+         ORDER BY ci.rowid LIMIT 1";
+
+    if id.privilege_access_rule.is_empty() {
+        return Ok(());
+    }
+    let mut st = db.prepare(SQL).map_err(|e| Error::Schema(e.to_string()))?;
+    let mut rows = st
+        .query([&id.privilege_access_rule])
+        .map_err(|e| Error::Query(e.to_string()))?;
+    if let Some(r) = rows.next().map_err(|e| Error::Query(e.to_string()))? {
+        selected.rowid = r.get(0).unwrap_or(0);
+        selected.carrier_id = r.get::<_, i64>(1).unwrap_or(0) as u32;
+        selected.hash = text(r, 2);
+        selected.name = text(r, 3);
+    }
+    Ok(())
+}
+
+/// Tier 2: the ranked `carrier_info` match.
+fn resolve_ranked_carrier(
+    db: &Connection,
+    id: &CarrierIdentity,
+    selected: &mut Candidate,
+) -> Result<(), Error> {
+    const SQL: &str = "SELECT ci.rowid,ci.carrier_id,ci.mccmnc,ci.imsi_prefix_xpattern,\
+         ci.spn,ci.gid1,ci.gid2,ci.iccid_prefix,cm.confman,\
+         COALESCE(n.name,pn.name,'') \
+         FROM carrier_info ci \
+         INNER JOIN confmap cm ON cm.carrier_id=CAST(ci.carrier_id AS TEXT) \
+         LEFT JOIN confnames n ON n.carrier_id=ci.carrier_id \
+         LEFT JOIN confnames pn ON pn.carrier_id=CAST(cm.parent_id AS INTEGER) \
+         WHERE ((?1 IS NOT NULL AND ci.mccmnc=?1) OR \
+                (?1 IS NULL AND SUBSTR(?2,1,LENGTH(ci.mccmnc))=ci.mccmnc)) \
+         ORDER BY ci.rowid";
+
+    if !selected.is_empty() || id.imsi.is_empty() {
+        return Ok(());
+    }
+    let mccmnc: Option<&str> = if id.mccmnc.is_empty() { None } else { Some(&id.mccmnc) };
+    let mut st = db.prepare(SQL).map_err(|e| Error::Schema(e.to_string()))?;
+    let mut rows = st
+        .query(rusqlite::params![mccmnc, &id.imsi])
+        .map_err(|e| Error::Query(e.to_string()))?;
+
+    while let Some(r) = rows.next().map_err(|e| Error::Query(e.to_string()))? {
+        let mut candidate = Candidate {
+            rowid: r.get(0).unwrap_or(0),
+            carrier_id: r.get::<_, i64>(1).unwrap_or(0) as u32,
+            mccmnc: text(r, 2),
+            imsi_pattern: text(r, 3),
+            spn: text(r, 4),
+            gid1: text(r, 5),
+            gid2: text(r, 6),
+            iccid_prefix: text(r, 7),
+            hash: text(r, 8),
+            name: text(r, 9),
+            ..Default::default()
+        };
+        if candidate_matches(&mut candidate, id) && candidate_is_better(&candidate, selected) {
+            *selected = candidate;
+        }
+    }
+    Ok(())
+}
+
+/// Tier 3: an ICCID IIN prefix, longest literal prefix winning.
+fn resolve_iccid_fallback(
+    db: &Connection,
+    id: &CarrierIdentity,
+    selected: &mut Candidate,
+) -> Result<(), Error> {
+    const SQL: &str = "SELECT i.carrier_id,i.iccid_prefix,cm.confman,\
+         COALESCE(n.name,pn.name,'') \
+         FROM iin i \
+         INNER JOIN confmap cm ON cm.carrier_id=i.carrier_id \
+         LEFT JOIN confnames n ON n.carrier_id=CAST(i.carrier_id AS INTEGER) \
+         LEFT JOIN confnames pn ON pn.carrier_id=CAST(cm.parent_id AS INTEGER)";
+
+    if !selected.is_empty() || id.iccid.is_empty() {
+        return Ok(());
+    }
+    let mut st = db.prepare(SQL).map_err(|e| Error::Schema(e.to_string()))?;
+    let mut rows = st.query([]).map_err(|e| Error::Query(e.to_string()))?;
+    let mut selected_strength = 0usize;
+
+    while let Some(r) = rows.next().map_err(|e| Error::Query(e.to_string()))? {
+        let pattern = text(r, 1);
+        if !like_match(&id.iccid, &pattern) {
+            continue;
+        }
+        // How much of the pattern is literal, so a more specific IIN wins.
+        let strength = pattern.find(['%', '_']).unwrap_or(pattern.len());
+        if !selected.is_empty() && strength <= selected_strength {
+            continue;
+        }
+        *selected = Candidate {
+            carrier_id: text(r, 0).parse().unwrap_or(0),
+            hash: text(r, 2),
+            name: text(r, 3),
+            ..Default::default()
+        };
+        selected_strength = strength;
+    }
+    Ok(())
+}
+
+/// Tier 4: the one row the vendor ships for "no idea".
+fn resolve_global_fallback(db: &Connection, selected: &mut Candidate) -> Result<(), Error> {
+    const SQL: &str = "SELECT r.carrier_id,cm.confman,COALESCE(n.name,'') \
+         FROM regional_fallback r \
+         INNER JOIN confmap cm ON cm.carrier_id=r.carrier_id \
+         LEFT JOIN confnames n ON n.carrier_id=CAST(r.carrier_id AS INTEGER) \
+         WHERE CAST(r.country_code AS INTEGER)=0 \
+         ORDER BY CAST(r.carrier_id AS INTEGER) LIMIT 1";
+
+    if !selected.is_empty() {
+        return Ok(());
+    }
+    let mut st = db.prepare(SQL).map_err(|e| Error::Schema(e.to_string()))?;
+    let mut rows = st.query([]).map_err(|e| Error::Query(e.to_string()))?;
+    if let Some(r) = rows.next().map_err(|e| Error::Query(e.to_string()))? {
+        *selected = Candidate {
+            carrier_id: text(r, 0).parse().unwrap_or(0),
+            hash: text(r, 1),
+            name: text(r, 2),
+            ..Default::default()
+        };
+    }
+    Ok(())
+}
+
+fn decode_sha1(hex: &str) -> Result<[u8; 20], Error> {
+    if hex.len() != 40 {
+        return Err(Error::BadSha1("is not a 40-character SHA1"));
+    }
+    let mut out = [0u8; 20];
+    for (i, slot) in out.iter_mut().enumerate() {
+        let byte = u8::from_str_radix(&hex[i * 2..i * 2 + 2], 16)
+            .map_err(|_| Error::BadSha1("contains non-hexadecimal data"))?;
+        *slot = byte;
+    }
+    Ok(out)
+}
+
+/// Resolve the manifest for `identity` out of the `cfg.db` at `database_path`.
+///
+/// The manifest file itself must be packaged beside the database, because a
+/// name the CP cannot be given is not a successful resolution.
+pub fn resolve(database_path: &str, identity: &CarrierIdentity) -> Result<CarrierConfig, Error> {
+    if identity.imsi.is_empty() {
+        return Err(Error::NoImsi);
+    }
+    let db = Connection::open_with_flags(
+        database_path,
+        OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    )
+    .map_err(|e| {
+        let reason = e.to_string();
+        let reason = reason
+            .strip_suffix(&format!(": {database_path}"))
+            .unwrap_or(&reason)
+            .to_string();
+        Error::Open { path: database_path.to_string(), reason }
+    })?;
+
+    let mut selected = Candidate::default();
+    resolve_privilege_rule(&db, identity, &mut selected)?;
+    resolve_ranked_carrier(&db, identity, &mut selected)?;
+    resolve_iccid_fallback(&db, identity, &mut selected)?;
+    resolve_global_fallback(&db, &mut selected)?;
+
+    if selected.is_empty() {
+        return Err(Error::NoManifest);
+    }
+
+    let manifest_sha1 = selected.hash.to_ascii_lowercase();
+    let manifest_sha1_bytes = decode_sha1(&manifest_sha1)?;
+    // A bare filename has an empty parent; the vendor's own path handling
+    // calls that the working directory.
+    let directory = match Path::new(database_path).parent() {
+        Some(d) if !d.as_os_str().is_empty() => d,
+        _ => Path::new("."),
+    };
+    let manifest_path = directory
+        .join("manifests")
+        .join(&manifest_sha1);
+    if !manifest_path.exists() {
+        return Err(Error::MissingManifest(manifest_path));
+    }
+
+    Ok(CarrierConfig {
+        carrier_id: selected.carrier_id,
+        carrier_name: selected.name,
+        manifest_sha1,
+        manifest_sha1_bytes,
+        manifest_path,
+    })
+}
