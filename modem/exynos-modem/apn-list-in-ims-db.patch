+-- The carrier's APN list, exactly as CarrierSettings ships it, with the
+-- vendor's enums already converted to what the CP is handed -- the same
+-- division of labour as `setting` below.
+--
+-- The whole list matters, not just the one APN a context wants: the CP will not
+-- match a URSP rule for any APN it has not been given a data profile for, and
+-- answers MATCH_ALL_RULE_NOT_ALLOWED (2253) instead. Registering the list and
+-- then attaching on the entry marked IA is what Android does, confirmed on the
+-- wire -- see docs/subsystems/modem/voice.md.
+CREATE TABLE apn (
+    carrier   INTEGER NOT NULL REFERENCES carrier(id),
+    seq       INTEGER NOT NULL,   -- the vendor's own order, which is significant
+    name      TEXT,
+    apn       TEXT NOT NULL,
+    types     INTEGER NOT NULL,   -- ApnSetting bitmask: IMS = 0x40, IA = 0x100
+    bearers   INTEGER NOT NULL,   -- 1 << (radio tech - 1); 0 means any
+    protocol  INTEGER NOT NULL,   -- SIT PdpType: 1 = IPv4, 2 = IPv6, 3 = IPv4v6
+    roaming   INTEGER NOT NULL,
+    PRIMARY KEY (carrier, seq)
+) WITHOUT ROWID;
 -- Merged and already transformed: `value` is what the CP is handed.
