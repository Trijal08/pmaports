# The single USB-C port has no Type-C controller and no ID pin, so nothing
# ever drives the role switch: role-switch-default-mode in the device tree
# sets up the hardware but never calls usb_role_switch_set_role(), and the
# class attribute keeps reporting "none". usb-signaller reads it, gives up
# with "Unknown USB role, cannot proceed", and the gadget is never built.
#
# Put the switch in the mode the device tree asked for. Guarded on "none" so
# it never fights a role that something else - the ES menu, usb-signaller
# switching to host mode - has deliberately set.
SUBSYSTEM=="usb_role", ACTION=="add", ATTR{role}=="none", ATTR{role}="device"
