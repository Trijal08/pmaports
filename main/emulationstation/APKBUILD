options="!check"
source="$pkgname-$_commit.tar.gz::https://github.com/archr-linux/emulationstation-next/archive/$_commit.tar.gz"
builddir="$srcdir/emulationstation-next-$_commit"

prepare() {
	default_prepare

	# Every source includes <pugixml/src/pugixml.hpp> - the path of the
	# git submodule this fork vendors under external/. GitHub's archive
	# tarball contains no submodules, and USE_SYSTEM_PUGIXML only
	# redirects the LINK step (find_package + target_link_libraries), so
	# the include itself still has to resolve. Point it at the system
	# headers, which pugixml-dev already provides. pugixml.hpp includes
	# "pugiconfig.hpp" relatively, so both have to sit in that directory.
	# rm first: the archive leaves the submodule as an empty directory or
	# a gitlink stub, and mkdir -p fails on the latter.
	rm -rf external/pugixml
	mkdir -p external/pugixml/src
	ln -sf /usr/include/pugixml.hpp external/pugixml/src/pugixml.hpp
	ln -sf /usr/include/pugiconfig.hpp external/pugixml/src/pugiconfig.hpp

	# GCC 13+ stopped pulling <cstdint> in transitively, so every file using
	# int8_t and friends has to include it itself. 17 files here do not, and
	# which of them break depends on what each translation unit happens to
	# pull in - MetaData.h was simply the first. Add the include wherever it
	# is missing rather than carry a multi-hunk patch against a moving fork;
	# adding it to a file that already compiles is harmless.
	grep -rlE '\b(u?int(8|16|32|64)_t)\b' es-app/src es-core/src \
		| grep -E '\.(h|hpp|cpp)$' \
		| while read -r f; do
			grep -qE '#include *[<"](cstdint|stdint\.h)[>"]' "$f" && continue
			if grep -q '^#pragma once' "$f"; then
				awk '{print} !ins && /^#pragma once/ {print "#include <cstdint>"; ins=1}' \
					"$f" > "$f.cstdint"
			else
				{ echo '#include <cstdint>'; cat "$f"; } > "$f.cstdint"
			fi
			mv "$f.cstdint" "$f"
		done

	# musl removed the LFS64 aliases in 1.2.4 - plain stat is already
	# 64-bit there, and this file sets _FILE_OFFSET_BITS anyway. It
	# defines stat64 for Windows but assumes glibc otherwise, so add the
	# musl case in the same idiom. Only the FIRST of the seven
	# "#else // _WIN32" lines opens the block that needs it.
	#
	# zip_file.hpp also mentions stat64, but in a branch miniz does not
	# take here - it reports "Using fopen, ftello, fseeko, stat()" and
	# ZipFile.cpp already compiles.
	awk '!ins && /^#else \/\/ _WIN32$/ {print; print "#if !defined(__GLIBC__)"; print "#define stat64 stat"; print "#endif"; ins=1; next} {print}' \
		es-core/src/utils/FileSystemUtil.cpp > FileSystemUtil.cpp.musl
	mv FileSystemUtil.cpp.musl es-core/src/utils/FileSystemUtil.cpp
}

build() {
	# ARCHR is deliberately left OFF. It is only a -DARCHR preprocessor
	# define, but it switches the code to ArchR's /storage and /usr/config
	# layout, which does not exist here. Turn it on only if you also
	# recreate that layout.
	#
	# GLES2 rather than GL: the RK3326 Mali runs through panfrost, and this
	# is what ArchR ships for the same SoC.
	# ENABLE_PULSE=OFF: it makes VolumeControl talk to a PulseAudio
	# server, and this image has neither libpulse nor pipewire-pulse -
	# the audio backend is PipeWire reached through its ALSA plugin. ES
	# drives the hw:0 mixer directly instead, which is what the session
	# script's AudioCard=hw:0 selects.
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DGLES2=ON \
		-DGL=OFF \
		-DCEC=OFF \
		-DDISABLE_KODI=ON \
		-DENABLE_FILEMANAGER=OFF \
		-DENABLE_PULSE=OFF \
		-DUSE_SYSTEM_PUGIXML=ON
	cmake --build build
}

package() {
	# CMake only installs the binary (es-app: install(TARGETS ... DESTINATION
	# bin)); resources are copied by hand upstream too.
	DESTDIR="$pkgdir" cmake --install build

	install -d "$pkgdir"/usr/share/emulationstation
	cp -r resources "$pkgdir"/usr/share/emulationstation/
}
