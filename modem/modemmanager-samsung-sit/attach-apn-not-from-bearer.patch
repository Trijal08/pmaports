+/*
+ * Connecting a bearer does not touch the attach APN.
+ *
+ * SET_INITIAL_ATTACH_APN names the APN the CP puts in its ATTACH REQUEST, and
+ * the CP keeps whatever it was last told. It is therefore modem-wide state and
+ * not a property of the context being brought up, so a bearer connect must not
+ * spend it: doing so overwrites the attach entry chosen at power-up with
+ * whichever APN this bearer happens to carry -- 'ims' for the IMS PDN, and ""
+ * for a bearer that names none. Android never sends it from its data-call path
+ * either.
+ *
+ * The damage is not limited to the attach that follows. An attach APN the HSS
+ * does not know draws ESM cause 27 (missing or unknown APN), the CP retries,
+ * gives up and reports EMM cause 10 (implicitly detached), and from there it
+ * refuses every PDN with MATCH_ALL_RULE_NOT_ALLOWED (2253) -- including the IMS
+ * one, so there is no VoLTE. Both indications were observed on a boot where
+ * this step had rewritten the attach APN 19 times; neither appears in the
+ * capture of this modem's own Android.
+ *
+ * The owners of the attach APN are therefore the power-up path, which seeds it
+ * from the carrier's IA (or DEFAULT) entry before the radio goes on, and
+ * SetInitialEpsBearerSettings, which is the user's explicit policy.
+ */
 typedef enum {
     CONNECT_STEP_PREFERRED_MODEM,
     CONNECT_STEP_DATA_PROFILE,
-    CONNECT_STEP_ATTACH_APN,
     CONNECT_STEP_CONFIG_0900,
     CONNECT_STEP_CONFIG_0106,
     CONNECT_STEP_CONFIG_0107,
