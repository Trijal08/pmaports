From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Thu, 6 Nov 2026 00:00:00 +0000
Subject: [PATCH] samsung-sit: ask the whole registration quartet, and stop
 waiting before the context

Five Android boots captured today on this baseband with these SIMs, so every
count below is from identical conditions rather than one capture.

The registration check is a quartet in stock and was not in ours. Stock's
four counts track each other and ours did not, because GET_OPERATOR only ran
on the unregistered path and QUERY_NETWORK_SELECTION_MODE was sent once per
boot:

                     stock ch0xf5   ours    stock ch0xf6   ours
    0x0700 voice reg     14-17        8        15-21        10
    0x0701 data reg      15-18        8        16-22        11
    0x0702 operator      16-19        9        17-25        15
    0x0703 selection     16-19        1        17-25         2

0x0703 was the largest single count divergence left in the AP->CP stream.
Both now run on every check, which is what makes the four track.

And the five boots give the registration timings this was all for:

                   f5          f6     inter-stack spread
    stock       20.9-28.8s  20.6-23.6s     1.0-5.3s
    ours r68      38.7s       36.8s          1.9s

Our spread is already inside stock's; the whole gap is absolute. 5s of it was
the settle window added in r56, which stock has no counterpart for. It was
justified by a correlation between the ask's distance from the first
PHYSICAL_CHANNEL_CONFIG and cause 168, and that was disproved in r57 -- an
ask 5901ms in was refused -- while since requests were pipelined the first
ask is granted anyway. It is removed: an invention that cost five seconds
per boot and never earned them.

--- a/src/plugins/samsung-sit/mm-sit-client.c
+++ b/src/plugins/samsung-sit/mm-sit-client.c
@@ -1516,12 +1516,15 @@
 /* A serving PLMN is also available while camped without registration. Keep the
  * raw registration state: the enable path provisions attachment before core
  * waits for registration, and a roaming subscription must remain roaming. */
+static void get_registration_selection_ready (MMSitClient *self, GAsyncResult *res, GTask *task);
+
 static void
 get_registration_operator_ready (MMSitClient *self,
                                  GAsyncResult *res,
                                  GTask *task)
 {
     g_autoptr(MMSitMessage) response = NULL;
+    g_autoptr(GByteArray)   request = NULL;
     g_autoptr(GError)       error = NULL;
     MMSitRegistration      *registration = g_task_get_task_data (task);
     MMSitRegistration      *result;
@@ -1540,6 +1543,35 @@
                     error ? error->message : "parse failed", registration->state);
     }
 
+    /*
+     * And the selection mode, which stock issues as part of the same check --
+     * 16-19 times on ch 0xf5 and 17-25 on 0xf6 across five boots, matching its
+     * other three. We sent it once per boot, which was the single largest
+     * count divergence left in the AP->CP stream.
+     */
+    request = mm_sit_request_new_query (MM_SIT_MESSAGE_QUERY_NETWORK_SELECTION_MODE,
+                                        mm_sit_client_next_token (self));
+    mm_sit_client_command (self, request, 5, g_task_get_cancellable (task),
+                           (GAsyncReadyCallback) get_registration_selection_ready,
+                           task);
+}
+
+/* Last of the quartet; its answer is not needed, only the asking. */
+static void
+get_registration_selection_ready (MMSitClient  *self,
+                                  GAsyncResult *res,
+                                  GTask        *task)
+{
+    g_autoptr(MMSitMessage)  response = NULL;
+    g_autoptr(GError)        error = NULL;
+    MMSitRegistration       *registration = g_task_get_task_data (task);
+    MMSitRegistration       *result;
+
+    response = mm_sit_client_command_finish (self, res, &error);
+    if (!response)
+        mm_obj_dbg (self->priv->port, "registration check: no selection mode (%s)",
+                    error->message);
+
     result = g_new (MMSitRegistration, 1);
     *result = *registration;
     g_task_return_pointer (task, result, g_free);
@@ -1565,12 +1597,13 @@
         return;
     }
 
-    if (registration->registered) {
-        g_task_return_pointer (task, registration, g_free);
-        g_object_unref (task);
-        return;
-    }
-
+    /*
+     * Stock queries the operator on every registration check, not only when
+     * the CP says it is not registered: across five boots on this baseband its
+     * GET_OPERATOR count tracks its GET_DATA_REGISTRATION count almost exactly
+     * (16-19 against 15-18 on ch 0xf5). Ours ran only on the unregistered
+     * path, so it fell behind.
+     */
     g_task_set_task_data (task, registration, g_free);
     request = mm_sit_request_new_query (MM_SIT_MESSAGE_GET_OPERATOR,
                                         mm_sit_client_next_token (self));
--- a/src/plugins/samsung-sit/mm-sit-ims.c
+++ b/src/plugins/samsung-sit/mm-sit-ims.c
@@ -97,26 +97,6 @@
  */
 #define RAT_GRACE_SECS 60
 
-/*
- * How long the CP needs after the radio comes up before it will grant a PDN
- * that is not the attach PDN.
- *
- * The CP announces its physical-channel configuration
- * (SIT_IND_PHYSICAL_CHANNEL_CONFIG) once the radio has carriers assigned, and
- * it is not ready for a second context the moment that lands. Measured across
- * six revisions and two carriers, with the gap from that first indication to
- * our SETUP_DATA_CALL on the x axis:
- *
- *     266-694ms   10 asks   10x cause 168 (a local refusal, back in 9-61ms)
- *     5065-6647ms  2 asks   2x granted    (stock, on this same firmware)
- *     7550-15066ms 2 asks   2x granted    (ours, once this wait was added)
- *
- * No ask inside 700ms has ever been granted and no ask past 5s has ever been
- * refused, so wait out stock's margin. This is a property of the modem, not of
- * any network: it is keyed to the CP's own indication and to our registration,
- * and no part of it depends on the operator.
- */
-#define PDN_SETTLE_MS 5000
 
 /*
  * How long a provisioned stack is given to register before the PDN is thrown
@@ -202,14 +182,6 @@
     /* The modem's own registration -- the radio being up and settled. Distinct
      * from `registered` below, which is the CP's IMS/SIP registration. */
     gboolean                net_registered;
-    /*
-     * When the radio registered and when the CP first described its physical
-     * channel, plus the pending wake-up that lets PDN_SETTLE_MS pass after the
-     * later of the two before we ask for the IMS PDN.
-     */
-    gint64                  net_registered_us;
-    gint64                  phych_us;
-    guint                   settle_id;
     MMSitVopsSupport        vops_support;
 
     /* The context the CP granted, kept because every later step describes it --
@@ -1543,35 +1515,11 @@
     case MM_SIT_MESSAGE_AIMS_CALL_STATUS:
         handle_call_status (self, message);
         break;
-    case MM_SIT_MESSAGE_PHYSICAL_CHANNEL_CONFIG:
-        /* The other mark of the settle window; see PDN_SETTLE_MS. Only the
-         * first one counts -- the CP repeats this throughout the session, and
-         * stock asks 600ms after a later one. */
-        if (!self->priv->phych_us) {
-            self->priv->phych_us = g_get_monotonic_time ();
-            mm_obj_dbg (self, "the CP described its physical channel; "
-                        "IMS may ask for a PDN %u ms from now",
-                        (guint) PDN_SETTLE_MS);
-            mm_sit_ims_reevaluate (self);
-        }
-        break;
     default:
         break;
     }
 }
 
-/*
- * Re-evaluates rather than starting directly: a physical-channel indication
- * that arrives while we are waiting moves the deadline out, and the gate below
- * re-arms this for whatever is left. See PDN_SETTLE_MS.
- */
-static gboolean
-settle_expired (MMSitIms *self)
-{
-    self->priv->settle_id = 0;
-    mm_sit_ims_reevaluate (self);
-    return G_SOURCE_REMOVE;
-}
 
 static gboolean
 rat_grace_expired (MMSitIms *self)
@@ -1631,8 +1579,6 @@
     }
 
     if (possible && self->priv->state == IMS_STATE_STOPPED) {
-        gint64 ready_us;
-
         ensure_device_identity (self);
         if (!self->priv->have_identity) {
             mm_obj_dbg (self, "not starting IMS: no device identity for the User-Agent");
@@ -1649,29 +1595,6 @@
             mm_obj_dbg (self, "not starting IMS yet: waiting for the radio to register");
             return;
         }
-        /*
-         * And let the CP settle before asking for a context that is not the
-         * attach context; see PDN_SETTLE_MS. Both marks are first-event marks,
-         * so this cannot starve: if the CP never describes a physical channel,
-         * the registration mark still carries the deadline.
-         */
-        ready_us = MAX (self->priv->net_registered_us, self->priv->phych_us);
-        if (ready_us) {
-            gint64 waited_ms = (g_get_monotonic_time () - ready_us) / 1000;
-
-            if (waited_ms < PDN_SETTLE_MS) {
-                guint remaining = (guint) (PDN_SETTLE_MS - waited_ms);
-
-                if (self->priv->settle_id)
-                    g_source_remove (self->priv->settle_id);
-                mm_obj_dbg (self, "not starting IMS yet: letting the CP settle for %u ms more",
-                            remaining);
-                self->priv->settle_id = g_timeout_add (remaining,
-                                                       (GSourceFunc) settle_expired,
-                                                       self);
-                return;
-            }
-        }
         mm_obj_dbg (self, "packet-switched RAT available; starting IMS");
         self->priv->state = IMS_STATE_STARTING;
         g_clear_object (&self->priv->cancellable);
@@ -1713,9 +1636,6 @@
     if (self->priv->net_registered == !!registered)
         return;
     self->priv->net_registered = !!registered;
-    /* The first mark of the settle window; see PDN_SETTLE_MS. */
-    if (registered && !self->priv->net_registered_us)
-        self->priv->net_registered_us = g_get_monotonic_time ();
 
     if (!registered) {
         /*
@@ -1983,10 +1903,6 @@
 
     clear_cooldown (self);
     clear_retry (self);
-    if (self->priv->settle_id) {
-        g_source_remove (self->priv->settle_id);
-        self->priv->settle_id = 0;
-    }
     clear_rat_grace (self);
     if (self->priv->cancellable) {
         g_cancellable_cancel (self->priv->cancellable);
--- a/src/plugins/samsung-sit/tests/test-sit-protocol.c
+++ b/src/plugins/samsung-sit/tests/test-sit-protocol.c
@@ -1847,6 +1847,13 @@
          * connect sequence.
          */
         MM_SIT_MESSAGE_GET_DATA_REGISTRATION,
+        /*
+         * The rest of the quartet stock issues on every registration check:
+         * its GET_OPERATOR and QUERY_NETWORK_SELECTION_MODE counts track its
+         * GET_DATA_REGISTRATION count across five boots.
+         */
+        MM_SIT_MESSAGE_GET_OPERATOR,
+        MM_SIT_MESSAGE_QUERY_NETWORK_SELECTION_MODE,
         MM_SIT_MESSAGE_SETUP_DATA_CALL,
         MM_SIT_MESSAGE_SET_FAST_DORMANCY_INFO,
     };
@@ -2735,11 +2742,15 @@
 {
     guint8 registration[86] = { 0 };
     guint8 operator[119] = { 0 };
+    guint8 selection[8] = { 0 };
 
     registration[15] = 14;
     memcpy (&operator[12], "26202#", 6);
     reply_request (ctx->peer_fd, MM_SIT_MESSAGE_GET_DATA_REGISTRATION, registration, sizeof (registration));
     reply_request (ctx->peer_fd, MM_SIT_MESSAGE_GET_OPERATOR, operator, sizeof (operator));
+    /* The quartet's last member; the check asks but does not read the answer. */
+    reply_request (ctx->peer_fd, MM_SIT_MESSAGE_QUERY_NETWORK_SELECTION_MODE,
+                   selection, sizeof (selection));
     return NULL;
 }
 
