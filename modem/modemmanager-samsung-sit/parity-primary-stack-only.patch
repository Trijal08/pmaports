- * <android-sitdump.bin> <this-header.h> <out.h> [chan]
+ * GENERATED -- do not edit by hand. See gen-boot-parity.py.
  *
  * The requests this modem's own Android sends on a SIT control stack between
  * the RIL's first frame and its first IMS PDN, less the ones this plugin
@@ -64,6 +62,13 @@
     MMSitParitySub   sub;
     guint16          len;
     const guint8    *payload;
+    /*
+     * Stock sent this on one control stack only, so it is about the AP and not
+     * about a subscription: the system clock, the OEM config, the debug-trace
+     * setting. Replayed on the primary stack alone. Derived from the capture --
+     * the id is absent from the other stack's boot window -- not chosen.
+     */
+    gboolean         primary_only;
 } MMSitParityRequest;
 
 static const guint8 mm_sit_parity_pay_000[1] = { 0x00 };
