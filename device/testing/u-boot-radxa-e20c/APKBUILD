maintainer="Federico Amedeo Izzo <federico@izzo.pro>"
pkgname=u-boot-radxa-e20c
pkgver=2017.09
pkgrel=0
_ddr_ver=1.13
_trust_ver=1.21
pkgdesc="U-Boot fork for the Radxa E20C"
url="https://github.com/radxa/u-boot"
arch="aarch64"
license="GPL-2.0"
options="!check !tracedeps"
makedepends="
	bash
	bc
	bison
	coreutils
	dtc
	flex
	openssl-dev
	python3
	py3-setuptools
	python3-dev
	swig
	u-boot-tools
"
_repository="u-boot"
_commit="5f685f833a8eec686f0105c1cbd5f42d502d486f"
_rkbin_commit="e6c4cb5c9e6918f4f2fbbfa781e38309b9656bcb"
source="
	$pkgname-$_commit.tar.gz::https://github.com/radxa/$_repository/archive/$_commit.tar.gz
	https://github.com/radxa/rkbin/raw/$_rkbin_commit/bin/rk35/rk3528_bl31_v$_trust_ver.elf
	https://github.com/radxa/rkbin/raw/$_rkbin_commit/bin/rk35/rk3528_ddr_1056MHz_v$_ddr_ver.bin
	https://github.com/radxa/rkbin/raw/$_rkbin_commit/bin/rk35/rk3528_spl_loader_v1.13.106.bin

	0001-menu-fix-timeout-duration.patch

	update-u-boot
"
builddir="$srcdir/$_repository-$_commit"

build() {
	export ROCKCHIP_TPL="$srcdir"/rk3528_ddr_1056MHz_v$_ddr_ver.bin
	export BL31="$srcdir"/rk3528_bl31_v$_trust_ver.elf

	make rock-2-rk3528_defconfig
	make all u-boot.itb

	# make idbloader.img
	mkimage -n rk3528 -T rksd -d "$ROCKCHIP_TPL:$builddir"/spl/u-boot-spl.bin "$builddir"/idbloader.img
}

package() {
	install -D -m755 "$srcdir"/update-u-boot "$pkgdir"/usr/bin/update-u-boot
	install -Dm644 \
		"$builddir"/idbloader.img \
		"$builddir"/u-boot.itb \
		"$srcdir"/rk3528_spl_loader_v1.13.106.bin \
		-t "$pkgdir"/usr/share/u-boot/radxa-e20c
}

