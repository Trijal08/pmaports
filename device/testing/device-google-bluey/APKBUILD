maintainer="Anton Bambura <jenneron@protonmail.com>"
pkgname=device-google-bluey
pkgdesc="Google Bluey Chromebooks"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	depthcharge-tools
	firmware-google-bluey
	linux-firmware-ath12k
	linux-firmware-qca
	linux-firmware-qcom
	linux-google-bluey
	postmarketos-base
	soc-qcom
"
makedepends="devicepkg-dev"
source="
	bluey.conf
	deviceinfo
	firmware.files
	kernel-cmdline.conf
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# ADSP is required for booting from USB
	install -Dm644 "$srcdir"/firmware.files \
		-t "$pkgdir"/usr/share/mkinitfs/files

	# Temporary config until there is a new depthcharge-tools tag with bluey support
	install -Dm644 "$srcdir"/bluey.conf \
		-t "$pkgdir"/etc/depthcharge-tools/config.d
}

