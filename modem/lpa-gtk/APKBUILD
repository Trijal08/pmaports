f19661c46a6cd124dabb5ea0f957dd2e6b3a57fdf84285559b4b38af7a5c1ecffb85b3fa6f12e5bd23297230fc0b44c4e39b7f2d0d82c87f41398a2961764cbf  sit-session.patch
