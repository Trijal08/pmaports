modem() {
	pkgdesc="Google Pixel 9 Pro Fold S5400 Modem and GNSS firmware"

	# Modem Partition Mounting Script
	install -Dm755 "$srcdir"/initramfs_setup_modemfw.sh \
		-t "$subpkgdir/usr/share/mkinitfs/hooks-cleanup/"

	# Carrier config
	install -d "$subpkgdir/lib/firmware/google/s5400/carrierconfig/"
	rsync -a --chmod=D755,F644 "$builddir"/proprietary/vendor/firmware/carrierconfig/ "$subpkgdir/lib/firmware/google/s5400/carrierconfig/"

	# UE Cap config
	install -d "$subpkgdir/lib/firmware/google/s5400/uecapconfig/"
	rsync -a --chmod=D755,F644 "$builddir"/proprietary/vendor/firmware/uecapconfig/ "$subpkgdir/lib/firmware/google/s5400/uecapconfig/"

	# Main Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/kepler.bin \
		"$subpkgdir/lib/firmware/google/s5400/kepler.bin"
}

aoc() {
	pkgdesc="Google Pixel 9 Pro Fold AoC (Always-on-Compute) firmware"

	# Main Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/aoc.bin \
		"$subpkgdir/lib/firmware/google/aoc.bin"

	# AoC Sensor USF Registry
	install -d "$subpkgdir/lib/firmware/google/usf/comet/"
	rsync -a --chmod=D755,F644 "$builddir"/proprietary/vendor/etc/sensors/registry/ "$subpkgdir/lib/firmware/google/usf/comet/"
}

audio() {
	pkgdesc="Google Pixel 9 Pro Fold Audio DSP/Protection firmware"

	# Speaker Protection Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/cs35l41-dsp1-spk-prot.wmfw \
		"$subpkgdir/lib/firmware/cirrus/cs35l41-dsp1-spk-prot-comet.wmfw"

	# Left Speaker Tuning Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/cs35l41-dsp1-spk-prot.bin \
		"$subpkgdir/lib/firmware/cirrus/cs35l41-dsp1-spk-prot-comet.bin"

	# Right Speaker Tuning Firmware Blob
	install -Dm644 "$builddir"/proprietary/vendor/firmware/R-cs35l41-dsp1-spk-prot.bin \
		"$subpkgdir/lib/firmware/cirrus/cs35l41-dsp1-spk-prot-comet-r.bin"
}
