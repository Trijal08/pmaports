+/// One APN of a carrier's list, with the vendor's enums already mapped to the
+/// values the CP expects.
+pub struct ApnRow {
+    pub name: String,
+    pub apn: String,
+    pub types: u32,
+    pub bearers: u32,
+    pub protocol: u8,
+    pub roaming: u8,
+}
+
+/// `bearer_bitmask` lists `TelephonyManager.NETWORK_TYPE_*`, which are 1-based;
+/// AOSP turns each into `1 << (n - 1)`.
+fn bitmask<I: IntoIterator<Item = i32>>(values: I) -> u32 {
+    values
+        .into_iter()
+        .filter(|&v| (1..=32).contains(&v))
+        .fold(0u32, |m, v| m | 1 << (v - 1))
+}
+
+/// `ApnItem.ApnType` -> `android.hardware.radio.data.ApnTypes`.
+///
+/// Deliberately a table, not `1 << (v - 1)`. Two things that arithmetic gets
+/// wrong, both measured against the stock capture on identical firmware:
+///
+/// * The proto enum is `ALL DEFAULT MMS SUPL DUN HIPRI FOTA IMS CBS IA
+///   EMERGENCY XCAP UT RCS` with **no MCX**, while `ApnTypes` has
+///   `MCX = 1 << 10` between EMERGENCY and XCAP. So everything from XCAP up is
+///   one bit out: `xcap` and `services.telus.com` went out 1024 where stock
+///   sends 2048.
+/// * `DEFAULT` carries `HIPRI`, because `ApnSetting.TYPE_DEFAULT` is
+///   `ApnTypes.DEFAULT | ApnTypes.HIPRI`. An APN typed `default,mms,supl`
+///   is 23 to stock and was 7 here.
+///
+/// `ALL` (0) is dropped: it means "every kind", and what that expands to is the
+/// framework's own `TYPE_ALL`, not something to invent here. `UT` (12) has no
+/// `ApnTypes` member, so it is dropped rather than aliased onto XCAP.
+fn apn_type_mask<I: IntoIterator<Item = i32>>(values: I) -> u32 {
+    const DEFAULT: u32 = 1 << 0;
+    const HIPRI: u32 = 1 << 4;
+    values.into_iter().fold(0u32, |m, v| {
+        m | match v {
+            1 => DEFAULT | HIPRI,
+            2 => 1 << 1,   // MMS
+            3 => 1 << 2,   // SUPL
+            4 => 1 << 3,   // DUN
+            5 => HIPRI,
+            6 => 1 << 5,   // FOTA
+            7 => 1 << 6,   // IMS
+            8 => 1 << 7,   // CBS
+            9 => 1 << 8,   // IA
+            10 => 1 << 9,  // EMERGENCY
+            11 => 1 << 11, // XCAP; MCX holds 1 << 10
+            13 => 1 << 15, // RCS
+            _ => 0,
+        }
+    })
+}
+
+/// `ApnItem.Protocol` is IP = 0, IPV6 = 1, IPV4V6 = 2; SIT numbers the same
+/// three from one. Absent means IP, which is both the proto default and
+/// `ApnSetting`'s.
+fn sit_pdp(protocol: Option<i32>) -> u8 {
+    (protocol.unwrap_or(0) + 1) as u8
+}
+
+/// Convert a carrier's APN list for the database.
+pub fn apn_rows(apns: &[crate::ApnItem]) -> Vec<ApnRow> {
+    apns.iter()
+        .filter_map(|a| {
+            // An entry with no APN names no DNN, so there is nothing to
+            // register and nothing to attach with.
+            let apn = a.apn.clone().filter(|s| !s.is_empty())?;
+            let bearers = a
+                .bearer_bitmask
+                .as_deref()
+                .map(|b| bitmask(b.split('|').filter_map(|t| t.trim().parse().ok())))
+                .unwrap_or(0);
+            Some(ApnRow {
+                name: a.name.clone().unwrap_or_default(),
+                apn,
+                types: apn_type_mask(a.r#type.iter().copied()),
+                bearers,
+                protocol: sit_pdp(a.protocol),
+                // Not `.or(a.protocol)`. proto2 omits a field equal to its
+                // default and this one's default is IP, so a carrier that says
+                // roaming_protocol="IP" arrives as None -- falling back to the
+                // home protocol then sends the wrong value. `sp.telus.com` is
+                // exactly that case: protocol="IPV4V6" roaming_protocol="IP",
+                // stock sends 1, the fallback sent 3.
+                roaming: sit_pdp(a.roaming_protocol),
+            })
+        })
+        .collect()
+}
