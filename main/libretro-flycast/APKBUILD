# Maintainer: Trijal Saha <trijalsaha2012@gmail.com>
pkgname=libretro-flycast
pkgver=0_git20260706
pkgrel=1
_commit="45bd2f4e59708a7c16a5bb1cb90a94d1b39e330d"
pkgdesc="libretro core for flycast"
url="https://github.com/libretro/flycast"
# aarch64 only, on purpose: "pmbootstrap build" with no --arch builds for
# the native architecture whenever the APKBUILD lists it, so listing
# x86_64 here quietly builds a package the R36S cannot use.
arch="aarch64"
license="GPL-2.0-only"
options="!check" # No tests
# Overrides Alpine's aport, which is pinned at 0_git20220406 - an April 2022
# snapshot. This is the libretro mirror's HEAD as of 2026-07-06: four years
# of Dreamcast fixes, and nothing more exotic than that. The option keys are
# unchanged (libretro_core_option_defines.h still says CORE_OPTION_NAME
# "reicast"), so reicast_region and the rest of the tuning carry over.
#
# Not flyinghead/flycast, which is what Arch packages: upstream moved the
# libretro target to CMake and needs nine git submodules (asio, glslang,
# libchdr, tinycmmc, tinygettext, Vulkan-Headers, VulkanMemoryAllocator,
# xbyak). The mirror still ships the legacy Makefile and vendors everything
# under core/deps, so a plain archive builds - a version bump rather than a
# packaging project. Upstream is also the heavier renderer, which is the
# wrong direction for a 4x Cortex-A35.
makedepends="libzip-dev mesa-dev zlib-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/libretro/flycast/archive/$_commit.tar.gz"
builddir="$srcdir/flycast-$_commit"

case $CARCH in
aarch64)
	# HOST_CPU_FLAGS is computed by the Makefile from WITH_DYNAREC
	# (-DHOST_CPU=0x20000006 for arm64). Passing it on the command line
	# would override that assignment and leave HOST_CPU undefined.
	_args="WITH_DYNAREC=arm64 HAVE_GENERIC_JIT=0 HAVE_VULKAN=0" ;;
arm*)
	_args="WITH_DYNAREC=arm HAVE_GENERIC_JIT=0 HAVE_VULKAN=0" ;;
esac

build() {
	# Unbundle libzip and zlib, as Alpine's aport does. Keeping them
	# vendored builds an inconsistency: there is no -I for core/deps/zlib,
	# so every #include <zlib.h> resolves to the SYSTEM header while the
	# vendored 1.2.8 implementation is what gets linked. Alpine's core,
	# built this way, does not crash; ours, built against the bundled
	# copies, segfaults intermittently a frame or two into a game and
	# hangs (Flycast's SIGSEGV handler cannot attribute the fault, so it
	# hits DEBUGBREAK and the process freezes with the display dead).
	# miniupnpc has no SYSTEM_ switch in this tree, so it stays vendored.
	#
	# This also drops the need for the vendored-libzip unistd.h patch:
	# SYSTEM_LIBZIP=1 removes those sources from the build entirely.
	rm -rf core/deps/libzip core/deps/zlib
	#
	# gcc locates its own startup files relative to argv[0], and under
	# crossdirect argv[0] is the wrapper in /native/usr/lib/crossdirect,
	# so crtbeginS.o and libgcc.a go missing:
	#
	#     $ c++ -print-file-name=crtbeginS.o
	#     crtbeginS.o                     # i.e. not found
	#
	# LIBRARY_PATH, not -B. -B also redirects where the driver looks for
	# *programs*, which makes it prefer the native cross ld in
	# /native/usr/<triplet>/bin over the target ld the chroot runs under
	# qemu. That native ld then tries to load the chroot's aarch64 libz
	# and dies on it - "Error relocating /lib/libz.so.1: unsupported
	# relocation type 1026", exit 127. Leaving ld to come from PATH is
	# what worked all along; LIBRARY_PATH touches only startup files and
	# -l lookups, which is exactly what is broken. No-op off crossdirect.
	for _d in /native/usr/lib/gcc/*/*/; do
		if [ -f "$_d/crtbeginS.o" ]; then
			export LIBRARY_PATH="$_d"
		fi
	done

	# HAVE_OPENMP=0: Alpine's cross gcc has no omp.h in its internal
	# include directory (the target's gcc does, but that is not the one
	# crossdirect runs). Flycast wants OpenMP in exactly one place, the
	# xBRZ texture upscaler, which a 4x Cortex-A35 cannot run at a
	# playable speed anyway. The switch defines TARGET_NO_OPENMP, which
	# TexCache.cpp guards every omp use behind - the upscaler falls back
	# to a serial xbrz::scale() - and softrend.cpp, the only other omp.h
	# user, is not in Makefile.common's source list.
	#
	# LDFLAGS_END=-fno-use-linker-plugin: Alpine's gcc is built with
	# HAVE_LTO_PLUGIN=2 and offers the linker an LTO plugin on every link.
	# Nothing here is compiled with LTO (HAVE_LTCG=0). LDFLAGS_END is
	# empty on every non-Windows target and appears only in the link rule.
	make $_args HAVE_LTCG=0 HAVE_OPENMP=0 \
		SYSTEM_LIBZIP=1 SYSTEM_ZLIB=1 \
		LDFLAGS_END=-fno-use-linker-plugin
}

package() {
	install -Dm644 flycast_libretro.so \
		"$pkgdir"/usr/lib/libretro/flycast_libretro.so
}

sha512sums="
7eabfae2ccaf7c310badc4ff736a20f21548b9978d67871fda5cb441e24fb9c8fa2aaabb3ae34cbbc8a9531f859b23e27acc0a0e8ffe6419b535b57275f0226c  libretro-flycast-45bd2f4e59708a7c16a5bb1cb90a94d1b39e330d.tar.gz
"
