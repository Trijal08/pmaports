From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] samsung-sit: send AIMS_SET_CALL_WAITING, and a live frame time

Two live clocks in the AIMS block. Both were decoded off the Android
capture rather than guessed.

**AIMS_SET_CALL_WAITING (0x0d17)** we never sent at all; stock sends it
3 times on ch 0xf5 and 2 on 0xf6. Its 24-byte payload is

    01 00 00 00 | 01 00 00 00 | 00 | 1a 0b 04 16 17 1e | 00 00 03 | 00 x6
                                     yy mm dd HH MM SS

-- `1a 0b 04 16 17 1e` is 2026-11-04 22:23:30, the moment that capture was
taken, as plain bytes rather than BCD. Only the seconds byte differs
between the five frames in one boot, which is what made it obvious.
MM_SIT_BOOT_SUB_WALLCLOCK already existed and already fills exactly those
six bytes; it had no row to fill, so it was dead code. This adds the row.
The literal leaves the clock zero so a stale replay is obvious if the sub
is ever dropped, and the 0x03 at +17 is the constant the parity report had
as "+0x01d A=03 P=00".

Its count is one of the ones the boot-config header lists as varying
between captures, so the row says nothing and sends it once. Pinning a
capture's number is what made the replay table this replaced go stale.

**AIMS_SET_FRAME_TIME (0x0d0b)** we did send, with its clock frozen. Bytes
2-3 of the payload are a little-endian 16-bit millisecond counter:

    +10.38s -> 407      +52.55s -> 42577
    (42577 - 407) / (52.55 - 10.38) = 1000.0 per second

so it is a monotonic millisecond clock truncated to 16 bits, wrapping
every ~65s. The table replayed one frame's value -- 1056 for the first row
and 1229 for the second -- telling the CP the same instant on every boot,
on both stacks, twice. New MM_SIT_BOOT_SUB_FRAMETIME fills it from
g_get_monotonic_time().

The test peer's switch ends in g_assert_not_reached(), so 0x0d17 joins the
PRE_PDN group beside 0x0d0b: the replay reaches the peer and would
otherwise abort the retry test.
diff -ruN a/src/plugins/samsung-sit/mm-sit-boot-config.c b/src/plugins/samsung-sit/mm-sit-boot-config.c
--- a/src/plugins/samsung-sit/mm-sit-boot-config.c	2026-11-08 10:16:58.569277970 -0500
+++ b/src/plugins/samsung-sit/mm-sit-boot-config.c	2026-11-08 10:17:42.239462989 -0500
@@ -133,6 +133,21 @@
 static const guint8 pre_aims_xcapm_stop_req[2]  = { 0x01, 0x01 };
 static const guint8 pre_aims_xcapm_stop_off[2]  = { 0x00, 0x01 };
 static const guint8 pre_aims_set_frame_time[10] = { 0x00, 0x02, 0x20, 0x04, 0xa9, 0xa8, 0xa1, 0x01, 0x00, 0x00 };
+/*
+ * AIMS_SET_CALL_WAITING. Two u32 ones, a zero, then six bytes of wall clock
+ * at +9 (yy mm dd HH MM SS, yy = year - 2000, plain bytes not BCD) which
+ * MM_SIT_BOOT_SUB_WALLCLOCK fills in -- they are left zero here so a stale
+ * replay is obvious if the sub is ever dropped. The 0x03 at +17 is a constant
+ * stock always sends and we sent as zero.
+ */
+static const guint8 pre_aims_set_call_waiting[24] = {
+    0x01, 0x00, 0x00, 0x00,
+    0x01, 0x00, 0x00, 0x00,
+    0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x03,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
 static const guint8 pre_aims_xcapm_start_req[2] = { 0x01, 0x01 };
 static const guint8 pre_set_voice_operation[4] = { 0x03, 0x00, 0x00, 0x00 };
 static const guint8 pre_aims_set_frame_time_02[10] = { 0x00, 0x02, 0xcd, 0x04, 0xa9, 0xa8, 0xa1, 0x01, 0x00, 0x00 };
@@ -369,7 +384,16 @@
     { 0x0d3c, "aims xcapm stop req", MM_SIT_BOOT_PHASE_PRE_PDN,
       { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_xcapm_stop_req },
     { 0x0d0b, "aims set frame time", MM_SIT_BOOT_PHASE_PRE_PDN,
-      { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 10, pre_aims_set_frame_time },
+      { 0, 0 }, MM_SIT_BOOT_SUB_FRAMETIME, MM_SIT_BOOT_STACKS_ALL, 10, pre_aims_set_frame_time },
+    /*
+     * Stock sends this immediately after a frame time, interleaved through the
+     * AIMS block: +10.38 0x0d0b, +10.47 0x0d0b, +10.57 0x0d17 on ch 0xf5. Its
+     * count is one of the ones that varies between captures (3 and 2 per stack
+     * in the long one), so this says nothing and sends it once -- the header's
+     * rule, and the opposite of what made the old replay table go stale.
+     */
+    { 0x0d17, "aims set call waiting", MM_SIT_BOOT_PHASE_PRE_PDN,
+      { 0, 0 }, MM_SIT_BOOT_SUB_WALLCLOCK, MM_SIT_BOOT_STACKS_ALL, 24, pre_aims_set_call_waiting },
     { 0x0d3b, "aims xcapm start req", MM_SIT_BOOT_PHASE_PRE_PDN,
       { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 2, pre_aims_xcapm_start_req },
     { 0x0d3a, "aims stack stop req (flag clear)", MM_SIT_BOOT_PHASE_PRE_PDN,
@@ -391,7 +415,7 @@
     { 0x091a, "set voice operation", MM_SIT_BOOT_PHASE_PRE_PDN,
       { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 4, pre_set_voice_operation },
     { 0x0d0b, "aims set frame time", MM_SIT_BOOT_PHASE_PRE_PDN,
-      { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 10, pre_aims_set_frame_time_02 },
+      { 0, 0 }, MM_SIT_BOOT_SUB_FRAMETIME, MM_SIT_BOOT_STACKS_ALL, 10, pre_aims_set_frame_time_02 },
     { 0x0703, "query network selection mode", MM_SIT_BOOT_PHASE_PRE_PDN,
       { 0, 0 }, MM_SIT_BOOT_SUB_NONE, MM_SIT_BOOT_STACKS_ALL, 0, NULL },
     { 0x0700, "get voice registration", MM_SIT_BOOT_PHASE_PRE_PDN,
diff -ruN a/src/plugins/samsung-sit/mm-sit-boot-config.h b/src/plugins/samsung-sit/mm-sit-boot-config.h
--- a/src/plugins/samsung-sit/mm-sit-boot-config.h	2026-11-08 09:02:12.660485535 -0500
+++ b/src/plugins/samsung-sit/mm-sit-boot-config.h	2026-11-08 10:17:42.239388438 -0500
@@ -35,6 +35,13 @@
     MM_SIT_BOOT_SUB_STACK,
     /* @0x09: the current time, as the CP's six-byte calendar. */
     MM_SIT_BOOT_SUB_WALLCLOCK,
+    /*
+     * A 16-bit millisecond counter at payload+2, little-endian. Stock's runs
+     * at exactly 1000/s and wraps at 65536 (~65s): across one capture it read
+     * 407 at +10.38s and 42577 at +52.55s, and (42577-407)/(52.55-10.38) is
+     * 1000.0. A replayed constant tells the CP the same instant every frame.
+     */
+    MM_SIT_BOOT_SUB_FRAMETIME,
     /* The whole payload is built at run time; see mm_sit_boot_build_payload(). */
     MM_SIT_BOOT_SUB_BUILD,
 } MMSitBootSub;
diff -ruN a/src/plugins/samsung-sit/mm-sit-client.c b/src/plugins/samsung-sit/mm-sit-client.c
--- a/src/plugins/samsung-sit/mm-sit-client.c	2026-11-08 09:02:12.666485957 -0500
+++ b/src/plugins/samsung-sit/mm-sit-client.c	2026-11-08 10:17:42.239654461 -0500
@@ -3989,6 +3989,22 @@
         body[4 + 14] = (guint8) g_date_time_get_second (now);
         break;
     }
+    case MM_SIT_BOOT_SUB_FRAMETIME: {
+        /*
+         * Two bytes of millisecond clock at payload+2, little-endian, wrapping
+         * at 65536. Stock's advances at 1000/s; the table replayed one frame's
+         * value (1056, and 1229 for the second row), so every boot told the CP
+         * the same instant twice.
+         */
+        guint64 ms;
+
+        if (req->len < 4)
+            return NULL;
+        ms = (guint64) (g_get_monotonic_time () / 1000);
+        body[4 + 2] = (guint8) (ms & 0xff);
+        body[4 + 3] = (guint8) ((ms >> 8) & 0xff);
+        break;
+    }
     case MM_SIT_BOOT_SUB_BUILD:
     case MM_SIT_BOOT_SUB_NONE:
     default:
diff -ruN a/src/plugins/samsung-sit/tests/test-sit-protocol.c b/src/plugins/samsung-sit/tests/test-sit-protocol.c
--- a/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-08 10:16:58.569390251 -0500
+++ b/src/plugins/samsung-sit/tests/test-sit-protocol.c	2026-11-08 10:18:25.748448196 -0500
@@ -3019,6 +3019,7 @@
      * default arm trips.
      */
     case 0x0d0b:
+    case 0x0d17:
     case 0x0d3b:
     case 0x0d3c:
     case 0x091a:
