+++ b/crates/samsung-sit-ffi/src/carrier_db.rs
@@ -0,0 +1,200 @@
+//! C ABI over [`samsung_carrier_db`]: which carrier manifest a SIM should be
+//! configured with.
+//!
+//! Here for the same reason as the IMS resolver next door -- the vendor's
+//! `cfg.db`, its four fallback tiers and its ranking are this project's
+//! business, not a modem daemon's. A caller hands over a path and a SIM
+//! identity and gets a manifest to feed the CP.
+
+use core::ffi::{c_char, CStr};
+use std::ffi::CString;
+
+use samsung_carrier_db as db;
+
+use crate::{set_last_error, SamsungSitStatus};
+
+/// SHA1, in bytes, as the CP is given it.
+pub const SAMSUNG_CARRIER_SHA1_LEN: usize = 20;
+
+/// The SIM's identity, as the vendor resolvers match on it -- this one and
+/// the IMS one next door, which ignores the privilege access rule.
+///
+/// The discriminators matter: several carriers share an MCCMNC and are told
+/// apart only by SPN, GID or an IMSI prefix. Every field is a NUL-terminated
+/// UTF-8 string, or null when the SIM does not carry it.
+#[repr(C)]
+pub struct SamsungCarrierIdentity {
+    pub imsi: *const c_char,
+    pub iccid: *const c_char,
+    pub mccmnc: *const c_char,
+    pub spn: *const c_char,
+    pub gid1: *const c_char,
+    pub gid2: *const c_char,
+    pub privilege_access_rule: *const c_char,
+}
+
+/// The manifest a SIM resolved to. Opaque: it owns its strings. Freed with
+/// [`samsung_carrier_config_free`].
+pub struct SamsungCarrierConfig {
+    carrier_id: u32,
+    carrier_name: CString,
+    manifest_sha1: CString,
+    manifest_path: CString,
+    manifest_sha1_bytes: [u8; SAMSUNG_CARRIER_SHA1_LEN],
+}
+
+unsafe fn opt(s: *const c_char) -> Result<String, SamsungSitStatus> {
+    if s.is_null() {
+        return Ok(String::new());
+    }
+    CStr::from_ptr(s)
+        .to_str()
+        .map(str::to_owned)
+        .map_err(|_| SamsungSitStatus::Utf8)
+}
+
+/// Resolve the carrier manifest for `identity` out of the `cfg.db` at
+/// `database_path`.
+///
+/// The manifest file must be packaged beside the database: a name the CP
+/// cannot then be given is not a successful resolution, and the status says
+/// so rather than handing back a config that cannot be used.
+///
+/// On `Ok` the handle is written to `out` and must be freed with
+/// [`samsung_carrier_config_free`]; on anything else `out` is untouched and
+/// `samsung_sit_last_error_message` says why.
+///
+/// # Safety
+/// `database_path` must be a NUL-terminated UTF-8 string, `out` writable.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_carrier_config_resolve(
+    database_path: *const c_char,
+    identity: *const SamsungCarrierIdentity,
+    out: *mut *mut SamsungCarrierConfig,
+) -> SamsungSitStatus {
+    if out.is_null() || database_path.is_null() || identity.is_null() {
+        return SamsungSitStatus::NullPointer;
+    }
+    let path = match opt(database_path) {
+        Ok(p) => p,
+        Err(s) => return s,
+    };
+    let i = &*identity;
+    let id = db::CarrierIdentity {
+        imsi: match opt(i.imsi) { Ok(v) => v, Err(s) => return s },
+        iccid: match opt(i.iccid) { Ok(v) => v, Err(s) => return s },
+        mccmnc: match opt(i.mccmnc) { Ok(v) => v, Err(s) => return s },
+        spn: match opt(i.spn) { Ok(v) => v, Err(s) => return s },
+        gid1: match opt(i.gid1) { Ok(v) => v, Err(s) => return s },
+        gid2: match opt(i.gid2) { Ok(v) => v, Err(s) => return s },
+        privilege_access_rule: match opt(i.privilege_access_rule) {
+            Ok(v) => v,
+            Err(s) => return s,
+        },
+    };
+
+    let resolved = match db::resolve(&path, &id) {
+        Ok(c) => c,
+        Err(e) => {
+            let status = match e {
+                db::Error::NoImsi => SamsungSitStatus::ArgOutOfRange,
+                db::Error::NoManifest | db::Error::MissingManifest(_) => {
+                    SamsungSitStatus::Unsupported
+                }
+                _ => SamsungSitStatus::Malformed,
+            };
+            set_last_error(e.to_string());
+            return status;
+        }
+    };
+
+    let handle = Box::new(SamsungCarrierConfig {
+        carrier_id: resolved.carrier_id,
+        carrier_name: CString::new(resolved.carrier_name).unwrap_or_default(),
+        manifest_sha1: CString::new(resolved.manifest_sha1).unwrap_or_default(),
+        manifest_path: CString::new(resolved.manifest_path.to_string_lossy().into_owned())
+            .unwrap_or_default(),
+        manifest_sha1_bytes: resolved.manifest_sha1_bytes,
+    });
+    out.write(Box::into_raw(handle));
+    SamsungSitStatus::Ok
+}
+
+/// The vendor's own carrier id.
+///
+/// # Safety
+/// `config` must come from [`samsung_carrier_config_resolve`] and not yet be freed.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_carrier_config_id(config: *const SamsungCarrierConfig) -> u32 {
+    if config.is_null() {
+        return 0;
+    }
+    (*config).carrier_id
+}
+
+/// The carrier's name, for logging. Owned by `config`.
+///
+/// # Safety
+/// As [`samsung_carrier_config_id`].
+#[no_mangle]
+pub unsafe extern "C" fn samsung_carrier_config_name(
+    config: *const SamsungCarrierConfig,
+) -> *const c_char {
+    if config.is_null() {
+        return core::ptr::null();
+    }
+    (*config).carrier_name.as_ptr()
+}
+
+/// The manifest's SHA1 as lowercase hex -- the manifest file's own name.
+/// Owned by `config`.
+///
+/// # Safety
+/// As [`samsung_carrier_config_id`].
+#[no_mangle]
+pub unsafe extern "C" fn samsung_carrier_config_sha1(
+    config: *const SamsungCarrierConfig,
+) -> *const c_char {
+    if config.is_null() {
+        return core::ptr::null();
+    }
+    (*config).manifest_sha1.as_ptr()
+}
+
+/// The same SHA1 in bytes, which is the form the CP is given it in.
+/// [`SAMSUNG_CARRIER_SHA1_LEN`] of them, owned by `config`.
+///
+/// # Safety
+/// As [`samsung_carrier_config_id`].
+#[no_mangle]
+pub unsafe extern "C" fn samsung_carrier_config_sha1_bytes(
+    config: *const SamsungCarrierConfig,
+) -> *const u8 {
+    if config.is_null() {
+        return core::ptr::null();
+    }
+    (*config).manifest_sha1_bytes.as_ptr()
+}
+
+/// Where the manifest is on disk. Owned by `config`.
+///
+/// # Safety
+/// As [`samsung_carrier_config_id`].
+#[no_mangle]
+pub unsafe extern "C" fn samsung_carrier_config_path(
+    config: *const SamsungCarrierConfig,
+) -> *const c_char {
+    if config.is_null() {
+        return core::ptr::null();
+    }
+    (*config).manifest_path.as_ptr()
+}
+
+/// # Safety
+/// `config` must come from [`samsung_carrier_config_resolve`], and be freed once.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_carrier_config_free(config: *mut SamsungCarrierConfig) {
+    if !config.is_null() {
+        drop(Box::from_raw(config));
+    }
+}
diff --git a/crates/samsung-sit-ffi/src/ims_config.rs b/crates/samsung-sit-ffi/src/ims_config.rs
new file mode 100644
index 0000000..8784a0d
--- /dev/null
+++ b/crates/samsung-sit-ffi/src/ims_config.rs
@@ -0,0 +1,378 @@
+//! C ABI over [`samsung_ims_config`]: the CP's IMS settings and the carrier's
+//! APN list, resolved for one SIM out of the vendor's own database.
+//!
+//! This is the half of the vendor data that is *not* a wire codec, and it lives
+//! here for the same reason the codecs do: the database's schema, the tag space
+//! and the vendor's value rules are this project's business, not a modem
+//! daemon's. A C caller hands over a path and a SIM identity and gets entries
+//! it can put straight into an `AIMS_HIDDEN_MENU` frame -- the same
+//! [`SamsungAimsConfigEntry`] the builder here already takes.
+//!
+//! Both results are opaque handles rather than plain arrays because the entries
+//! point at strings and blobs the handle owns; the array is valid exactly as
+//! long as the handle is.
+
+use core::ffi::{c_char, CStr};
+use std::ffi::CString;
+
+use samsung_aims::Value;
+use samsung_ims_config as cfg;
+
+use crate::aims::{SamsungAimsConfigEntry, SamsungAimsValueType};
+use crate::carrier_db::SamsungCarrierIdentity;
+use crate::{set_last_error, SamsungSitStatus};
+
+/// The device half of the SIP User-Agent. The carrier owns the template's
+/// shape; these fill its placeholders.
+///
+/// Every field is a NUL-terminated UTF-8 string, or null for an empty one.
+#[repr(C)]
+pub struct SamsungImsDeviceIdentity {
+    pub manufacturer: *const c_char,
+    pub model: *const c_char,
+    /// Operating system as the User-Agent names it, plus its version.
+    pub os_name: *const c_char,
+    pub os_version: *const c_char,
+    /// Build/software identifier.
+    pub software_version: *const c_char,
+}
+
+/// One APN, in the CP's own numbering -- the database build has already done
+/// the conversion from Android's enums.
+#[repr(C)]
+pub struct SamsungImsApn {
+    /// The vendor's label, for logging. Never null.
+    pub name: *const c_char,
+    pub apn: *const c_char,
+    /// Type bitmask, Android's `ApnSetting` encoding.
+    pub types: u32,
+    /// `1 << (radio tech - 1)`, Android's framework encoding. Zero is not
+    /// "any": it declares a profile valid on no radio technology, and the IMS
+    /// PDN is then refused with MATCH_ALL_RULE_NOT_ALLOWED (2253).
+    pub bearers: u32,
+    pub protocol: u8,
+    pub roaming: u8,
+}
+
+/// A resolved configuration. Opaque: it owns the strings and blobs the entries
+/// point at. Freed with [`samsung_ims_config_free`].
+pub struct SamsungImsConfig {
+    entries: Vec<SamsungAimsConfigEntry>,
+    carrier: CString,
+    user_agent: CString,
+    /// Keeps every string and blob an entry borrows alive for the handle's
+    /// lifetime. Never read directly -- the entries point into it.
+    _owned: Vec<OwnedValue>,
+}
+
+enum OwnedValue {
+    Str(CString),
+    Bytes(Vec<u8>),
+}
+
+/// A resolved APN list. Opaque for the same reason as [`SamsungImsConfig`].
+/// Freed with [`samsung_ims_apn_list_free`].
+pub struct SamsungImsApnList {
+    apns: Vec<SamsungImsApn>,
+    _owned: Vec<CString>,
+}
+
+/// Borrow an optional C string: null and empty both mean "the SIM does not say".
+unsafe fn opt(s: *const c_char) -> Result<String, SamsungSitStatus> {
+    if s.is_null() {
+        return Ok(String::new());
+    }
+    CStr::from_ptr(s)
+        .to_str()
+        .map(str::to_owned)
+        .map_err(|_| SamsungSitStatus::Utf8)
+}
+
+/// A string the handle owns, as a C pointer into it.
+fn own(owned: &mut Vec<OwnedValue>, s: String) -> *const c_char {
+    let c = CString::new(s).unwrap_or_default();
+    let ptr = c.as_ptr();
+    owned.push(OwnedValue::Str(c));
+    ptr
+}
+
+unsafe fn device_from(d: *const SamsungImsDeviceIdentity) -> Result<cfg::DeviceIdentity, SamsungSitStatus> {
+    if d.is_null() {
+        return Err(SamsungSitStatus::NullPointer);
+    }
+    let d = &*d;
+    Ok(cfg::DeviceIdentity {
+        manufacturer: opt(d.manufacturer)?,
+        model: opt(d.model)?,
+        os_name: opt(d.os_name)?,
+        os_version: opt(d.os_version)?,
+        software_version: opt(d.software_version)?,
+    })
+}
+
+/// A null identity is an absent SIM, not a bad argument: the carrier-neutral
+/// layer is still worth sending.
+unsafe fn identity_from(i: *const SamsungCarrierIdentity) -> Result<cfg::CarrierIdentity, SamsungSitStatus> {
+    if i.is_null() {
+        return Ok(cfg::CarrierIdentity::default());
+    }
+    let i = &*i;
+    Ok(cfg::CarrierIdentity {
+        mccmnc: opt(i.mccmnc)?,
+        spn: opt(i.spn)?,
+        imsi: opt(i.imsi)?,
+        gid1: opt(i.gid1)?,
+        gid2: opt(i.gid2)?,
+        iccid: opt(i.iccid)?,
+        // The privilege access rule picks a carrier *manifest*; the IMS
+        // settings are not keyed on it.
+    })
+}
+
+/// Resolve the IMS configuration in `database_path` for `identity`, with
+/// `device` substituted into the carrier's User-Agent template.
+///
+/// An unknown or absent SIM identity is not an error -- the database's
+/// carrier-neutral layer is returned instead. A database that cannot be read,
+/// or that has no default record either, is: the alternative is registering
+/// with another carrier's timers.
+///
+/// On `Ok` the handle is written to `out` and must be freed with
+/// [`samsung_ims_config_free`]; on anything else `out` is untouched and
+/// `samsung_sit_last_error_message` says why.
+///
+/// # Safety
+/// `database_path` must be a NUL-terminated UTF-8 string, `out` writable.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_config_resolve(
+    database_path: *const c_char,
+    device: *const SamsungImsDeviceIdentity,
+    identity: *const SamsungCarrierIdentity,
+    out: *mut *mut SamsungImsConfig,
+) -> SamsungSitStatus {
+    if out.is_null() {
+        return SamsungSitStatus::NullPointer;
+    }
+    let path = match opt(database_path) {
+        Ok(p) => p,
+        Err(s) => return s,
+    };
+    let device = match device_from(device) {
+        Ok(d) => d,
+        Err(s) => return s,
+    };
+    let identity = match identity_from(identity) {
+        Ok(i) => i,
+        Err(s) => return s,
+    };
+
+    let resolved = match cfg::resolve(&path, &device, &identity) {
+        Ok(c) => c,
+        Err(e) => {
+            set_last_error(e.to_string());
+            return SamsungSitStatus::Unsupported;
+        }
+    };
+
+    let mut owned: Vec<OwnedValue> = Vec::with_capacity(resolved.entries.len() + 2);
+    let mut entries = Vec::with_capacity(resolved.entries.len());
+    for (tag, value) in resolved.entries {
+        let entry = match value {
+            Value::Int(v) => SamsungAimsConfigEntry {
+                tag,
+                value_type: SamsungAimsValueType::Int,
+                int_value: v,
+                str_value: core::ptr::null(),
+                bytes_value: core::ptr::null(),
+                bytes_len: 0,
+            },
+            // The builder has a byte form, and the corpus shows no use of it;
+            // the CP reads it as the integer either way.
+            Value::Byte(v) => SamsungAimsConfigEntry {
+                tag,
+                value_type: SamsungAimsValueType::Int,
+                int_value: u32::from(v),
+                str_value: core::ptr::null(),
+                bytes_value: core::ptr::null(),
+                bytes_len: 0,
+            },
+            Value::Str(s) => {
+                let ptr = own(&mut owned, s);
+                SamsungAimsConfigEntry {
+                    tag,
+                    value_type: SamsungAimsValueType::Str,
+                    int_value: 0,
+                    str_value: ptr,
+                    bytes_value: core::ptr::null(),
+                    bytes_len: 0,
+                }
+            }
+            Value::Bytes(b) => {
+                let len = b.len();
+                let ptr = b.as_ptr();
+                owned.push(OwnedValue::Bytes(b));
+                SamsungAimsConfigEntry {
+                    tag,
+                    value_type: SamsungAimsValueType::Bytes,
+                    int_value: 0,
+                    str_value: core::ptr::null(),
+                    bytes_value: ptr,
+                    bytes_len: len,
+                }
+            }
+        };
+        entries.push(entry);
+    }
+
+    let handle = Box::new(SamsungImsConfig {
+        entries,
+        carrier: CString::new(resolved.carrier).unwrap_or_default(),
+        user_agent: CString::new(resolved.user_agent).unwrap_or_default(),
+        _owned: owned,
+    });
+    out.write(Box::into_raw(handle));
+    SamsungSitStatus::Ok
+}
+
+/// The entries, in the order they should reach the CP. Owned by `config` and
+/// valid until it is freed. Null with `*out_n_entries` zero if `config` is null.
+///
+/// # Safety
+/// `config` must come from [`samsung_ims_config_resolve`] and not yet be freed.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_config_entries(
+    config: *const SamsungImsConfig,
+    out_n_entries: *mut usize,
+) -> *const SamsungAimsConfigEntry {
+    if config.is_null() {
+        if !out_n_entries.is_null() {
+            out_n_entries.write(0);
+        }
+        return core::ptr::null();
+    }
+    let config = &*config;
+    if !out_n_entries.is_null() {
+        out_n_entries.write(config.entries.len());
+    }
+    config.entries.as_ptr()
+}
+
+/// Which carrier's overrides were applied, for logging. "default" if none.
+///
+/// # Safety
+/// As [`samsung_ims_config_entries`].
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_config_carrier(config: *const SamsungImsConfig) -> *const c_char {
+    if config.is_null() {
+        return core::ptr::null();
+    }
+    (*config).carrier.as_ptr()
+}
+
+/// The assembled User-Agent. Worth logging on its own: it is the one value a
+/// network is known to reject a registration over.
+///
+/// # Safety
+/// As [`samsung_ims_config_entries`].
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_config_user_agent(config: *const SamsungImsConfig) -> *const c_char {
+    if config.is_null() {
+        return core::ptr::null();
+    }
+    (*config).user_agent.as_ptr()
+}
+
+/// # Safety
+/// `config` must come from [`samsung_ims_config_resolve`], and be freed once.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_config_free(config: *mut SamsungImsConfig) {
+    if !config.is_null() {
+        drop(Box::from_raw(config));
+    }
+}
+
+/// Resolve the carrier's APN list, in the vendor's own order, which is the
+/// order it should reach the CP in.
+///
+/// Unlike the settings there is no default to fall back on: the carrier-neutral
+/// layer has no APNs of its own, and registering another carrier's would be
+/// worse than registering none. A SIM that resolves to no carrier therefore
+/// yields an empty list, not an error.
+///
+/// # Safety
+/// `database_path` must be a NUL-terminated UTF-8 string, `out` writable.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_apns_resolve(
+    database_path: *const c_char,
+    identity: *const SamsungCarrierIdentity,
+    out: *mut *mut SamsungImsApnList,
+) -> SamsungSitStatus {
+    if out.is_null() {
+        return SamsungSitStatus::NullPointer;
+    }
+    let path = match opt(database_path) {
+        Ok(p) => p,
+        Err(s) => return s,
+    };
+    let identity = match identity_from(identity) {
+        Ok(i) => i,
+        Err(s) => return s,
+    };
+    let resolved = match cfg::apns(&path, &identity) {
+        Ok(a) => a,
+        Err(e) => {
+            set_last_error(e.to_string());
+            return SamsungSitStatus::Unsupported;
+        }
+    };
+
+    let mut owned: Vec<CString> = Vec::with_capacity(resolved.len() * 2);
+    let mut apns = Vec::with_capacity(resolved.len());
+    for a in resolved {
+        let name = CString::new(a.name).unwrap_or_default();
+        let apn = CString::new(a.apn).unwrap_or_default();
+        apns.push(SamsungImsApn {
+            name: name.as_ptr(),
+            apn: apn.as_ptr(),
+            types: a.types,
+            bearers: a.bearers,
+            protocol: a.protocol,
+            roaming: a.roaming,
+        });
+        owned.push(name);
+        owned.push(apn);
+    }
+    out.write(Box::into_raw(Box::new(SamsungImsApnList { apns, _owned: owned })));
+    SamsungSitStatus::Ok
+}
+
+/// The APNs. Owned by `list` and valid until it is freed.
+///
+/// # Safety
+/// `list` must come from [`samsung_ims_apns_resolve`] and not yet be freed.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_apn_list_peek(
+    list: *const SamsungImsApnList,
+    out_n_apns: *mut usize,
+) -> *const SamsungImsApn {
+    if list.is_null() {
+        if !out_n_apns.is_null() {
+            out_n_apns.write(0);
+        }
+        return core::ptr::null();
+    }
+    let list = &*list;
+    if !out_n_apns.is_null() {
+        out_n_apns.write(list.apns.len());
+    }
+    list.apns.as_ptr()
+}
+
+/// # Safety
+/// `list` must come from [`samsung_ims_apns_resolve`], and be freed once.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_ims_apn_list_free(list: *mut SamsungImsApnList) {
+    if !list.is_null() {
+        drop(Box::from_raw(list));
+    }
+}
