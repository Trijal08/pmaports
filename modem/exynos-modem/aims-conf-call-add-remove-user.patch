+    #[test]
+    fn conf_call_remove_matches_the_capture() {
+        // The one frame Android sent to drop a member of a two-party
+        // conference, at 407.48 s of the call capture: REMOVE, conference
+        // call id 2, one participant -- leg 1, "18004377950".
+        let f = build_conf_call_add_remove_user(
+            0x03de,
+            ConfCallOp::Remove,
+            2,
+            &[ConfParticipant {
+                call_id: 1,
+                number: "18004377950",
+            }],
+        )
+        .unwrap();
+
+        assert_eq!(&f[2..4], &msg_id::CONF_CALL_ADD_REMOVE_USER.to_le_bytes());
+        assert_eq!(u16::from_le_bytes([f[4], f[5]]), 534);
+        assert_eq!(f.len(), 534);
+        assert_eq!(u16::from_le_bytes([f[6], f[7]]), 0x03de);
+
+        let p = payload_of(&f, false).unwrap();
+        assert_eq!(&p[..4], &[0x01, 0x02, 0x01, 0x00]);
+        assert_eq!(&p[4..8], &11u32.to_le_bytes());
+        assert_eq!(p[8], 1);
+        assert_eq!(&p[9..20], b"18004377950");
+        // The number field is fixed at 513 bytes and zero-padded, so the
+        // record -- and the payload -- end where the capture's did.
+        assert!(p[20..].iter().all(|&b| b == 0));
+        assert_eq!(p.len(), 4 + 4 + 1 + NUM_FIELD);
+    }
+
+    #[test]
+    fn conf_call_change_needs_a_participant() {
+        assert!(build_conf_call_add_remove_user(1, ConfCallOp::Remove, 2, &[]).is_err());
+        assert!(build_conf_call_add_remove_user(
+            1,
+            ConfCallOp::Add,
+            2,
+            &[ConfParticipant { call_id: 1, number: "" }],
+        )
+        .is_err());
+    }
