# Fork of Alpine's community/modemmanager with Samsung SIT support.
maintainer="Steffen Deusch <steffen@deusch.me>"
pkgname=modemmanager-samsung-sit
pkgver=1.25.95_git20260829
pkgrel=1
pkgdesc="ModemManager with Samsung SIT modem support"
url="https://git.deusch.me/api/v1/repos/pixel-mainline/ModemManager"
arch="all"
license="GPL-2.0-or-later AND LGPL-2.1-or-later"
provides="modemmanager=$pkgver-r$pkgrel"
replaces="modemmanager"
provider_priority=100
depends="
	dbus
	libmm-glib
	mobile-broadband-provider-info
	polkit
"
depends_dev="libmm-glib"
makedepends="
	bash-completion-dev
	dbus-dev
	elogind-dev
	gobject-introspection-dev
	gtk-doc
	libgudev-dev
	libsamsung-sit-ffi
	linux-headers
	meson
	polkit-dev
	sqlite-dev
	vala
"
checkdepends="dbus glib-dev py3-gobject3 py3-dbus"
subpackages="
	$pkgname-lang
	$pkgname-doc
	libmm-glib:libmm
	$pkgname-dbg
	$pkgname-dev
	$pkgname-openrc
	$pkgname-bash-completion:bashcomp
	$pkgname-systemd
	$pkgname-udev
"

_commit="bb0686ddd6a2b69a1e78728f1807c326e440816b"
source="modemmanager-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	modemmanager.rules
	modemmanager.initd
	zz-debug.conf

	0001-intel-XMM7360-fix-big-endian-handling-of-ASN-integer.patch
	wwan-at-honour-send-lf.patch
	ignore-vendor-wwan-ports.patch
	promote-s5400-camped-state.patch
	query-carrier-sim-info.patch
	fixb-attach-apn.patch
	trust-radio-state-only-when-accepted.patch
	sit-ims-data-profile.patch
	sit-tool-map-every-logical-stack.patch
	aims-media-state-ind.patch
	aims-send-dtmf.patch
	cs-send-dtmf.patch
	apn-list-from-carrier-db.patch
	ims-decline-reason.patch
	ims-hold-ims-across-dsds-gaps.patch
	report-5g-from-endc-offer.patch
	publish-carrier-id.patch
"
builddir="$srcdir/modemmanager"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		-Ddbus_policy_dir=/usr/share/dbus-1/system.d \
		-Dgtk_doc=false \
		-Dplugin_samsung_sit=enabled \
		-Dqmi=false \
		-Dmbim=false \
		-Dqrtr=false \
		-Dplugin_foxconn=disabled \
		-Dplugin_qcom_soc=disabled \
		-Dpolkit=permissive \
		-Dsystemd_journal=false \
		-Dsystemd_suspend_resume=true \
		-Dvapi=true \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -m644 -D "$srcdir/modemmanager.rules" \
		"$pkgdir/usr/share/polkit-1/rules.d/01-org.freedesktop.ModemManager.rules"
	install -m755 -D "$srcdir/modemmanager.initd" \
		"$pkgdir/etc/init.d/modemmanager"
	install -m644 -D "$srcdir/zz-debug.conf" \
		"$pkgdir/usr/lib/systemd/system/ModemManager.service.d/zz-debug.conf"

	mkdir -p "$pkgdir/usr/share/doc/modemmanager"
	cat > "$pkgdir/usr/share/doc/modemmanager/README.alpine" <<- EOF
	If your USB modem shows up as a Flash drive when you plug it in:

	install 'usb-modeswitch' to automatically switch to USB modem mode whenever you plug it in.
	To control your modem without the root password: add your user account to the 'plugdev' group.
	EOF
}

libmm() {
	depends=""
	amove usr/lib/girepository-1.0
	amove usr/lib/libmm-glib.so*
}

lang() {
	default_lang
	provides="modemmanager-lang=$pkgver-r$pkgrel"
	replaces="modemmanager-lang"
}

doc() {
	default_doc
	provides="modemmanager-doc=$pkgver-r$pkgrel"
	replaces="modemmanager-doc"
}

dev() {
	default_dev
	provides="modemmanager-dev=$pkgver-r$pkgrel"
	replaces="modemmanager-dev"
}

openrc() {
	default_openrc
	provides="modemmanager-openrc=$pkgver-r$pkgrel"
	replaces="modemmanager-openrc"
}

bashcomp() {
	default_bashcomp
	provides="modemmanager-bash-completion=$pkgver-r$pkgrel"
	replaces="modemmanager-bash-completion"
}

systemd() {
	default_systemd
	provides="modemmanager-systemd=$pkgver-r$pkgrel"
	replaces="modemmanager-systemd"
}

udev() {
	default_udev
	provides="modemmanager-udev=$pkgver-r$pkgrel"
	replaces="modemmanager-udev"
}



