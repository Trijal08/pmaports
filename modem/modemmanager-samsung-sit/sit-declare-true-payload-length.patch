+/*
+ * Drain a request's payload padding.
+ *
+ * The builder pads the payload -- everything after the 12-byte request header
+ * -- out to a multiple of 8, the way the vendor RIL does, while `length` keeps
+ * declaring the true size. A peer that reads only `length` bytes leaves the
+ * padding in the socket and then reads it as the next frame's header, so every
+ * peer in here drains it.
+ */
+static gboolean
+read_padding (int fd, guint16 request_len)
+{
+    guint8 pad[8];
+    gsize  payload, n;
+
+    if (request_len <= 12)
+        return TRUE;
+    payload = (gsize) request_len - 12;
+    n = (8 - payload % 8) % 8;
+    return n ? read_all (fd, pad, n) : TRUE;
+}
+
 static void reply_request (gint fd, guint16 expected, guint8 *response, gsize response_len);
 
 static gpointer
@@ -1880,6 +1933,7 @@
             g_autofree guint8 *body = g_malloc (request_len - MM_SIT_HEADER_SIZE);
 
