+/// Build a `DTMF` (0x0003) request carrying a run of keypad digits.
+///
+/// The self-timed burst form: the CP times each tone itself, so there is no
+/// release to pair with it. `digits` are the keys' ASCII characters -- pass
+/// "2012", not the values -- and at most 64 of them.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_sit_build_dtmf(
+    token: u16,
+    digits: *const c_char,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    let digits = match cstr(digits) {
+        Ok(s) => s,
+        Err(s) => return s,
+    };
+    emit_result(sit::build_dtmf(token, digits), out, out_len)
+}
