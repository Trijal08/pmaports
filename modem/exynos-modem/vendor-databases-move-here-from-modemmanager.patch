+// SPDX-License-Identifier: GPL-2.0-or-later
+//! The configuration the CP's IMS stack needs before it can register.
+//!
+//! This lives here rather than in the ModemManager plugin for one reason: the
+//! plugin is meant to be upstreamable, and a plugin that opens a vendor carrier
+//! database with its own SQLite dependency is not. Everything that knows where
+//! the vendor's data lives and what shape it is in belongs on this side of the
+//! FFI; the plugin should ask for "the IMS configuration for this SIM" and be
+//! handed values it can put on the wire.
+//!
+//! The database is built offline by `carrier-settings` from Android's
+//! CarrierSettings protobufs, merged with AOSP's framework defaults and put
+//! through the vendor's value transforms, so every value stored is already the
+//! value the CP is handed. Reading it is therefore one flat query and no
+//! merging -- for now. The per-MCC XML the vendor IMS app carries in its own
+//! assets is a second, larger source that is not merged here yet.
+
+use rusqlite::{Connection, OpenFlags};
+pub use samsung_aims::Value;
+
+/// Tags the vendor does not read from carrier configuration either, so they are
+/// stated here rather than looked up.
+pub mod tag {
+    pub const USER_AGENT: u16 = 519;
+    pub const SIP_TIMER_TA_MS: u16 = 523;
+    pub const SIP_TIMER_TE_MS: u16 = 527;
+    pub const SIP_TIMER_TG_MS: u16 = 529;
+    pub const SIP_TIMER_TI_MS: u16 = 531;
+    pub const SIP_TIMER_TK_MS: u16 = 533;
+    pub const UA_MANUFACTURER: u16 = 772;
+    pub const UA_MODEL: u16 = 773;
+    pub const UA_SOFTWARE_VERSION: u16 = 774;
+    pub const UA_PRODUCT_LINE: u16 = 775;
+    pub const UA_OS_VERSION: u16 = 776;
+    pub const GEOLOCATION_VOWIFI_EMERGENCY: u16 = 1044;
+    pub const GEOLOCATION_VOLTE_EMERGENCY: u16 = 1045;
+}
+
+const COMPILED_IN: &[(u16, u32)] = &[
+    (tag::SIP_TIMER_TA_MS, 30),
+    (tag::SIP_TIMER_TE_MS, 30),
+    (tag::SIP_TIMER_TG_MS, 30),
+    (tag::SIP_TIMER_TI_MS, 30),
+    (tag::SIP_TIMER_TK_MS, 30),
+    (tag::GEOLOCATION_VOWIFI_EMERGENCY, 1),
+    (tag::GEOLOCATION_VOLTE_EMERGENCY, 0),
+];
+
+/// The SIM's identity, not the serving network's. The discriminators matter:
+/// several carriers share an MCCMNC and are told apart only by these.
+#[derive(Debug, Default, Clone)]
+pub struct CarrierIdentity {
+    pub mccmnc: String,
+    pub spn: String,
+    pub imsi: String,
+    pub gid1: String,
+    pub gid2: String,
+    pub iccid: String,
+}
+
+/// What the device contributes to the SIP User-Agent. The carrier owns the
+/// template's shape; these four fill it in.
+#[derive(Debug, Default, Clone)]
+pub struct DeviceIdentity {
+    pub manufacturer: String,
+    pub model: String,
+    pub os_name: String,
+    pub os_version: String,
+    pub software_version: String,
+}
+
+#[derive(Debug)]
+pub struct ImsConfig {
+    /// Whose overrides were applied, for logging. "default" if none matched.
+    pub carrier: String,
+    pub user_agent: String,
+    pub entries: Vec<(u16, Value)>,
+}
+
+#[derive(Debug, Clone)]
+pub struct Apn {
+    pub name: String,
+    pub apn: String,
+    pub types: u32,
+    pub bearers: u32,
+    pub protocol: u8,
+    pub roaming: u8,
+}
+
+#[derive(Debug)]
+pub enum Error {
+    Unconfigured,
+    Open { path: String, reason: String },
+    Query(String),
+    NoCarrier(String),
+}
+
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Error::Unconfigured => write!(f, "no IMS configuration database configured"),
+            Error::Open { path, reason } => write!(
+                f,
+                "could not open the IMS configuration database '{path}': {reason}"
+            ),
+            Error::Query(m) => write!(f, "IMS configuration database query failed: {m}"),
+            Error::NoCarrier(m) => {
+                write!(f, "the IMS configuration database has no record for '{m}' and no default")
+            }
+        }
+    }
+}
+impl std::error::Error for Error {}
+
+fn open(path: &str) -> Result<Connection, Error> {
+    // An empty path is not a database sqlite can fail to open: it is a
+    // caller that was never configured with one, and sqlite would answer by
+    // opening a private temporary database with no tables in it.
+    if path.is_empty() {
+        return Err(Error::Unconfigured);
+    }
+    Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY).map_err(|e| {
+        // sqlite repeats the path in its own message; the caller already has
+        // it, and saying it twice makes the log harder to read, not clearer.
+        let reason = e.to_string();
+        let reason = reason
+            .strip_suffix(&format!(": {path}"))
+            .unwrap_or(&reason)
+            .to_string();
+        Error::Open { path: path.to_string(), reason }
+    })
+}
+
+/// A record's field either says nothing, or has to agree with the SIM.
+fn field_matches(required: &str, actual: &str, prefix: bool) -> bool {
+    if required.is_empty() {
+        return true;
+    }
+    if actual.is_empty() {
+        return false;
+    }
+    if prefix {
+        actual.starts_with(required)
+    } else {
+        required.eq_ignore_ascii_case(actual)
+    }
+}
+
+/// Android's rule over `carrier_list`: every field a record *does* specify must
+/// agree with the SIM, and among the survivors the one specifying the most
+/// wins. A record asking for nothing beyond the MCCMNC is the fallback for that
+/// MCCMNC rather than a competitor to a more specific one.
+fn find_carrier(db: &Connection, id: &CarrierIdentity) -> Result<Option<(i64, String)>, Error> {
+    if id.mccmnc.is_empty() {
+        return Ok(None);
+    }
+    let mut st = db
+        .prepare(
+            "SELECT c.id, c.canonical_name, i.spn, i.imsi, i.gid1, i.gid2, i.iccid \
+             FROM carrier c JOIN carrier_id i ON i.carrier = c.id WHERE i.mccmnc = ?1",
+        )
+        .map_err(|e| Error::Query(e.to_string()))?;
+    let mut rows = st
+        .query([&id.mccmnc])
+        .map_err(|e| Error::Query(e.to_string()))?;
+
+    let mut best: Option<(i64, String)> = None;
+    let mut best_score = -1i32;
+    while let Some(r) = rows.next().map_err(|e| Error::Query(e.to_string()))? {
+        let get = |i: usize| -> String { r.get::<_, Option<String>>(i).ok().flatten().unwrap_or_default() };
+        let fields = [
+            (get(2), id.spn.as_str(), false),
+            (get(3), id.imsi.as_str(), true),
+            (get(4), id.gid1.as_str(), true),
+            (get(5), id.gid2.as_str(), true),
+            (get(6), id.iccid.as_str(), true),
+        ];
+        let mut score = 0i32;
+        for (required, actual, prefix) in &fields {
+            if !field_matches(required, actual, *prefix) {
+                score = -1;
+                break;
+            }
+            if !required.is_empty() {
+                score += 1;
+            }
+        }
+        if score > best_score {
+            best_score = score;
+            best = Some((
+                r.get(0).map_err(|e| Error::Query(e.to_string()))?,
+                r.get::<_, Option<String>>(1).ok().flatten().unwrap_or_default(),
+            ));
+        }
+    }
+    Ok(best)
+}
+
+fn find_default_carrier(db: &Connection) -> Result<Option<(i64, String)>, Error> {
+    let mut st = db
+        .prepare("SELECT id FROM carrier WHERE canonical_name = 'default'")
+        .map_err(|e| Error::Query(e.to_string()))?;
+    let mut rows = st.query([]).map_err(|e| Error::Query(e.to_string()))?;
+    match rows.next().map_err(|e| Error::Query(e.to_string()))? {
+        Some(r) => Ok(Some((
+            r.get(0).map_err(|e| Error::Query(e.to_string()))?,
+            "default".to_string(),
+        ))),
+        None => Ok(None),
+    }
+}
+
+/// Replace an already-emitted tag, or append.
+///
+/// The database cannot produce a duplicate -- (carrier, tag) is its primary key
+/// -- but the compiled-in values and the device identity go on top of it, and
+/// two entries for one tag would leave the CP taking the second. That happens
+/// to be the right one, but only by accident.
+fn set(entries: &mut Vec<(u16, Value)>, tag: u16, value: Value) {
+    if let Some(slot) = entries.iter_mut().find(|(t, _)| *t == tag) {
+        slot.1 = value;
+    } else {
+        entries.push((tag, value));
+    }
+}
+
+/// SQLite's own column coercion, which the C API applies on every read: a
+/// value comes back as the type you ask for, not only the type it was stored
+/// as. Reproduced here because the database is the vendor's and a column it
+/// stored as text is still a value the CP expects to be sent.
+fn as_text(row: &rusqlite::Row<'_>, i: usize) -> String {
+    use rusqlite::types::ValueRef;
+    match row.get_ref(i) {
+        Ok(ValueRef::Text(b)) | Ok(ValueRef::Blob(b)) => String::from_utf8_lossy(b).into_owned(),
+        Ok(ValueRef::Integer(v)) => v.to_string(),
+        Ok(ValueRef::Real(v)) => v.to_string(),
+        _ => String::new(),
+    }
+}
+
+/// As [`as_text`], for a column read as bytes.
+fn as_blob(row: &rusqlite::Row<'_>, i: usize) -> Vec<u8> {
+    use rusqlite::types::ValueRef;
+    match row.get_ref(i) {
+        Ok(ValueRef::Blob(b)) | Ok(ValueRef::Text(b)) => b.to_vec(),
+        Ok(ValueRef::Integer(v)) => v.to_string().into_bytes(),
+        Ok(ValueRef::Real(v)) => v.to_string().into_bytes(),
+        _ => Vec::new(),
+    }
+}
+
+/// A User-Agent token: one field of the header, so it carries no spaces.
+fn ua_token(value: &str) -> String {
+    value.replace(' ', "-")
+}
+
+/// Expand the carrier's User-Agent template.
+///
+/// The template is the carrier's, placeholders and all
+/// ("#MANUFACTURE# #MODEL# Android #AV# #BUILD# EU01454"), because its *shape*
+/// is what the network is sensitive to -- the separators differ between
+/// carriers, and one carrier's is underscores. Only the placeholders are ours
+/// to fill.
+///
+/// The literal "Android" is replaced too, and deliberately: we are not Android,
+/// the field is one token either way so the shape is preserved, and the string
+/// that registered on o2 named postmarketOS. It is substituted first, while the
+/// template still holds no device values, so a device value containing the word
+/// cannot be corrupted by it.
+fn expand_user_agent(template: &str, dev: &DeviceIdentity) -> String {
+    let vendor = dev.manufacturer.as_str();
+    let mut model = dev.model.as_str();
+
+    // The device tree names the model with its vendor already in it ("Google
+    // Pixel 9a") while the template wants them separately, so a repeated
+    // vendor is dropped rather than emitted twice.
+    let vendor_len = vendor.len();
+    if vendor_len != 0
+        && model.len() > vendor_len
+        && model.as_bytes()[..vendor_len].eq_ignore_ascii_case(vendor.as_bytes())
+        && model.as_bytes()[vendor_len] == b' '
+    {
+        model = &model[vendor_len + 1..];
+    }
+
+    template
+        .replace("Android", &ua_token(&dev.os_name))
+        .replace("#MANUFACTURE#", vendor)
+        .replace("#MODEL#", &ua_token(model))
+        .replace("#AV#", &dev.os_version)
+        .replace("#BUILD#", &ua_token(&dev.software_version))
+}
+
+/// The template every carrier record falls back to.
+const DEFAULT_USER_AGENT: &str = "#MANUFACTURE# #MODEL# Android #AV# #BUILD#";
+
+/// Resolve the IMS configuration for `identity`.
+///
+/// An unknown or absent SIM identity is not an error: the database carries the
+/// carrier-neutral layer every per-carrier record is built on, and a CP with
+/// those settings is worth trying. A missing database *is* an error, because
+/// the alternative is registering with another carrier's timers.
+pub fn resolve(
+    database_path: &str,
+    device: &DeviceIdentity,
+    identity: &CarrierIdentity,
+) -> Result<ImsConfig, Error> {
+    let db = open(database_path)?;
+    let found = match find_carrier(&db, identity)? {
+        Some(c) => Some(c),
+        None => find_default_carrier(&db)?,
+    };
+    let (carrier_id, carrier_name) = found.ok_or_else(|| {
+        let who = if identity.mccmnc.is_empty() { "(unknown operator)" } else { &identity.mccmnc };
+        Error::NoCarrier(who.to_string())
+    })?;
+
+    let mut entries: Vec<(u16, Value)> = Vec::new();
+    let mut template: Option<String> = None;
+
+    {
+        let mut st = db
+            .prepare(
+                "SELECT tag, kind, int_value, text_value, blob_value FROM setting \
+                 WHERE carrier = ?1 ORDER BY tag",
+            )
+            .map_err(|e| Error::Query(e.to_string()))?;
+        let mut rows = st
+            .query([carrier_id])
+            .map_err(|e| Error::Query(e.to_string()))?;
+        while let Some(r) = rows.next().map_err(|e| Error::Query(e.to_string()))? {
+            let tag: u16 = r.get::<_, i64>(0).map_err(|e| Error::Query(e.to_string()))? as u16;
+            // A row with no kind says nothing about how to read its value.
+            let kind = match r.get_ref(1) {
+                Ok(rusqlite::types::ValueRef::Null) | Err(_) => continue,
+                _ => as_text(r, 1),
+            };
+            if tag == tag::USER_AGENT {
+                template = Some(as_text(r, 3));
+                continue;
+            }
+            match kind.as_str() {
+                "int" => {
+                    let v: i64 = r.get(2).unwrap_or(0);
+                    set(&mut entries, tag, Value::Int(v as u32));
+                }
+                "str" => set(&mut entries, tag, Value::Str(as_text(r, 3))),
+                "bytes" => set(&mut entries, tag, Value::Bytes(as_blob(r, 4))),
+                _ => {}
+            }
+        }
+    }
+
+    for (tag, value) in COMPILED_IN {
+        set(&mut entries, *tag, Value::Int(*value));
+    }
+
+    // The CP wants both the parts and the finished string it puts in REGISTER:
+    // it does not assemble one for itself, which is why an unprovisioned CP
+    // cannot register at all.
+    set(&mut entries, tag::UA_MANUFACTURER, Value::Str(device.manufacturer.clone()));
+    set(&mut entries, tag::UA_MODEL, Value::Str(device.model.clone()));
+    set(&mut entries, tag::UA_SOFTWARE_VERSION, Value::Str(device.software_version.clone()));
+    set(&mut entries, tag::UA_PRODUCT_LINE, Value::Str("SH000000".to_string()));
+    set(&mut entries, tag::UA_OS_VERSION, Value::Str(device.os_version.clone()));
+
+    let user_agent = expand_user_agent(
+        template.as_deref().unwrap_or(DEFAULT_USER_AGENT),
+        device,
+    );
+    set(&mut entries, tag::USER_AGENT, Value::Str(user_agent.clone()));
+
+    Ok(ImsConfig { carrier: carrier_name, user_agent, entries })
+}
+
+/// The carrier's APN list, in the vendor's own order, which is the order it
+/// should reach the CP in.
+///
+/// Not an IMS detail despite sharing the database: the CP will not match a URSP
+/// rule for an APN it was never given a data profile for, and answers
+/// MATCH_ALL_RULE_NOT_ALLOWED (2253) instead. The whole list has to be
+/// registered before any one context is asked for.
+pub fn apns(database_path: &str, identity: &CarrierIdentity) -> Result<Vec<Apn>, Error> {
+    let db = open(database_path)?;
+    let carrier_id = match find_carrier(&db, identity)? {
+        Some((id, _)) => id,
+        None => return Ok(Vec::new()),
+    };
+    let mut st = db
+        .prepare(
+            "SELECT name, apn, types, bearers, protocol, roaming FROM apn \
+             WHERE carrier = ?1 ORDER BY seq",
+        )
+        .map_err(|e| Error::Query(e.to_string()))?;
+    let mut rows = st
+        .query([carrier_id])
+        .map_err(|e| Error::Query(e.to_string()))?;
+    let mut out = Vec::new();
+    while let Some(r) = rows.next().map_err(|e| Error::Query(e.to_string()))? {
+        // A row with no APN string names no network to attach to. The database
+        // build should not emit one; if it does, sending it would cost a
+        // context the CP then refuses.
+        let apn = as_text(r, 1);
+        if apn.is_empty() {
+            continue;
+        }
+        out.push(Apn {
+            name: as_text(r, 0),
+            apn,
+            types: r.get::<_, Option<i64>>(2).ok().flatten().unwrap_or(0) as u32,
+            bearers: r.get::<_, Option<i64>>(3).ok().flatten().unwrap_or(0) as u32,
+            protocol: r.get::<_, Option<i64>>(4).ok().flatten().unwrap_or(0) as u8,
+            roaming: r.get::<_, Option<i64>>(5).ok().flatten().unwrap_or(0) as u8,
+        });
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const DEVICE: fn() -> DeviceIdentity = || DeviceIdentity {
+        manufacturer: "Google".into(),
+        model: "Pixel9a".into(),
+        os_name: "Android".into(),
+        os_version: "17".into(),
+        software_version: "CP2A.260705.006".into(),
+    };
+
+    /// The same fixture the C tests build, so a divergence shows up as a
+    /// failing assertion here rather than as a carrier that will not register.
+    fn fixture() -> (tempfile::TempDir, String) {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let path = dir.path().join("ims.db").to_string_lossy().into_owned();
+        let db = Connection::open(&path).expect("create");
+        for sql in [
+            "CREATE TABLE carrier (id INTEGER PRIMARY KEY, canonical_name TEXT NOT NULL UNIQUE, version INTEGER)",
+            "CREATE TABLE carrier_id (carrier INTEGER NOT NULL, mccmnc TEXT, spn TEXT, imsi TEXT, gid1 TEXT, gid2 TEXT, iccid TEXT)",
+            "CREATE TABLE setting (carrier INTEGER NOT NULL, tag INTEGER NOT NULL, kind TEXT NOT NULL, int_value INTEGER, text_value TEXT, blob_value BLOB, key TEXT, PRIMARY KEY (carrier, tag))",
+            "INSERT INTO carrier (id, canonical_name) VALUES (1, 'default'), (2, 'o2_de'), (3, 'mvno_de')",
+            // Two records on one MCCMNC, told apart only by GID1 -- the shape
+            // that makes the match rule matter rather than a formality.
+            "INSERT INTO carrier_id (carrier, mccmnc, gid1) VALUES (2, '26203', NULL), (3, '26203', 'AB')",
+            "INSERT INTO setting (carrier, tag, kind, int_value) VALUES (3, 1028, 'int', 1400)",
+            "INSERT INTO setting (carrier, tag, kind, int_value, text_value) VALUES \
+             (1, 10, 'int', 5060, NULL), (1, 528, 'int', 128000, NULL), \
+             (1, 1028, 'int', 1500, NULL), (1, 1029, 'int', 1500, NULL), \
+             (1, 519, 'str', NULL, '#MANUFACTURE# #MODEL# Android #AV# #BUILD#')",
+            "INSERT INTO setting (carrier, tag, kind, int_value, text_value) VALUES \
+             (2, 10, 'int', 5060, NULL), (2, 528, 'int', 32000, NULL), \
+             (2, 1028, 'int', 1300, NULL), \
+             (2, 1032, 'str', NULL, 'teleconferenceuri-factory@telefonica.de'), \
+             (2, 519, 'str', NULL, '#MANUFACTURE# #MODEL# Android #AV# #BUILD# EU01454')",
+            "INSERT INTO setting (carrier, tag, kind, blob_value) VALUES \
+             (2, 1060, 'bytes', x'6801ff00')",
+        ] {
+            db.execute_batch(sql).expect(sql);
+        }
+        (dir, path)
+    }
+
+    fn sim(mccmnc: &str) -> CarrierIdentity {
+        CarrierIdentity { mccmnc: mccmnc.into(), ..Default::default() }
+    }
+
+    /// Every entry for `tag`, so "the override replaced the default" can be
+    /// told apart from "the override merely came after it".
+    fn all(cfg: &ImsConfig, tag: u16) -> Vec<&Value> {
+        cfg.entries.iter().filter(|(t, _)| *t == tag).map(|(_, v)| v).collect()
+    }
+
+    fn int(cfg: &ImsConfig, tag: u16) -> u32 {
+        let v = all(cfg, tag);
+        assert_eq!(v.len(), 1, "tag {tag} appears {} times", v.len());
+        match v[0] {
+            Value::Int(i) => *i,
+            other => panic!("tag {tag} is {other:?}, not an int"),
+        }
+    }
+
+    /// An unknown carrier is the defaults, not a failure: a CP with sane
+    /// timers and a valid User-Agent is worth trying.
+    #[test]
+    fn unknown_carrier_falls_back_to_the_defaults() {
+        let (_dir, path) = fixture();
+        let cfg = resolve(&path, &DEVICE(), &sim("99999")).expect("resolve");
+        assert_eq!(cfg.carrier, "default");
+        assert_eq!(int(&cfg, 1028), 1500); // IPv4 SIP MTU
+        assert_eq!(int(&cfg, 10), 5060); // SIP server port
+
+        // The seven tags that are in no database because the vendor does not
+        // read them from carrier configuration either. They have to be sent
+        // whatever the database says, so a carrier that never mentions them is
+        // the case worth asserting.
+        for (tag, value) in [(523, 30), (527, 30), (529, 30), (531, 30), (533, 30), (1044, 1), (1045, 0)] {
+            assert_eq!(int(&cfg, tag), value, "compiled-in tag {tag}");
+        }
+    }
+
+    /// A database that is not there is a packaging fault, and reporting it as
+    /// one beats registering with whatever another carrier's timers happen to
+    /// be.
+    #[test]
+    fn a_missing_database_is_an_error() {
+        assert!(resolve("/nonexistent/ims.db", &DEVICE(), &sim("26203")).is_err());
+        assert!(matches!(
+            resolve("", &DEVICE(), &sim("26203")),
+            Err(Error::Unconfigured)
+        ));
+    }
+
+    /// The override has to replace the default, not sit after it. Two entries
+    /// for one tag would still work -- the CP takes the last -- and that is
+    /// exactly why it is worth asserting: it would work by accident.
+    #[test]
+    fn a_carrier_override_replaces_the_default() {
+        let (_dir, path) = fixture();
+        let cfg = resolve(&path, &DEVICE(), &sim("26203")).expect("resolve");
+        assert_eq!(cfg.carrier, "o2_de");
+
+        assert_eq!(int(&cfg, 1028), 1300);
+        assert_eq!(int(&cfg, 528), 32000); // Timer F: 32 s where AOSP says 128 s.
+
+        let v = all(&cfg, 1032);
+        assert_eq!(v.len(), 1);
+        assert_eq!(v[0], &Value::Str("teleconferenceuri-factory@telefonica.de".into()));
+
+        let v = all(&cfg, 1060); // AMR-WB description
+        assert_eq!(v.len(), 1);
+        assert_eq!(v[0], &Value::Bytes(vec![0x68, 0x01, 0xff, 0x00]));
+
+        // A default the carrier does not override stays.
+        assert_eq!(int(&cfg, 10), 5060);
+    }
+
+    /// Several carriers share an MCCMNC and are told apart only by GID1.
+    #[test]
+    fn gid1_picks_between_two_records_on_one_mccmnc() {
+        let (_dir, path) = fixture();
+        let id = CarrierIdentity { mccmnc: "26203".into(), gid1: "AB".into(), ..Default::default() };
+        let cfg = resolve(&path, &DEVICE(), &id).expect("resolve");
+        assert_eq!(cfg.carrier, "mvno_de");
+        assert_eq!(int(&cfg, 1028), 1400);
+    }
+
+    /// The carrier owns the template's shape -- including its certification
+    /// suffix -- and the device owns only what the placeholders stand for.
+    #[test]
+    fn the_user_agent_keeps_the_carriers_shape() {
+        let (_dir, path) = fixture();
+        let cfg = resolve(&path, &DEVICE(), &sim("26203")).expect("resolve");
+        assert_eq!(cfg.user_agent, "Google Pixel9a Android 17 CP2A.260705.006 EU01454");
+        assert_eq!(all(&cfg, tag::USER_AGENT), vec![&Value::Str(cfg.user_agent.clone())]);
+        // The parts go too: the CP does not assemble a User-Agent for itself.
+        assert_eq!(all(&cfg, tag::UA_PRODUCT_LINE), vec![&Value::Str("SH000000".into())]);
+    }
+
+    /// A device value with a space in it would otherwise split the header
+    /// field in two, and the device tree names the model with its vendor
+    /// already in it.
+    #[test]
+    fn the_user_agent_is_one_token_per_field() {
+        let dev = DeviceIdentity {
+            manufacturer: "Google".into(),
+            model: "Google Pixel 9 Pro XL".into(),
+            os_name: "postmarketOS Edge".into(),
+            os_version: "25.12".into(),
+            software_version: "nura edge".into(),
+        };
+        assert_eq!(
+            expand_user_agent(DEFAULT_USER_AGENT, &dev),
+            "Google Pixel-9-Pro-XL postmarketOS-Edge 25.12 nura-edge"
+        );
+    }
+
+    /// Carriers that ship no APNs are a normal outcome; another carrier's
+    /// APNs would be worse than none, so there is no default to fall back on.
+    #[test]
+    fn apns_do_not_fall_back_to_the_default_carrier() {
+        let (_dir, path) = fixture();
+        assert!(apns(&path, &sim("99999")).expect("apns").is_empty());
+    }
+
+    /// A row with no APN string names no network to attach to, and sending it
+    /// would cost a context the CP then refuses.
+    #[test]
+    fn an_apn_row_with_no_apn_is_dropped() {
+        let (_dir, path) = fixture();
+        let db = Connection::open(&path).expect("open");
+        db.execute_batch(
+            "CREATE TABLE apn (carrier INTEGER NOT NULL, seq INTEGER, name TEXT, apn TEXT, \
+             types INTEGER, bearers INTEGER, protocol INTEGER, roaming INTEGER); \
+             INSERT INTO apn (carrier, seq, name, apn, types, bearers, protocol, roaming) VALUES \
+             (2, 0, 'blank', '',   17, 2, 0, 0), \
+             (2, 1, 'ims',   'ims', 64, 2, 2, 2), \
+             (2, 2, 'null',  NULL, 17, 2, 0, 0)",
+        )
+        .expect("apn table");
+
+        let list = apns(&path, &sim("26203")).expect("apns");
+        assert_eq!(list.len(), 1);
+        assert_eq!(list[0].apn, "ims");
+        assert_eq!(list[0].bearers, 2);
+    }
+}
