+        let cfg = resolve(&path, &DEVICE(), &id).expect("resolve");
+        assert_eq!(cfg.geo_entity,
+                   "pres:302220808479542@ims.mnc220.mcc302.3gppnetwork.org");
+        assert_eq!(cfg.geo_country, "CA");
