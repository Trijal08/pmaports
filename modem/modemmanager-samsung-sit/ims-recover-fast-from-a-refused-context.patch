From: Trijal Saha <97483939+Trijal08@users.noreply.github.com>
Date: Wed, 5 Nov 2026 00:00:00 +0000
Subject: [PATCH] samsung-sit: recover quickly from a refused IMS context

Across twelve boots the first IMS ask is refused on ten of them, with cause
168 returned in 9-61ms. That is a local refusal, far too quick to be a
network round trip, and a later identical ask is granted. Nothing we send
accounts for it: the AP->CP request streams before a granted ask and a
refused one are 98% identical, differing only in polling churn, and no CP
indication is present before every grant and absent before every refusal.

So treat it as a transient to recover from rather than something to predict.
The wait before the next attempt was a flat 30s, which is where the time
actually went -- stack 0 was refused 15s into a boot and granted at 60s,
stack 1 was still retrying at 72s. It now starts at 2s and doubles to the
same 30s cap, and the burst gets five attempts instead of three because an
attempt that costs 15ms is cheap. Five attempts now span 30s where three
spanned 90s.

The cap, the monotonic cooldown floor and its growth to
PROVISIONING_COOLDOWN_MAX_SECS are all untouched, so a subscription that
refuses the IMS PDN for good still backs off exactly as before, and the
CP's own SIP throttling -- which is what the patience here was for -- is
still waited out between bursts rather than inside one.

The retry-limit test pinned the old budget; it now expects five setups when
the burst is exhausted and three when the peer accepts on the third, and the
wait helper's ceiling covers the longer burst.

--- a/src/plugins/samsung-sit/mm-sit-ims.c
+++ b/src/plugins/samsung-sit/mm-sit-ims.c
@@ -36,16 +36,31 @@
 /* The fallback when no carrier record names one; see mm_sit_ims_set_apn(). */
 #define IMS_APN "ims"
 
-/* How long to wait before trying again after the CP refuses a step. The CP
- * throttles its own registration attempts (RILC_UNSOL_IMS_THROTTLED_TIME), so
- * being patient here costs nothing and hammering it would be actively wrong. */
+/*
+ * How long to wait before trying again after the CP refuses a step.
+ *
+ * The first delay is short because the common refusal is a transient. Measured
+ * across twelve boots, the first IMS ask is refused on ten of them with cause
+ * 168 returned in 9-61ms -- a local refusal, far too quick to be a network
+ * round trip -- and a later, identical ask is granted. Nothing we send
+ * separates the two: the AP->CP request streams before a granted ask and a
+ * refused one are 98% identical, so this is a condition to recover from rather
+ * than one to predict, and sleeping 30s on it was most of the time VoLTE took
+ * to come up.
+ *
+ * It still backs off to the cap, because a data-only subscription may refuse
+ * the IMS PDN for good and because the CP throttles its own SIP registration
+ * (RILC_UNSOL_IMS_THROTTLED_TIME), which is what the patience here was
+ * originally for. The cooldown below takes over once the attempts run out.
+ */
+#define MM_SIT_IMS_RETRY_FIRST_SECS 2
 #ifndef MM_SIT_IMS_RETRY_TIMEOUT_SECS
 #define MM_SIT_IMS_RETRY_TIMEOUT_SECS 30
 #endif
 
 /* Data-only subscriptions may always refuse the IMS PDN. Bound AP-side
  * provisioning attempts per lifecycle; the CP manages SIP retries itself. */
-#define MAX_PROVISIONING_ATTEMPTS 3
+#define MAX_PROVISIONING_ATTEMPTS 5
 
 /*
  * Floor on how often the whole provisioning sequence may run, and how fast it
@@ -346,11 +361,25 @@
     return G_SOURCE_REMOVE;
 }
 
+/* See MM_SIT_IMS_RETRY_FIRST_SECS: quick first, then doubling to the cap. */
+static guint
+retry_delay_secs (guint failures)
+{
+    guint secs = MM_SIT_IMS_RETRY_FIRST_SECS;
+
+    while (failures > 1 && secs < MM_SIT_IMS_RETRY_TIMEOUT_SECS) {
+        secs *= 2;
+        failures--;
+    }
+    return MIN (secs, (guint) MM_SIT_IMS_RETRY_TIMEOUT_SECS);
+}
+
 static void
 schedule_retry (MMSitIms    *self,
                 const gchar *what,
                 GError      *error)
 {
+    guint retry_secs;
     clear_retry (self);
     /*
      * Only a refusal counts against the burst. "Serial command timed out" means
@@ -395,9 +424,10 @@
         mm_sit_ims_stop (self);
         return;
     }
+    retry_secs = retry_delay_secs (self->priv->provisioning_failures);
     mm_obj_dbg (self, "IMS %s attempt %u/%u failed (%s); retrying in %us",
                 what, self->priv->provisioning_failures, MAX_PROVISIONING_ATTEMPTS,
-                error ? error->message : "unknown", MM_SIT_IMS_RETRY_TIMEOUT_SECS);
+                error ? error->message : "unknown", retry_secs);
     /*
      * Tell whoever is listening why, so it can change something before the
      * retry. The cause travels in the message because that is where
@@ -412,7 +442,7 @@
             g_signal_emit (self, signals[SIGNAL_PDN_REFUSED], 0, (guint) cause);
     }
     g_clear_error (&error);
-    self->priv->retry_id = g_timeout_add_seconds (MM_SIT_IMS_RETRY_TIMEOUT_SECS,
+    self->priv->retry_id = g_timeout_add_seconds (retry_secs,
                                                   (GSourceFunc) retry_cb, self);
 }
 
--- a/src/plugins/samsung-sit/tests/test-sit-protocol.c
+++ b/src/plugins/samsung-sit/tests/test-sit-protocol.c
@@ -3026,7 +3026,7 @@
     guint poll_id, timeout_id;
 
     poll_id = g_timeout_add (10, (GSourceFunc) ims_retry_wait_poll, &wait);
-    timeout_id = g_timeout_add_seconds (8, (GSourceFunc) ims_retry_wait_done, loop);
+    timeout_id = g_timeout_add_seconds (20, (GSourceFunc) ims_retry_wait_done, loop);
     g_main_loop_run (loop);
     if (*counter < target) {
         g_source_remove (poll_id);
@@ -3140,7 +3140,7 @@
     mm_sit_ims_set_registered (ims, TRUE);
     ims_retry_wait (recover ? &peer.pdn_infos : &peer.stops, 1);
     ims_retry_check_quiet (ims);
-    g_assert_cmpuint (peer.setups, ==, 3);
+    g_assert_cmpuint (peer.setups, ==, recover ? 3 : 5);
     g_assert_cmpuint (peer.pdn_infos, ==, recover ? 1 : 0);
     g_assert_cmpuint (peer.stops, ==, recover ? 0 : 1);
 
@@ -3150,7 +3150,7 @@
         mm_sit_ims_set_registered (ims, TRUE);
         ims_retry_wait (&peer.stops, 3);
         ims_retry_check_quiet (ims);
-        g_assert_cmpuint (peer.setups, ==, 6);
+        g_assert_cmpuint (peer.setups, ==, 10);
     }
     mm_sit_ims_stop (ims);
     ims_retry_wait (&peer.stops, recover ? 1 : 4);
