diff -ruN a/crates/exynos-modem/src/oem_ml.rs b/crates/exynos-modem/src/oem_ml.rs
--- a/crates/exynos-modem/src/oem_ml.rs	1969-12-31 19:00:00.000000000 -0500
+++ b/crates/exynos-modem/src/oem_ml.rs	2026-10-11 22:23:46.657890391 -0400
@@ -0,0 +1,56 @@
+//! The oem_ipc2 channel (`/dev/umts_oem2`, ch 0x83), downstream's
+//! `modem_ml_svc_sit`.
+//!
+//! The AP is the requester. Stock registers machine-learning model names with
+//! the CP here in one burst -- `fr2_bps_ml_model` for FR2 beam prediction, plus
+//! two sample models -- and the CP answers each with the sequence number it was
+//! given and a status. Nothing else uses the channel for the rest of the boot.
+//!
+//! This driver's job is therefore the prologue and little else: send the
+//! captured burst, then drain. We do not synthesise the requests, because the
+//! model list is a property of the firmware package rather than something to
+//! invent, and the envelope's payload ids here are not the ones oem_ipc0 uses.
+//!
+//! Until this existed the kernel published no port for 0x83 at all and the
+//! frames were dropped in the rx path, which looked like a CP fault.
+
+use std::path::Path;
+
+use crate::chan::{self, Handler};
+
+pub fn run(dev: &Path, verbose: bool) {
+    let ml = OemMl { verbose };
+    eprintln!(
+        "oem-ml: serving {}{}",
+        dev.display(),
+        if verbose { " (verbose)" } else { "" }
+    );
+    chan::run(dev, &ml);
+}
+
+pub struct OemMl {
+    verbose: bool,
+}
+
+impl Handler for OemMl {
+    fn name(&self) -> &str {
+        "oem-ml"
+    }
+
+    /// Replies only, and the CP asks us for nothing here. Log them once so a
+    /// refusal is visible, and answer nothing: a response needs no response.
+    fn handle(&self, frame: &[u8]) -> Vec<Vec<u8>> {
+        if self.verbose {
+            eprintln!("oem-ml <= {} bytes: {}", frame.len(), hex(frame));
+        }
+        Vec::new()
+    }
+
+    fn prologue(&self) -> &'static [&'static [u8]] {
+        crate::android_replay::OEM_ML_PROLOGUE
+    }
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{:02x}", x)).collect()
+}
