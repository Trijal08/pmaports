	ISC LGPL-2.0-only LGPL-2.1-only X11"
makedepends="$depends_dev py3-setuptools bc dtc python3-dev swig bison flex openssl-dev opensbi"
options="!check"
_commit="a13e24ed9ed773d4a07f079576a2fd654af6bfbb"
source="u-boot-$_commit.tar.gz::https://github.com/revyos/th1520-vendor-uboot/archive/$_commit.tar.gz"
builddir="$srcdir"/th1520-vendor-uboot-$_commit

build() {
	export OPENSBI="/usr/share/opensbi/generic/firmware/fw_dynamic.bin"
	make HOSTCC=gcc ARCH=riscv light_lpi4a_defconfig
	make HOSTCC=gcc ARCH=riscv
}

package() {
	install -D -m644 u-boot-with-spl.bin \
		"$pkgdir"/usr/share/u-boot/sipeed-licheepi-4a/u-boot-with-spl.bin
}

