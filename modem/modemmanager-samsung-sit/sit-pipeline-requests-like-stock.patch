+            reply[3] = buffer[offset + 3];
+            reply[6] = buffer[offset + 6];
+            reply[7] = buffer[offset + 7];
+            g_assert_true (write_all (ctx->peer_fd, reply, sizeof (reply)));
+            answered++;
+            offset += frame_len;
+        }
+
+        memmove (buffer, buffer + offset, have - offset);
+        have -= offset;
     }
     return NULL;
 }
