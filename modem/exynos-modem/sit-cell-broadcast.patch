+/// Build a `GET_BROADCAST_SMS_CONFIG` (0x0105) query.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_sit_build_get_broadcast_sms_config(
+    token: u16,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    emit_bytes(sit::build_get_broadcast_sms_config(token), out, out_len)
+}
+
+/// Build a `SET_BROADCAST_SMS_CONFIG` (0x0106) from `ranges`, which must hold
+/// `count` entries and at most SAMSUNG_SIT_MAX_BROADCAST_RANGES of them.
+///
+/// Pass NULL for `ranges` to send the config this device's own Android writes
+/// at boot -- ETWS and CMAS enabled with the test and exercise identifiers
+/// left off -- which is what `count == 0` means.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_sit_build_set_broadcast_sms_config(
+    token: u16,
+    ranges: *const crate::SamsungSitBroadcastRange,
+    count: usize,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    let owned: Vec<sit::BroadcastRange>;
+    let list: &[sit::BroadcastRange] = if ranges.is_null() || count == 0 {
+        &sit::ANDROID_BOOT_RANGES
+    } else {
+        if count > crate::MAX_BROADCAST_RANGES {
+            return SamsungSitStatus::ArgTooLong;
+        }
+        owned = core::slice::from_raw_parts(ranges, count)
+            .iter()
+            .map(|&r| r.into())
+            .collect();
+        &owned
+    };
+    match sit::build_set_broadcast_sms_config(token, list) {
+        Ok(f) => emit_bytes(f, out, out_len),
+        Err(e) => crate::status_from_err(&e),
+    }
+}
