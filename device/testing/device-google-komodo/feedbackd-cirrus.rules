# Cirrus Logic CS40L26/CS40L27 and CS40L50 haptic drivers.
#
# feedbackd's own 72-feedbackd.rules recognises a vibrator by matching a fixed
# list of driver names, and knows neither of these parts, so without this the
# device is never tagged for user access nor marked a vibrator: feedbackd finds
# no vibrator at all and reports no error, and a desktop's haptics are silently
# dead. Belongs upstream in feedbackd rather than here -- CS40L50 has been in
# mainline since 2024 and is missing from that list too.
ACTION=="remove", GOTO="cirrus_haptic_end"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT}=="1", SUBSYSTEMS=="input", ATTRS{name}=="cs40l26_vibra", TAG+="uaccess", ENV{FEEDBACKD_TYPE}="vibra"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT}=="1", SUBSYSTEMS=="input", ATTRS{name}=="cs40l50_vibra", TAG+="uaccess", ENV{FEEDBACKD_TYPE}="vibra"
LABEL="cirrus_haptic_end"
