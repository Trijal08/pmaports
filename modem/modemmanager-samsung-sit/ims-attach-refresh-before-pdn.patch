+                      GAsyncResult *res,
+                      GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_sit_client_set_initial_attach_apn_finish (client, res, &error))
+        mm_obj_dbg (g_task_get_source_object (task),
+                    "attach APN refresh refused (%s); continuing to the PDN",
+                    error->message);
+    sequence_step (task);
+}
