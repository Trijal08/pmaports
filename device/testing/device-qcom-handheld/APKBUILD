# Reference: <https://postmarketos.org/devicepkg>
maintainer="Anton Bambura <jenneron@protonmail.com>"
pkgname=device-qcom-handheld
pkgver=5
pkgrel=0
pkgdesc="Generic device package for various Qualcomm based handheld devices"
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-qcom-handheld
	firmware-ayn-audioreach-topology
	firmware-qcom-wcn7860
	hexagonrpcd
	inputplumber
	linux-firmware-ath10k
	linux-firmware-ath11k
	linux-firmware-ath12k
	linux-firmware-qca
	linux-firmware-qcom
	linux-qcom-handheld
	make-dynpart-mappings
	msm-firmware-loader
	msm-firmware-loader-hexagonrpcd
	postmarketos-base
	rmtfs
	soc-qcom
	soc-qcom-qbootctl
	systemd-boot
	unl0kr-fbforcerefresh
"
makedepends="devicepkg-dev"
subpackages="$pkgname-systemd $pkgname-udev"
source="
	50-fastrpc.hwdb
	80-device-qcom-handheld.preset
	81-libssc.rules
	deviceinfo
	kernel-cmdline.conf
	hexagonrpcd-adsp-secure-sensorspd.service
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# inputplumber
	install -Dm644 "$srcdir"/80-device-qcom-handheld.preset \
		-t "$pkgdir"/usr/lib/systemd/system-preset

	# some of these devices use /dev/fastrpc-adsp-secure instead of /dev/fastrpc-adsp
	install -Dm644 "$srcdir"/hexagonrpcd-adsp-secure-sensorspd.service \
		-t "$pkgdir"/usr/lib/systemd/system

	# mount matrix
	install -Dm644 50-fastrpc.hwdb \
		-t "$pkgdir"/usr/lib/udev/hwdb.d
	install -Dm644 81-libssc.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
}

