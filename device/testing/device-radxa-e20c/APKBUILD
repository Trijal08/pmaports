6ef912bcf4e09d248dc93b0be8d98e0c720b497892b50e8f0ab076032cccf317f650126cef4a9b48ebbe573255433f87a9a3f9799dca35e492af8933177a1c98  gunzip-vmlinuz.sh
51be0af5b2354ce9c917138b4433d480653ecd700b17ff4a92fdfa7e7825eee80f41a811a95709b48aa9d1938e3e8ad70120dbd7aa7df6e2cc725570db5b19db  kernel-cmdline.conf
"
