+/// The slot the bootloader booted.
+///
+/// androidboot.slot_suffix is the primary source, but it is unavailable
+/// whenever the kernel rejects the bootloader's bootconfig: the bootloader
+/// puts its whole 32 KiB buffer size in the trailer's size field, so the
+/// declared data spans the 20-byte trailer itself, and since the upstream
+/// commit "bootconfig: Reject unexpected data after null character" the kernel
+/// discards the entire blob rather than parsing what precedes the padding.
+/// /proc/bootconfig is then present but empty, on every boot.
+///
+/// Fall back to the devinfo record, where the bootloader sets exactly one
+/// slot's active bit to the slot it chose. This introduces no new trust:
+/// validate_current_slot() already refuses to act unless the current slot is
+/// the active one, so the two can never legitimately disagree.
+fn read_current_slot(record: &DevInfo) -> Result<Slot, String> {
+    let from_bootconfig = fs::read_to_string(BOOTCONFIG_PATH)
+        .map_err(|error| format!("failed to read {BOOTCONFIG_PATH}: {error}"))
+        .and_then(|contents| bootconfig::parse_current_slot(&contents));
+
+    let error = match from_bootconfig {
+        Ok(slot) => return Ok(slot),
+        Err(error) => error,
+    };
+
+    match record.active_bits() {
+        (true, false) => {
+            eprintln!("pixel-boot-control: {error}; using the devinfo active slot a");
+            Ok(Slot::A)
+        }
+        (false, true) => {
+            eprintln!("pixel-boot-control: {error}; using the devinfo active slot b");
+            Ok(Slot::B)
+        }
+        (a, b) => Err(format!(
+            "{error}, and devinfo cannot break the tie (active bits a={a} b={b})"
+        )),
+    }
 }
 
