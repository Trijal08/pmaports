 /// The vendor sends 0 unless the APN is IMS or emergency capable, which is why
 /// an ordinary internet context asks for none.
 const PCSCF_REQUEST_NONE: u8 = 0;
+const PCSCF_REQUEST_V4: u8 = 1;
+const PCSCF_REQUEST_V6: u8 = 2;
 const PCSCF_REQUEST_BOTH: u8 = 3;
 
+/// A P-CSCF request names the address families the PDN itself will have, never
+/// more. Asking for a family the PDN does not carry is a request the network
+/// cannot answer, and this CP does not let it reach the network: a `DNN=ims`
+/// context on an IPv6 PDN asking for both families is refused locally with
+/// MATCH_ALL_RULE_NOT_ALLOWED (2253) -- the same answer it gives when no URSP
+/// rule matched at all, which is what made this look like a policy problem for
+/// a month. Captured from this modem's own Android, the IMS context on Telus,
+/// whose carrier record makes `ims` IPv6, sends `@0xda = 2` with `@0xdb = 2`;
+/// that byte pair is the whole difference between a context the CP forwards
+/// and one it refuses.
+fn pcscf_for_pdp(pdp: PdpType) -> u8 {
+    match pdp {
+        PdpType::Ipv4 => PCSCF_REQUEST_V4,
+        PdpType::Ipv6 => PCSCF_REQUEST_V6,
+        PdpType::Ipv4v6 => PCSCF_REQUEST_BOTH,
+    }
+}
+
 /// Both the CP's apn-type byte and the P-CSCF request follow from what the
 /// context is *for*, so the RIL derives them from the same bitmask rather than
 /// taking them separately (`GetProtocolApnType`, `GetPcscfReqType`). Emergency
 /// wins over IMS where an APN claims both, matching the RIL's test order.
-fn apn_purpose(apn_types: u32) -> (u8, u8) {
+fn apn_purpose(apn_types: u32, pdp: PdpType) -> (u8, u8) {
     if apn_types & apn_type::EMERGENCY != 0 {
-        (SIT_APN_TYPE_EMERGENCY, PCSCF_REQUEST_BOTH)
+        (SIT_APN_TYPE_EMERGENCY, pcscf_for_pdp(pdp))
     } else if apn_types & apn_type::IMS != 0 {
-        (SIT_APN_TYPE_IMS, PCSCF_REQUEST_BOTH)
+        (SIT_APN_TYPE_IMS, pcscf_for_pdp(pdp))
     } else {
         (SIT_APN_TYPE_NORMAL, PCSCF_REQUEST_NONE)
     }
