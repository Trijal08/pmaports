# Co-Maintainer: Anton Bambura <jenneron@protonmail.com>
maintainer="Victoria Brekenfeld <pkg@drakulix.de>"
pkgname=steamos-manager
pkgver=26.4.1
pkgrel=1
pkgdesc="SteamOS Manager is a system daemon that aims to abstract Steam's interactions with the operating system."
url="https://gitlab.steamos.cloud/holo/steamos-manager"
# armv7: error[E0512]: cannot transmute between types of different sizes, or dependently-sized types
# ppc64le: error[E0659]: `STATX_TYPE` is ambiguous
# riscv64: fails with pmb crossdirect
arch="all !armv7 !ppc64le !riscv64"
license="MIT"
depends="orca"
makedepends="
	sccache
	cargo
	cargo-auditable
	rust
	clang21-dev
	eudev-dev
	glib-dev
	speech-dispatcher-dev
"
depends="pipewire-tools"
source="https://gitlab.steamos.cloud/holo/steamos-manager/-/archive/v$pkgver/steamos-manager-v$pkgver.tar.gz
	0001-use-gamescope-session-plus.patch
	0002-use-plasmalogin.patch
"
subpackages="
	$pkgname-systemd
	$pkgname-dbus
	$pkgname-doc
"
# remote_battery_charge_limit1_autoadd_drop_remote test depends on race conditions on slow CI runners
options="!check"
builddir="$srcdir/$pkgname-v$pkgver"

build() {
	# -vv to avoid being killed in bpo
	make build CARGOFLAGS="auditable -vv"
}

package() {
	# -vv to avoid being killed in bpo
	make install DESTDIR="$pkgdir" CARGOFLAGS="-vv"

	# conflicts with orca package
	rm $pkgdir/usr/lib/systemd/user/orca.service

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/"$pkgname"
}

dbus() {
	pkgdesc="DBus configs for $pkgname"
	install_if="$pkgname=$pkgver-r$pkgrel dbus"
	amove usr/share/dbus-1
}

