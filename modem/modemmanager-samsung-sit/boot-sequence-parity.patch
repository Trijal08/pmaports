+/*
+ * GENERATED -- do not edit by hand.
+ *
+ * The requests this modem's own Android sends on a SIT control stack between
+ * the RIL's first frame and its first IMS PDN, less the ones this plugin
+ * already sends and less the subsystems it drives its own way (SMS, SIM, STK,
+ * calls). Captured from /proc/sitdump on komodo, one stack, cold boot.
+ *
+ * It exists because matching individual fields was not enough: with the IMS
+ * context and the whole carrier-configuration exchange byte-identical to
+ * Android's, the CP still refused every PDN but the one it attached with. The
+ * difference is not in any one request -- it is that Android sends 419
+ * requests in its first 22 seconds and this plugin sent 89. Whatever state the
+ * CP needs is built by that traffic, so the traffic is reproduced rather than
+ * guessed at.
+ *
+ * Payloads are verbatim, at the frame offset the CP reads them from (@0x0c),
+ * except the two rows that name a subscription: SET_OPEN_CARRIER_INFO carries
+ * the SIM's MCCMNC and SET_MOBILE_DATA_STATE the logical stack, and those are
+ * filled in at run time.
+ */
+
+#ifndef MM_SIT_BOOT_PARITY_H
+#define MM_SIT_BOOT_PARITY_H
+
+#include <glib.h>
+
+typedef enum {
+    /* Before the radio goes on, with the rest of the boot configuration. */
+    MM_SIT_PARITY_PHASE_BOOT,
+    /* After it, while the CP is searching and before anything wants a PDN. */
+    MM_SIT_PARITY_PHASE_RADIO,
+} MMSitParityPhase;
+
+typedef enum {
+    MM_SIT_PARITY_SUB_NONE,
+    /* @0x0c: the SIM's MCCMNC, ASCII, NUL-padded to the field width. */
+    MM_SIT_PARITY_SUB_MCCMNC,
+    /* @0x0c: the logical stack this request is about. */
+    MM_SIT_PARITY_SUB_STACK,
+} MMSitParitySub;
+
+typedef struct {
+    guint16          id;
+    MMSitParityPhase phase;
+    MMSitParitySub   sub;
+    guint16          len;
+    const guint8    *payload;
+} MMSitParityRequest;
