+/// String tags the vendor sends empty and never populated, in the same five
+/// captures. They are not optional -- a tag absent from the menu leaves the
+/// CP's slot at whatever it held -- so they are sent as stock sends them.
+const COMPILED_IN_EMPTY: &[u16] = &[tag::UA_EXTRA_1, tag::UA_EXTRA_2];
+
 /// The SIM's identity, not the serving network's. The discriminators matter:
 /// several carriers share an MCCMNC and are told apart only by these.
 #[derive(Debug, Default, Clone)]
 pub struct CarrierIdentity {
+    /// Whether the card carries an ISIM application (AID `A000000087 1004`).
+    ///
+    /// It decides one thing here: stock sends the IMS home domain only for a
+    /// card that has one. Confirmed on this pair of SIMs -- the Videotron card
+    /// has an ISIM and is sent `ims.mnc500.mcc302.3gppnetwork.org`, the Telus
+    /// card has none and is sent no domain at all.
+    pub has_isim: bool,
+    /// EF_DOMAIN as the ISIM states it, when the card answered it.
+    ///
+    /// The operator chooses this name; most use the 3GPP default form but
+    /// nothing obliges them to, so a card that states one is believed and
+    /// [`ims_home_domain`] is only the fallback.
+    pub isim_domain: String,
     pub mccmnc: String,
     pub spn: String,
     pub imsi: String,
@@ -254,6 +279,28 @@
     value.replace(' ', "-")
 }
 
+/// The model as the vendor names it: no vendor prefix and no spaces.
+///
+/// The device tree says "Pixel 9 Pro XL" where stock sends "Pixel9ProXL", in
+/// tag 773 and inside the User-Agent alike. The spaces are removed rather than
+/// replaced because that is what the captures show, and because tag 773 is not
+/// a User-Agent field -- it has no separator to preserve.
+fn model_token(vendor: &str, model: &str) -> String {
+    let mut model = model;
+    // The device tree names the model with its vendor already in it ("Google
+    // Pixel 9a") while the CP wants them separately, so a repeated vendor is
+    // dropped rather than emitted twice.
+    let vendor_len = vendor.len();
+    if vendor_len != 0
+        && model.len() > vendor_len
+        && model.as_bytes()[..vendor_len].eq_ignore_ascii_case(vendor.as_bytes())
+        && model.as_bytes()[vendor_len] == b' '
+    {
+        model = &model[vendor_len + 1..];
+    }
+    model.replace(' ', "")
+}
+
 /// Expand the carrier's User-Agent template.
 ///
 /// The template is the carrier's, placeholders and all
@@ -269,28 +316,27 @@
 /// cannot be corrupted by it.
 fn expand_user_agent(template: &str, dev: &DeviceIdentity) -> String {
     let vendor = dev.manufacturer.as_str();
-    let mut model = dev.model.as_str();
-
-    // The device tree names the model with its vendor already in it ("Google
-    // Pixel 9a") while the template wants them separately, so a repeated
-    // vendor is dropped rather than emitted twice.
-    let vendor_len = vendor.len();
-    if vendor_len != 0
-        && model.len() > vendor_len
-        && model.as_bytes()[..vendor_len].eq_ignore_ascii_case(vendor.as_bytes())
-        && model.as_bytes()[vendor_len] == b' '
-    {
-        model = &model[vendor_len + 1..];
-    }
 
     template
         .replace("Android", &ua_token(&dev.os_name))
         .replace("#MANUFACTURE#", vendor)
-        .replace("#MODEL#", &ua_token(model))
+        .replace("#MODEL#", &model_token(vendor, &dev.model))
         .replace("#AV#", &dev.os_version)
         .replace("#BUILD#", &ua_token(&dev.software_version))
 }
 
+/// The IMS home domain for an MCCMNC, as 3GPP TS 23.003 section 13.2 names it.
+///
+/// The MNC is padded to three digits, which is why this cannot simply split
+/// the MCCMNC in half: a two-digit MNC is written `mnc0NN`.
+fn ims_home_domain(mccmnc: &str) -> Option<String> {
+    if mccmnc.len() < 5 || mccmnc.len() > 6 || !mccmnc.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    let (mcc, mnc) = mccmnc.split_at(3);
+    Some(format!("ims.mnc{mnc:0>3}.mcc{mcc}.3gppnetwork.org"))
+}
+
 /// The template every carrier record falls back to.
 const DEFAULT_USER_AGENT: &str = "#MANUFACTURE# #MODEL# Android #AV# #BUILD#";
 
@@ -359,11 +405,27 @@
     // it does not assemble one for itself, which is why an unprovisioned CP
     // cannot register at all.
     set(&mut entries, tag::UA_MANUFACTURER, Value::Str(device.manufacturer.clone()));
-    set(&mut entries, tag::UA_MODEL, Value::Str(device.model.clone()));
+    set(&mut entries, tag::UA_MODEL,
+        Value::Str(model_token(&device.manufacturer, &device.model)));
     set(&mut entries, tag::UA_SOFTWARE_VERSION, Value::Str(device.software_version.clone()));
     set(&mut entries, tag::UA_PRODUCT_LINE, Value::Str("SH000000".to_string()));
     set(&mut entries, tag::UA_OS_VERSION, Value::Str(device.os_version.clone()));
 
+    for tag in COMPILED_IN_EMPTY {
+        set(&mut entries, *tag, Value::Str(String::new()));
+    }
+    // Only for a card that has an ISIM; see CarrierIdentity::has_isim.
+    if identity.has_isim {
+        let domain = if identity.isim_domain.is_empty() {
+            ims_home_domain(&identity.mccmnc)
+        } else {
+            Some(identity.isim_domain.clone())
+        };
+        if let Some(domain) = domain {
+            set(&mut entries, tag::IMS_HOME_DOMAIN, Value::Str(domain));
+        }
+    }
+
     let user_agent = expand_user_agent(
         template.as_deref().unwrap_or(DEFAULT_USER_AGENT),
         device,
