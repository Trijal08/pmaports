+/// Serialise records back into the same framing `parse_prologue` reads, so a
+/// session that worked can be written out and replayed later.
+pub fn encode_prologue(records: &[PrologueRecord]) -> Vec<u8> {
+    let mut out = Vec::new();
+    for r in records {
+        out.extend_from_slice(&r.midsid.to_le_bytes());
+        out.extend_from_slice(&r.proto.to_le_bytes());
+        out.extend_from_slice(&(r.data.len() as u16).to_le_bytes());
+        out.extend_from_slice(&r.data);
+    }
+    out
+}
