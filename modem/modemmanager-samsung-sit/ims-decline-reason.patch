diff --git a/src/plugins/samsung-sit/mm-call-samsung-sit.c b/src/plugins/samsung-sit/mm-call-samsung-sit.c
index ced2137..57ffb80 100644
--- a/src/plugins/samsung-sit/mm-call-samsung-sit.c
+++ b/src/plugins/samsung-sit/mm-call-samsung-sit.c
@@ -315,9 +315,14 @@ call_hangup (MMBaseCall          *_self,
     call_id = call_cp_id (_self);
 
     if (call_is_ims (self)) {
-        mm_obj_dbg (self, "hanging up IMS call %u (MM index %u)", call_id, index);
+        /* A call that was never answered is declined rather than hung up, and
+         * the CP is told which of the two it was. */
+        gboolean declined = (mm_base_call_get_state (_self) == MM_CALL_STATE_RINGING_IN);
+
+        mm_obj_dbg (self, "%s IMS call %u (MM index %u)",
+                    declined ? "declining" : "hanging up", call_id, index);
         mm_sit_ims_hangup (mm_broadband_modem_samsung_sit_peek_ims (MM_BROADBAND_MODEM_SAMSUNG_SIT (self->priv->modem)),
-                           (guint8) call_id,
+                           (guint8) call_id, declined,
                            (GAsyncReadyCallback) ims_simple_ready, task);
         return;
     }
diff --git a/src/plugins/samsung-sit/mm-sit-ims.c b/src/plugins/samsung-sit/mm-sit-ims.c
index 94d14ee..0e452df 100644
--- a/src/plugins/samsung-sit/mm-sit-ims.c
+++ b/src/plugins/samsung-sit/mm-sit-ims.c
@@ -922,6 +922,7 @@ mm_sit_ims_answer_finish (MMSitIms      *self,
 void
 mm_sit_ims_hangup (MMSitIms            *self,
                    guint8               call_id,
+                   gboolean             declined,
                    GAsyncReadyCallback  callback,
                    gpointer             user_data)
 {
@@ -931,10 +932,17 @@ mm_sit_ims_hangup (MMSitIms            *self,
 
     g_return_if_fail (MM_IS_SIT_IMS (self));
 
-    /* Reason 0 is an ordinary local hang-up; the capture uses 2 for declining a
-     * call that is still ringing, which the interface does not distinguish. */
+    /*
+     * Reason 0 is an ordinary local hang-up, and the capture uses 2 for
+     * declining a call that is still ringing. Sending 0 for a decline tells
+     * the CP that a call it never answered ended normally, and it then stops
+     * registering IMS at all: the network keeps accepting calls and routing
+     * them to voicemail without ever paging, and nothing short of a reboot
+     * recovers it -- re-provisioning replays the identical AIMS sequence,
+     * every response succeeds, and the CP still never registers.
+     */
     status = samsung_aims_build_hangup (mm_sit_client_next_token (self->priv->client),
-                                        call_id, 0, &frame, &len);
+                                        call_id, declined ? 2 : 0, &frame, &len);
     send_simple (self, frame, len, status, "hangup", NULL, callback, user_data);
 }
 
