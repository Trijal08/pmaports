+    /// Data blocks say "more follows"; only the close says "that was all".
+    ///
+    /// Stock's boot capture has 39 payload-carrying frames, every one type 7,
+    /// and every read-closing envelope type 1. Tagging the blocks type 1 makes
+    /// the CP read block one as the whole answer and re-issue the read, which
+    /// is the entire boot-time re-read storm.
+    #[test]
+    fn data_blocks_are_partial_and_only_the_close_is_the_response() {
+        let dir = std::env::temp_dir().join(format!("gipc-type-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let name = "typetest.binarypb";
+        std::fs::write(dir.join(name), vec![3u8; 9000]).unwrap();
+
+        let req = GipcMessage {
+            r#type: Some(TYPE_REQUEST),
+            endpoint: Some(132),
+            service: Some(SVC_UECAP_FILE),
+            method: Some(0x5b78_66da),
+            payload: Some(
+                UecapFileReadRequest {
+                    size: 20000,
+                    block_size: 4000,
+                    file_dir: 1,
+                    file_name: name.to_string(),
+                }
+                .encode_to_vec(),
+            ),
+            sequence: Some(6),
+        };
+        let out = Gipc::new(dir.clone(), false).serve_uecap_file(&req);
+        std::fs::remove_dir_all(&dir).ok();
+
+        /* 9000 bytes at 4000 per block is 3 blocks, plus the closing envelope. */
+        assert_eq!(out.len(), 4);
+        for (n, frame) in out[..3].iter().enumerate() {
+            let m = GipcMessage::decode(frame.as_slice()).unwrap();
+            assert_eq!(
+                m.r#type,
+                Some(TYPE_RESPONSE_PARTIAL),
+                "data block {} is not marked partial",
+                n
+            );
+            assert!(m.payload.is_some(), "data block {} lost its payload", n);
+        }
+        let close = GipcMessage::decode(out[3].as_slice()).unwrap();
+        assert_eq!(close.r#type, Some(TYPE_RESPONSE));
+        assert!(close.payload.is_none());
+    }
+
