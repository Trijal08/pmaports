# Co-Maintainer: Anton Bambura <jenneron@protonmail.com>
maintainer="Victoria Brekenfeld <pkg@drakulix.de>"
pkgname=decky-loader
pkgver=3.3.1
pkgrel=0
pkgdesc="A plugin loader for the Steam Deck"
url="https://github.com/SteamDeckHomebrew/decky-loader"
# riscv64: Error: string or blob too big
arch="all !riscv64"
# The project does not specify GPL v2 variant
# https://github.com/SteamDeckHomebrew/decky-loader/issues/1015
license="GPL-2.0-only"
depends="
	py3-aiohttp
	py3-aiohttp-jinja2
	py3-aiohttp-cors
	py3-certifi
	py3-multidict
	py3-packaging
	py3-setproctitle
	py3-watchdog
"
makedepends="
	nodejs
	pnpm
	py3-poetry-core
	py3-gpep517
	python3-dev
	rollup
"
subpackages="$pkgname-systemd $pkgname-pyc"
source="$pkgname-v$pkgver.tar.gz::https://github.com/SteamDeckHomebrew/decky-loader/archive/refs/tags/v$pkgver.tar.gz
	decky-loader.service
	0001-build-use-system-dependencies.patch
	0002-frontend-Hide-updater.patch
	0003-frontend-Add-Nura-warning.patch
"
options="!check" # no tests

prepare() {
	default_prepare

	# set version
	sed -i "s/version = \"0.0.0\"/version = \"$pkgver\"/" "$builddir"/backend/pyproject.toml

	cd "$builddir"/frontend
	pnpm link /usr/share/node_modules/rollup
	pnpm install --frozen-lockfile
}

build() {
	cd "$builddir"/frontend
	pnpm run build

	cd "$builddir"/backend
	export POETRY_DYNAMIC_VERSIONING_BYPASS="$pkgver"
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1
}

package() {
	python3 -m installer -d "$pkgdir" "$builddir"/backend/.dist/*.whl
	install -Dm644 "$srcdir"/decky-loader.service "$pkgdir"/usr/lib/systemd/user/decky-loader.service
}

