+/// The `DTMF` digit field is a fixed 64-byte slot (frame 0x0d..0x4d), and the
+/// builder clamps the count to it.
+const DTMF_CAP: usize = 64;
+
+/// The sixteen keys a DTMF keypad can send: RFC 4733's digits, letters and the
+/// two symbols. The CP has no encoding for anything else.
+fn is_dtmf_digit(digit: char) -> bool {
+    digit.is_ascii_digit() || matches!(digit, 'A'..='D' | '*' | '#')
+}
+
+/// Build a `DTMF` (0x0003) request: 77 bytes.
+///
+/// This is the self-timed burst form -- it carries the whole run of digits and
+/// the CP times each tone itself, so there is no release to pair with it.
+///
+/// Layout from `ProtocolCallBuilder::BuildDtmf(int, char *)`, which calls
+/// `InitRequestHeader(..., 3, 77)` and then writes `min(count, 64)` as one byte
+/// at frame 0x0c before copying the digits to frame 0x0d. Digits go on the wire
+/// as their ASCII characters -- the vendor's parameter is a `char *` -- so '2'
+/// is 0x32, not 2.
+///
+/// The other two ids in this group are deliberately not built. `DTMF_START`
+/// (0x0005, 15 bytes) is `ProtocolCallBuilder::BuildDtmfStart(bool, unsigned
+/// short)`, which writes that bool at frame 0x0c, a constant 1 at 0x0d and the
+/// digit at 0x0e; nothing in any library we have calls it, so what the bool
+/// selects is unknown and guessing it would put an undefined byte on the wire.
+/// `DTMF_STOP` (0x0006) is header-only and would be meaningless after a burst
+/// that is already finished.
+pub fn build_dtmf(token: u16, digits: &str) -> Result<Vec<u8>, SitError> {
+    if digits.is_empty() {
+        return Err(SitError::Malformed("DTMF with no digits"));
+    }
+    if digits.len() > DTMF_CAP {
+        return Err(SitError::ArgTooLong("DTMF digits"));
+    }
+
+    let mut body = [0u8; 4 + 1 + DTMF_CAP];
+    let mut n = 0;
+    for d in digits.chars() {
+        let d = d.to_ascii_uppercase();
+        if !is_dtmf_digit(d) {
+            return Err(SitError::Malformed("not a DTMF digit"));
+        }
+        body[5 + n] = d as u8; // frame 0x0d onwards
+        n += 1;
+    }
+    body[4] = n as u8; // frame 0x0c
+    Ok(frame_header(msg_id::DTMF, token, &body))
+}
+
