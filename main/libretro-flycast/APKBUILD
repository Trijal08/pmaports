# Maintainer: Trijal Saha <trijalsaha2012@gmail.com>
pkgname=libretro-flycast
pkgver=0_git20260706
pkgrel=0
_commit="45bd2f4e59708a7c16a5bb1cb90a94d1b39e330d"
pkgdesc="libretro core for flycast"
url="https://github.com/libretro/flycast"
# aarch64 only, on purpose: "pmbootstrap build" with no --arch builds for
# the native architecture whenever the APKBUILD lists it, so listing
# x86_64 here quietly builds a package the R36S cannot use.
arch="aarch64"
license="GPL-2.0-only"
options="!check" # No tests
# Overrides Alpine's aport, which is pinned at 0_git20220406 - an April 2022
# snapshot. Four years of Dreamcast work were missing, and it showed: the
# core still used the old reicast_* option names, and its region handling
# left USA discs booting in Japanese.
#
# The libretro mirror vendors everything under core/deps (no .gitmodules,
# unlike flyinghead/flycast which has 22 submodules), so a plain archive
# builds - which is what makes this a version bump rather than a packaging
# project.
makedepends="mesa-dev zlib-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/libretro/flycast/archive/$_commit.tar.gz
	0001-libzip-include-unistd-h-unconditionally.patch
	"
builddir="$srcdir/flycast-$_commit"

case $CARCH in
aarch64)
	# HOST_CPU_FLAGS is computed by the Makefile from WITH_DYNAREC
	# (-DHOST_CPU=0x20000006 for arm64). Passing it on the command line
	# would override that assignment and leave HOST_CPU undefined.
	_args="WITH_DYNAREC=arm64 HAVE_GENERIC_JIT=0 HAVE_VULKAN=0" ;;
arm*)
	_args="WITH_DYNAREC=arm HAVE_GENERIC_JIT=0 HAVE_VULKAN=0" ;;
esac

build() {
	# Built against the bundled deps. The old aport unbundled libzip,
	# miniupnpc and zlib via two local patches plus SYSTEM_LIBZIP=1 and
	# SYSTEM_ZLIB=1; those Makefile switches no longer exist, and the
	# patches were written against the 2022 tree.
	#
	# HAVE_OPENMP=0 because Alpine's *cross* gcc ships no omp.h: the
	# aarch64 buildroot has one (and libgomp), but crossdirect runs the
	# native cross-compiler, whose own include directory is searched
	# instead. The switch defines TARGET_NO_OPENMP, which TexCache.cpp
	# guards every omp use behind - including a serial xbrz::scale()
	# fallback - and softrend.cpp, the only other omp.h user, is not in
	# the source list. All it costs is a single-threaded texture
	# upscaler, which a 4x Cortex-A35 was never going to run anyway.
	#
	# LDFLAGS_END carries -fno-use-linker-plugin to the link. Alpine's gcc
	# is built with HAVE_LTO_PLUGIN=2, so it hands the linker an LTO plugin
	# on every link unless told otherwise, and through crossdirect it
	# cannot locate one:
	#
	#     c++: fatal error: '-fuse-linker-plugin', but liblto_plugin.so
	#     not found
	#
	# The file is present in both chroots; the wrapper is what loses it.
	# Nothing here is compiled with LTO (HAVE_LTCG=0), so declining the
	# plugin is exact rather than a workaround. LDFLAGS_END is empty on
	# every non-Windows target and appears only in the link rule.
	make $_args HAVE_LTCG=0 HAVE_OPENMP=0 LDFLAGS_END=-fno-use-linker-plugin
}

package() {
	install -Dm644 flycast_libretro.so \
		"$pkgdir"/usr/lib/libretro/flycast_libretro.so
}

sha512sums="
