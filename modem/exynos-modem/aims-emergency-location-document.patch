 /// flagged `more_expected`; send them in order. Free the result with
 /// [`samsung_aims_frame_list_free`]. Tokens run from `token` upwards, one per
 /// frame.
+/// Build `SET_GEO_LOCATION_INFO` (0x0d62): the emergency location the CP
+/// puts in an emergency INVITE. Stock sends one per stack at boot.
+///
+/// `entity` is the presence URI and `country` an ISO 3166-1 alpha-2 code;
+/// either may be empty. The buffer is freed with `samsung_sit_buf_free`.
+///
+/// # Safety
+/// `entity`/`country` must be NUL-terminated UTF-8; `out`/`out_len` writable.
+#[no_mangle]
+pub unsafe extern "C" fn samsung_aims_build_geo_location_info(
+    token: u16,
+    entity: *const c_char,
+    country: *const c_char,
+    out: *mut *mut u8,
+    out_len: *mut usize,
+) -> SamsungSitStatus {
+    if out.is_null() || out_len.is_null() {
+        return SamsungSitStatus::NullPointer;
+    }
+    let entity = match crate::builders::cstr_or_empty(entity) {
+        Ok(v) => v,
+        Err(s) => return s,
+    };
+    let country = match crate::builders::cstr_or_empty(country) {
+        Ok(v) => v,
+        Err(s) => return s,
+    };
+    let f = samsung_aims::geoloc::build_set_geo_location_info(token, entity, country);
+    emit_result(Ok(f), out, out_len)
+}
